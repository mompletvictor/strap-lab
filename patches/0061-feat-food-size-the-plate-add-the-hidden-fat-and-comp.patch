+    /**
+     * One item of the reply. With grams and a composition per 100 g (the schema), the per-portion
+     * numbers are grams × per-100 g; a reply in the older per-portion shape (`kcal`, `protein_g`…)
+     * still reads, so a model answering from the text fallback in that shape is not lost.
+     */
+    internal fun parseItem(o: JSONObject): FoodItem {
+        val grams = o.optDouble("grams", 0.0)
+        val per100 = grams.isFinite() && grams > 0.0 && ITEM_FIELDS.drop(3).any { o.has(it) }
+        fun of(per100Key: String, portionKey: String): Double =
+            if (per100) round1(grams * o.optDouble(per100Key, 0.0) / 100.0) else round1(o.optDouble(portionKey, 0.0))
+        return FoodItem(
+            name = o.optString("name").trim(),
+            portion = o.optString("portion").trim(),
+            kcal = of("kcal_per_100g", "kcal"),
+            proteinG = of("protein_per_100g", "protein_g"),
+            carbsG = of("carbs_per_100g", "carbs_g"),
+            fatG = of("fat_per_100g", "fat_g"),
+        )
+    }
+
