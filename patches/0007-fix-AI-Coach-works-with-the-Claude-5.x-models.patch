new file mode 100644
index 00000000..9bde863d
--- /dev/null
+++ b/android/app/src/test/java/com/noop/ai/AnthropicReplyTextTest.kt
@@ -0,0 +1,55 @@
+package com.noop.ai
+
+import org.json.JSONObject
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** victor:claude-models — reading Messages API replies from Claude 5.x (thinking on by default). */
+class AnthropicReplyTextTest {
+
+    @Test
+    fun skipsTheThinkingBlockThatClaude5PutsFirst() {
+        val reply = JSONObject(
+            """{"content":[{"type":"thinking","thinking":"","signature":"abc"},
+               {"type":"text","text":"  Duerme más hoy.  "}],"stop_reason":"end_turn"}""",
+        )
+        assertEquals("Duerme más hoy.", AiCoach.anthropicReplyText(reply))
+    }
+
+    @Test
+    fun joinsEveryTextBlockInOrder() {
+        val reply = JSONObject(
+            """{"content":[{"type":"text","text":"Uno. "},{"type":"thinking","thinking":""},
+               {"type":"text","text":"Dos."}]}""",
+        )
+        assertEquals("Uno. Dos.", AiCoach.anthropicReplyText(reply))
+    }
+
+    @Test
+    fun olderModelsWithASingleTextBlockStillWork() {
+        val reply = JSONObject("""{"content":[{"type":"text","text":"Hola"}]}""")
+        assertEquals("Hola", AiCoach.anthropicReplyText(reply))
+    }
+
+    @Test
+    fun refusalIsNamedInsteadOfEmptyReply() {
+        val body = """{"content":[],"stop_reason":"refusal"}"""
+        val msg = AiCoach.anthropicEmptyReplyMessage(JSONObject(body), body)
+        assertEquals("", AiCoach.anthropicReplyText(JSONObject(body)))
+        assertTrue(msg.contains("declined"))
+        val other = """{"content":[],"stop_reason":"end_turn"}"""
+        assertFalse(AiCoach.anthropicEmptyReplyMessage(JSONObject(other), other).contains("declined"))
+    }
+
+    @Test
+    fun curatedListHasTheCurrentGenerationAndNoRetiredModels() {
+        val models = AiProvider.ANTHROPIC.models
+        assertTrue("claude-opus-5-5" in models)
+        assertTrue("claude-fable-5-1" in models)
+        assertTrue(AiProvider.ANTHROPIC.defaultModel in models)
+        assertFalse(models.any { it.startsWith("claude-3") })
+        assertTrue(AiProvider.ANTHROPIC.modelsEndpoint.endsWith("?limit=1000"))
+    }
+}
