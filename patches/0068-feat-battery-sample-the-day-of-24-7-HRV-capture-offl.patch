+package com.noop.ble
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** victor:battery — the sampled day of 24/7 capture and the slower offload while the stream runs. */
+class VictorBatteryTest {
+
+    private val start = 22 * 60
+    private val end = 7 * 60
+
+    @Test
+    fun theNightStreamsTheWholeTimeAndTheDayFiveMinutesOfEveryThirty() {
+        for (m in listOf(22 * 60, 23 * 60 + 17, 0, 3 * 60 + 44, 6 * 60 + 59)) {
+            assertTrue("night $m", WhoopBleClient.victorContinuousCaptureWanted(false, m, start, end))
+        }
+        val day = (7 * 60 until 22 * 60).filter { WhoopBleClient.victorContinuousCaptureWanted(false, it, start, end) }
+        assertEquals(30 * 5, day.size)   // 15 h × 2 windows × 5 min
+        assertTrue(WhoopBleClient.victorContinuousCaptureWanted(false, 9 * 60 + 4, start, end))
+        assertFalse(WhoopBleClient.victorContinuousCaptureWanted(false, 9 * 60 + 5, start, end))
+        assertTrue(WhoopBleClient.victorContinuousCaptureWanted(false, 9 * 60 + 30, start, end))
+        // Every waking hour keeps two whole windows: ten minutes of samples, past the Stress score's five.
+        for (h in 7 until 22) assertEquals(10, (h * 60 until h * 60 + 60).count { WhoopBleClient.victorDayDutyOn(it) })
+    }
+
+    @Test
+    fun overnightOnlyStillStreamsNothingByDay() {
+        assertTrue(WhoopBleClient.victorContinuousCaptureWanted(true, 23 * 60, start, end))
+        for (m in 7 * 60 until 22 * 60) assertFalse("day $m", WhoopBleClient.victorContinuousCaptureWanted(true, m, start, end))
+    }
+
+    @Test
+    fun theOffloadWaitsHalfAnHourOnlyWhileStreamingAndNeverShortensASlowerChoice() {
+        assertEquals(1_800_000L, WhoopBleClient.victorStreamingBackfillBaseMs(900_000L, streaming = true))
+        assertEquals(900_000L, WhoopBleClient.victorStreamingBackfillBaseMs(900_000L, streaming = false))
+        assertEquals(3_600_000L, WhoopBleClient.victorStreamingBackfillBaseMs(3_600_000L, streaming = true))   // low refresh stays hourly
+    }
+}
