diff --git a/android/app/src/main/java/com/noop/ble/WhoopBleClient.kt b/android/app/src/main/java/com/noop/ble/WhoopBleClient.kt
index dbbaaa322..98ee3a26e 100644
--- a/android/app/src/main/java/com/noop/ble/WhoopBleClient.kt
+++ b/android/app/src/main/java/com/noop/ble/WhoopBleClient.kt
@@ -2127,6 +2127,26 @@ class WhoopBleClient(
             if (!overnightOnly) return true
             return overnightWindowContains(minuteOfDay, startMin, endMin)
         }
+
+        /** victor:battery — the daytime share of 24/7 capture: [VICTOR_DAY_DUTY_ON_MIN] of every
+         *  [VICTOR_DAY_DUTY_PERIOD_MIN] minutes. Five minutes of R-R is the standard short-term HRV reading, and
+         *  the daytime Stress score is HR-only and needs five minutes of samples an hour, so every waking hour
+         *  keeps two full windows while the strap streams a sixth of the day. */
+        fun victorDayDutyOn(minuteOfDay: Int): Boolean = minuteOfDay.mod(VICTOR_DAY_DUTY_PERIOD_MIN) < VICTOR_DAY_DUTY_ON_MIN
+
+        /** victor:battery — continuous capture (already known on): the nightly window streams the whole time, as
+         *  before; outside it, overnight-only streams nothing and 24/7 samples the day ([victorDayDutyOn]). */
+        fun victorContinuousCaptureWanted(overnightOnly: Boolean, minuteOfDay: Int, startMin: Int, endMin: Int): Boolean =
+            overnightWindowContains(minuteOfDay, startMin, endMin) || (!overnightOnly && victorDayDutyOn(minuteOfDay))
+
+        /** victor:battery — while the realtime stream runs its HR and R-R already arrive live, so the history
+         *  offload waits [VICTOR_STREAMING_BACKFILL_INTERVAL_MS]: bigger batches, nothing lost. Only lengthens. */
+        fun victorStreamingBackfillBaseMs(baseMs: Long, streaming: Boolean): Long =
+            if (streaming) maxOf(baseMs, VICTOR_STREAMING_BACKFILL_INTERVAL_MS) else baseMs
+
+        const val VICTOR_DAY_DUTY_ON_MIN = 5
+        const val VICTOR_DAY_DUTY_PERIOD_MIN = 30
+        const val VICTOR_STREAMING_BACKFILL_INTERVAL_MS = 1_800_000L
     }
 
     // MARK: Published state — the single source of truth the UI observes. Seeded with the PERSISTED
@@ -2504,7 +2524,7 @@ class WhoopBleClient(
     private fun nextBackfillDelayMs(): Long {
