+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.text.input.KeyboardType
+import androidx.compose.ui.unit.dp
+import com.noop.R
+import com.noop.food.foodFieldColors
+import com.noop.ui.NoopCard
+import com.noop.ui.NoopType
+import com.noop.ui.Overline
+import com.noop.ui.Palette
+import com.noop.ui.uiString
+
+/**
+ * victor:goals — "Your goals" card in the Coach settings: main goal, target weight, daily intake target
+ * and a free note. Saved on every edit; read by the coach (GOALS line) and by the Food card's target.
+ */
+@OptIn(ExperimentalLayoutApi::class)
+@Composable
+internal fun VictorGoalsCard() {
+    val ctx = LocalContext.current
+    var goals by remember { mutableStateOf(VictorGoalsStore.load(ctx)) }
+    var weightText by remember { mutableStateOf(goals.targetWeightKg?.let { trimNumber(it) }.orEmpty()) }
+    var kcalText by remember { mutableStateOf(goals.dailyKcalTarget?.toString().orEmpty()) }
+    fun update(g: VictorGoals) {
+        goals = g
+        VictorGoalsStore.save(ctx, g)
+    }
+
+    NoopCard(padding = 14.dp, tint = Palette.chargeColor) {
+        Column(verticalArrangement = Arrangement.spacedBy(10.dp)) {
+            Overline(uiString(R.string.victor_goals_title))
+            Text(uiString(R.string.victor_goals_blurb), style = NoopType.footnote, color = Palette.textSecondary)
+            FlowRow(horizontalArrangement = Arrangement.spacedBy(6.dp), verticalArrangement = Arrangement.spacedBy(6.dp)) {
+                VictorGoals.Goal.entries.filter { it != VictorGoals.Goal.NONE }.forEach { g ->
+                    GoalChip(
+                        label = uiString(goalLabel(g)),
+                        selected = goals.goal == g,
+                        // Tapping the chosen goal again clears it.
+                        onClick = { update(goals.copy(goal = if (goals.goal == g) VictorGoals.Goal.NONE else g)) },
+                    )
+                }
+            }
+            Row(horizontalArrangement = Arrangement.spacedBy(10.dp)) {
+                OutlinedTextField(
+                    value = weightText,
+                    onValueChange = { v ->
+                        if (v.length <= 5 && v.all { it.isDigit() || it == '.' || it == ',' }) {
+                            weightText = v
+                            update(goals.copy(targetWeightKg = VictorGoalsStore.parseWeight(v)))
+                        }
+                    },
+                    label = { Text(uiString(R.string.victor_goals_target_weight)) },
+                    singleLine = true,
+                    keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Decimal),
+                    colors = foodFieldColors(),
+                    modifier = Modifier.weight(1f),
+                )
+                OutlinedTextField(
+                    value = kcalText,
+                    onValueChange = { v ->
+                        if (v.length <= 4 && v.all { it.isDigit() }) {
+                            kcalText = v
+                            update(goals.copy(dailyKcalTarget = VictorGoalsStore.parseKcal(v)))
+                        }
+                    },
+                    label = { Text(uiString(R.string.victor_goals_daily_kcal)) },
+                    singleLine = true,
+                    keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number),
+                    colors = foodFieldColors(),
+                    modifier = Modifier.weight(1f),
+                )
+            }
+            OutlinedTextField(
+                value = goals.note,
+                onValueChange = { v -> update(goals.copy(note = v.take(VictorGoals.MAX_NOTE))) },
+                label = { Text(uiString(R.string.victor_goals_note)) },
+                placeholder = { Text(uiString(R.string.victor_goals_note_hint)) },
+                maxLines = 4,
+                colors = foodFieldColors(),
+                modifier = Modifier.fillMaxWidth(),
+            )
+        }
+    }
+}
+
+@Composable
+private fun GoalChip(label: String, selected: Boolean, onClick: () -> Unit) {
+    Surface(
+        shape = RoundedCornerShape(50),
+        color = if (selected) Palette.accent else Palette.surfaceInset,
+        modifier = Modifier.clickable(onClick = onClick),
+    ) {
+        Text(
+            label,
+            style = NoopType.subhead,
+            color = if (selected) Palette.surfaceBase else Palette.textPrimary,
+            modifier = Modifier.padding(horizontal = 12.dp, vertical = 7.dp),
+        )
+    }
+}
+
+private fun goalLabel(g: VictorGoals.Goal): Int = when (g) {
+    VictorGoals.Goal.LOSE_FAT -> R.string.victor_goals_lose_fat
+    VictorGoals.Goal.MAINTAIN -> R.string.victor_goals_maintain
+    VictorGoals.Goal.GAIN_MUSCLE -> R.string.victor_goals_gain_muscle
+    VictorGoals.Goal.PERFORMANCE -> R.string.victor_goals_performance
+    VictorGoals.Goal.NONE -> R.string.victor_goals_title
+}
+
+private fun trimNumber(v: Double): String = if (v % 1.0 == 0.0) v.toInt().toString() else v.toString()
