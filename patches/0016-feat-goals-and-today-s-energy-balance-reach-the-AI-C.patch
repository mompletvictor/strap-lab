+package com.noop.goals
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** victor:goals — the GOALS line the coach reads, and the lenient form parsing. */
+class VictorGoalsTest {
+
+    @Test
+    fun nothingSetMeansNoLine() {
+        assertNull(VictorGoals.coachLine(VictorGoals(), currentWeightKg = 80.0))
+    }
+
+    @Test
+    fun fullGoalsWithDistanceToTargetWeight() {
+        val g = VictorGoals(VictorGoals.Goal.LOSE_FAT, targetWeightKg = 75.0, dailyKcalTarget = 2200, note = "  fuerza 4 días ")
+        assertEquals(
+            "GOALS (set by the user; plan advice against them): main goal: lose body fat; " +
+                "target weight 75.0 kg (now 78.2 kg, 3.2 kg to lose); daily intake target 2200 kcal; " +
+                "in their own words: \"fuerza 4 días\"",
+            VictorGoals.coachLine(g, currentWeightKg = 78.2),
+        )
+    }
+
+    @Test
+    fun targetWeightWithoutAScaleReadingOmitsTheDistance() {
+        val line = VictorGoals.coachLine(VictorGoals(targetWeightKg = 82.0), currentWeightKg = null)!!
+        assertTrue(line.endsWith("target weight 82.0 kg"))
+    }
+
+    @Test
+    fun formParsingIsLenientAndBounded() {
+        assertEquals(75.5, VictorGoalsStore.parseWeight("75,5")!!, 0.0)
+        assertEquals(75.5, VictorGoalsStore.parseWeight(" 75.5 ")!!, 0.0)
+        assertNull(VictorGoalsStore.parseWeight("7"))
+        assertNull(VictorGoalsStore.parseWeight(""))
+        assertEquals(2200, VictorGoalsStore.parseKcal("2200"))
+        assertNull(VictorGoalsStore.parseKcal("50"))
+    }
+}
