+package com.noop.ai
+
+import com.noop.food.FoodEnergy
+import java.time.LocalTime
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+/** victor:coach-extras — the TODAY line: steps, energy out, eaten and the balance so far. */
+class VictorCoachExtrasTest {
+    private val noon = LocalTime.of(14, 5)
+
+    @Test
+    fun fullDay() {
+        val energy = FoodEnergy.resolve(activeKcal = 600.0, phoneBasalKcal = 1050.0, scaleBmr = null, dayFraction = 0.6)
+        assertEquals(
+            "TODAY so far (2026-10-16, 14:05): steps 6240; energy burned 1650 kcal (resting 1050 + activity 600); " +
+                "eaten 1850 kcal (photo food log); surplus 200 kcal",
+            VictorCoachExtras.todayLine("2026-10-16", noon, 6240, energy, 1850.0),
+        )
+    }
+
+    @Test
+    fun noRestingEnergyMeansNoBalance() {
+        val energy = FoodEnergy.resolve(activeKcal = 500.0, phoneBasalKcal = null, scaleBmr = null, dayFraction = 0.6)
+        assertEquals(
+            "TODAY so far (2026-10-16, 14:05): activity energy 500 kcal (resting energy unknown); eaten 900 kcal (photo food log)",
+            VictorCoachExtras.todayLine("2026-10-16", noon, null, energy, 900.0),
+        )
+    }
+
+    @Test
+    fun nothingKnownMeansNoLine() {
+        val energy = FoodEnergy.resolve(null, null, null, 0.6)
+        assertNull(VictorCoachExtras.todayLine("2026-10-16", noon, null, energy, null))
+    }
+}
