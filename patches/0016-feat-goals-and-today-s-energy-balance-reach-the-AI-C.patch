+package com.noop.goals
+
+import android.content.Context
+import android.content.SharedPreferences
+import java.util.Locale
+
+/**
+ * victor:goals — the wearer's own goals, so the AI Coach (and the Food card's daily target) can plan
+ * against them instead of guessing. Fork-owned, stored in SharedPreferences; every field is optional.
+ */
+data class VictorGoals(
+    val goal: Goal = Goal.NONE,
+    val targetWeightKg: Double? = null,
+    val dailyKcalTarget: Int? = null,
+    val note: String = "",
+) {
+    enum class Goal(val raw: String, val coachText: String) {
+        NONE("none", ""),
+        LOSE_FAT("loseFat", "lose body fat"),
+        MAINTAIN("maintain", "maintain weight and body composition"),
+        GAIN_MUSCLE("gainMuscle", "gain muscle"),
+        PERFORMANCE("performance", "improve sports performance");
+
+        companion object {
+            fun fromRaw(raw: String?): Goal = entries.firstOrNull { it.raw == raw } ?: NONE
+        }
+    }
+
+    val isEmpty: Boolean get() = goal == Goal.NONE && targetWeightKg == null && dailyKcalTarget == null && note.isBlank()
+
+    companion object {
+        const val MAX_NOTE = 400
+
+        /**
+         * Pure: the GOALS line for the coach, or null when nothing is set. [currentWeightKg] (latest scale
+         * weigh-in) adds the distance to the target weight.
+         */
+        fun coachLine(g: VictorGoals, currentWeightKg: Double?): String? {
+            if (g.isEmpty) return null
+            val parts = buildList {
+                if (g.goal != Goal.NONE) add("main goal: ${g.goal.coachText}")
+                g.targetWeightKg?.let { t ->
+                    val now = currentWeightKg?.let { c ->
+                        " (now ${fmt(c)} kg, ${fmt(kotlin.math.abs(c - t))} kg to ${if (c > t) "lose" else "gain"})"
+                    }.orEmpty()
+                    add("target weight ${fmt(t)} kg$now")
+                }
+                g.dailyKcalTarget?.let { add("daily intake target $it kcal") }
+                g.note.trim().takeIf { it.isNotEmpty() }?.let { add("in their own words: \"${it.take(MAX_NOTE)}\"") }
+            }
+            return "GOALS (set by the user; plan advice against them): " + parts.joinToString("; ")
+        }
+
+        private fun fmt(v: Double) = String.format(Locale.ROOT, "%.1f", v)
+    }
+}
+
+/** Persistence for [VictorGoals] in the app's `noop_prefs`. */
+object VictorGoalsStore {
+    private const val FILE = "noop_prefs"
+    private const val K_GOAL = "victor.goals.goal"
+    private const val K_WEIGHT = "victor.goals.targetWeightKg"
+    private const val K_KCAL = "victor.goals.dailyKcal"
+    private const val K_NOTE = "victor.goals.note"
+
+    private fun prefs(ctx: Context): SharedPreferences =
+        ctx.applicationContext.getSharedPreferences(FILE, Context.MODE_PRIVATE)
+
+    fun load(ctx: Context): VictorGoals {
+        val p = prefs(ctx)
+        return VictorGoals(
+            goal = VictorGoals.Goal.fromRaw(p.getString(K_GOAL, null)),
+            targetWeightKg = p.getString(K_WEIGHT, null)?.toDoubleOrNull(),
+            dailyKcalTarget = p.getString(K_KCAL, null)?.toIntOrNull(),
+            note = p.getString(K_NOTE, null).orEmpty(),
+        )
+    }
+
+    fun save(ctx: Context, g: VictorGoals) {
+        prefs(ctx).edit()
+            .putString(K_GOAL, g.goal.raw)
+            .putString(K_WEIGHT, g.targetWeightKg?.toString())
+            .putString(K_KCAL, g.dailyKcalTarget?.toString())
+            .putString(K_NOTE, g.note.take(VictorGoals.MAX_NOTE))
+            .apply()
+    }
+
+    /** Lenient number parsing for the form fields ("75,5" and "75.5" both work); out-of-range → null. */
+    internal fun parseWeight(text: String): Double? =
+        text.trim().replace(',', '.').toDoubleOrNull()?.takeIf { it in 30.0..300.0 }
+
+    internal fun parseKcal(text: String): Int? = text.trim().toIntOrNull()?.takeIf { it in 800..8000 }
+}
