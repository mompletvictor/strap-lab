 /**
- * victor:coach-extras — fork-only context for the AI Coach: the smart-scale BODY line and the photo
- * FOOD LOG line. Appended by [AiCoach] under the same `consent` gate as the strap metrics; each line is
- * best-effort and simply absent when there is no data.
+ * victor:coach-extras — fork-only context for the AI Coach, appended by [AiCoach] under the same
+ * `consent` gate as the strap metrics: TODAY (steps, energy out, eaten, balance so far), the smart-scale
+ * BODY line, the photo FOOD LOG line and the wearer's GOALS. Each line is best-effort and simply absent
+ * when there is no data.
  */
 internal object VictorCoachExtras {
-    suspend fun block(ctx: Context, repo: WhoopRepository): String? =
-        listOfNotNull(
-            runCatching { ScaleCoachContext.line(repo) }.getOrNull(),
+    suspend fun block(ctx: Context, repo: WhoopRepository, strapId: String): String? {
+        val today = LocalDate.now().toString()
+        val scale = runCatching { ScaleImport.snapshot(repo) }.getOrNull()
+        return listOfNotNull(
+            runCatching { todayLine(ctx, repo, strapId, today) }.getOrNull(),
+            ScaleCoachContext.line(scale),
             runCatching { FoodCoachContext.line(ctx) }.getOrNull(),
+            runCatching { VictorGoals.coachLine(VictorGoalsStore.load(ctx), scale?.weight?.value) }.getOrNull(),
         ).takeIf { it.isNotEmpty() }?.joinToString("\n")
+    }
+
+    private suspend fun todayLine(ctx: Context, repo: WhoopRepository, strapId: String, today: String): String? {
+        // Steps resolved like the Today Steps card: the phone's imported count first, else the strap day.
+        val steps = runCatching {
+            stepsForDay(repo.appleDaily("apple-health", today, today), repo.appleDaily("health-connect", today, today), today)
+        }.getOrNull() ?: runCatching { repo.daysMerged(strapId).lastOrNull { it.day == today }?.steps }.getOrNull()
+        val energy = FoodEnergy.load(repo, strapId, today)
+        val eaten = runCatching { FoodDays.totalsFor(FoodStore.load(ctx), today)?.kcal }.getOrNull()
+        return todayLine(today, LocalTime.now(), steps, energy, eaten)
+    }
+
+    /** Pure: the TODAY line, or null when nothing about today is known yet. */
+    internal fun todayLine(day: String, time: LocalTime, steps: Int?, energy: FoodEnergy, eatenKcal: Double?): String? {
+        val parts = buildList {
+            steps?.let { add("steps $it") }
+            val total = energy.totalKcal
+            if (total != null) {
+                add("energy burned ${r(total)} kcal (resting ${r(energy.basalKcal ?: 0.0)} + activity ${r(energy.activeKcal ?: 0.0)})")
+            } else {
+                energy.activeKcal?.let { add("activity energy ${r(it)} kcal (resting energy unknown)") }
+            }
+            if (eatenKcal != null) {
+                add("eaten ${r(eatenKcal)} kcal (photo food log)")
+                energy.balance(eatenKcal)?.let { b -> add(if (b < 0) "deficit ${r(-b)} kcal" else "surplus ${r(b)} kcal") }
+            }
+        }
+        if (parts.isEmpty()) return null
+        return "TODAY so far ($day, ${time.format(HHMM)}): " + parts.joinToString("; ")
+    }
+
+    private val HHMM = DateTimeFormatter.ofPattern("HH:mm")
+    private fun r(v: Double) = v.roundToInt()
 }
