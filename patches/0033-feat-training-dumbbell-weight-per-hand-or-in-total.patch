+    @Test
+    fun aPerDumbbellLoadIsReadSavedAndSpelledOut() {
+        val curl = TrainingExercise("Curl", ExerciseKind.STRENGTH, List(3) { TrainingSet(10, 12.0, done = true) }, perHand = true)
