+package com.noop.ai
+
+import com.noop.data.DailyMetric
+import com.noop.data.LabMarkerRow
+import com.noop.data.SleepSession
+import java.time.LocalDate
+import java.time.LocalDateTime
+import java.time.ZoneId
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+/** victor:coach-vitals — PROFILE, NIGHTS and BLOOD PRESSURE lines for the AI Coach. */
+class VictorCoachVitalsTest {
+    private val zone: ZoneId = ZoneId.of("Europe/Madrid")
+    private fun ts(y: Int, mo: Int, d: Int, h: Int, mi: Int) =
+        LocalDateTime.of(y, mo, d, h, mi).atZone(zone).toEpochSecond()
+
+    @Test
+    fun profileUsesTheAgeFormulaUnlessOverridden() {
+        assertEquals(
+            "PROFILE (from the app's Settings): age 26, male, 178 cm, 75.0 kg, max HR 190 bpm (age formula)",
+            VictorCoachVitals.profileLine(26, "male", 178.0, 75.0, 0),
+        )
+        assertEquals(
+            "PROFILE (from the app's Settings): age 26, male, 178 cm, 75.0 kg, max HR 198 bpm (set by the user)",
+            VictorCoachVitals.profileLine(26, "male", 178.0, 75.0, 198),
+        )
+    }
+
+    @Test
+    fun nightsJoinSleepTimesAndVitalsNewestFirst() {
+        val days = listOf(
+            DailyMetric("my-whoop", "2026-10-14", spo2Pct = 95.6, respRateBpm = 15.04, skinTempDevC = -0.04),
+            DailyMetric("my-whoop", "2026-10-15", spo2Pct = 96.2, respRateBpm = 14.8, skinTempDevC = 0.34),
+            DailyMetric("my-whoop", "2026-10-16", skinTempDevC = 33.71),   // an import's absolute wrist °C
+            DailyMetric("my-whoop", "2026-10-13"),                         // nothing → no line
+        )
+        val sessions = listOf(
+            SleepSession("my-whoop", ts(2026, 10, 14, 23, 41), ts(2026, 10, 15, 7, 26)),
+            SleepSession("my-whoop", ts(2026, 10, 14, 1, 0), ts(2026, 10, 14, 8, 0), startTsAdjusted = ts(2026, 10, 14, 0, 30)),
+        )
+        assertEquals(
+            "NIGHTS (newest first; bed/up = local sleep and wake times; skin temp ± is vs the user's own baseline):\n" +
+                "  2026-10-16: skin temp 33.7°C absolute\n" +
+                "  2026-10-15: bed 23:41, up 07:26, SpO₂ 96%, resp 14.8/min, skin temp +0.3°C\n" +
+                "  2026-10-14: bed 00:30, up 08:00, SpO₂ 96%, resp 15.0/min, skin temp +0.0°C",
+            VictorCoachVitals.nightsBlock(days, sessions, zone),
+        )
+    }
+
+    @Test
+    fun noFiguresMeansNoNightsBlock() {
+        assertNull(VictorCoachVitals.nightsBlock(listOf(DailyMetric("my-whoop", "2026-10-15")), emptyList(), zone))
+    }
+
+    private fun bp(key: String, value: Double, at: Long) = LabMarkerRow(
+        id = "$key-$at", deviceId = "my-whoop", markerKey = key, category = "bloodPressure",
+        day = "", takenAt = at, value = value, unit = "mmHg", source = "hc",
+    )
+
+    private fun reading(sys: Double, dia: Double, at: Long) =
+        listOf(bp("bp_systolic", sys, at), bp("bp_diastolic", dia, at))
+
+    @Test
+    fun bloodPressurePairsReadingsAndAverages() {
+        val rows = reading(128.0, 82.0, ts(2026, 10, 15, 8, 10)) +
+            reading(124.0, 79.0, ts(2026, 10, 10, 21, 5)) +
+            bp("resting_pulse", 64.0, ts(2026, 10, 10, 21, 5)) +
+            bp("bp_systolic", 140.0, ts(2026, 10, 12, 9, 0)) +       // no diastolic → not a reading
+            reading(150.0, 95.0, ts(2026, 8, 1, 9, 0))                // outside the 30-day window
+        assertEquals(
+            "BLOOD PRESSURE (the user's own cuff readings, last 30 days, newest first): " +
+                "2026-10-15 08:10 128/82 mmHg; 2026-10-10 21:05 124/79 mmHg, pulse 64; " +
+                "30-day avg 126/81 mmHg over 2 readings",
+            VictorCoachVitals.bloodPressureLine(rows, LocalDate.of(2026, 10, 16), zone),
+        )
+    }
+
+    @Test
+    fun onlyOldBloodPressureSaysSo() {
+        assertEquals(
+            "BLOOD PRESSURE (the user's own cuff readings): latest 2026-08-01 09:00 150/95 mmHg; none in the last 30 days",
+            VictorCoachVitals.bloodPressureLine(reading(150.0, 95.0, ts(2026, 8, 1, 9, 0)), LocalDate.of(2026, 10, 16), zone),
+        )
+        assertNull(VictorCoachVitals.bloodPressureLine(emptyList(), LocalDate.of(2026, 10, 16), zone))
+    }
+}
