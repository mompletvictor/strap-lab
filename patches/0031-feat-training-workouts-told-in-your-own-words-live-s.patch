+private enum class Stage { WRITE, READING, REVIEW }
+
+/**
+ * victor:training — "Entreno": tell the workout in your own words (typed or dictated on the device), Claude
+ * turns it into exercises and sets, you correct them, then either start it ([TrainingMode.PLANNED]: the live
+ * workout opens with the sets to tick) or save it with its time ([TrainingMode.LOGGED]: a manual workout whose
+ * heart rate the strap fills in). Opened from the Start and Add buttons upstream's workout section shows.
+ *
+ * [onStarted] opens the live workout screen; [onPlainStart] / [onPlainLog], when given, offer upstream's own
+ * sport picker / manual form for a workout without exercises.
+ */
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun TrainingSheet(
+    vm: AppViewModel,
+    initialMode: TrainingMode,
+    onDismiss: () -> Unit,
+    onStarted: () -> Unit,
+    onPlainStart: (() -> Unit)? = null,
+    onPlainLog: (() -> Unit)? = null,
+) {
+    val ctx = LocalContext.current
+    val scope = rememberCoroutineScope()
+    val live by vm.live.collectAsStateWithLifecycle()
+    val running by vm.activeWorkout.collectAsStateWithLifecycle()
+
+    var mode by rememberSaveable { mutableStateOf(initialMode) }
+    var text by rememberSaveable { mutableStateOf("") }
+    var stage by remember { mutableStateOf(Stage.WRITE) }
+    var plan by remember { mutableStateOf<TrainingPlan?>(null) }
+    var exercises by remember { mutableStateOf<List<TrainingExercise>>(emptyList()) }
+    var sport by remember { mutableStateOf(WorkoutSport.default.name) }
+    var error by remember { mutableStateOf<String?>(null) }
+    var job by remember { mutableStateOf<Job?>(null) }
+
+    // A past workout's when: day + start/end clock times, prefilled from what was said.
+    var day by remember { mutableStateOf(LocalDate.now()) }
+    var start by remember { mutableStateOf(LocalTime.now().minusHours(1).withSecond(0).withNano(0)) }
+    var end by remember { mutableStateOf(LocalTime.now().withSecond(0).withNano(0)) }
+
+    // Like the food sheet: once Claude has been asked, a stray swipe must not throw the answer away.
+    val dismissible by rememberUpdatedState(stage == Stage.WRITE)
+    val confirm = remember { { v: SheetValue -> v != SheetValue.Hidden || dismissible } }
+    val sheetState = rememberModalBottomSheetState(skipPartiallyExpanded = true, confirmValueChange = confirm)
+
+    fun read() {
+        error = null
+        stage = Stage.READING
+        job?.cancel()
+        job = scope.launch {
+            when (val r = TrainingAi.parse(ctx, text, mode)) {
+                is TrainingAiResult.Ok -> {
+                    val p = r.value
+                    plan = p
+                    exercises = p.exercises
+                    sport = p.sport
+                    val now = LocalDateTime.now()
+                    day = now.toLocalDate().plusDays(p.dayOffset.toLong())
+                    val e = p.end ?: p.start?.plusHours(1) ?: now.toLocalTime()
+                    end = e
+                    start = p.start ?: e.minusHours(1)
+                    stage = Stage.REVIEW
+                }
+                is TrainingAiResult.Failed -> {
+                    error = ctx.getString(trainingError(r.error)) + (r.detail?.let { "\n$it" } ?: "")
+                    stage = Stage.WRITE
+                }
+            }
+        }
+    }
+
+    fun begin(gps: Boolean) {
+        val chosen = WorkoutSport.all.firstOrNull { it.name == sport } ?: WorkoutSport.default
+        RecentSportsPrefs.record(ctx, chosen.name)
+        vm.startWorkout(chosen, gpsEnabled = gps)
+        val w = vm.activeWorkout.value ?: return
+        val session = TrainingSession(
+            id = UUID.randomUUID().toString(),
+            mode = TrainingMode.PLANNED,
+            startTs = w.startMs / 1000,
+            endTs = null,
+            sport = w.sport.name,
+            description = text.trim(),
+            exercises = exercises.map { ex -> ex.copy(sets = ex.sets.map { it.copy(done = false, doneAt = null) }) },
+        )
+        TrainingStore.launch { TrainingStore.startLive(ctx, session) }
+        onStarted()
+    }
+    val beginWithGps = rememberRequestLocation { granted -> begin(gps = granted) }
+
+    fun saveLogged() {
+        val zone = ZoneId.systemDefault()
+        val startS = day.atTime(start).atZone(zone).toEpochSecond()
+        var endS = day.atTime(end).atZone(zone).toEpochSecond()
+        if (endS <= startS) endS += 86_400 // past midnight
+        val row = WorkoutEditing.buildManualRowFromSpan(
+            deviceId = "my-whoop",
+            startSeconds = startS,
+            endSeconds = endS,
+            sport = sport,
+            avgHr = null,
+            energyKcal = null,
+        )
+        if (row == null) {
+            error = ctx.getString(R.string.victor_training_bad_time)
+            return
+        }
+        RecentSportsPrefs.record(ctx, sport)
+        vm.saveManualWorkout(row)
+        val session = TrainingSession(
+            id = UUID.randomUUID().toString(),
+            mode = TrainingMode.LOGGED,
+            startTs = row.startTs,
+            endTs = row.endTs,
+            sport = row.sport,
+            description = text.trim(),
+            exercises = exercises.map { ex -> ex.copy(sets = ex.sets.map { it.copy(done = true) }) },
+        )
+        TrainingStore.launch {
+            TrainingStore.save(ctx, session)
+            TrainingAnalyzer.analyze(ctx, session.id)
+        }
+        onDismiss()
+    }
+
+    ModalBottomSheet(
+        onDismissRequest = { job?.cancel(); onDismiss() },
+        sheetState = sheetState,
+        containerColor = Palette.surfaceBase,
+        contentColor = Palette.textPrimary,
+    ) {
+        Column(
+            modifier = Modifier
+                .fillMaxWidth()
+                .imePadding()
+                .verticalScroll(rememberScrollState())
+                .padding(horizontal = Metrics.screenPadding)
+                .padding(bottom = Metrics.space24),
+            verticalArrangement = Arrangement.spacedBy(Metrics.space16),
+        ) {
+            Text(uiString(R.string.victor_training_title), style = NoopType.title2, color = Palette.textPrimary)
+            Row(horizontalArrangement = Arrangement.spacedBy(Metrics.space6)) {
+                FoodChip(uiString(R.string.victor_training_mode_planned), selected = mode == TrainingMode.PLANNED) {
+                    if (stage != Stage.READING) mode = TrainingMode.PLANNED
+                }
+                FoodChip(uiString(R.string.victor_training_mode_logged), selected = mode == TrainingMode.LOGGED) {
+                    if (stage != Stage.READING) mode = TrainingMode.LOGGED
+                }
+            }
+            when (stage) {
+                Stage.WRITE -> {
+                    OutlinedTextField(
+                        value = text,
+                        onValueChange = { text = it.take(2000) },
+                        placeholder = {
+                            Text(
+                                uiString(if (mode == TrainingMode.PLANNED) R.string.victor_training_hint_planned else R.string.victor_training_hint_logged),
+                                style = NoopType.subhead,
+                                color = Palette.textTertiary,
+                            )
+                        },
+                        textStyle = NoopType.body,
+                        minLines = 4,
+                        modifier = Modifier.fillMaxWidth().heightIn(min = 120.dp),
+                    )
+                    DictateButton(text) { text = it }
+                    error?.let { Text(it, style = NoopType.subhead, color = Palette.statusWarning) }
+                    NoopButton(
+                        text = uiString(R.string.victor_training_read),
+                        leadingIcon = Icons.Filled.AutoAwesome,
+                        kind = NoopButtonKind.Primary,
+                        fullWidth = true,
+                        enabled = text.isNotBlank(),
+                    ) { read() }
+                    val plain = if (mode == TrainingMode.PLANNED) onPlainStart else onPlainLog
+                    if (plain != null) {
+                        NoopButton(
+                            text = uiString(R.string.victor_training_plain),
+                            kind = NoopButtonKind.Tertiary,
+                            fullWidth = true,
+                        ) { plain() }
+                    }
+                }
+                Stage.READING -> {
+                    Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(Metrics.space12)) {
+                        CircularProgressIndicator(color = Palette.accent, modifier = Modifier.size(Metrics.iconButton))
+                        Text(uiString(R.string.victor_training_reading), style = NoopType.subhead, color = Palette.textSecondary)
+                    }
+                    NoopButton(text = uiString(R.string.victor_training_cancel), kind = NoopButtonKind.Secondary, fullWidth = true) {
+                        job?.cancel()
+                        stage = Stage.WRITE
+                    }
+                }
+                Stage.REVIEW -> {
+                    plan?.notes?.takeIf { it.isNotBlank() }?.let { Text(it, style = NoopType.subhead, color = Palette.textSecondary) }
+                    SportPicker(sport) { sport = it }
+                    if (mode == TrainingMode.LOGGED) {
+                        WhenEditor(day, start, end, onDay = { day = it }, onStart = { start = it }, onEnd = { end = it })
+                    }
+                    ExerciseListEditor(exercises) { exercises = it }
+                    error?.let { Text(it, style = NoopType.subhead, color = Palette.statusWarning) }
+                    val canGo = exercises.any { it.name.isNotBlank() }
+                    if (mode == TrainingMode.PLANNED) {
+                        val attach = running != null
+                        if (!live.bonded && !attach) {
+                            Text(uiString(R.string.victor_training_need_strap), style = NoopType.subhead, color = Palette.statusWarning)
+                        }
+                        NoopButton(
+                            text = uiString(if (attach) R.string.victor_training_attach else R.string.victor_training_start),
+                            leadingIcon = Icons.Filled.PlayArrow,
+                            kind = NoopButtonKind.Primary,
+                            fullWidth = true,
+                            enabled = canGo && (live.bonded || attach),
+                        ) {
+                            val chosen = WorkoutSport.all.firstOrNull { it.name == sport }
+                            if (!attach && chosen?.isDistanceSport == true) beginWithGps() else begin(gps = false)
+                        }
+                    } else {
+                        NoopButton(
+                            text = uiString(R.string.victor_training_save),
