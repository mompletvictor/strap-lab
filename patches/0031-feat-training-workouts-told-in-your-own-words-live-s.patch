+                            fullWidth = true,
+                            enabled = canGo,
+                        ) { saveLogged() }
+                    }
+                    NoopButton(text = uiString(R.string.victor_training_rewrite), kind = NoopButtonKind.Tertiary, fullWidth = true) {
+                        error = null
+                        stage = Stage.WRITE
+                    }
+                }
+            }
+        }
+    }
+}
+
+/** On-device dictation: what is said lands after what is already written. Hidden where the device cannot. */
+@Composable
+private fun DictateButton(text: String, onText: (String) -> Unit) {
+    val ctx = LocalContext.current
+    val current by rememberUpdatedState(text)
+    var recording by remember { mutableStateOf(false) }
+    var base by remember { mutableStateOf("") }
+    var status by remember { mutableStateOf<String?>(null) }
+    fun join(a: String, b: String) = listOf(a.trim(), b.trim()).filter { it.isNotEmpty() }.joinToString(" ")
+    val voice = remember {
+        CoachVoiceInput(
+            context = ctx,
+            onPartial = { p -> onText(join(base, p)) },
+            onFinal = { f ->
+                onText(join(base, f))
+                recording = false
+            },
+            onError = { msg ->
+                status = msg
+                recording = false
+            },
+        )
+    }
+    DisposableEffect(voice) { onDispose { voice.destroy() } }
+    if (!voice.isAvailable()) return
+    fun startVoice() {
+        base = current
+        status = null
+        voice.start()
+        recording = true
+    }
+    val permission = androidx.activity.compose.rememberLauncherForActivityResult(
+        androidx.activity.result.contract.ActivityResultContracts.RequestPermission(),
+    ) { granted -> if (granted) startVoice() else status = ctx.getString(R.string.coach_voice_permission_denied) }
+    Column(verticalArrangement = Arrangement.spacedBy(Metrics.space4)) {
+        NoopButton(
+            text = uiString(if (recording) R.string.victor_training_dictate_stop else R.string.victor_training_dictate),
+            leadingIcon = if (recording) Icons.Filled.Stop else Icons.Filled.Mic,
+            kind = if (recording) NoopButtonKind.Primary else NoopButtonKind.Secondary,
+            fullWidth = true,
+        ) {
+            when {
+                recording -> {
+                    voice.stop()
+                    recording = false
+                }
+                voice.isPermissionGranted() -> startVoice()
+                else -> permission.launch(voice.requiredPermission)
+            }
+        }
+        status?.let { Text(it, style = NoopType.footnote, color = Palette.textTertiary) }
+    }
+}
+
+@Composable
+private fun SportPicker(sport: String, onPick: (String) -> Unit) {
+    var open by remember { mutableStateOf(false) }
+    Box {
+        FoodChip(sport, selected = true) { open = true }
+        DropdownMenu(expanded = open, onDismissRequest = { open = false }, modifier = Modifier.heightIn(max = 360.dp)) {
+            TrainingAi.sportNames().forEach { name ->
+                DropdownMenuItem(text = { Text(name, style = NoopType.body) }, onClick = { onPick(name); open = false })
+            }
+        }
+    }
+}
+
+/** Today / yesterday / the day before, and the start and end clock times. */
+@Composable
+private fun WhenEditor(
+    day: LocalDate,
+    start: LocalTime,
+    end: LocalTime,
+    onDay: (LocalDate) -> Unit,
+    onStart: (LocalTime) -> Unit,
+    onEnd: (LocalTime) -> Unit,
+) {
+    val today = LocalDate.now()
+    Column(verticalArrangement = Arrangement.spacedBy(Metrics.space8)) {
+        Row(horizontalArrangement = Arrangement.spacedBy(Metrics.space6)) {
+            FoodChip(uiString(R.string.victor_training_today), selected = day == today, small = true) { onDay(today) }
+            FoodChip(uiString(R.string.victor_training_yesterday), selected = day == today.minusDays(1), small = true) { onDay(today.minusDays(1)) }
+            FoodChip(uiString(R.string.victor_training_day_before), selected = day == today.minusDays(2), small = true) { onDay(today.minusDays(2)) }
+        }
+        Row(horizontalArrangement = Arrangement.spacedBy(Metrics.space8), verticalAlignment = Alignment.CenterVertically) {
+            TimeChip(R.string.victor_training_from, start, onStart)
+            TimeChip(R.string.victor_training_to, end, onEnd)
+        }
+    }
+}
+
+@Composable
+private fun TimeChip(label: Int, time: LocalTime, onPick: (LocalTime) -> Unit) {
+    val ctx = LocalContext.current
+    val shown = remember(time) {
+        DateFormat.getTimeFormat(ctx).format(Date.from(LocalDate.now().atTime(time).atZone(ZoneId.systemDefault()).toInstant()))
+    }
+    FoodChip("${uiString(label)} $shown", selected = false) {
+        TimePickerDialog(ctx, { _, h, m -> onPick(LocalTime.of(h, m)) }, time.hour, time.minute, DateFormat.is24HourFormat(ctx)).show()
+    }
+}
+
+/** The food log's error texts, except where they talk about photos. */
+internal fun trainingError(e: com.noop.food.FoodError): Int = when (e) {
+    com.noop.food.FoodError.NO_KEY -> R.string.victor_training_err_no_key
+    com.noop.food.FoodError.REFUSAL, com.noop.food.FoodError.UNREADABLE -> R.string.victor_training_err_unreadable
+    else -> errorMessage(e)
+}
