+        assertEquals(160.0, TrainingEnergy.extraKcal(380.0, 220.0, 3600.0, 1800.0), 1e-9)
+        // No heart rate: the resting share of the hour is already in the day.
+        assertEquals(305.0, TrainingEnergy.extraKcal(380.0, null, 3600.0, 1800.0), 1e-9)
+        // Steady cardio where heart rate beats Claude: nothing added.
+        assertEquals(0.0, TrainingEnergy.extraKcal(300.0, 450.0, 3600.0, 1800.0), 0.0)
+        assertEquals(0.0, TrainingEnergy.extraKcal(Double.NaN, 100.0, 3600.0, 1800.0), 0.0)
+    }
+
+    @Test
+    fun extraByDayNeedsTheWorkoutAndPrefersItsCurrentKcal() {
