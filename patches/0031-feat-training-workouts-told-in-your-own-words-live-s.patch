+        // The analysis saw 210 kcal of heart rate, but the row has been rescored to 220 since.
+        assertEquals(160.0, TrainingEnergy.extraByDay(listOf(logged), listOf(row), null, madrid).getValue("2026-10-19"), 1e-9)
+        assertEquals(emptyMap<String, Double>(), TrainingEnergy.extraByDay(listOf(logged), emptyList(), 1800.0, madrid))
+        assertEquals(emptyMap<String, Double>(), TrainingEnergy.extraByDay(listOf(logged.copy(analysis = null)), listOf(row), 1800.0, madrid))
+    }
