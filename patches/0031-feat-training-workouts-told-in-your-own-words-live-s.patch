+            "exercises":[
+              {"name":"Press de banca","kind":"strength","sets":[{"reps":5,"kg":20,"seconds":0},{"reps":5,"kg":20,"seconds":0}],"minutes":0,"km":0,"note":""},
+              {"name":"Dominadas","kind":"strength","sets":[],"minutes":0,"km":0,"note":""},
+              {"name":"Plancha","kind":"strength","sets":[{"reps":0,"kg":0,"seconds":45}],"minutes":0,"km":0,"note":""},
+              {"name":"Cinta","kind":"cardio","sets":[],"minutes":20,"km":3.3,"note":""},
+              {"name":"  ","kind":"other","sets":[],"minutes":0,"km":0,"note":""}
+            ]}""",
+        )
+        val p = TrainingAi.parsePlan(reply, TrainingAi.sportNames())!!
