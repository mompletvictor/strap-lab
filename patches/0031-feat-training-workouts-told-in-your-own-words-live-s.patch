+package com.noop.training
+
+import android.content.Context
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.File
+
+/**
+ * victor:training — JSON codec for the sessions. Pure, so the round trip is JVM-testable. Unknown fields
+ * are ignored and missing optional ones default, so the format can grow without a migration.
+ */
+internal object TrainingStoreCodec {
+
+    const val VERSION = 1
+
+    fun encode(sessions: List<TrainingSession>): String {
+        val arr = JSONArray()
+        for (s in sessions) {
+            val o = JSONObject()
+                .put("id", s.id)
+                .put("mode", s.mode.id)
+                .put("start", s.startTs)
+                .put("sport", s.sport)
+                .put("description", s.description)
+                .put("exercises", JSONArray().apply { s.exercises.forEach { put(exerciseJson(it)) } })
+            s.endTs?.let { o.put("end", it) }
+            s.analysis?.let { a ->
+                o.put(
+                    "analysis",
+                    JSONObject()
+                        .put("total_kcal", a.totalKcal)
+                        .put("notes", a.notes)
+                        .put("at", a.atMs)
+                        .apply {
+                            a.lowKcal?.let { put("low_kcal", it) }
+                            a.highKcal?.let { put("high_kcal", it) }
+                            a.hrKcal?.let { put("hr_kcal", it) }
+                        },
+                )
+            }
+            arr.put(o)
+        }
+        return JSONObject().put("version", VERSION).put("sessions", arr).toString()
+    }
+
+    /** Throws on text that is not a training document, so a corrupt file is never mistaken for empty. */
+    fun decode(text: String): List<TrainingSession> {
+        val arr = JSONObject(text).getJSONArray("sessions")
+        val out = ArrayList<TrainingSession>(arr.length())
+        for (n in 0 until arr.length()) {
+            val o = arr.optJSONObject(n) ?: continue
+            val id = o.optString("id").takeIf { it.isNotBlank() } ?: continue
+            val start = o.optLong("start", 0L).takeIf { it > 0 } ?: continue
+            val exArr = o.optJSONArray("exercises") ?: JSONArray()
+            val exercises = (0 until exArr.length()).mapNotNull { i -> exArr.optJSONObject(i)?.let(::exerciseOf) }
+            val analysis = o.optJSONObject("analysis")?.let { a ->
+                TrainingAnalysis(
+                    totalKcal = a.optDouble("total_kcal", 0.0),
+                    lowKcal = optDouble(a, "low_kcal"),
+                    highKcal = optDouble(a, "high_kcal"),
+                    hrKcal = optDouble(a, "hr_kcal"),
+                    notes = a.optString("notes"),
+                    atMs = a.optLong("at", 0L),
+                )
+            }
+            out += TrainingSession(
+                id = id,
+                mode = TrainingMode.fromId(o.optString("mode")),
+                startTs = start,
+                endTs = if (o.has("end")) o.optLong("end") else null,
+                sport = o.optString("sport"),
+                description = o.optString("description"),
+                exercises = exercises,
+                analysis = analysis,
+            )
+        }
+        return out.sortedBy { it.startTs }
+    }
+
+    private fun exerciseJson(e: TrainingExercise): JSONObject {
+        val sets = JSONArray()
+        for (s in e.sets) {
+            sets.put(
+                JSONObject().apply {
+                    s.reps?.let { put("reps", it) }
+                    s.kg?.let { put("kg", it) }
+                    s.seconds?.let { put("seconds", it) }
+                    if (s.done) put("done", true)
+                    s.doneAt?.let { put("done_at", it) }
+                },
+            )
+        }
+        return JSONObject()
+            .put("name", e.name)
+            .put("kind", e.kind.id)
+            .put("sets", sets)
+            .apply {
+                e.minutes?.let { put("minutes", it) }
+                e.km?.let { put("km", it) }
+                if (e.note.isNotBlank()) put("note", e.note)
+            }
+    }
+
+    private fun exerciseOf(o: JSONObject): TrainingExercise {
+        val arr = o.optJSONArray("sets") ?: JSONArray()
+        val sets = (0 until arr.length()).mapNotNull { i ->
+            val s = arr.optJSONObject(i) ?: return@mapNotNull null
+            TrainingSet(
+                reps = if (s.has("reps")) s.optInt("reps") else null,
+                kg = optDouble(s, "kg"),
+                seconds = if (s.has("seconds")) s.optInt("seconds") else null,
+                done = s.optBoolean("done", false),
+                doneAt = if (s.has("done_at")) s.optLong("done_at") else null,
+            )
+        }
+        return TrainingExercise(
+            name = o.optString("name"),
+            kind = ExerciseKind.fromId(o.optString("kind")),
+            sets = sets,
+            minutes = optDouble(o, "minutes"),
+            km = optDouble(o, "km"),
+            note = o.optString("note"),
+        )
+    }
+
+    private fun optDouble(o: JSONObject, key: String): Double? =
+        if (o.has(key)) o.optDouble(key).takeIf { it.isFinite() } else null
+}
+
+/**
+ * victor:training — the sessions on disk: `files/training/sessions.json`. App-private, never in the Room
+ * DB. Calls are serialized by one mutex and run on [Dispatchers.IO]; [sessions] mirrors the file.
+ */
+object TrainingStore {
+
+    private const val DIR = "training"
+    private const val FILE = "sessions.json"
+
+    private val mutex = Mutex()
+    private var cache: List<TrainingSession>? = null
+
+    /**
+     * Writes from the screens run here, not in a composable's scope: the sheet that saves a session closes
+     * in the same tap, and leaving composition would cancel the write half-way.
+     */
+    private val writes = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+
+    fun launch(block: suspend () -> Unit) {
+        writes.launch { block() }
+    }
+
+    private val _sessions = MutableStateFlow<List<TrainingSession>>(emptyList())
+    /** Oldest first. Empty until the first [load]. */
+    val sessions: StateFlow<List<TrainingSession>> = _sessions.asStateFlow()
+
+    suspend fun load(ctx: Context): List<TrainingSession> = withContext(Dispatchers.IO) {
+        mutex.withLock { state(ctx) }
+    }
+
+    /** Add or replace (by id). */
+    suspend fun save(ctx: Context, session: TrainingSession) = update(ctx) { list ->
+        list.filterNot { it.id == session.id } + session
+    }
+
+    suspend fun delete(ctx: Context, id: String) = update(ctx) { list -> list.filterNot { it.id == id } }
+
+    /** Change one session in place; a no-op when it is gone. */
+    suspend fun edit(ctx: Context, id: String, change: (TrainingSession) -> TrainingSession) = update(ctx) { list ->
+        list.map { if (it.id == id) change(it) else it }
+    }
+
+    /** Begin a planned session for the workout that started at [startTs]; any stale live one is dropped. */
+    suspend fun startLive(ctx: Context, session: TrainingSession) = update(ctx) { list ->
+        list.filterNot { it.isLive || it.id == session.id } + session
+    }
+
+    private suspend fun update(ctx: Context, change: (List<TrainingSession>) -> List<TrainingSession>) =
+        withContext(Dispatchers.IO) {
+            mutex.withLock { persist(ctx, change(state(ctx)).sortedBy { it.startTs }) }
+        }
+
+    /** Caller holds [mutex]. A corrupt file is set aside (never silently overwritten) and the log starts empty. */
+    private fun state(ctx: Context): List<TrainingSession> {
+        cache?.let { return it }
+        val dir = File(ctx.applicationContext.filesDir, DIR)
+        val file = File(dir, FILE)
+        val loaded = if (!file.exists()) {
+            emptyList()
+        } else {
+            runCatching { TrainingStoreCodec.decode(file.readText()) }.getOrElse {
+                runCatching { file.renameTo(File(dir, "$FILE.corrupt-${System.currentTimeMillis()}")) }
+                emptyList()
+            }
+        }
+        cache = loaded
+        _sessions.value = loaded
+        return loaded
+    }
+
+    /** Caller holds [mutex]. Write-then-rename so a crash mid-write never leaves half a file. */
+    private fun persist(ctx: Context, sessions: List<TrainingSession>) {
+        val dir = File(ctx.applicationContext.filesDir, DIR).apply { mkdirs() }
+        val text = TrainingStoreCodec.encode(sessions)
+        val tmp = File(dir, "$FILE.tmp")
+        tmp.writeText(text)
+        if (!tmp.renameTo(File(dir, FILE))) {
+            File(dir, FILE).writeText(text)
+            tmp.delete()
+        }
+        cache = sessions
+        _sessions.value = sessions
+    }
+}
