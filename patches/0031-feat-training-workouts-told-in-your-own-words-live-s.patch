+            TrainingExercise("B", ExerciseKind.STRENGTH, listOf(TrainingSet(5, done = true, doneAt = start + 200), TrainingSet(5))),
+            TrainingExercise("C", ExerciseKind.STRENGTH, listOf(TrainingSet(5))),
+        ))
+        val samples = listOf(50L to 100, 150L to 140, 250L to 120, 290L to 130).map { (dt, bpm) -> HrSample("x", start + dt, bpm) }
+        val hr = TrainingHr.perExercise(s, samples)
+        // A owns 0-100 and 200-300 (100, 120, 130); B owns 100-200 (140); C has no tick.
+        assertEquals(TrainingHr.Stat(116, 130), hr[0])
