+    @Test
+    fun theRoundTripReadsTheTextBlockAfterThinkingAndRetriesWithoutStructuredOutput() = runBlocking {
+        val sent = ArrayList<JSONObject>()
+        val reply = """{"content":[{"type":"thinking","thinking":"..."},{"type":"text","text":"{\"total_kcal\":380,\"low_kcal\":330,\"high_kcal\":430,\"notes\":\"Cargas moderadas.\"}"}],"stop_reason":"end_turn"}"""
+        val r = TrainingAi.run("old-model", "p", TrainingAi.kcalSchema(), { TrainingAi.parseKcal(it, 7L) }) { body ->
+            sent += JSONObject(body)
+            if (sent.size == 1) 400 to """{"error":{"message":"output_config.format is not supported"}}""" else 200 to reply
+        }
+        assertEquals(2, sent.size)
+        assertFalse(sent[1].has("output_config"))
+        val a = (r as TrainingAiResult.Ok).value
+        assertEquals(380.0, a.totalKcal, 0.0)
+        assertEquals(330.0, a.lowKcal!!, 0.0)
+        assertEquals(7L, a.atMs)
+
+        val refused = TrainingAi.run("m", "p", TrainingAi.kcalSchema(), { TrainingAi.parseKcal(it, 0L) }) { 200 to """{"content":[],"stop_reason":"refusal"}""" }
+        assertEquals(FoodError.REFUSAL, (refused as TrainingAiResult.Failed).error)
+        val busy = TrainingAi.run("m", "p", TrainingAi.kcalSchema(), { TrainingAi.parseKcal(it, 0L) }) { 529 to "{}" }
+        assertEquals(FoodError.BUSY, (busy as TrainingAiResult.Failed).error)
+    }
