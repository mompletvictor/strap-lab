+        assertEquals(2660.0, e.burnedKcal, 1e-9)
+        assertEquals(160.0, e.trainingKcal, 1e-9)
+        val none = FoodEnergy.resolve(2500.0, null, null, 1800.0, 1.0)!!
+        assertEquals(2500.0, none.burnedKcal, 1e-9)
+        assertEquals(0.0, none.trainingKcal, 0.0)
+    }
