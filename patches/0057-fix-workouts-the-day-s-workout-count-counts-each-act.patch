                 .filter { detected ->
@@ -383,4 +387,14 @@ internal object PhysiologicalStepCycleEngine {
             ),
         )
     }
+
+    /**
+     * victor:workout-count — the cycle's workouts as the Workouts list shows them: dismissed bouts out, then
+     * the list's own cross-source collapse ([WorkoutEditing.dedupCrossSource]), so the same session from the
+     * strap and from Samsung a minute apart is ONE workout, not two (only exact copies collapsed before).
+     */
+    internal fun uniqueWorkouts(rows: List<WorkoutRow>, dismissed: List<DismissedWorkout>): List<WorkoutRow> =
+        WorkoutEditing.dedupCrossSource(
+            WorkoutEditing.filterDismissed(rows.distinctBy { Triple(it.startTs, it.endTs, it.sport) }, dismissed),
+        )
 }
