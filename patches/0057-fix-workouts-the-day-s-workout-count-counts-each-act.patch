@@ -0,0 +1,43 @@
+package com.noop.analytics
+
+import com.noop.data.DismissedWorkout
+import com.noop.data.WorkoutRow
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+/**
+ * victor:workout-count — the day's workout count (the coach's "2 workouts", Trends, Coupled) counts each
+ * activity once, as the Workouts list shows it.
+ */
+class VictorWorkoutCountTest {
+
+    private val t0 = 1_760_976_000L   // 2025-10-20 16:00 UTC
+
+    private fun row(source: String, start: Long, end: Long, sport: String = "Running", device: String = source) =
+        WorkoutRow(deviceId = device, startTs = start, endTs = end, sport = sport, source = source)
+
+    @Test
+    fun theSameSessionFromTwoSourcesCountsOnce() {
+        val strap = row("my-whoop", t0, t0 + 3600)
+        val samsung = row("health-connect", t0 + 60, t0 + 3720)            // a minute off at each end
+        assertEquals(1, PhysiologicalStepCycleEngine.uniqueWorkouts(listOf(strap, samsung), emptyList()).size)
+        // An exact copy still collapses, as before.
+        assertEquals(1, PhysiologicalStepCycleEngine.uniqueWorkouts(listOf(strap, strap.copy()), emptyList()).size)
+    }
+
+    @Test
+    fun twoRealSessionsStayTwo() {
+        val morning = row("my-whoop", t0, t0 + 3600)
+        val evening = row("health-connect", t0 + 8 * 3600, t0 + 9 * 3600)
+        val otherSport = row("health-connect", t0 + 600, t0 + 3000, sport = "Cycling")   // overlaps, but another activity
+        assertEquals(3, PhysiologicalStepCycleEngine.uniqueWorkouts(listOf(morning, evening, otherSport), emptyList()).size)
+    }
+
+    @Test
+    fun aDismissedBoutDoesNotCount() {
+        val detected = row("my-whoop-noop", t0, t0 + 1800, sport = "detected")
+        val dismissed = listOf(DismissedWorkout("my-whoop-noop", t0, t0 + 1800))
+        assertEquals(0, PhysiologicalStepCycleEngine.uniqueWorkouts(listOf(detected), dismissed).size)
+        assertEquals(1, PhysiologicalStepCycleEngine.uniqueWorkouts(listOf(detected), emptyList()).size)
+    }
+}
