+/**
+ * victor:training — the wearer's notes on a suggested workout: one per exercise of [current] (by position, blank
+ * to keep it) and one for the whole session. Claude revises the proposal with them instead of starting over.
+ */
+data class TrainingRevision(
+    val current: List<TrainingExercise>,
+    val asks: List<String>,
+    val general: String,
+) {
+    /** A note on some exercise or on the whole session. */
+    val hasNotes: Boolean get() = current.isNotEmpty() && (asks.any { it.isNotBlank() } || general.isNotBlank())
+
+    /** The notes as later proposals in the same sheet keep hearing them: «no tengo aerobike» (about «Aerobike»). */
+    fun told(): List<String> =
+        current.indices.mapNotNull { i ->
+            asks.getOrNull(i)?.trim()?.takeIf { it.isNotEmpty() }?.let { "«${quote(it)}» (about «${current[i].name}»)" }
+        } + listOfNotNull(general.trim().takeIf { it.isNotEmpty() }?.let { "«${quote(it)}» (the whole workout)" })
+}
+
+private fun quote(s: String) = s.trim().replace("\"", "'").take(300)
+
