+    @Test
+    fun aRevisionKeepsTheProposalChangesOnlyWhatTheNotesSayAndIsRemembered() {
+        val now = LocalDateTime.of(2026, 10, 20, 18, 0)
+        val warm = TrainingExercise("Calentamiento", ExerciseKind.OTHER, minutes = 10.0)
+        val bike = TrainingExercise("Aerobike", ExerciseKind.CARDIO, minutes = 15.0)
+        val press = TrainingExercise("Press de banca", ExerciseKind.STRENGTH, List(4) { TrainingSet(8, 60.0) }, note = "Descanso 90 s")
+        val curl = TrainingExercise("Curl", ExerciseKind.STRENGTH, List(3) { TrainingSet(10, 12.0) }, perHand = true)
+
+        // Blank notes are no notes: a plain new proposal, without the revision block.
+        val none = TrainingRevision(listOf(warm, bike, press), listOf("", " ", ""), "  ")
+        assertFalse(none.hasNotes)
+        assertTrue(none.told().isEmpty())
+        assertFalse(TrainingAi.suggestPrompt("", 45, TrainingIntensity.MODERATE, null, now, listOf("Strength"), none).contains("YOUR PROPOSAL"))
+
+        // One exercise's note and one for the whole: every exercise listed as it is, each marked keep or CHANGE.
+        val r = TrainingRevision(listOf(warm, bike, press, curl), listOf("", "no tengo \"aerobike\"", ""), "son demasiado estáticos")
+        assertTrue(r.hasNotes)
+        val p = TrainingAi.suggestPrompt("", 45, TrainingIntensity.MODERATE, "DATA", now, listOf("Strength"), r)
+        assertTrue(p.contains("1. Calentamiento (other): 10 min | keep\n"))
+        assertTrue(p.contains("2. Aerobike (cardio): 15 min | CHANGE: «no tengo 'aerobike'»\n"))
+        assertTrue(p.contains("3. Press de banca (strength): 4×8 · 60 kg · cue: Descanso 90 s | keep\n"))
+        assertTrue(p.contains("4. Curl (strength): 3×10 · 12 kg each | keep\n"))
+        assertTrue(p.contains("Note for the whole workout: «son demasiado estáticos»"))
+        assertTrue(p.contains("REVISE that proposal, do not start over"))
+        assertTrue(p.endsWith("DATA"))
+
+        // What was said is still heard by the next proposals of the same sheet, a fresh one included.
+        val told = r.told()
+        assertEquals(listOf("«no tengo 'aerobike'» (about «Aerobike»)", "«son demasiado estáticos» (the whole workout)"), told)
+        val next = TrainingAi.suggestPrompt("", 45, TrainingIntensity.MODERATE, null, now, listOf("Strength"), null, told)
+        assertTrue(next.contains("also told you (still true, honour it): «no tengo 'aerobike'» (about «Aerobike»); «son demasiado estáticos» (the whole workout)."))
+        assertFalse(next.contains("YOUR PROPOSAL"))
+    }
