diff --git a/android/app/src/test/java/com/noop/food/FoodVisionRequestTest.kt b/android/app/src/test/java/com/noop/food/FoodVisionRequestTest.kt
index 732a65bf4..d6bd2760c 100644
--- a/android/app/src/test/java/com/noop/food/FoodVisionRequestTest.kt
+++ b/android/app/src/test/java/com/noop/food/FoodVisionRequestTest.kt
@@ -136,4 +136,23 @@ class FoodVisionRequestTest {
         val arr = o.getJSONArray("required")
         return (0 until arr.length()).map { arr.getString(it) }
     }
+
+    @Test
+    fun aMealToldInWordsIsSentAsTextOnly() {   // victor:food
+        val body = FoodVision.buildRequestBody("m", emptyList(), "me he comido un entrecot de 500 gramos", structured = true)
+        val content = body.getJSONArray("messages").getJSONObject(0).getJSONArray("content")
+        assertEquals(1, content.length())
+        val text = content.getJSONObject(0).getString("text")
+        assertTrue(text.startsWith("Estimate the nutrition of the meal the user describes below in words; there is no photo."))
+        assertTrue(text.contains("raw weight"))
+        assertTrue(text.trim().endsWith("\"me he comido un entrecot de 500 gramos\""))
+        assertFalse(text.contains("this photo"))
+
+        fun draft(note: String, thumbs: List<String> = emptyList()) =
+            FoodDraft(null, 0L, "2026-10-24", MealType.LUNCH, note, emptyList(), emptyList(), thumbs, null, null, FoodStage.PREPARE)
+        assertFalse(draft("  ").canAnalyze)
+        assertTrue(draft("un entrecot de 500 g").canAnalyze)
+        // A saved photo meal keeps only thumbnails: never re-read from its note alone.
+        assertFalse(draft("frito", listOf("thumb.jpg")).canAnalyze)
+    }
