+    /** victor:food — a meal told in words only: a new meal with no photo, analysed from its note. */
+    fun startWritten() {
+        if (_draft.value != null) return
+        val now = System.currentTimeMillis()
+        _draft.value = FoodDraft(
+            entryId = null,
+            timestamp = now,
+            day = FoodDays.mealDayOf(now),
+            meal = MealType.forTimestamp(now),
+            note = "",
+            items = emptyList(),
+            photos = emptyList(),
+            thumbPaths = emptyList(),
+            confidence = null,
+            aiNotes = null,
+            stage = FoodStage.PREPARE,
+        )
+    }
+
     fun removePhoto(index: Int) = _draft.update { d ->
         d?.copy(photos = d.photos.filterIndexed { i, _ -> i != index })
     }
@@ -131,7 +150,7 @@ class FoodViewModel(app: Application) : AndroidViewModel(app) {
 
     fun analyze() {
         val d = _draft.value ?: return
-        if (d.photos.isEmpty()) return
+        if (!d.canAnalyze) return
         val jpegs = d.photos.map { it.jpeg }
         _draft.value = d.copy(stage = FoodStage.ANALYZING, error = null, errorDetail = null)
         analysis?.cancel()
