+    /** Keep [items] as a frequent meal; a no-op when the same foods already are one. */
+    suspend fun addFavorite(ctx: Context, id: String, items: List<FoodItem>, nowMs: Long) = withContext(Dispatchers.IO) {
+        mutex.withLock {
+            val current = state(ctx)
+            if (items.isEmpty() || current.favorites.any { it.sameFoods(items) }) return@withLock
+            val next = listOf(FoodFavorite(id, items, nowMs)) + current.favorites
+            persist(ctx, current.copy(favorites = next.take(FoodFavorite.MAX)))
+        }
+    }
+
+    suspend fun removeFavorite(ctx: Context, id: String) = withContext(Dispatchers.IO) {
+        mutex.withLock {
+            val current = state(ctx)
+            if (current.favorites.none { it.id == id }) return@withLock
+            persist(ctx, current.copy(favorites = current.favorites.filterNot { it.id == id }))
+        }
+    }
+
+    /**
+     * Log the frequent meal [favoriteId] at [nowMs] as a new meal (then re-sync its day into the lane) and
+     * move its chip to the front. Returns the new entry, or null when that frequent meal is gone.
+     */
+    suspend fun logFavorite(ctx: Context, repo: WhoopRepository, favoriteId: String, entryId: String, nowMs: Long): FoodEntry? =
+        withContext(Dispatchers.IO) {
+            mutex.withLock {
+                val current = state(ctx)
+                val fav = current.favorites.firstOrNull { it.id == favoriteId } ?: return@withLock null
+                val entry = fav.toEntry(entryId, nowMs)
+                val favorites = listOf(fav.copy(lastUsed = nowMs)) + current.favorites.filterNot { it.id == favoriteId }
+                var next = current.copy(entries = (current.entries + entry).sortedBy { it.timestamp }, favorites = favorites)
+                persist(ctx, next)
+                next = syncDays(repo, next, setOf(entry.day))
+                persist(ctx, next)
+                entry
+            }
+        }
+
