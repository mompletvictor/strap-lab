@@ -150,3 +150,47 @@ object FoodDays {
 /** Finite, non-negative, one decimal. */
 internal fun round1(v: Double): Double =
     if (!v.isFinite() || v <= 0.0) 0.0 else (v * 10.0).roundToLong() / 10.0
+
+/**
+ * victor:food — a meal eaten again and again (the same breakfast every day): its foods with their
+ * macros, logged again with one tap instead of a photo. [lastUsed] orders the chips, most recent first.
+ */
+data class FoodFavorite(
+    val id: String,
+    val items: List<FoodItem>,
+    val createdAt: Long,
+    val lastUsed: Long = createdAt,
+) {
+    val totals: FoodTotals get() = FoodTotals.ofItems(items)
+
+    val label: String get() = items.joinToString(", ") { it.name.trim() }.trim().ifEmpty { "—" }
+
+    /** The same foods in the same amounts, in any order: saving it again would only add a twin chip. */
+    fun sameFoods(other: List<FoodItem>): Boolean = key(items) == key(other)
+
+    /** A new meal at [timestampMs]: these foods, on the day and meal the clock says (both editable later). */
+    fun toEntry(id: String, timestampMs: Long, zone: ZoneId = ZoneId.systemDefault()): FoodEntry {
+        val t = totals
+        return FoodEntry(
+            id = id,
+            timestamp = timestampMs,
+            day = FoodDays.dayOf(timestampMs, zone),
+            note = "",
+            items = items,
+            kcal = t.kcal,
+            proteinG = t.proteinG,
+            carbsG = t.carbsG,
+            fatG = t.fatG,
+            thumbnailPaths = emptyList(),
+            meal = MealType.forTimestamp(timestampMs, zone),
+        )
+    }
+
+    companion object {
+        /** Enough for every routine meal; the oldest-used drop off beyond it. */
+        const val MAX = 24
+
+        private fun key(items: List<FoodItem>): List<String> =
+            items.map { "${it.name.trim().lowercase()}|${round1(it.kcal)}" }.sorted()
+    }
+}
