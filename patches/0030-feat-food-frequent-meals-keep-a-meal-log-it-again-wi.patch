+package com.noop.food
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.time.ZoneId
+
+/** victor:food — frequent meals: what counts as the same meal, what one tap logs, and the JSON round trip. */
+class FoodFavoriteTest {
+
+    private val madrid = ZoneId.of("Europe/Madrid")
+
+    private val breakfast = FoodFavorite(
+        id = "f1",
+        items = listOf(
+            FoodItem("Plátano", "1 mediano", 105.0, 1.3, 27.0, 0.4),
+            FoodItem("Café con leche", "1 taza", 60.0, 3.0, 5.0, 3.0),
+            FoodItem("Huevos a la plancha", "2 huevos", 180.0, 12.6, 1.0, 13.0, eaten = 1.0),
+        ),
+        createdAt = 1_792_000_000_000L,
+        lastUsed = 1_792_100_000_000L,
+    )
+
+    @Test
+    fun sameFoodsIgnoresOrderCaseAndSpacesButNotAmounts() {
+        val reordered = listOf(
+            FoodItem(" huevos a la plancha", "", 180.0, 0.0, 0.0, 0.0),
+            FoodItem("PLÁTANO", "", 105.0, 0.0, 0.0, 0.0),
+            FoodItem("café con leche ", "", 60.0, 0.0, 0.0, 0.0),
+        )
+        assertTrue(breakfast.sameFoods(reordered))
+        assertFalse(breakfast.sameFoods(reordered.dropLast(1)))
+        assertFalse(breakfast.sameFoods(reordered.map { if (it.name.contains("PLÁTANO")) it.copy(kcal = 210.0) else it }))
+    }
+
+    @Test
+    fun oneTapLogsTheSameFoodsOnTheClocksDayAndMeal() {
+        // 2026-10-19 08:30 in Madrid (UTC+2).
+        val ts = 1_792_391_400_000L
+        val e = breakfast.toEntry("e9", ts, madrid)
+        assertEquals("e9", e.id)
+        assertEquals("2026-10-19", e.day)
+        assertEquals(MealType.BREAKFAST, e.meal)
+        assertEquals(breakfast.items, e.items)
+        assertEquals(345.0, e.kcal, 0.0)
+        assertEquals(16.9, e.proteinG, 0.0)
+        assertEquals(emptyList<String>(), e.thumbnailPaths)
+    }
+
+    @Test
+    fun labelJoinsTheFoods() {
+        assertEquals("Plátano, Café con leche, Huevos a la plancha", breakfast.label)
+    }
+
+    @Test
+    fun favoritesRoundTripNewestFirstAndOldLogsReadWithout() {
+        val older = FoodFavorite("f0", listOf(FoodItem("Yogur", "1", 90.0, 4.0, 12.0, 3.0)), 1L, 2L)
+        val state = FoodState(favorites = listOf(older, breakfast))
+        val decoded = FoodStoreCodec.decode(FoodStoreCodec.encode(state))
+        assertEquals(listOf(breakfast, older), decoded.favorites)
+
+        val before = """{"version":1,"entries":[]}"""
+        assertEquals(emptyList<FoodFavorite>(), FoodStoreCodec.decode(before).favorites)
+    }
+
+    @Test
+    fun aFavoriteWithoutFoodsIsDropped() {
+        val json = """{"version":1,"entries":[],"favorites":[{"id":"x","created":1,"items":[]}]}"""
+        assertEquals(emptyList<FoodFavorite>(), FoodStoreCodec.decode(json).favorites)
+    }
+}
