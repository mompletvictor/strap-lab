+/** The frequent meals: a tap logs one now, a long press offers to drop it. */
+@OptIn(ExperimentalLayoutApi::class, ExperimentalFoundationApi::class)
+@Composable
+private fun FavoritesCard(favorites: List<FoodFavorite>, onLog: (FoodFavorite) -> Unit, onRemove: (FoodFavorite) -> Unit) {
+    NoopCard {
+        Column(verticalArrangement = Arrangement.spacedBy(Metrics.space8)) {
+            Overline(uiString(R.string.victor_food_fav_title))
+            FlowRow(
+                horizontalArrangement = Arrangement.spacedBy(Metrics.space8),
+                verticalArrangement = Arrangement.spacedBy(Metrics.space8),
+            ) {
+                favorites.forEach { fav ->
+                    Column(
+                        modifier = Modifier
+                            .clip(RoundedCornerShape(Metrics.cornerSm))
+                            .background(Palette.surfaceInset)
+                            .combinedClickable(onClick = { onLog(fav) }, onLongClick = { onRemove(fav) })
+                            .padding(horizontal = Metrics.space12, vertical = Metrics.space8),
+                    ) {
+                        Text(fav.label, style = NoopType.subhead, color = Palette.textPrimary, maxLines = 2, overflow = TextOverflow.Ellipsis)
+                        Text(
+                            "${whole(fav.totals.kcal)} ${uiString(R.string.victor_food_kcal)}",
+                            style = NoopType.caption,
+                            color = Palette.textSecondary,
+                        )
+                    }
+                }
+            }
+        }
+    }
+}
