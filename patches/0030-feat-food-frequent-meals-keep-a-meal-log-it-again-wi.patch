+/** "Guardar en frecuentes" for foods that are not one yet; a quiet mark when they already are. */
+@Composable
+private fun FavoriteToggle(draft: FoodDraft, food: FoodViewModel) {
+    val favorites by food.favorites.collectAsStateWithLifecycle()
+    val items = draft.items.filter { it.isMeaningful }.map { it.toItem() }
+    if (items.isEmpty()) return
+    if (favorites.any { it.sameFoods(items) }) {
+        Text(uiString(R.string.victor_food_fav_already), style = NoopType.caption, color = Palette.textSecondary)
+    } else {
+        FoodChip(uiString(R.string.victor_food_fav_keep), selected = draft.asFavorite) { food.setAsFavorite(!draft.asFavorite) }
+    }
+}
