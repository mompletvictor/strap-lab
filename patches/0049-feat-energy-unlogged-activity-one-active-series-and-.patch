+package com.noop.energy
+
+/** victor:energy — a [DayEnergy] with the figures a test wants, for the screens' and the coach's pure halves. */
+object EnergyFixtures {
+
+    fun day(
+        day: String = "2026-10-16",
+        totalKcal: Double? = 2600.0,
+        bmrKcal: Double? = 1800.0,
+        fraction: Double = 1.0,
+        stepsKcal: Double = 300.0,
+        stepsSource: StepsSource = StepsSource.STRAP,
+        workoutsNetKcal: Double = 0.0,
+        epocKcal: Double = 0.0,
+        unloggedKcal: Double? = 0.0,
+        tefKcal: Double? = null,
+        missing: Set<EnergyMissing> = emptySet(),
+        workouts: List<WorkoutEnergy> = emptyList(),
+    ): DayEnergy {
+        val basal = bmrKcal?.times(fraction)
+        val active = if (totalKcal == null) null else stepsKcal + workoutsNetKcal + epocKcal + (unloggedKcal ?: 0.0)
+        return DayEnergy(
+            day = day,
+            fraction = fraction,
+            bmrKcal = bmrKcal,
+            basalKcal = basal,
+            weightKg = 80.0,
+            basalBlend = 1.0,
+            steps = if (totalKcal == null) null else StepsEnergy(if (stepsSource == StepsSource.ESTIMATED) null else 7000, stepsSource, stepsKcal, 9000, null, 2000),
+            workouts = workouts,
+            workoutsNetKcal = workoutsNetKcal,
+            epocKcal = epocKcal,
+            unloggedKcal = unloggedKcal,
+            unloggedMinutes = 0,
+            tefKcal = tefKcal,
+            totalKcal = totalKcal,
+            activeKcal = active,
+            projectedKcal = if (totalKcal == null || bmrKcal == null) totalKcal else totalKcal + bmrKcal * (1.0 - fraction),
+            missing = missing,
+            diagnostics = EnergyDiagnostics(),
+        )
+    }
+
+    fun workout(
+        startTs: Long,
+        endTs: Long,
+        sport: String = "Strength",
+        grossKcal: Double = 490.0,
+        netKcal: Double = 392.0,
+        epocKcal: Double = 47.0,
+        method: EnergyMethod = EnergyMethod.MET,
+    ): WorkoutEnergy = WorkoutEnergy(
+        key = WorkoutKey(startTs, sport), sport = sport, category = SportCategory.of(sport), source = "my-whoop",
+        startTs = startTs, endTs = endTs, durationS = endTs - startTs, grossKcal = grossKcal, netKcal = netKcal,
+        epocKcal = epocKcal, method = method, coverage = 1.0, meanBpm = 118.0, meanHrr = 0.45, trimmed = false, assumed = false,
+    )
+}
