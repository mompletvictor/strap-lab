new file mode 100644
index 000000000..b8c12c507
--- /dev/null
+++ b/android/app/src/main/java/com/noop/energy/UnloggedMinutes.kt
@@ -0,0 +1,101 @@
+package com.noop.energy
+
+import com.noop.analytics.Calories
+import com.noop.analytics.StepsCounter
+import com.noop.data.HrSample
+import com.noop.data.StepSample
+
+/**
+ * victor:energy — activity the wearer did not log: a minute OUTSIDE every workout window whose mean heart
+ * rate is at or above resting + 50 % of the reserve (upstream's whole-day gate) earns the Keytel net of
+ * that minute, less what its own strap steps already earn — so a brisk walk adds nothing beyond its
+ * steps, while a run, a ride or a bout on the bag nobody logged still counts. Upstream's detector only
+ * SUGGESTS workouts (#2187), so without this an unlogged run would be worth its footsteps alone.
+ */
+data class UnloggedMinute(
+    /** Epoch minute (epoch seconds / 60). */
+    val minute: Long,
+    val meanBpm: Double,
+    /** Calibrated strap steps counted in the minute. */
+    val steps: Int,
+)
+
+object UnloggedMinutes {
+
+    /** Strap ticks per epoch minute, each increment attributed to the later sample as [StepsCounter] does. */
+    fun ticksByMinute(samples: List<StepSample>): Map<Long, Int> {
+        val sorted = samples.sortedBy { it.ts }
+        if (sorted.size < 2) return emptyMap()
+        val classed = StepsCounter.hasActivityClasses(sorted)
+        val out = HashMap<Long, Int>()
+        for (i in 1 until sorted.size) {
+            val delta = (sorted[i].counter - sorted[i - 1].counter) and 0xFFFF
+            if (!StepsCounter.shouldCountDelta(sorted[i].activityClass, classed)) continue
+            if (!StepsCounter.isPlausibleDelta(sorted[i - 1].ts, sorted[i].ts, delta)) continue
+            out.merge(sorted[i].ts / 60L, delta, Int::plus)
+        }
+        return out
+    }
+
+    /**
+     * The qualifying minutes of a day: inside [startS, endS), outside every [windows] span (a minute that
+     * touches one is left out), mean bpm at or above the gate. [ticksByMinute] are raw ticks; [steps]
+     * calibrates them. [hrMax] null keeps upstream's 220 fallback, [restingHr] null its 60.
+     */
+    fun of(
+        hr: List<HrSample>,
+        ticksByMinute: Map<Long, Int>,
+        windows: List<Window>,
+        startS: Long,
+        endS: Long,
+        restingHr: Double?,
+        hrMax: Double?,
+        steps: (Int) -> Int = { it },
+    ): List<UnloggedMinute> {
+        val effMax = hrMax ?: HrIntegral.EMPTY_HRMAX
+        val effRest = restingHr ?: 60.0
+        val gate = effRest + Calories.dayActiveHRRFraction * (effMax - effRest)
+        val sums = HashMap<Long, LongArray>()   // minute -> [bpm sum, count]
+        for (s in hr) {
+            if (s.ts < startS || s.ts >= endS) continue
+            val m = s.ts / 60L
+            val acc = sums.getOrPut(m) { LongArray(2) }
+            acc[0] = acc[0] + s.bpm
+            acc[1] = acc[1] + 1
+        }
+        return sums.entries.asSequence()
+            .map { (m, acc) -> Triple(m, acc[0].toDouble() / acc[1], m) }
+            .filter { (m, mean, _) -> mean >= gate && windows.none { w -> w.durationS > 0 && m * 60L <= w.endTs && m * 60L + 59L >= w.startTs } }
+            .map { (m, mean, _) -> UnloggedMinute(m, mean, steps(ticksByMinute[m] ?: 0)) }
+            .sortedBy { it.minute }
+            .toList()
+    }
+
+    /**
+     * What the minutes add to the day: per minute, the Keytel net above basal less its steps' own energy,
+     * never below zero. Uses the day's weight, age and resting / max heart rate like the windows do.
+     */
+    fun kcal(
+        minutes: List<UnloggedMinute>,
+        sex: String,
+        weightKg: Double,
+        heightCm: Double,
+        ageYears: Double,
+        bmrRatePerS: Double,
+        restingHr: Double?,
+        hrMax: Double?,
+    ): Double {
+        if (minutes.isEmpty()) return 0.0
+        val effMax = hrMax ?: HrIntegral.EMPTY_HRMAX
+        val coeffs = Calories.resolveCoeffs(sex)
+        val vo2 = Calories.vo2maxFor(effMax, restingHr)
+        var total = 0.0
+        for (m in minutes) {
+            val gross = Calories.activeKcalPerS(coeffs, m.meanBpm, effMax, weightKg, ageYears, vo2) * 60.0
+            val net = (gross - bmrRatePerS * 60.0).coerceAtLeast(0.0)
+            val stepsKcal = EnergyEquations.stepsKcal(m.steps, weightKg, heightCm)
+            total += (net - stepsKcal).coerceAtLeast(0.0)
+        }
+        return total
+    }
+}
