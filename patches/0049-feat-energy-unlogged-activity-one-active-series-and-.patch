+package com.noop.energy
+
+import com.noop.analytics.Calories
+import com.noop.data.HrSample
+import com.noop.data.StepSample
+import com.noop.data.WorkoutRow
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * victor:energy — activity nobody logged: a run outside any window counts, a brisk walk adds nothing beyond
+ * its steps, a minute with both earns the larger not the sum, and a minute inside a window is left alone.
+ */
+class UnloggedMinutesTest {
+
+    private val start = 1_792_422_000L   // 2026-10-19 17:00 Madrid
+    private val end = start + 3600       // the logical-day slice under test
+    private val resting = 55.0
+    private val hrMax = 194.0
+    private val bmrRate = 2021.7 / 86_400.0
+
+    private fun hr(bpm: Int, from: Long, to: Long) = (from until to).map { HrSample("my-whoop", it, bpm) }
+
+    /** One tick a second over [from, to) on a cumulative counter, classed as walking. */
+    private fun walking(from: Long, to: Long, counterAt: Int) =
+        (from until to).mapIndexed { i, ts -> StepSample("my-whoop", ts, (counterAt + i) and 0xFFFF, activityClass = 1) }
+
+    private fun kcal(minutes: List<UnloggedMinute>) = UnloggedMinutes.kcal(minutes, "male", 80.0, 180.0, 26.0, bmrRate, resting, hrMax)
+
+    @Test
+    fun anUnloggedRunCounts() {
+        // 30 min at 160 bpm (75 % HRR), no steps recorded: 30 minutes of Keytel net.
+        val minutes = UnloggedMinutes.of(hr(160, start, start + 1800), emptyMap(), emptyList(), start, end, resting, hrMax)
+        assertEquals(30, minutes.size)
+        assertEquals(160.0, minutes.first().meanBpm, 0.0)
+        val gross = Calories.activeKcalPerS(Calories.male, 160.0, hrMax, 80.0, 26.0, Calories.vo2maxFor(hrMax, resting)) * 1800
+        assertEquals(gross - bmrRate * 1800, kcal(minutes), 1e-6)
+        assertTrue(kcal(minutes) > 250.0)
+    }
+
+    @Test
+    fun aBriskWalkUnderTheGateAddsNothing() {
+        // 105 bpm is under resting + 50 % of the reserve (124.5): its steps already pay for it.
+        val minutes = UnloggedMinutes.of(hr(105, start, start + 1800), emptyMap(), emptyList(), start, end, resting, hrMax)
+        assertTrue(minutes.isEmpty())
+        assertEquals(0.0, kcal(minutes), 0.0)
+    }
+
+    @Test
+    fun aMinuteWithStepsAndAHighPulseEarnsTheLargerNotTheSum() {
+        // 130 bpm (54 % HRR) with 120 steps in the minute: the steps' energy comes off the pulse's.
+        val ticks = UnloggedMinutes.ticksByMinute(walking(start, start + 60, 100))   // 59 counted increments
+        val minute = UnloggedMinutes.of(hr(130, start, start + 60), ticks, emptyList(), start, end, resting, hrMax).single()
+        assertEquals(59, minute.steps)
+        val netHr = Calories.activeKcalPerS(Calories.male, 130.0, hrMax, 80.0, 26.0, Calories.vo2maxFor(hrMax, resting)) * 60 - bmrRate * 60
+        val stepsKcal = EnergyEquations.stepsKcal(59, 80.0, 180.0)
+        assertEquals((netHr - stepsKcal).coerceAtLeast(0.0), kcal(listOf(minute)), 1e-9)
+        assertTrue(kcal(listOf(minute)) < netHr)
+        // Enough steps for the minute: the pulse adds nothing on top.
+        assertEquals(0.0, kcal(listOf(minute.copy(steps = 5000))), 0.0)
+    }
+
+    @Test
+    fun minutesInsideAWindowAreNotUnlogged() {
+        val row = WorkoutRow("my-whoop", start + 600, start + 1200, "Running", "my-whoop")
+        val window = EnergyModel.windows(listOf(row)).single()
+        val minutes = UnloggedMinutes.of(hr(160, start, start + 1800), emptyMap(), listOf(window), start, end, resting, hrMax)
+        // 30 minutes of pulse, 10 of them in the window (and the minute touching its end): none of those count.
+        assertTrue(minutes.none { it.minute * 60 in (start + 600)..(start + 1200) })
+        assertEquals(19, minutes.size)
+    }
+
+    @Test
+    fun theStepsOfAMinuteAreTheCountersIncrementsInIt() {
+        val ticks = UnloggedMinutes.ticksByMinute(walking(start, start + 180, 10))
+        assertEquals(mapOf(start / 60 to 59, start / 60 + 1 to 60, start / 60 + 2 to 60), ticks)
+        // Unclassed legacy samples count everything; a still-classed sample counts nothing.
+        val still = listOf(StepSample("my-whoop", start, 10, activityClass = 0), StepSample("my-whoop", start + 1, 20, activityClass = 0))
+        assertTrue(UnloggedMinutes.ticksByMinute(still).isEmpty())
+    }
+}
