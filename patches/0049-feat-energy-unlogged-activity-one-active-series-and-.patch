+/**
+ * victor:energy — the two seams upstream's code reaches the model through, set by [DayEnergyModel.install]:
+ * `WhoopRepository.resolvedSeries("active_kcal")` and the workout lists. Null until installed (tests, a
+ * repository built on its own), when upstream's own figures stand.
+ */
+object EnergyHooks {
+    @Volatile var activeSeries: (suspend (from: String, to: String) -> List<WhoopRepository.ResolvedMetricPoint>)? = null
+    @Volatile var pricedRows: (suspend (rows: List<WorkoutRow>) -> List<WorkoutRow>)? = null
+
+    /** The model's points for an `active_kcal` / `energy_kcal` read, or null when not installed or on failure. */
+    suspend fun activeSeries(key: String, from: String, to: String): List<WhoopRepository.ResolvedMetricPoint>? {
+        if (key != "active_kcal" && key != "energy_kcal") return null
+        val f = activeSeries ?: return null
+        return runCatching { f(from, to) }.getOrNull()
+    }
+
+    /** [rows] with each workout's kcal replaced by the model's gross figure, or [rows] as given when not installed. */
+    suspend fun priced(rows: List<WorkoutRow>): List<WorkoutRow> {
+        val f = pricedRows ?: return rows
+        return runCatching { f(rows) }.getOrDefault(rows)
+    }
+}
+
+/** victor:energy — workout rows as the lists show them: their kcal is the model's gross figure. */
+object EnergyRows {
+
+    /**
+     * Each row with `energyKcal` = the model's gross for its window; null where the model has no figure
+     * (no profile, a row collapsed into another), so the list says "–" rather than an estimate the day does
+     * not count. Everything else on the row is untouched.
+     */
+    suspend fun priced(ctx: Context, repo: WhoopRepository, strapId: String, rows: List<WorkoutRow>): List<WorkoutRow> {
+        if (rows.isEmpty()) return rows
+        val energy = DayEnergyModel.workouts(ctx, repo, strapId, rows)
+        return rows.map { r -> r.copy(energyKcal = energy[WorkoutKey.of(r)]?.grossKcal) }
+    }
+}
