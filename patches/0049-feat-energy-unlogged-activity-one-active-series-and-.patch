+        assertEquals(base.activeKcal!! + withRun.unloggedKcal!!, withRun.activeKcal!!, 1e-6)
+        // The strap recorded no heart rate that day: unknown, not zero; a worn strap with nothing above the gate: a real zero.
+        assertNull(EnergyModel.compose(example()).unloggedKcal)
+        assertEquals(0.0, EnergyModel.compose(example().copy(unlogged = emptyList())).unloggedKcal!!, 0.0)
+        // A minute that its steps already pay for adds nothing.
+        val walked = listOf(UnloggedMinute(dayStart / 60 + 600, 130.0, 3000))
+        assertEquals(0.0, EnergyModel.compose(example().copy(unlogged = walked, restingHr = 55.0, hrMax = 194.0)).unloggedKcal!!, 0.0)
+    }
+
+    @Test
+    fun aWeighInMovesItsDayAndTheDaysAfterNotTheDaysBefore() {
+        val readings = listOf("2026-10-10" to 82.0)
+        val before = EnergyModel.compose(example(body = body.copy(weightKg = EnergyEquations.weightOn("2026-10-09", readings) ?: 80.0)))
+        val on = EnergyModel.compose(example(body = body.copy(weightKg = EnergyEquations.weightOn("2026-10-10", readings) ?: 80.0)))
+        val later = listOf("2026-10-10" to 82.0, "2026-10-12" to 90.0)
+        assertEquals(before.bmrKcal!!, EnergyModel.compose(example(body = body.copy(weightKg = EnergyEquations.weightOn("2026-10-09", later) ?: 80.0))).bmrKcal!!, 0.0)
+        assertEquals(on.bmrKcal!!, EnergyModel.compose(example(body = body.copy(weightKg = EnergyEquations.weightOn("2026-10-11", later) ?: 80.0))).bmrKcal!!, 0.0)
+        assertTrue(EnergyModel.compose(example(body = body.copy(weightKg = EnergyEquations.weightOn("2026-10-12", later) ?: 80.0))).bmrKcal!! > on.bmrKcal!!)
+    }
+
+    @Test
+    fun aMealEditedOrDeletedMovesTheDigestionAndTheBalance() {
+        val logged = EnergyModel.compose(example())
+        val edited = EnergyModel.compose(example(meals = listOf(meal(p = 200.0, c = 200.0, f = 70.0, kcal = 2230.0))))
+        assertNotEquals(logged.tefKcal!!, edited.tefKcal!!, 1.0)
+        assertNotEquals(logged.balance(2600.0)!!, edited.balance(2230.0)!!, 1.0)
+        val deleted = EnergyModel.compose(example(meals = emptyList()))
+        assertNull(deleted.tefKcal)
+        assertEquals(logged.totalKcal!! - logged.tefKcal!!, deleted.totalKcal!!, 1e-6)
+    }
 }
