+/** The fork's pill chip (food meal/day/portion pickers, the goals card). */
+@Composable
+internal fun FoodChip(label: String, selected: Boolean, small: Boolean = false, onClick: () -> Unit) {
+    Surface(
+        shape = RoundedCornerShape(50),
+        color = if (selected) Palette.accent else Palette.surfaceInset,
+        modifier = Modifier.clip(RoundedCornerShape(50)).clickable(onClick = onClick),
+    ) {
+        Text(
+            label,
+            style = NoopType.subhead,
+            color = if (selected) Palette.surfaceBase else Palette.textPrimary,
+            modifier = Modifier.padding(horizontal = if (small) 10.dp else 12.dp, vertical = if (small) 5.dp else 7.dp),
+        )
+    }
+}
