+/** A row of photo thumbnails; with [onRemove], each carries a small remove button. */
+@Composable
+private fun PhotoStrip(previews: List<ImageBitmap?>, size: androidx.compose.ui.unit.Dp, onRemove: ((Int) -> Unit)?) {
+    Row(
+        modifier = Modifier.horizontalScroll(rememberScrollState()),
+        horizontalArrangement = Arrangement.spacedBy(Metrics.space8),
+    ) {
+        previews.forEachIndexed { i, bitmap ->
+            Box {
+                ThumbBox(bitmap, Modifier.size(size))
+                if (onRemove != null) {
+                    Surface(
+                        shape = CircleShape,
+                        color = Palette.surfaceOverlay,
+                        modifier = Modifier
+                            .align(Alignment.TopEnd)
+                            .padding(Metrics.space4)
+                            .size(24.dp)
+                            .clip(CircleShape)
+                            .clickable { onRemove(i) },
+                    ) {
+                        Icon(
+                            Icons.Filled.Close,
+                            contentDescription = uiString(R.string.victor_food_photo_remove),
+                            tint = Palette.textPrimary,
+                            modifier = Modifier.padding(Metrics.space4),
+                        )
+                    }
+                }
+            }
+        }
+    }
+}
