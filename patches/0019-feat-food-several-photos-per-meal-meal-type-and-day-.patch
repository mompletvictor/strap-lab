+/**
+ * The meals of a Spanish day, in the order they are shown. [NIBBLE] (picoteo) is never picked by the
+ * clock: it is the wearer's choice for something eaten between meals.
+ */
+enum class MealType(val id: String) {
+    BREAKFAST("breakfast"),
+    MID_MORNING("mid_morning"),
+    LUNCH("lunch"),
+    SNACK("snack"),
+    DINNER("dinner"),
+    NIBBLE("nibble");
+
+    companion object {
+        fun fromId(id: String?): MealType? = entries.firstOrNull { it.id == id }
+
+        /** The meal a local time most likely is, on Spanish hours (almuerzo = mid-morning). */
+        fun forTime(time: LocalTime): MealType = when {
+            time < LocalTime.of(4, 0) -> DINNER
+            time < LocalTime.of(10, 30) -> BREAKFAST
+            time < LocalTime.of(13, 0) -> MID_MORNING
+            time < LocalTime.of(16, 30) -> LUNCH
+            time < LocalTime.of(20, 0) -> SNACK
+            else -> DINNER
+        }
+
+        fun forTimestamp(timestampMs: Long, zone: ZoneId = ZoneId.systemDefault()): MealType =
+            forTime(Instant.ofEpochMilli(timestampMs).atZone(zone).toLocalTime())
+    }
+}
