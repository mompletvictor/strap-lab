+    /** [timestampMs] moved to the local [day], same wall-clock time: what "this was yesterday's dinner" means. */
+    fun moveToDay(timestampMs: Long, day: String, zone: ZoneId = ZoneId.systemDefault()): Long {
+        val time = Instant.ofEpochMilli(timestampMs).atZone(zone).toLocalTime()
+        return LocalDate.parse(day).atTime(time).atZone(zone).toInstant().toEpochMilli()
+    }
+
     /** The day's totals, or null when nothing is logged that day (distinct from a logged 0 kcal). */
     fun totalsFor(entries: List<FoodEntry>, day: String): FoodTotals? {
         val ofDay = entries.filter { it.day == day }
         return if (ofDay.isEmpty()) null else FoodTotals.ofEntries(ofDay)
     }
 
+    /** One day's entries by meal, in [MealType] order; within a meal, in the order they were eaten. */
+    fun groupedByMeal(entries: List<FoodEntry>): List<Pair<MealType, List<FoodEntry>>> =
+        entries.groupBy { it.meal }
+            .toSortedMap(compareBy { it.ordinal })
