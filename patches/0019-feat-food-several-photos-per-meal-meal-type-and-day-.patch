+/** Which meal of the day, and which day: the clock's guess, one tap to change. */
+@OptIn(ExperimentalLayoutApi::class)
+@Composable
+private fun WhenPicker(draft: FoodDraft, food: FoodViewModel) {
+    val ctx = LocalContext.current
+    val locale = LocalConfiguration.current.locales[0] ?: Locale.getDefault()
+    val today = FoodDays.today()
+    val yesterday = LocalDate.parse(today).minusDays(1).toString()
+    Column(verticalArrangement = Arrangement.spacedBy(Metrics.space8)) {
+        Overline(uiString(R.string.victor_food_when))
+        FlowRow(horizontalArrangement = Arrangement.spacedBy(6.dp), verticalArrangement = Arrangement.spacedBy(6.dp)) {
+            MealType.entries.forEach { meal ->
+                FoodChip(uiString(mealLabel(meal)), selected = draft.meal == meal) { food.setMeal(meal) }
+            }
+        }
+        FlowRow(horizontalArrangement = Arrangement.spacedBy(6.dp), verticalArrangement = Arrangement.spacedBy(6.dp)) {
+            FoodChip(uiString(R.string.victor_food_today), selected = draft.day == today) { food.setDay(today) }
+            FoodChip(uiString(R.string.victor_food_yesterday), selected = draft.day == yesterday) { food.setDay(yesterday) }
+            val other = draft.day != today && draft.day != yesterday
+            FoodChip(
+                if (other) foodDayLabel(draft.day, today, locale) else uiString(R.string.victor_food_day_other),
+                selected = other,
+            ) {
+                val d = runCatching { LocalDate.parse(draft.day) }.getOrDefault(LocalDate.now())
+                DatePickerDialog(ctx, { _, y, m, dom -> food.setDay(LocalDate.of(y, m + 1, dom).toString()) }, d.year, d.monthValue - 1, d.dayOfMonth)
+                    .apply {
+                        datePicker.maxDate = LocalDate.parse(today).plusDays(1)
+                            .atStartOfDay(ZoneId.systemDefault()).toInstant().toEpochMilli() - 1
+                    }
+                    .show()
+            }
         }
     }
