+package com.noop.haptics
+
+import android.content.Context
+
+/**
+ * victor:haptics — one master switch for every AUTOMATIC strap vibration the app sends (notification and
+ * call mirroring, inactivity and stress nudges, HR-zone coaching, intervals, breathing and live-session
+ * cues, double-tap actions). OFF by default in the family build: the strap stays quiet unless the wearer
+ * opts in. Gated at [com.noop.ble.WhoopBleClient.buzz], the single funnel those features share; explicit
+ * one-shot requests ([com.noop.ble.WhoopBleClient.buzzStrapOnce]: the Live "buzz now" button and Tasker)
+ * are not gated, and neither is the strap's own firmware (it may still buzz when a link re-bonds).
+ */
+object StrapVibration {
+    private const val FILE = "noop_prefs"
+    private const val KEY = "victor.haptics.automatic"
+
+    fun automaticAllowed(ctx: Context): Boolean =
+        ctx.applicationContext.getSharedPreferences(FILE, Context.MODE_PRIVATE).getBoolean(KEY, false)
+
+    fun setAutomaticAllowed(ctx: Context, on: Boolean) {
+        ctx.applicationContext.getSharedPreferences(FILE, Context.MODE_PRIVATE).edit().putBoolean(KEY, on).apply()
+    }
+}
