+
+    @Test
+    fun theMealMarkSeesTheDaysBurnAndItsWorkouts() {   // victor:scores
+        val gym = LocalDate.parse(day).atTime(18, 0).atZone(madrid).toEpochSecond()
+        val past = EnergyFixtures.day(day = day, totalKcal = 2800.0, workouts = listOf(EnergyFixtures.workout(gym, gym + 3_600, "Weightlifting", grossKcal = 450.0)))
+        assertEquals(
+            "ENERGY THAT DAY: burned 2800 kcal over the whole day; workouts: 18:00-19:00 Weightlifting 450 kcal",
+            MealScoring.energyLine(past, madrid),
+        )
+        val today = EnergyFixtures.day(day = day, totalKcal = 1200.0, bmrKcal = 1800.0, fraction = 0.5)
+        assertEquals(
+            "ENERGY THAT DAY: burned 1200 kcal so far, about 2100 by the end of the day; workouts: none recorded",
+            MealScoring.energyLine(today, madrid),
+        )
+        assertNull(MealScoring.energyLine(null))
+        val lunch = entry("l", 14, 0, MealType.LUNCH, 700.0)
+        val p = MealScoring.prompt(MealType.LUNCH, day, listOf(lunch), listOf(lunch), listOf("GOALS: gain muscle"), MealScoring.energyLine(past, madrid))
+        assertTrue(p.contains("burned 2800 kcal over the whole day"))
+        assertTrue(p.trim().endsWith("GOALS: gain muscle"))
+    }
