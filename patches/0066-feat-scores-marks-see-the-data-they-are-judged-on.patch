diff --git a/android/app/src/main/java/com/noop/training/TrainingScoreContext.kt b/android/app/src/main/java/com/noop/training/TrainingScoreContext.kt
new file mode 100644
index 000000000..39a171f6f
--- /dev/null
+++ b/android/app/src/main/java/com/noop/training/TrainingScoreContext.kt
@@ -0,0 +1,74 @@
+package com.noop.training
+
+import android.content.Context
+import com.noop.ai.AiCoach
+import com.noop.data.DailyMetric
+import com.noop.data.WhoopRepository
+import com.noop.data.WorkoutRow
+import com.noop.energy.EnergyDays
+import java.time.Instant
+import java.time.ZoneId
+import java.time.format.DateTimeFormatter
+import java.util.Locale
+import kotlin.math.roundToInt
+
+/**
+ * victor:scores — what a session's 0-10 mark is judged against, as of the session itself: that day's Charge and
+ * the night before it, and every workout in the 48 hours before it started. Read only with the coach's data
+ * consent (the analyzer checks), and worded so a missing record reads as missing, never as a rest day.
+ */
+internal object TrainingScoreContext {
+
+    private const val WINDOW_S = 48 * 3_600L
+
+    suspend fun lines(
+        ctx: Context,
+        repo: WhoopRepository,
+        strapId: String,
+        session: TrainingSession,
+        days: List<DailyMetric>,
+        zone: ZoneId,
+    ): List<String> {
+        val day = EnergyDays.dayOf(session.startTs, zone)
+        val rest = runCatching {
+            repo.resolvedSeries("sleep_performance", "my-whoop", day, day, strapDeviceId = strapId)
+                .values.firstOrNull { it.first == day }?.second
+        }.getOrNull()
+        val rows = runCatching {
+            AiCoach(repo) { strapId }.visibleWorkoutRows(session.startTs - WINDOW_S, session.startTs - 1)
+        }.getOrDefault(emptyList())
+        val sessions = runCatching { TrainingStore.load(ctx) }.getOrDefault(emptyList())
+        return listOf(dayLine(day, days.firstOrNull { it.day == day }, rest), recentLine(session, rows, sessions, zone))
+    }
+
+    /** Pure. The session day's Charge, the night before it and its Rest score. */
+    internal fun dayLine(day: String, d: DailyMetric?, restScore: Double?): String {
+        val parts = listOfNotNull(
+            d?.recovery?.let { "Charge (recovery) ${it.roundToInt()}/100" },
+            d?.totalSleepMin?.takeIf { it > 0 }?.let { "slept ${it.roundToInt() / 60} h ${it.roundToInt() % 60} min" },
+            restScore?.let { "Rest (sleep score) ${it.roundToInt()}/100" },
+            d?.avgHrv?.let { "HRV ${it.roundToInt()} ms" },
+        )
+        return "SESSION DAY ($day): " + parts.joinToString(", ").ifEmpty { "no recovery or sleep recorded" }
+    }
+
+    /** Pure. Every workout that started in the 48 h before [session], oldest first, with its sets when logged. */
+    internal fun recentLine(session: TrainingSession, rows: List<WorkoutRow>, sessions: List<TrainingSession>, zone: ZoneId): String {
+        val parts = rows
+            .filter { it.startTs in (session.startTs - WINDOW_S) until session.startTs }
+            .sortedBy { it.startTs }
+            .map { row ->
+                val logged = sessions.firstOrNull { !it.isLive && it.pairs(row) }
+                val start = Instant.ofEpochSecond(row.startTs).atZone(zone)
+                val end = Instant.ofEpochSecond(row.endTs).atZone(zone)
+                val effort = (logged?.analysis?.effort ?: row.strain)?.let { ", effort ${it.roundToInt()}/100" }.orEmpty()
+                val sets = logged?.exercises?.mapNotNull { ex ->
+                    TrainingFormat.summary(ex, logged::performed, Locale.US).takeIf { it.isNotEmpty() }?.let { "${ex.name} $it" }
+                }?.takeIf { it.isNotEmpty() }?.joinToString("; ", prefix = ": ").orEmpty()
+                "${start.toLocalDate()} ${start.format(HHMM)}-${end.format(HHMM)} ${row.sport}$effort$sets"
+            }
+        return "WORKOUTS IN THE 48 H BEFORE IT: " + parts.joinToString(" || ").ifEmpty { "none recorded" }
+    }
+
+    private val HHMM = DateTimeFormatter.ofPattern("HH:mm")
+}
