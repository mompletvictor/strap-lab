+package com.noop.ui
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Test
+
+/** victor:food — the Food slot the fork adds to the bottom bar, under the same rules upstream's tabs obey. */
+class VictorBarTabsTest {
+
+    @Test
+    fun foodSitsRightAfterSleep() {
+        assertEquals(
+            listOf(Destination.Sleep, Destination.Food, Destination.Coach),
+            withVictorTabs(barTrailingTabsFor(coachEnabled = true)).map { it.dest },
+        )
+        assertEquals(
+            listOf(Destination.Sleep, Destination.Food),
+            withVictorTabs(barTrailingTabsFor(coachEnabled = false)).map { it.dest },
+        )
+    }
+
+    @Test
+    fun foodIsNotAlsoInTheMoreSheetAndNoSlotRepeats() {
+        assertFalse(drawerGroups.flatMap { it.items }.contains(Destination.Food))
+        val bar = (barLeadingTabs + withVictorTabs(barTrailingTabs)).map { it.dest }
+        assertEquals(bar.distinct(), bar)
+    }
+}
