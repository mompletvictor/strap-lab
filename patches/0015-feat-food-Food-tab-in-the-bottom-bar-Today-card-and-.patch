+package com.noop.food
+
+import java.time.LocalDate
+import java.time.LocalTime
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** victor:food — the energy-out resolver behind the Food screen's and Today's balance. */
+class FoodEnergyTest {
+
+    @Test
+    fun phoneBasalWinsOverTheScaleBmr() {
+        val e = FoodEnergy.resolve(activeKcal = 600.0, phoneBasalKcal = 1500.0, scaleBmr = 1800.0, dayFraction = 0.5)
+        assertEquals(2100.0, e.totalKcal!!, 0.0)
+        assertFalse(e.basalFromScale)
+        assertEquals(-250.0, e.balance(1850.0)!!, 0.0)
+    }
+
+    @Test
+    fun scaleBmrIsProratedToTheShareOfTheDayGone() {
+        val e = FoodEnergy.resolve(activeKcal = 400.0, phoneBasalKcal = null, scaleBmr = 1800.0, dayFraction = 0.5)
+        assertEquals(900.0, e.basalKcal!!, 0.0)
+        assertEquals(1300.0, e.totalKcal!!, 0.0)
+        assertTrue(e.basalFromScale)
+    }
+
+    @Test
+    fun noBalanceWithoutBothHalves() {
+        val activeOnly = FoodEnergy.resolve(activeKcal = 500.0, phoneBasalKcal = null, scaleBmr = null, dayFraction = 1.0)
+        assertNull(activeOnly.totalKcal)
+        assertNull(activeOnly.balance(2000.0))
+        val zeroes = FoodEnergy.resolve(activeKcal = 0.0, phoneBasalKcal = 0.0, scaleBmr = 0.0, dayFraction = 1.0)
+        assertNull(zeroes.activeKcal)
+        assertNull(zeroes.basalKcal)
+    }
+
+    @Test
+    fun dayFractionIsWholeForPastDaysAndElapsedForToday() {
+        val today = LocalDate.of(2026, 10, 16)
+        assertEquals(1.0, FoodEnergy.dayFraction("2026-10-15", today, LocalTime.NOON), 0.0)
+        assertEquals(0.5, FoodEnergy.dayFraction("2026-10-16", today, LocalTime.NOON), 0.0)
+    }
+}
