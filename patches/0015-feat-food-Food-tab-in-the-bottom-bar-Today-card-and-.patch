+/**
+ * victor:food — one day's intake card: kcal, macros and the energy balance. Shared by the Food screen and
+ * the Today section so both show the same numbers from the same resolver ([FoodEnergy]). [onAdd] adds a
+ * button that opens the Food screen (Today only).
+ */
+@Composable
+internal fun FoodDayCard(
+    totals: FoodTotals,
+    meals: Int,
+    energy: FoodEnergy?,
+    title: String = uiString(R.string.victor_food_today),
+    onAdd: (() -> Unit)? = null,
+) {
+    NoopCard(tint = Palette.accent) {
+        Column(verticalArrangement = Arrangement.spacedBy(Metrics.space12)) {
+            Row(verticalAlignment = Alignment.CenterVertically) {
+                Overline(title)
+                Spacer(Modifier.weight(1f))
+                if (meals > 0) {
+                    Text(
+                        uiPlural(R.plurals.victor_food_meals, meals, meals),
+                        style = NoopType.caption,
+                        color = Palette.textSecondary,
+                    )
+                }
+            }
+            Row(verticalAlignment = Alignment.Bottom, horizontalArrangement = Arrangement.spacedBy(Metrics.space6)) {
+                Text(whole(totals.kcal), style = NoopType.display(48f), color = Palette.textPrimary)
+                Text(
+                    uiString(R.string.victor_food_kcal),
+                    style = NoopType.headline,
+                    color = Palette.textSecondary,
+                    modifier = Modifier.padding(bottom = Metrics.space8),
+                )
+            }
+            Row(Modifier.fillMaxWidth()) {
+                MacroStat(uiString(R.string.victor_food_protein), totals.proteinG, Palette.metricCyan, Modifier.weight(1f))
+                MacroStat(uiString(R.string.victor_food_carbs), totals.carbsG, Palette.metricAmber, Modifier.weight(1f))
+                MacroStat(uiString(R.string.victor_food_fat), totals.fatG, Palette.metricRose, Modifier.weight(1f))
+            }
+            EnergyLines(totals.kcal, energy)
+            if (onAdd != null) {
+                NoopButton(
+                    text = uiString(R.string.victor_food_add_meal),
+                    leadingIcon = Icons.Filled.Add,
+                    kind = NoopButtonKind.Primary,
+                    fullWidth = true,
+                    onClick = onAdd,
+                )
+            }
+        }
+    }
+}
+
+/** Burned so far (basal + activity) and the balance; just the activity when the basal half is unknown. */
+@Composable
+private fun EnergyLines(intakeKcal: Double, energy: FoodEnergy?) {
+    val total = energy?.totalKcal
+    when {
+        total != null -> {
+            val balance = energy.balance(intakeKcal) ?: return
+            Column(verticalArrangement = Arrangement.spacedBy(Metrics.space2)) {
+                Text(
+                    uiString(R.string.victor_food_burned_total, whole(total), whole(energy.basalKcal ?: 0.0), whole(energy.activeKcal ?: 0.0)),
+                    style = NoopType.subhead,
+                    color = Palette.textSecondary,
+                )
+                Text(
+                    uiString(
+                        if (balance < 0) R.string.victor_food_balance_deficit else R.string.victor_food_balance_surplus,
+                        whole(abs(balance)),
+                    ),
+                    style = NoopType.headline,
+                    color = if (balance < 0) Palette.chargeColor else Palette.metricAmber,
+                )
+                if (energy.basalFromScale) {
+                    Text(uiString(R.string.victor_food_basal_from_scale), style = NoopType.caption, color = Palette.textTertiary)
+                }
+            }
+        }
+        energy?.activeKcal != null ->
+            Text(
+                uiString(R.string.victor_food_burned_active_only, whole(energy.activeKcal)),
+                style = NoopType.subhead,
+                color = Palette.textSecondary,
+            )
+        else -> Unit
+    }
+}
+
+@Composable
+private fun MacroStat(label: String, grams: Double, accent: Color, modifier: Modifier) {
+    Column(modifier, verticalArrangement = Arrangement.spacedBy(Metrics.space2)) {
+        Text(label, style = NoopType.caption, color = accent)
+        Text(uiString(R.string.victor_food_grams, whole(grams)), style = NoopType.chartValue, color = Palette.textPrimary)
+    }
+}
diff --git a/android/app/src/main/java/com/noop/food/FoodEnergy.kt b/android/app/src/main/java/com/noop/food/FoodEnergy.kt
new file mode 100644
index 000000000..7188bca7f
--- /dev/null
+++ b/android/app/src/main/java/com/noop/food/FoodEnergy.kt
@@ -0,0 +1,59 @@
+package com.noop.food
+
+import com.noop.ingest.ScaleImport
+import com.noop.ui.AppViewModel
+import java.time.LocalDate
+import java.time.LocalTime
+import java.time.ZoneId
+
+/**
+ * victor:food — energy OUT for one day, so the food log can show a balance (eaten − burned). One
+ * resolver for every surface that shows it (the Food screen and the Today section), so the two can
+ * never disagree.
+ *
+ * [activeKcal] is resolved exactly like the Today "Calories" card (#616). [basalKcal] is the phone's own
+ * basal for the day (Samsung Health / Apple total − active, imported by Health Connect / Apple Health)
+ * when present, else the smart scale's BMR — prorated by how much of the day has passed when the day is
+ * today, so "so far" figures compare like with like.
+ */
+internal data class FoodEnergy(
+    val activeKcal: Double?,
+    val basalKcal: Double?,
+    val basalFromScale: Boolean,
+) {
+    /** Total burned, only when both halves are known (active alone would overstate any deficit). */
+    val totalKcal: Double? get() = if (activeKcal != null && basalKcal != null) activeKcal + basalKcal else null
+
+    /** Eaten minus burned; negative is a deficit. Null without a total. */
+    fun balance(intakeKcal: Double): Double? = totalKcal?.let { intakeKcal - it }
+
+    companion object {
+        /** Pure: combine the reads. [dayFraction] is 1.0 for a past day, the elapsed share of today otherwise. */
+        fun resolve(activeKcal: Double?, phoneBasalKcal: Double?, scaleBmr: Double?, dayFraction: Double): FoodEnergy {
+            val active = activeKcal?.takeIf { it > 0 }
+            val phoneBasal = phoneBasalKcal?.takeIf { it > 0 }
+            val scaleBasal = scaleBmr?.takeIf { it > 0 }?.let { it * dayFraction.coerceIn(0.0, 1.0) }
+            return FoodEnergy(active, phoneBasal ?: scaleBasal, basalFromScale = phoneBasal == null && scaleBasal != null)
+        }
+
+        /** Share of [day] elapsed at [now]: 1.0 for any past day. */
+        fun dayFraction(day: String, now: LocalDate = LocalDate.now(), time: LocalTime = LocalTime.now()): Double =
+            if (day < now.toString()) 1.0 else time.toSecondOfDay() / 86_400.0
+
+        /** Read the day's energy from the repository. Best-effort: any failed read just leaves its half null. */
+        suspend fun load(vm: AppViewModel, day: String): FoodEnergy {
+            val repo = vm.repo
+            val phoneRows = runCatching {
+                repo.appleDaily("apple-health", day, day) + repo.appleDaily("health-connect", day, day)
+            }.getOrDefault(emptyList())
+            val active = phoneRows.firstNotNullOfOrNull { r -> r.activeKcal?.takeIf { it > 0 } }
+                ?: runCatching {
+                    repo.resolvedSeries("active_kcal", "my-whoop", day, day, strapDeviceId = vm.activeStrapId)
+                        .points.firstOrNull()?.value?.takeIf { it > 0 }
+                }.getOrNull()
+            val phoneBasal = phoneRows.firstNotNullOfOrNull { r -> r.basalKcal?.takeIf { it > 0 } }
+            val scaleBmr = runCatching { ScaleImport.snapshot(repo)?.bmr?.value }.getOrNull()
+            return resolve(active, phoneBasal, scaleBmr, dayFraction(day, LocalDate.now(ZoneId.systemDefault())))
+        }
+    }
+}
