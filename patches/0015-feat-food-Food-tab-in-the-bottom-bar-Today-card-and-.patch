@@ -0,0 +1,14 @@
+package com.noop.ui
+
+import com.noop.R
+import com.noop.food.foodNavIcon
+
+/** victor:food — the fork's extra bottom-bar slot (Food), kept out of upstream's tab lists and their tests. */
+internal val victorFoodTab = BarTab(Destination.Food, foodNavIcon, R.string.victor_food_nav)
+
+/** Insert [victorFoodTab] right after Sleep (Today · Trends · Sleep · Food · Coach · More). */
+internal fun withVictorTabs(trailing: List<BarTab>): List<BarTab> {
+    val sleep = trailing.indexOfFirst { it.dest == Destination.Sleep }
+    return if (sleep < 0) trailing + victorFoodTab
+    else trailing.take(sleep + 1) + victorFoodTab + trailing.drop(sleep + 1)
+}
