+package com.noop.food
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.produceState
+import androidx.compose.ui.platform.LocalContext
+import com.noop.R
+import com.noop.ui.AppViewModel
+import com.noop.ui.uiString
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+
+/**
+ * victor:food — the Today Food card (anchored above Workouts): today's intake and energy balance, the same
+ * [FoodDayCard] the Food tab shows, plus a button into the Food tab. Re-reads the log each time Today is
+ * composed, so a meal saved on the Food tab is here when the wearer comes back.
+ */
+@Composable
+internal fun TodayFoodSection(vm: AppViewModel, onOpenFood: () -> Unit) {
+    val ctx = LocalContext.current
+    val today = FoodDays.today()
+    val entries by produceState(emptyList<FoodEntry>(), today) {
+        value = runCatching { FoodStore.load(ctx) }.getOrDefault(emptyList())
+    }
+    val energy by produceState<FoodEnergy?>(null, today, entries) {
+        value = withContext(Dispatchers.IO) { runCatching { FoodEnergy.load(vm, today) }.getOrNull() }
+    }
+    val todays = entries.filter { it.day == today }
+    FoodDayCard(
+        totals = FoodTotals.ofEntries(todays),
+        meals = todays.size,
+        energy = energy,
+        title = uiString(R.string.victor_food_nav),
+        onAdd = onOpenFood,
+    )
+}
