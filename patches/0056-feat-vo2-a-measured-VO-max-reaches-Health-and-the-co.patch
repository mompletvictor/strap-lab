@@ -41,6 +44,21 @@ class VictorCoachBlockTest {
     @After
     fun tearDown() = db.close()
 
+    @Test
+    fun aMeasuredVo2maxIsTheNewestOfEitherSourceWithinAYear() = runBlocking {
+        val today = LocalDate.of(2026, 10, 20)
+        assertNull(VictorCoachVitals.measuredVo2max(repo, today))
+        repo.upsertAppleDaily(
+            listOf(
+                AppleDaily("health-connect", "2025-09-01", vo2max = 52.0),   // over a year old: no longer counts
+                AppleDaily("health-connect", "2026-09-30", vo2max = 47.5),
+                AppleDaily("health-connect", "2026-10-15", steps = 9000),    // a day without a VO₂max reading
+                AppleDaily("apple-health", "2026-10-05", vo2max = 48.8),
+            ),
+        )
+        assertEquals("2026-10-05" to 48.8, VictorCoachVitals.measuredVo2max(repo, today))
+    }
+
     @Test
     fun todaysWeighInReachesTheCoachAndEverySectionIsThere() = runBlocking {
         val today = LocalDate.now()
