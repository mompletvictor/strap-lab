         vo2maxEstimator = estimator
+        vo2Measured = com.noop.ai.VictorCoachVitals.measuredVo2max(vm.repo)
     }
 
     // Readiness from what THIS screen can see: the last 7 merged daily rows. RHR coverage drives the
@@ -718,6 +720,7 @@ private fun FitnessAgeSection(vm: AppViewModel, days: List<DailyMetric>, profile
                 chronoAge = profile.age,
                 vo2max = vo2max,
                 vo2maxEstimator = vo2maxEstimator,
+                vo2Measured = vo2Measured,
                 onHowAccurate = { showChecklist = !showChecklist },
                 checklistOpen = showChecklist,
             )
@@ -968,6 +971,7 @@ private fun FitnessAgeHero(
     vo2maxEstimator: Vo2MaxEstimator?,
     onHowAccurate: () -> Unit,
     checklistOpen: Boolean,
+    vo2Measured: Pair<String, Double>? = null,
 ) {
     val shown = fitnessAge.roundToInt()
     val boundSymbol = fitnessAgeBoundSymbol(fitnessAge)
@@ -1025,18 +1029,34 @@ private fun FitnessAgeHero(
                         else if (younger) Palette.statusPositive else Palette.statusWarning,
                     )
                 }
-                if (vo2max != null) {
+                if (vo2max != null || vo2Measured != null) {
                     Column(horizontalAlignment = Alignment.End) {
-                        StatePill(
-                            title = uiString(R.string.l10n_health_screen_vo_max_vo2max_roundtoint_c32a04b3, vo2max.roundToInt()),
-                            tone = StrandTone.Accent,
-                            showsDot = false,
-                        )
-                        Text(
-                            text = uiString(vo2MaxAttributionLabelRes(vo2maxEstimator)),
-                            style = NoopType.footnote,
-                            color = Palette.textTertiary,
-                        )
+                        if (vo2max != null) {
+                            StatePill(
+                                title = uiString(R.string.l10n_health_screen_vo_max_vo2max_roundtoint_c32a04b3, vo2max.roundToInt()),
+                                tone = StrandTone.Accent,
+                                showsDot = false,
+                            )
+                            Text(
+                                text = uiString(vo2MaxAttributionLabelRes(vo2maxEstimator)),
+                                style = NoopType.footnote,
+                                color = Palette.textTertiary,
+                            )
+                        }
+                        // victor:vo2-measured — a watch's or test's VO₂max beside the estimate, with its day.
+                        vo2Measured?.let { (day, value) ->
+                            Text(
+                                text = uiString(
+                                    R.string.victor_vo2_measured,
+                                    value.roundToInt(),
+                                    runCatching {
+                                        java.time.LocalDate.parse(day).format(java.time.format.DateTimeFormatter.ofPattern("d MMM", java.util.Locale.getDefault()))
+                                    }.getOrDefault(day),
+                                ),
+                                style = NoopType.footnote,
+                                color = Palette.textSecondary,
+                            )
+                        }
                     }
                 }
             }
