 .../src/main/java/com/noop/ui/HealthScreen.kt | 42 ++++++++++++++-----
 .../src/main/res/values-es/strings_victor.xml |  3 ++
 .../src/main/res/values/strings_victor.xml    |  3 ++
 .../java/com/noop/ai/VictorCoachBlockTest.kt  | 18 ++++++++
 .../java/com/noop/ai/VictorCoachVitalsTest.kt | 10 +++++
 6 files changed, 101 insertions(+), 17 deletions(-)

diff --git a/android/app/src/main/java/com/noop/ai/VictorCoachVitals.kt b/android/app/src/main/java/com/noop/ai/VictorCoachVitals.kt
index a216904b5..360be1a5c 100644
--- a/android/app/src/main/java/com/noop/ai/VictorCoachVitals.kt
+++ b/android/app/src/main/java/com/noop/ai/VictorCoachVitals.kt
@@ -10,6 +10,7 @@ import com.noop.data.DailyMetric
 import com.noop.data.LabMarkerRow
 import com.noop.data.SleepSession
 import com.noop.data.WhoopRepository
+import com.noop.ingest.HealthConnectImporter
 import com.noop.ui.ProfileStore
 import java.time.Instant
 import java.time.LocalDate
@@ -33,6 +34,9 @@ internal object VictorCoachVitals {
     private const val WATER_DAYS = 7
     private const val FITNESS_LOOKBACK_DAYS = 120L
 
+    /** How long a measured VO₂max still describes the wearer: it moves slowly, and its day is always shown. */
+    private const val MEASURED_VO2_DAYS = 365L
+
     /** The Lab Book's own read id ("my-whoop", where Health Connect writes blood pressure). */
     private const val LAB_DEVICE_ID = WhoopRepository.WHOOP_SOURCE
 
@@ -143,24 +147,50 @@ internal object VictorCoachVitals {
         return "WATER: today ${today.roundToInt()} ml so far$prior"
     }
 
-    /** The app's own VO₂max and fitness-age estimates (Health screen), newest of the last 120 days. */
+    /**
+     * The app's own VO₂max and fitness-age estimates (Health screen), newest of the last 120 days, and a
+     * VO₂max a watch or test MEASURED ([measuredVo2max]) when there is one.
+     */
     suspend fun fitnessLine(repo: WhoopRepository, strapId: String): String? {
         val to = LocalDate.now().toString()
         val from = LocalDate.now().minusDays(FITNESS_LOOKBACK_DAYS).toString()
         suspend fun latest(key: String) = runCatching {
             repo.resolvedSeries(key, LAB_DEVICE_ID, from, to, strapDeviceId = strapId).points.lastOrNull { it.value > 0 }
         }.getOrNull()?.let { it.day to it.value }
-        return fitnessLine(latest("vo2max_est"), latest("fitness_age"))
+        return fitnessLine(latest("vo2max_est"), latest("fitness_age"), measuredVo2max(repo))
     }
 
-    /** Pure: (day, value) of each estimate; null when neither exists. */
-    internal fun fitnessLine(vo2max: Pair<String, Double>?, fitnessAge: Pair<String, Double>?): String? {
+    /** Pure: (day, value) of each estimate and of the measured VO₂max; null when none exists. */
+    internal fun fitnessLine(
+        vo2max: Pair<String, Double>?,
+        fitnessAge: Pair<String, Double>?,
+        measured: Pair<String, Double>? = null,
+    ): String? {
         val parts = listOfNotNull(
             vo2max?.let { "VO₂max ~${it.second.roundToInt()} ml/kg/min (${it.first})" },
             fitnessAge?.let { "fitness age ${it.second.roundToInt()} (${it.first})" },
         )
-        if (parts.isEmpty()) return null
-        return "FITNESS (the app's own estimates from resting HR and profile): " + parts.joinToString("; ")
+        val estimates = parts.takeIf { it.isNotEmpty() }
+            ?.let { "FITNESS (the app's own estimates from resting HR and profile): " + it.joinToString("; ") }
+        val measuredLine = measured?.let {
+            "VO₂max MEASURED by a watch or test (Health Connect): ${it.second.roundToInt()} ml/kg/min (${it.first}); " +
+                "prefer it over the estimate"
+        }
+        return listOfNotNull(estimates, measuredLine).takeIf { it.isNotEmpty() }?.joinToString("\n")
+    }
+
+    /**
+     * victor:vo2-measured — the newest VO₂max a watch or a test MEASURED, from the Health Connect / Apple
+     * Health daily rows, as (day, ml/kg/min); null when none in the last [MEASURED_VO2_DAYS]. The one place
+     * the Health screen and the coach read it from; the app's own estimate stays `vo2max_est`.
+     */
+    suspend fun measuredVo2max(repo: WhoopRepository, today: LocalDate = LocalDate.now()): Pair<String, Double>? {
+        val from = today.minusDays(MEASURED_VO2_DAYS).toString()
+        val to = today.toString()
+        return listOf(HealthConnectImporter.HC_DEVICE, "apple-health")
+            .flatMap { id -> runCatching { repo.appleDaily(id, from, to) }.getOrDefault(emptyList()) }
+            .mapNotNull { r -> r.vo2max?.takeIf { it > 0 }?.let { r.day to it } }
+            .maxByOrNull { it.first }
     }
 
     private data class Bp(val ts: Long, val sys: Double, val dia: Double, val pulse: Double?)
