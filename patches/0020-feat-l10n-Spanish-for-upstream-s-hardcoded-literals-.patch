@@ -0,0 +1,173 @@
+#!/usr/bin/env python3
+"""victor:l10n — Spanish for the parts of upstream that never reach strings.xml, without patching upstream.
+
+Two gaps, both filled at build time so the patch queue never conflicts with upstream's own i18n work:
+
+1. Hardcoded English literals in Kotlin (`Text("Sleep chart")`). Each rule in Tools/victor_l10n/*.json
+   is an exact find -> replace in one file, pointing at our own resources
+   (res/values{,-es}/strings_victor_l10n_*.xml). A rule whose text is gone (upstream changed or
+   translated it) is skipped, never an error: that string simply shows upstream's version.
+2. Poor or missing Spanish in upstream's values-es/strings.xml. Tools/victor_l10n/es_fixes.json maps
+   key -> {"en": English it was translated from, "es": our Spanish}. Entries whose English still matches
+   upstream's current values/strings.xml are written to the `full` flavor overlay
+   (src/full/res/values-es/strings_victor_es.xml, git-ignored), which overrides main's Spanish for that
+   key. A changed English (or a key upstream removed) drops the entry, so a stale override never ships.
+
+Usage: python3 Tools/victor_l10n.py [--check]
+  default  apply what still matches, write the overlay, print a summary, exit 0 (the CI runs this after
+           `git am`; locally, run it before building and `git checkout` the touched .kt files after)
+  --check  change nothing; exit 1 when a rule names a missing resource, resources disagree on
+           placeholders, or an es_fixes entry is malformed. Rules that no longer match are reported only.
+"""
+import argparse
+import json
+import re
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+RULES_DIR = ROOT / "Tools" / "victor_l10n"
+SRC = ROOT / "android" / "app" / "src"
+JAVA = SRC / "main" / "java" / "com" / "noop"
+RES = SRC / "main" / "res"
+OVERLAY = SRC / "full" / "res" / "values-es" / "strings_victor_es.xml"
+
+STRING_RE = re.compile(r'<string\s+name="([^"]+)"([^>]*)>(.*?)</string>', re.S)
+PLACEHOLDER_RE = re.compile(r"%(?:\d+\$)?[-#+ 0,(]*\d*(?:\.\d+)?[a-zA-Z%]")
+KEY_RE = re.compile(r"R\.string\.(victor_l10n_\w+)")
+
+
+def strings_in(path):
+    """name -> raw inner XML of every <string> in [path] (escapes kept as written)."""
+    if not path.exists():
+        return {}
+    return {m.group(1): m.group(3) for m in STRING_RE.finditer(path.read_text(encoding="utf-8"))}
+
+
+def placeholders(text):
+    return sorted(p for p in PLACEHOLDER_RE.findall(text) if p != "%%")
+
+
+def own_resources(folder):
+    out = {}
+    for f in sorted((RES / folder).glob("strings_victor_l10n_*.xml")):
+        out.update(strings_in(f))
+    return out
+
+
+def load_rules():
+    rules = []
+    for f in sorted(RULES_DIR.glob("*.json")):
+        if f.name == "es_fixes.json":
+            continue
+        for r in json.loads(f.read_text(encoding="utf-8")):
+            rules.append((f.name, r))
+    return rules
+
+
+def ensure_imports(text):
+    """Add the imports a replacement needs, after the last import (or the package line)."""
+    pkg = re.search(r"^package\s+([\w.]+)", text, re.M)
+    pkg = pkg.group(1) if pkg else ""
+    needed = []
+    if "uiString(" in text and pkg != "com.noop.ui" and "import com.noop.ui.uiString" not in text:
+        needed.append("import com.noop.ui.uiString")
+    if re.search(r"(?<![\w.])R\.string\.", text) and pkg != "com.noop" and "import com.noop.R\n" not in text:
+        needed.append("import com.noop.R")
+    if not needed:
+        return text
+    lines = text.split("\n")
+    anchor = max((i for i, l in enumerate(lines) if l.startswith("import ")), default=None)
+    if anchor is None:
+        anchor = next(i for i, l in enumerate(lines) if l.startswith("package "))
+    lines[anchor + 1:anchor + 1] = needed
+    return "\n".join(lines)
+
+
+def apply_rules(check):
+    rules = load_rules()
+    en, es = own_resources("values"), own_resources("values-es")
+    problems, applied, already, missing = [], 0, 0, []
+    pending = {}
+    for origin, r in rules:
+        for key in KEY_RE.findall(r["replace"]):
+            if key not in en or key not in es:
+                problems.append(f"{origin}: {key} missing from values or values-es")
+        path = JAVA / r["file"]
+        if path not in pending:
+            pending[path] = path.read_text(encoding="utf-8") if path.exists() else None
+        text = pending[path]
+        # "Already applied" first: some rules wrap an expression (find `range.label`, replace
+        # `when (range) { … else -> range.label }`), so their find survives in their own output.
+        if text is not None and r["replace"] in text:
+            already += 1
+        elif text is not None and r["find"] in text:
+            pending[path] = text.replace(r["find"], r["replace"])
+            applied += 1
+        else:
+            missing.append(f"{origin}: {r['file']}: {r['find'][:70]!r}")
+    for key in sorted(set(en) | set(es)):
+        if key not in en or key not in es:
+            problems.append(f"{key}: only in {'values' if key in en else 'values-es'}")
+        elif placeholders(en[key]) != placeholders(es[key]):
+            problems.append(f"{key}: placeholders differ between values and values-es")
+    if not check:
+        for path, text in pending.items():
+            if text is not None and text != path.read_text(encoding="utf-8"):
+                path.write_text(ensure_imports(text), encoding="utf-8")
+    return applied, already, missing, problems
+
+
+def build_overlay(check):
+    fixes_file = RULES_DIR / "es_fixes.json"
+    fixes = json.loads(fixes_file.read_text(encoding="utf-8")) if fixes_file.exists() else {}
+    upstream_en = strings_in(RES / "values" / "strings.xml")
+    kept, stale, problems = {}, [], []
+    for key, e in sorted(fixes.items()):
+        if not isinstance(e, dict) or not isinstance(e.get("en"), str) or not isinstance(e.get("es"), str):
+            problems.append(f"es_fixes {key}: needs string fields en and es")
+            continue
+        if placeholders(e["en"]) != placeholders(e["es"]):
+            problems.append(f"es_fixes {key}: placeholders differ between en and es")
+            continue
+        current = upstream_en.get(key)
+        if current is None or current.strip() != e["en"].strip():
+            stale.append(key)
+            continue
+        kept[key] = e["es"]
+    if not check:
+        OVERLAY.parent.mkdir(parents=True, exist_ok=True)
+        body = "".join(f'    <string name="{k}">{v}</string>\n' for k, v in kept.items())
+        OVERLAY.write_text(
+            '<?xml version="1.0" encoding="utf-8"?>\n'
+            "<!-- Generated by Tools/victor_l10n.py from Tools/victor_l10n/es_fixes.json. Do not edit. -->\n"
+            f"<resources>\n{body}</resources>\n",
+            encoding="utf-8",
+        )
+    return kept, stale, problems
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    ap.add_argument("--check", action="store_true", help="validate only; change nothing")
+    args = ap.parse_args()
+
+    applied, already, missing, problems = apply_rules(args.check)
+    kept, stale, overlay_problems = build_overlay(args.check)
+    problems += overlay_problems
+
+    verb = "would apply" if args.check else "applied"
+    print(f"victor_l10n: literals {verb} {applied}, already applied {already}, no longer matching {len(missing)}")
+    for m in missing:
+        print(f"  skip  {m}")
+    print(f"victor_l10n: es fixes kept {len(kept)}, dropped as stale {len(stale)}")
+    for k in stale:
+        print(f"  stale {k}")
+    for p in problems:
+        print(f"  ERROR {p}")
+    if args.check and problems:
+        sys.exit(1)
+
+
+if __name__ == "__main__":
+    main()
