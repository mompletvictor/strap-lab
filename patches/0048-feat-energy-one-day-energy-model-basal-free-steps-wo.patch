@@ -0,0 +1,297 @@
+package com.noop.energy
+
+import com.noop.data.HrSample
+import com.noop.data.WorkoutRow
+import com.noop.food.FoodEntry
+import com.noop.food.FoodItem
+import com.noop.ui.WorkoutEditing
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.time.ZoneId
+
+/**
+ * victor:energy — the composition: every input moves the total, nothing is counted twice, and a missing
+ * input is null rather than zero. The reference day is the worked example of CONTEXT/modelo-energia.md.
+ */
+class EnergyModelTest {
+
+    private val madrid = ZoneId.of("Europe/Madrid")
+    private val day = "2026-10-19"
+    private val dayStart = EnergyDays.startEpochS(day, madrid)
+
+    private val body = BodyInputs(sex = "male", weightKg = 80.0, heightCm = 180.0, ageYears = 26.0)
+
+    private fun row(sport: String, startMin: Long, durMin: Long, source: String = "my-whoop", kcal: Double? = null) =
+        WorkoutRow(
+            deviceId = source, startTs = dayStart + startMin * 60, endTs = dayStart + (startMin + durMin) * 60,
+            sport = sport, source = source, energyKcal = kcal,
+        )
+
+    private fun flat(bpm: Int, w: Window): List<HrSample> = (w.startTs..w.endTs).map { HrSample("my-whoop", it, bpm) }
+
+    private fun hr(w: Window, bpm: Int?, restingHr: Double? = 55.0): HrIntegral =
+        if (bpm == null) HrIntegral.empty(restingHr, 194.0) else HrIntegral.of(flat(bpm, w), w.startTs, w.endTs, restingHr, 194.0)
+
+    private fun meal(p: Double = 160.0, c: Double = 280.0, f: Double = 85.0, kcal: Double = 2600.0) = FoodEntry(
+        id = "m1", timestamp = (dayStart + 10 * 3600) * 1000L, day = day, note = "",
+        items = listOf(FoodItem("día", "todo", kcal, p, c, f)),
+        kcal = kcal, proteinG = p, carbsG = c, fatG = f, thumbnailPaths = emptyList(),
+    )
+
+    /** The worked example: 9 000 steps (2 000 in the gym), 70 min of lifting at 118 bpm, 2 600 kcal eaten. */
+    private fun example(
+        body: BodyInputs = this.body,
+        trainingDays28: Int = 12,
+        strapDaySteps: Int? = 9000,
+        phoneDaySteps: Int? = null,
+        gymSteps: Int? = 2000,
+        gymBpm: Int? = 118,
+        sport: String = "Strength",
+        claude: Double? = null,
+        meals: List<FoodEntry> = listOf(meal()),
+        fraction: Double = 1.0,
+        extraWindows: List<WindowInputs> = emptyList(),
+        prior: List<Double> = emptyList(),
+    ): DayInputs {
+        val w = EnergyModel.windows(listOf(row(sport, 18 * 60, 70))).single()
+        return DayInputs(
+            day = day, fraction = fraction, body = body, trainingDays28 = trainingDays28,
+            strapDaySteps = strapDaySteps, phoneDaySteps = phoneDaySteps,
+            windows = listOf(WindowInputs(w, hr(w, gymBpm), gymSteps, claude, null)) + extraWindows,
+            meals = meals, priorStepsKcal = prior,
+        )
+    }
+
+    private fun total(inputs: DayInputs): Double = EnergyModel.compose(inputs).totalKcal!!
+
+    @Test
+    fun theWorkedExampleBurnsAboutTwoThousandNineHundredAndSeventy() {
+        val e = EnergyModel.compose(example())
+        assertEquals(2021.7, e.bmrKcal!!, 0.1)                 // Ten Haaf: 12 training days in 28
+        assertEquals(1.0, e.basalBlend, 0.0)
+        assertEquals(7000, e.steps!!.freeSteps)                 // 9 000 − 2 000 in the gym
+        assertEquals(StepsSource.STRAP, e.steps!!.source)
+        assertEquals(230.1, e.steps!!.kcal, 0.1)
+        val gym = e.workouts.single()
+        assertEquals(SportCategory.STRENGTH, gym.category)
+        assertEquals(EnergyMethod.MET, gym.method)              // 45 % HRR → MET 5.0 (+4 % anaerobic)
+        assertEquals(509.6, gym.grossKcal, 0.1)
+        assertEquals(411.3, gym.netKcal, 0.1)                   // minus 98 kcal of basal for the 70 min
+        assertEquals(49.4, gym.epocKcal, 0.1)
+        assertEquals(259.3, e.tefKcal!!, 0.1)
+        assertEquals(2972.0, e.totalKcal!!, 5.0)
+        assertEquals(e.steps!!.kcal + gym.netKcal + gym.epocKcal, e.activeKcal!!, 1e-9)
+        assertEquals(-372.0, e.balance(2600.0)!!, 5.0)
+        assertTrue(e.missing.isEmpty())
+        assertFalse(e.isToday)
+    }
+
+    @Test
+    fun everyInputMovesTheTotal() {
+        val base = total(example())
+        assertTrue(total(example(body = body.copy(weightKg = 90.0))) > base)          // weight: basal, steps, MET
+        assertTrue(total(example(body = body.copy(heightCm = 190.0))) > base)         // height: basal, stride
+        assertTrue(total(example(body = body.copy(ageYears = 46.0))) < base)          // age: basal
+        assertTrue(total(example(body = body.copy(sex = "female"))) < base)           // sex: basal
+        assertTrue(total(example(trainingDays28 = 0)) < base)                         // sedentary: Mifflin
+        assertEquals(1800.0, EnergyModel.compose(example(trainingDays28 = 0)).bmrKcal!!, 0.1)
+        assertTrue(total(example(strapDaySteps = 12_000)) > base)                     // steps
+        assertTrue(total(example(gymSteps = 0)) > base)                               // fewer steps in the gym = more free
+        assertTrue(total(example(gymBpm = 140)) > base)                               // pulse: MET 6 above 55 % HRR
+        assertEquals(EnergyMethod.MET, EnergyModel.compose(example(gymBpm = 140)).workouts.single().method)
+        assertTrue(total(example(gymBpm = 95)) < base)                                // MET 3.5 under 35 % HRR
+        assertNotEquals(base, total(example(sport = "Running")), 1.0)                 // sport: Keytel on the pulse
+        assertEquals(EnergyMethod.HEART_RATE, EnergyModel.compose(example(sport = "Running")).workouts.single().method)
+        val claude = EnergyModel.compose(example(claude = 600.0))
+        assertEquals(EnergyMethod.CLAUDE, claude.workouts.single().method)            // Claude
+        assertTrue(claude.totalKcal!! > base)
+        assertTrue(total(example(meals = listOf(meal(p = 220.0)))) > base)            // macros: more protein, more TEF
+        assertTrue(total(example(meals = listOf(meal(kcal = 1300.0, p = 80.0, c = 140.0, f = 42.5)))) < base)   // half the portion
+    }
+
+    @Test
+    fun claudeIsKeptInsideTheSportsMetBand() {
+        val gym = EnergyModel.compose(example(claude = 2000.0)).workouts.single()
+        assertEquals(EnergyEquations.metKcal(8.0, 80.0, 70.0), gym.grossKcal, 0.01)
+        val low = EnergyModel.compose(example(claude = 50.0)).workouts.single()
+        assertEquals(EnergyEquations.metKcal(3.0, 80.0, 70.0), low.grossKcal, 0.01)
+        // Intervals on the pulse: Keytel, bounded to MET 5-11.
+        val hiit = EnergyModel.compose(example(sport = "HIIT", gymBpm = 190)).workouts.single()
+        assertEquals(EnergyMethod.HEART_RATE, hiit.method)
+        assertEquals(EnergyEquations.metKcal(11.0, 80.0, 70.0), hiit.grossKcal, 0.01)
+        assertEquals(EnergyEquations.EPOC_CAP_KCAL, hiit.epocKcal, 0.0)
+    }
+
+    @Test
+    fun stepsInsideAWorkoutAreNotFreeSteps() {
+        assertEquals(7000, EnergyModel.compose(example()).steps!!.freeSteps)
+        assertEquals(9000, EnergyModel.compose(example(gymSteps = 0)).steps!!.freeSteps)
+        // The strap counted none in the window (null): nothing to take off.
+        assertEquals(9000, EnergyModel.compose(example(gymSteps = null)).steps!!.freeSteps)
+    }
+
+    @Test
+    fun strapAndPhoneStepsCompeteAndNeverAdd() {
+        val both = EnergyModel.compose(example(strapDaySteps = 9000, phoneDaySteps = 6000)).steps!!
+        assertEquals(7000, both.freeSteps)                      // the strap's 7 000 free, not 13 000
+        assertEquals(StepsSource.STRAP, both.source)
+        val phoneWins = EnergyModel.compose(example(strapDaySteps = 9000, phoneDaySteps = 12_000)).steps!!
+        assertEquals(StepsSource.PHONE, phoneWins.source)
+        assertEquals(10_000, phoneWins.freeSteps)               // the phone's 12 000 minus the 2 000 the strap saw in the gym
+        // No strap steps in the gym: a walking window takes an assumed cadence off the phone's count, a lift takes nothing.
+        val walk = EnergyModel.windows(listOf(row("Walking", 10 * 60, 30))).single()
+        val phoneOnly = EnergyModel.compose(
+            example(strapDaySteps = null, phoneDaySteps = 8000, gymSteps = null, extraWindows = listOf(WindowInputs(walk, hr(walk, null), null, null, null))),
+        ).steps!!
+        assertEquals(StepsSource.PHONE, phoneOnly.source)
+        assertEquals(8000 - 100 * 30, phoneOnly.freeSteps)
+    }
+
+    @Test
+    fun theBasalOfAWindowIsNeverCountedTwice() {
+        // An hour of "running" at resting pulse: the window's gross is its basal, so the day gains nothing from it.
+        val quiet = EnergyModel.compose(example(sport = "Running", gymBpm = 60, gymSteps = 0))
+        val run = quiet.workouts.single()
+        assertEquals(EnergyMethod.HEART_RATE, run.method)
+        assertEquals(0.0, run.netKcal, 0.5)
+        val without = EnergyModel.compose(example(sport = "Running", gymBpm = 60, gymSteps = 0).copy(windows = emptyList()))
+        assertEquals(without.totalKcal!!, quiet.totalKcal!!, 0.5)
+    }
+
+    @Test
+    fun theSameWorkoutFromTwoSourcesCountsOnce() {
+        val strap = row("Running", 18 * 60, 60)
+        val phone = row("Running", 18 * 60 + 1, 60, source = "health-connect", kcal = 500.0)
+        val visible = WorkoutEditing.dedupCrossSource(listOf(strap, phone))
+        assertEquals(1, visible.size)
+        assertEquals(1, EnergyModel.windows(visible).size)
+    }
+
+    @Test
+    fun windowsThatStillOverlapAreTrimmed() {
+        val run = row("Running", 10 * 60, 60)
+        val bike = row("Cycling", 10 * 60 + 30, 60)
+        val ws = EnergyModel.windows(listOf(bike, run))
+        assertEquals(run.startTs, ws[0].startTs)
+        assertEquals(run.endTs, ws[0].endTs)
+        assertFalse(ws[0].trimmed)
+        assertEquals(run.endTs, ws[1].startTs)                 // the bike starts where the run ends
+        assertEquals(bike.endTs, ws[1].endTs)
+        assertTrue(ws[1].trimmed)
+        assertEquals(90L * 60, ws.sumOf { it.durationS })      // 90 minutes priced, not 120
+        // Claude's figure for the trimmed session is scaled to the part that counts.
+        val priced = EnergyModel.workoutEnergy(WindowInputs(ws[1], hr(ws[1], null), null, 400.0, null), body, 2000.0 / 86_400.0)
+        assertEquals(EnergyMethod.CLAUDE, priced.method)
+        assertEquals(200.0, priced.grossKcal, 0.01)
+    }
+
+    @Test
+    fun absentIsNotZero() {
+        // No profile: no burn at all, said so.
+        val noProfile = EnergyModel.compose(example(body = body.copy(weightKg = null)))
+        assertNull(noProfile.totalKcal)
+        assertNull(noProfile.bmrKcal)
+        assertTrue(EnergyMissing.PROFILE in noProfile.missing)
+        assertEquals(259.3, noProfile.tefKcal!!, 0.1)           // what can be known still is
+        // No steps from anywhere: the median of the last days with steps, marked; with no history, null.
+        val estimated = EnergyModel.compose(example(strapDaySteps = null, prior = listOf(200.0, 260.0, 240.0)))
+        assertEquals(StepsSource.ESTIMATED, estimated.steps!!.source)
+        assertEquals(240.0, estimated.steps!!.kcal, 0.0)
+        assertNull(estimated.steps!!.freeSteps)
+        val none = EnergyModel.compose(example(strapDaySteps = null))
+        assertNull(none.steps)
+        assertTrue(EnergyMissing.STEPS in none.missing)
+        assertEquals(total(example()) - 230.1, none.totalKcal!!, 0.2)   // not a zero in disguise: simply absent
+        // No meals: no digestion, no balance.
+        val fasting = EnergyModel.compose(example(meals = emptyList()))
+        assertNull(fasting.tefKcal)
+        assertTrue(EnergyMissing.MEALS in fasting.missing)
+        // A workout with neither pulse, nor analysis, nor an imported figure: priced at its default MET, and flagged.
+        val blind = EnergyModel.compose(example(gymBpm = null))
+        val gym = blind.workouts.single()
+        assertTrue(gym.assumed)
+        assertEquals(EnergyMethod.MET, gym.method)
+        assertEquals(EnergyEquations.metKcal(5.0, 80.0, 70.0) * 1.04, gym.grossKcal, 0.01)
+        assertTrue(EnergyMissing.WORKOUT_DATA in blind.missing)
+        // EPOC without a workout is a real zero.
+        assertEquals(0.0, EnergyModel.compose(example().copy(windows = emptyList())).epocKcal, 0.0)
+    }
+
+    @Test
+    fun anImportedWorkoutWithoutPulseKeepsItsOwnCalories() {
+        val w = EnergyModel.windows(listOf(row("Cycling", 9 * 60, 45, source = "health-connect", kcal = 420.0))).single()
+        val priced = EnergyModel.workoutEnergy(WindowInputs(w, hr(w, null), null, null, EnergyModel.externalKcal(w.row)), body, 2000.0 / 86_400.0)
+        assertEquals(EnergyMethod.EXTERNAL, priced.method)
+        assertEquals(420.0, priced.grossKcal, 0.0)
+        assertFalse(priced.assumed)
+        // The strap's own row figure is the heart-rate estimate this model replaces: never an external figure.
+        assertNull(EnergyModel.externalKcal(row("Cycling", 9 * 60, 45, kcal = 420.0)))
+    }
+
+    @Test
+    fun walkingIsPricedBySteps() {
+        val w = EnergyModel.windows(listOf(row("Hiking", 9 * 60, 120))).single()
+        val bmrRate = 2000.0 / 86_400.0
+        val hike = EnergyModel.workoutEnergy(WindowInputs(w, hr(w, 110), 12_000, null, null), body, bmrRate)
+        assertEquals(EnergyMethod.STEPS, hike.method)
+        assertEquals(EnergyEquations.stepsKcal(12_000, 80.0, 180.0), hike.netKcal, 0.01)
+        assertEquals(0.0, hike.epocKcal, 0.0)
+        val yoga = EnergyModel.workoutEnergy(
+            WindowInputs(EnergyModel.windows(listOf(row("Yoga", 9 * 60, 60))).single(), hr(w, 130), null, null, null), body, bmrRate,
+        )
+        assertEquals(EnergyEquations.metKcal(2.5, 80.0, 60.0), yoga.grossKcal, 0.01)
+        assertFalse(yoga.assumed)
+    }
+
+    @Test
+    fun epocIsHardAfterLiftingIntervalsOrLongHardCardio() {
+        val long = EnergyModel.windows(listOf(row("Running", 9 * 60, 60))).single()
+        val hard = EnergyModel.workoutEnergy(WindowInputs(long, hr(long, 160), null, null, null), body, 2000.0 / 86_400.0)
+        assertEquals(EnergyEquations.epoc(hard.netKcal, 0.12), hard.epocKcal, 1e-9)       // 60 min at 75 % HRR
+        val easy = EnergyModel.workoutEnergy(WindowInputs(long, hr(long, 120), null, null, null), body, 2000.0 / 86_400.0)
+        assertEquals(EnergyEquations.epoc(easy.netKcal, 0.07), easy.epocKcal, 1e-9)       // 47 % HRR
+    }
+
+    @Test
+    fun todayIsPricedForTheHoursGoneAndProjectedAtRest() {
+        val noon = EnergyModel.compose(example(fraction = 0.5))
+        assertTrue(noon.isToday)
+        assertEquals(2021.7 / 2, noon.basalKcal!!, 0.1)
+        assertEquals(noon.totalKcal!! + 2021.7 / 2, noon.projectedKcal!!, 0.1)
+        assertEquals(2600.0 - noon.projectedKcal!!, noon.projectedBalance(2600.0)!!, 1e-9)
+        val whole = EnergyModel.compose(example())
+        assertEquals(whole.totalKcal!!, whole.projectedKcal!!, 0.0)
+    }
+
+    @Test
+    fun trainingDaysCountDistinctDaysWithARealSession() {
+        val byDay = mapOf(
+            "2026-10-19" to EnergyModel.windows(listOf(row("Strength", 18 * 60, 70), row("Running", 8 * 60, 30))),
+            "2026-10-18" to EnergyModel.windows(listOf(row("Walking", 18 * 60, 70))),      // walking does not count
+            "2026-10-17" to EnergyModel.windows(listOf(row("HIIT", 18 * 60, 15))),         // too short
+            "2026-09-21" to EnergyModel.windows(listOf(row("Cycling", 18 * 60, 60))),      // 29 days back: outside
+            "2026-09-22" to EnergyModel.windows(listOf(row("Cycling", 18 * 60, 60))),      // 28th day: inside
+        )
+        assertEquals(2, EnergyModel.trainingDays28("2026-10-19", byDay))
+    }
+
+    @Test
+    fun sportsFallIntoTheirCategories() {
+        assertEquals(SportCategory.STRENGTH, SportCategory.of("Strength"))
+        assertEquals(SportCategory.STRENGTH, SportCategory.of("Strength Training"))   // the Hevy import
+        assertEquals(SportCategory.STRENGTH, SportCategory.of("weightlifting"))
+        assertEquals(SportCategory.INTERVAL, SportCategory.of("CrossFit"))
+        assertEquals(SportCategory.WALK, SportCategory.of("Hiking"))
+        assertEquals(SportCategory.GENTLE, SportCategory.of("Pilates"))
+        assertEquals(SportCategory.CARDIO, SportCategory.of("Boxing"))
+        assertEquals(SportCategory.OTHER, SportCategory.of("detected"))
+        assertEquals(SportCategory.OTHER, SportCategory.of("Other"))
+        assertEquals(160, SportCategory.assumedCadence("Running"))
+        assertEquals(100, SportCategory.assumedCadence("Walking"))
+        assertNull(SportCategory.assumedCadence("Cycling"))
+    }
