+package com.noop.energy
+
+import com.noop.analytics.Calories
+import com.noop.analytics.UserProfile
+import com.noop.data.HrSample
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** victor:energy — the weight-free heart-rate sums reproduce upstream's bout integral. */
+class HrIntegralTest {
+
+    private val start = 1_792_422_000L   // 2026-10-19 17:00 Madrid
+    private val end = start + 3_600L
+    private val profile = UserProfile(weightKg = 80.0, heightCm = 180.0, age = 26.0, sex = "male")
+
+    private fun stream(bpm: Int, from: Long = start, to: Long = end, stepS: Long = 1L): List<HrSample> =
+        (from..to step stepS).map { HrSample("my-whoop", it, bpm) }
+
+    @Test
+    fun anAllActiveStreamMatchesUpstreamsKeytelBout() {
+        // Every sample above resting + 30 % of the reserve: the bout is pure Keytel, no resting share.
+        val samples = stream(150)
+        val h = HrIntegral.of(samples, start, end, restingHr = 55.0, hrMax = 194.0)
+        val upstream = Calories.estimateBoutCalories(samples, profile, 194.0, 55.0).first
+        assertEquals(upstream, h.activeKcal("male", 80.0, 26.0), 0.01)
+        assertEquals(0.0, h.restS, 0.0)
+        assertEquals(3601.0, h.activeS, 0.0)   // 3600 one-second gaps + the last sample's own second
+        assertEquals(150.0, h.meanBpm!!, 0.0)
+        assertEquals((150.0 - 55.0) / (194.0 - 55.0), h.meanHrr()!!, 1e-9)
+        assertEquals(61, h.coveredMin)
+        // Without a resting HR the base (fitness-blind) Keytel model, as upstream.
+        val base = HrIntegral.of(samples, start, end, restingHr = null, hrMax = 194.0)
+        assertEquals(Calories.estimateBoutCalories(samples, profile, 194.0, null).first, base.activeKcal("male", 80.0, 26.0), 0.01)
+    }
+
+    @Test
+    fun aSparseStreamCarriesEachSampleToTheNextUpToTheMergeGap() {
+        val sparse = stream(150, stepS = 30L)           // one sample every 30 s
+        val h = HrIntegral.of(sparse, start, end, 55.0, 194.0)
+        assertEquals(Calories.estimateBoutCalories(sparse, profile, 194.0, 55.0).first, h.activeKcal("male", 80.0, 26.0), 0.01)
+        val gappy = listOf(HrSample("my-whoop", start, 150), HrSample("my-whoop", start + 1000, 150))
+        assertEquals(150.0 + 1.0, HrIntegral.of(gappy, start, end, 55.0, 194.0).activeS, 0.0)   // capped at 150 s
+    }
+
+    @Test
+    fun restingSecondsAreCountedAtTheDaysBasalRate() {
+        val h = HrIntegral.of(stream(70), start, end, 55.0, 194.0)   // under 55 + 0.3·139 = 96.7
+        assertEquals(0.0, h.activeS, 0.0)
+        assertEquals(3601.0, h.restS, 0.0)
+        val bmrRate = 2000.0 / 86_400.0
+        assertEquals(bmrRate * 3601.0, h.grossKcal("male", 80.0, 26.0, bmrRate), 1e-9)
+    }
+
+    @Test
+    fun samplesOutsideTheWindowNeverCount() {
+        val inside = stream(150)
+        val around = stream(180, start - 7200, start - 1) + inside + stream(180, end + 1, end + 7200)
+        assertEquals(HrIntegral.of(inside, start, end, 55.0, 194.0), HrIntegral.of(around, start, end, 55.0, 194.0))
+        val empty = HrIntegral.of(emptyList(), start, end, 55.0, 194.0)
+        assertTrue(empty.isEmpty)
+        assertNull(empty.meanBpm)
+        assertEquals(0.0, empty.grossKcal("male", 80.0, 26.0, 0.02), 0.0)
+    }
+
+    @Test
+    fun weightRepricesACachedIntegralWithoutTheSamples() {
+        val h = HrIntegral.of(stream(150), start, end, 55.0, 194.0)
+        val heavier = HrIntegral.of(stream(150), start, end, 55.0, 194.0)
+        assertEquals(h, heavier)   // the sums do not know the weight …
+        assertTrue(h.activeKcal("male", 90.0, 26.0) > h.activeKcal("male", 80.0, 26.0))   // … the price does
+        assertEquals(
+            Calories.estimateBoutCalories(stream(150), profile.copy(weightKg = 90.0), 194.0, 55.0).first,
+            h.activeKcal("male", 90.0, 26.0), 0.01,
+        )
+    }
+}
