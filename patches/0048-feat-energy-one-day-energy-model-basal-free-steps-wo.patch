+package com.noop.energy
+
+import android.content.Context
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.File
+
+/**
+ * victor:energy — what a day's RAW streams reduce to, kept so a year of history never re-reads its heart
+ * rate and step samples: per workout window the weight-free heart-rate sums ([HrIntegral]) and the
+ * strap's step ticks, plus the day's ticks. Everything cheap (weight, basal, Claude's figures, meals)
+ * is applied at read time, so a weigh-in or a meal shows at once.
+ *
+ * [setupKey] names what the reduction was built from that is NOT a stream: the window set and the
+ * heart-rate parameters. [hrKey] and [stepsKey] are the stream fingerprints, kept apart so a live
+ * heart-rate stream re-reduces the windows (small) without re-reading the day's step samples (large). A
+ * recent day is stale when any moved; an old day only when [setupKey] moved (its streams are not probed
+ * again), or when [EnergyModel.VERSION] changed, which empties the whole cache.
+ */
+data class WindowRaw(
+    val startTs: Long,
+    val endTs: Long,
+    val sport: String,
+    val hr: HrIntegral,
+    /** Raw strap ticks inside the window (uncalibrated); null when the strap has no samples there. */
+    val strapTicks: Int?,
+)
+
+data class DayRaw(
+    val day: String,
+    val setupKey: String,
+    val hrKey: String,
+    val stepsKey: String,
+    /** Raw strap ticks over the logical day (uncalibrated); null when the strap has no samples that day. */
+    val strapTicks: Int?,
+    val windows: List<WindowRaw>,
+) {
+    fun window(startTs: Long, endTs: Long, sport: String): WindowRaw? =
+        windows.firstOrNull { it.startTs == startTs && it.endTs == endTs && it.sport == sport }
+}
+
+/** JSON codec for the cache. Pure, so the round trip is JVM-testable. Unknown fields are ignored. */
+internal object EnergyCacheCodec {
+
+    fun encode(days: Map<String, DayRaw>): String {
+        val o = JSONObject()
+        for ((day, raw) in days.toSortedMap()) {
+            val d = JSONObject()
+                .put("setup", raw.setupKey)
+                .put("hr_key", raw.hrKey)
+                .put("steps_key", raw.stepsKey)
+            raw.strapTicks?.let { d.put("ticks", it) }
+            val ws = JSONArray()
+            for (w in raw.windows) {
+                val h = w.hr
+                val wo = JSONObject()
+                    .put("start", w.startTs)
+                    .put("end", w.endTs)
+                    .put("sport", w.sport)
+                    .put("samples", h.samples)
+                    .put("covered_min", h.coveredMin)
+                    .put("active_s", h.activeS)
+                    .put("active_bpm_s", h.activeBpmS)
+                    .put("rest_s", h.restS)
+                    .put("hr_max", h.hrMax)
+                h.meanBpm?.let { wo.put("mean_bpm", it) }
+                h.restingHr?.let { wo.put("resting_hr", it) }
+                w.strapTicks?.let { wo.put("ticks", it) }
+                ws.put(wo)
+            }
+            d.put("windows", ws)
+            o.put(day, d)
+        }
+        return JSONObject().put("version", EnergyModel.VERSION).put("days", o).toString()
+    }
+
+    /** Throws on text that is not a cache document. A document of another model version decodes EMPTY. */
+    fun decode(text: String): Map<String, DayRaw> {
+        val root = JSONObject(text)
+        if (root.optInt("version", -1) != EnergyModel.VERSION) return emptyMap()
+        val days = root.getJSONObject("days")
+        val out = LinkedHashMap<String, DayRaw>()
+        for (day in days.keys()) {
+            val d = days.optJSONObject(day) ?: continue
+            val arr = d.optJSONArray("windows") ?: JSONArray()
+            val windows = (0 until arr.length()).mapNotNull { i ->
+                val wo = arr.optJSONObject(i) ?: return@mapNotNull null
+                WindowRaw(
+                    startTs = wo.optLong("start"),
+                    endTs = wo.optLong("end"),
+                    sport = wo.optString("sport"),
+                    hr = HrIntegral(
+                        samples = wo.optInt("samples"),
+                        coveredMin = wo.optInt("covered_min"),
+                        meanBpm = optDouble(wo, "mean_bpm"),
+                        activeS = wo.optDouble("active_s", 0.0),
+                        activeBpmS = wo.optDouble("active_bpm_s", 0.0),
+                        restS = wo.optDouble("rest_s", 0.0),
+                        restingHr = optDouble(wo, "resting_hr"),
+                        hrMax = wo.optDouble("hr_max", HrIntegral.EMPTY_HRMAX),
+                    ),
+                    strapTicks = if (wo.has("ticks")) wo.optInt("ticks") else null,
+                )
+            }
+            out[day] = DayRaw(
+                day = day,
+                setupKey = d.optString("setup"),
+                hrKey = d.optString("hr_key"),
+                stepsKey = d.optString("steps_key"),
+                strapTicks = if (d.has("ticks")) d.optInt("ticks") else null,
+                windows = windows,
+            )
+        }
+        return out
+    }
+
+    private fun optDouble(o: JSONObject, key: String): Double? =
+        if (o.has(key)) o.optDouble(key).takeIf { it.isFinite() } else null
+}
+
+/**
+ * victor:energy — the cache on disk: `files/energy/days.json`. App-private, never in the Room DB. The
+ * caller ([DayEnergyModel]) serialises access; a corrupt file is set aside and the cache starts empty.
+ */
+internal object EnergyCacheFile {
+
+    private const val DIR = "energy"
+    private const val FILE = "days.json"
+
+    fun read(ctx: Context): MutableMap<String, DayRaw> {
+        val dir = File(ctx.applicationContext.filesDir, DIR)
+        val file = File(dir, FILE)
+        if (!file.exists()) return HashMap()
+        return runCatching { HashMap(EnergyCacheCodec.decode(file.readText())) }.getOrElse {
+            runCatching { file.renameTo(File(dir, "$FILE.corrupt-${System.currentTimeMillis()}")) }
+            HashMap()
+        }
+    }
+
+    /** Write-then-rename so a crash mid-write never leaves half a file. */
+    fun write(ctx: Context, days: Map<String, DayRaw>) {
+        val dir = File(ctx.applicationContext.filesDir, DIR).apply { mkdirs() }
+        val text = EnergyCacheCodec.encode(days)
+        val tmp = File(dir, "$FILE.tmp")
+        tmp.writeText(text)
+        if (!tmp.renameTo(File(dir, FILE))) {
+            File(dir, FILE).writeText(text)
+            tmp.delete()
+        }
+    }
+
+    fun delete(ctx: Context) {
+        runCatching { File(File(ctx.applicationContext.filesDir, DIR), FILE).delete() }
+    }
+}
diff --git a/android/app/src/main/java/com/noop/energy/EnergyDays.kt b/android/app/src/main/java/com/noop/energy/EnergyDays.kt
new file mode 100644
index 000000000..0180467c2
--- /dev/null
+++ b/android/app/src/main/java/com/noop/energy/EnergyDays.kt
@@ -0,0 +1,60 @@
+package com.noop.energy
+
+import com.noop.food.FoodDays
+import java.time.LocalDate
+import java.time.LocalTime
+import java.time.ZoneId
+import java.time.ZonedDateTime
+
+/**
+ * victor:energy — the ONE day the energy model counts in: the logical day from 04:00 to 04:00 local
+ * (the rule upstream's Today and the food log already use, [FoodDays.mealDayOf]). Bounds are resolved in
+ * the zone, so the day the clocks change is 23 or 25 hours long and its elapsed share is honest.
+ */
+object EnergyDays {
+
+    private val ROLLOVER: LocalTime = LocalTime.of(4, 0)
+
+    /** The logical day ("yyyy-MM-dd") an epoch second belongs to. */
+    fun dayOf(epochS: Long, zone: ZoneId = ZoneId.systemDefault()): String = FoodDays.mealDayOf(epochS * 1000L, zone)
+
+    fun startOf(day: String, zone: ZoneId = ZoneId.systemDefault()): ZonedDateTime =
+        LocalDate.parse(day).atTime(ROLLOVER).atZone(zone)
+
+    /** Exclusive end: the next day's 04:00. */
+    fun endOf(day: String, zone: ZoneId = ZoneId.systemDefault()): ZonedDateTime =
+        LocalDate.parse(day).plusDays(1).atTime(ROLLOVER).atZone(zone)
+
+    fun startEpochS(day: String, zone: ZoneId = ZoneId.systemDefault()): Long = startOf(day, zone).toEpochSecond()
+
+    fun endEpochS(day: String, zone: ZoneId = ZoneId.systemDefault()): Long = endOf(day, zone).toEpochSecond()
+
+    /** Real length of the day in seconds: 86 400, or 82 800 / 90 000 around a clock change. */
+    fun durationS(day: String, zone: ZoneId = ZoneId.systemDefault()): Long = endEpochS(day, zone) - startEpochS(day, zone)
+
+    /** Share of [day] elapsed at [nowEpochS]: 0 before it starts, 1 once it is over. */
+    fun fraction(day: String, nowEpochS: Long, zone: ZoneId = ZoneId.systemDefault()): Double {
+        val start = startEpochS(day, zone)
+        val length = endEpochS(day, zone) - start
+        if (length <= 0L) return 1.0
+        return ((nowEpochS - start).toDouble() / length.toDouble()).coerceIn(0.0, 1.0)
+    }
+
+    /** Whether [day] is still running at [nowEpochS]. */
+    fun isOpen(day: String, nowEpochS: Long, zone: ZoneId = ZoneId.systemDefault()): Boolean =
+        nowEpochS < endEpochS(day, zone)
+
+    fun plusDays(day: String, n: Long): String = LocalDate.parse(day).plusDays(n).toString()
+
+    /** Every day from [from] to [to], inclusive, in order. */
+    fun days(from: String, to: String): List<String> {
+        val out = ArrayList<String>()
+        var d = LocalDate.parse(from)
+        val last = LocalDate.parse(to)
+        while (!d.isAfter(last)) {
+            out += d.toString()
+            d = d.plusDays(1)
+        }
+        return out
+    }
+}
diff --git a/android/app/src/main/java/com/noop/energy/EnergyEquations.kt b/android/app/src/main/java/com/noop/energy/EnergyEquations.kt
new file mode 100644
index 000000000..66f2a4ad7
--- /dev/null
+++ b/android/app/src/main/java/com/noop/energy/EnergyEquations.kt
@@ -0,0 +1,103 @@
+package com.noop.energy
+
+import com.noop.food.FoodItem
+
+/**
+ * victor:energy — the equations of the day-energy model, each a pure function of its inputs. Nothing
+ * here reads a store; the loader ([DayEnergyModel]) gathers the inputs and [EnergyModel] composes them.
+ * Coefficients and sources: `CONTEXT/modelo-energia.md`.
+ */
+object EnergyEquations {
+
+    /** Ten Haaf & Weijs 2014 (recreational athletes), kcal/day. [sexTerm] 1 male, 0 female, 0.5 non-binary. */
+    fun tenHaaf(weightKg: Double, heightCm: Double, ageYears: Double, sexTerm: Double): Double =
+        11.936 * weightKg + 587.73 * (heightCm / 100.0) - 8.130 * ageYears + 191.03 * sexTerm + 29.28
+
+    /** Mifflin–St Jeor 1990 (general population), kcal/day. */
+    fun mifflin(weightKg: Double, heightCm: Double, ageYears: Double, sexTerm: Double): Double {
+        val constant = when {
+            sexTerm >= 1.0 -> 5.0
+            sexTerm <= 0.0 -> -161.0
+            else -> -78.0
+        }
+        return 10.0 * weightKg + 6.25 * heightCm - 5.0 * ageYears + constant
+    }
+
+    fun sexTerm(sex: String): Double = when (sex.lowercase()) {
+        "male" -> 1.0
+        "female" -> 0.0
+        else -> 0.5
+    }
+
+    /**
+     * How far the basal equation leans from Mifflin (0: one training day a week or fewer) to Ten Haaf
+     * (1: three or more), from the distinct training days in the 28 days ending on the day.
+     */
+    fun basalBlend(trainingDays28: Int): Double = ((trainingDays28 / 4.0 - 1.0) / 2.0).coerceIn(0.0, 1.0)
+
+    /** Whole-day resting energy (kcal/day), or null when weight, height or age is missing. */
+    fun bmr(weightKg: Double?, heightCm: Double?, ageYears: Double?, sex: String, trainingDays28: Int): Double? {
+        if (weightKg == null || heightCm == null || ageYears == null) return null
+        if (weightKg <= 0 || heightCm <= 0 || ageYears <= 0) return null
+        val s = sexTerm(sex)
+        val m = mifflin(weightKg, heightCm, ageYears, s)
+        val t = tenHaaf(weightKg, heightCm, ageYears, s)
+        return (m + basalBlend(trainingDays28) * (t - m)).takeIf { it > 0 }
+    }
+
+    /**
+     * The weight that stands for a day: an exponential average (α 0.1, ≈10 weigh-ins of memory) of the
+     * scale readings up to and including that day, oldest first; null with no reading by then.
+     */
+    fun weightOn(day: String, readings: List<Pair<String, Double>>, alpha: Double = 0.1): Double? {
+        var ema: Double? = null
+        for ((d, kg) in readings.sortedBy { it.first }) {
+            if (d > day) break
+            if (!kg.isFinite() || kg <= 0) continue
+            ema = ema?.let { it + alpha * (kg - it) } ?: kg
+        }
+        return ema
+    }
+
+    /** Net walking energy: 0.55 kcal per kg per km, stride 0.415 × height. */
+    fun stepsKcal(steps: Int, weightKg: Double, heightCm: Double): Double =
+        0.55 * weightKg * stepsKm(steps, heightCm)
+
+    fun stepsKm(steps: Int, heightCm: Double): Double = steps.coerceAtLeast(0) * 0.415 * (heightCm / 100.0) / 1000.0
+
+    /** Gross energy of [minutes] at [met] for [weightKg]: MET · 3.5 · kg / 200 per minute. */
+    fun metKcal(met: Double, weightKg: Double, minutes: Double): Double = met * 3.5 * weightKg / 200.0 * minutes
+
+    /** Anaerobic share added on the MET route of lifting and intervals. */
+    const val ANAEROBIC_SHARE = 0.04
+
+    /** Post-exercise oxygen consumption: a share of the net, never above [EPOC_CAP_KCAL]. */
+    fun epoc(netKcal: Double, share: Double): Double = (share * netKcal.coerceAtLeast(0.0)).coerceAtMost(EPOC_CAP_KCAL)
+
+    const val EPOC_CAP_KCAL = 100.0
+    const val EPOC_HARD = 0.12
+    const val EPOC_MODERATE = 0.07
+
+    /**
+     * Thermic effect of one food: 25 % of protein energy, 7.5 % of carbohydrate, 2 % of fat; a food with
+     * calories but no macros counts 10 %. Items hold what was EATEN (the portion already applied).
+     */
+    fun tefOf(item: FoodItem): Double {
+        val p = item.proteinG.coerceAtLeast(0.0)
+        val c = item.carbsG.coerceAtLeast(0.0)
+        val f = item.fatG.coerceAtLeast(0.0)
+        if (p == 0.0 && c == 0.0 && f == 0.0) return 0.10 * item.kcal.coerceAtLeast(0.0)
+        return 0.25 * 4.0 * p + 0.075 * 4.0 * c + 0.02 * 9.0 * f
+    }
+
+    /** The day's thermic effect over every food of its meals; null (not 0) when nothing was logged. */
+    fun tef(items: List<FoodItem>): Double? = if (items.isEmpty()) null else items.sumOf { tefOf(it) }
+
+    /** Median of a list, or null when empty. */
+    fun median(values: List<Double>): Double? {
+        if (values.isEmpty()) return null
+        val s = values.sorted()
+        val mid = s.size / 2
+        return if (s.size % 2 == 0) (s[mid - 1] + s[mid]) / 2.0 else s[mid]
+    }
+}
diff --git a/android/app/src/main/java/com/noop/energy/EnergyModel.kt b/android/app/src/main/java/com/noop/energy/EnergyModel.kt
new file mode 100644
index 000000000..1e2ce0e42
--- /dev/null
+++ b/android/app/src/main/java/com/noop/energy/EnergyModel.kt
@@ -0,0 +1,384 @@
+package com.noop.energy
+
+import com.noop.data.WorkoutRow
+import com.noop.food.FoodEntry
+import com.noop.ui.WorkoutEditing
+import com.noop.ui.WorkoutSource
+import kotlin.math.max
+import kotlin.math.min
+
+/*
+ * victor:energy — ONE day-energy model every screen reads from, so the Food balance, Today's calories,
+ * the Workouts list, the week and the coach can never disagree:
+ *
+ *     burned = basal (24 h) + free steps + workouts (net) + post-exercise (EPOC) + digestion (TEF)
+ *     active = free steps + workouts (net) + EPOC
+ *
+ * Each component comes from one source and nothing is counted twice: steps inside a workout window are
+ * not free steps, the basal of a window is subtracted from its gross, the strap's and the phone's step
+ * counts compete (the larger wins) and never add, heart rate outside a window earns nothing. A missing
+ * input is null, never 0 — only EPOC without a workout is a real zero. The science and the audit behind
+ * it: CONTEXT/modelo-energia.md.
+ */
+
+/** The natural key of a workout row (its deviceId aside): what pairs a row with its energy. */
+data class WorkoutKey(val startTs: Long, val sport: String) {
+    companion object {
+        fun of(row: WorkoutRow) = WorkoutKey(row.startTs, row.sport)
+    }
+}
+
+/** Which rule priced a workout window. */
+enum class EnergyMethod {
+    /** Keytel on the strap's heart rate. */
+    HEART_RATE,
+    /** Claude's estimate from the exercises, within the sport's MET band. */
+    CLAUDE,
+    /** A MET for the sport (and, in lifting, the mean %HRR). */
+    MET,
+    /** The calories the import carried (Samsung Health, Strava, a file). */
+    EXTERNAL,
+    /** Strap steps in the window (walking). */
+    STEPS,
+}
+
+/** What a day lacks; the screens say it rather than show a silent zero. */
+enum class EnergyMissing { PROFILE, STEPS, MEALS, WORKOUT_DATA }
+
+/** Where a day's free steps came from. */
+enum class StepsSource { STRAP, PHONE, ESTIMATED }
+
+/**
+ * A workout window after the cross-source dedup and the overlap trim: [startTs]..[endTs] is the part of
+ * [row] that counts, so two windows never share a second.
+ */
+data class Window(val row: WorkoutRow, val startTs: Long, val endTs: Long) {
+    val key: WorkoutKey get() = WorkoutKey.of(row)
+    val durationS: Long get() = (endTs - startTs).coerceAtLeast(0L)
+    val originalDurationS: Long get() = (row.endTs - row.startTs).coerceAtLeast(0L)
+    val trimmed: Boolean get() = startTs != row.startTs || endTs != row.endTs
+    val category: SportCategory get() = SportCategory.of(row.sport)
+}
+
+/** One window with everything the loader resolved for it. */
+data class WindowInputs(
+    val window: Window,
+    val hr: HrIntegral,
+    /** Strap steps inside the window (calibrated); null when the strap has no samples there. */
+    val strapSteps: Int?,
+    /** The paired exercise-log session's Claude estimate (gross kcal) for the whole row, if any. */
+    val claudeKcal: Double?,
+    /** The row's own kcal when it is an import (never the strap's heart-rate figure). */
+    val externalKcal: Double?,
+)
+
+data class BodyInputs(
+    val sex: String,
+    /** The day's weight: the scale's exponential average, else the profile's; null when neither is set. */
+    val weightKg: Double?,
+    val heightCm: Double?,
+    val ageYears: Double?,
+)
+
+/** Figures other estimators give for the same day. Shown for comparison; never part of the total. */
+data class EnergyDiagnostics(
+    /** Upstream's strap estimate (`DailyMetric.activeKcalEst`: resting + active over the worn hours). */
+    val strapTotalKcal: Double? = null,
+    /** The phone's active calories (Samsung Health / Apple via Health Connect). */
+    val phoneActiveKcal: Double? = null,
+    /** The phone's resting calories (total − active). */
+    val phoneBasalKcal: Double? = null,
+)
+
+data class DayInputs(
+    val day: String,
+    /** Elapsed share of the logical day: 1.0 for a past day. */
+    val fraction: Double,
+    val body: BodyInputs,
+    /** Distinct training days (cardio / lifting / intervals ≥ 20 min) in the 28 days ending on [day]. */
+    val trainingDays28: Int,
+    /** Strap steps in the logical day (calibrated); null when the strap has no samples that day. */
+    val strapDaySteps: Int?,
+    /** The phone's step count for the calendar day; null when it has none. */
+    val phoneDaySteps: Int?,
+    val windows: List<WindowInputs>,
+    /** The meals logged on the day. Empty = nothing logged. */
+    val meals: List<FoodEntry>,
+    /** The free-steps kcal of the previous days that had steps (up to 14), for the estimate when the day has none. */
+    val priorStepsKcal: List<Double> = emptyList(),
+    val diagnostics: EnergyDiagnostics = EnergyDiagnostics(),
+)
+
+data class WorkoutEnergy(
+    val key: WorkoutKey,
+    val sport: String,
+    val category: SportCategory,
+    val source: String,
+    val startTs: Long,
+    val endTs: Long,
+    val durationS: Long,
+    /** What the list shows: the whole cost of the window, basal included. */
+    val grossKcal: Double,
+    /** What the day adds: gross minus the basal of the window. */
+    val netKcal: Double,
+    val epocKcal: Double,
+    val method: EnergyMethod,
+    /** Share of the window's minutes with strap heart rate. */
+    val coverage: Double,
+    val meanBpm: Double?,
+    val meanHrr: Double?,
+    val trimmed: Boolean,
+    /** The window had no heart rate, no analysis and no imported figure: priced at its sport's default MET. */
+    val assumed: Boolean,
+)
+
+data class StepsEnergy(
+    val freeSteps: Int?,
+    val source: StepsSource,
+    val kcal: Double,
+    val strapDaySteps: Int?,
+    val phoneDaySteps: Int?,
+    /** Steps inside workout windows, taken off the day's count (strap-counted, else assumed by cadence). */
+    val inWorkoutSteps: Int,
+)
+
+/** One day's energy out, by component. Null components are unknown, not zero. */
+data class DayEnergy(
+    val day: String,
+    val fraction: Double,
+    /** Whole-day resting energy (kcal/day). */
+    val bmrKcal: Double?,
+    /** Resting energy for the elapsed share of the day. */
+    val basalKcal: Double?,
+    val weightKg: Double?,
+    /** 0 = Mifflin–St Jeor, 1 = Ten Haaf. */
+    val basalBlend: Double,
+    val steps: StepsEnergy?,
+    val workouts: List<WorkoutEnergy>,
+    val workoutsNetKcal: Double,
+    val epocKcal: Double,
+    val tefKcal: Double?,
+    /** Burned so far today, or the whole day for a past day; null without a profile. */
+    val totalKcal: Double?,
+    /** Steps + workouts + EPOC. */
+    val activeKcal: Double?,
+    /** Where today closes if nothing more happens: total plus the basal of the hours left. */
+    val projectedKcal: Double?,
+    val missing: Set<EnergyMissing>,
+    val diagnostics: EnergyDiagnostics,
+) {
+    val isToday: Boolean get() = fraction < 1.0
+
+    /** Eaten minus burned so far; null when the burn is unknown. */
+    fun balance(intakeKcal: Double): Double? = totalKcal?.let { intakeKcal - it }
+
+    /** Eaten minus the end-of-day burn. */
+    fun projectedBalance(intakeKcal: Double): Double? = projectedKcal?.let { intakeKcal - it }
+}
+
+/** victor:energy — the pure composition. The loader ([DayEnergyModel]) feeds it; tests drive it directly. */
+object EnergyModel {
+
+    /** Bump when a rule changes so cached intermediates are rebuilt; the cache stores it. */
+    const val VERSION = 1
+
+    /** A window shorter than this is not a training day for the basal blend. */
+    const val TRAINING_DAY_MIN_S = 20L * 60L
+
+    /** Strap coverage a cardio / interval window needs for its heart rate to price it. */
+    const val HR_COVERAGE = 0.70
+
+    /** Strap coverage a lifting window needs for its mean %HRR to choose the MET. */
+    const val HR_COVERAGE_STRENGTH = 0.50
+
+    /**
+     * The windows of a deduplicated row list, in time order, with any overlap that survived the dedup cut
+     * off the later row, so no second is priced twice. A row wholly inside an earlier one keeps a
+     * zero-length window (it is listed, it adds nothing).
+     */
+    fun windows(rows: List<WorkoutRow>): List<Window> {
+        val sorted = rows.sortedWith(compareBy<WorkoutRow> { it.startTs }.thenByDescending { it.endTs })
+        val out = ArrayList<Window>(sorted.size)
+        var cursor = Long.MIN_VALUE
+        for (r in sorted) {
+            val s = max(r.startTs, cursor)
+            val e = max(r.endTs, s)
+            out += Window(r, s, e)
+            cursor = max(cursor, e)
+        }
+        return out
+    }
+
+    /** The row's own kcal when it is an import; the strap's rows carry a heart-rate figure this model replaces. */
+    fun externalKcal(row: WorkoutRow): Double? {
+        val kcal = row.energyKcal?.takeIf { it.isFinite() && it > 0 } ?: return null
+        return when (WorkoutEditing.classify(row.source)) {
+            WorkoutSource.APPLE, WorkoutSource.LIFTING, WorkoutSource.ACTIVITY_FILE -> kcal
+            else -> null
+        }
+    }
+
+    /** Distinct days in the 28 ending on [day] with a cardio / lifting / interval window of 20 min or more. */
+    fun trainingDays28(day: String, windowsByDay: Map<String, List<Window>>): Int {
+        val first = EnergyDays.plusDays(day, -27)
+        return windowsByDay.count { (d, ws) ->
+            d in first..day && ws.any { it.category.trainsForBasal && it.durationS >= TRAINING_DAY_MIN_S }
+        }
+    }
+
+    /** Price one window. [bmrRatePerS] is the day's resting rate; the body must be complete. */
+    fun workoutEnergy(w: WindowInputs, body: BodyInputs, bmrRatePerS: Double): WorkoutEnergy {
+        val weight = requireNotNull(body.weightKg)
+        val height = requireNotNull(body.heightCm)
+        val age = requireNotNull(body.ageYears)
+        val win = w.window
+        val durS = win.durationS
+        val durMin = durS / 60.0
+        val cat = win.category
+        val coverage = if (durMin <= 0.0) 0.0 else min(1.0, w.hr.coveredMin / durMin)
+        val hrr = w.hr.meanHrr()
+        val basalWindow = bmrRatePerS * durS
+        fun met(m: Double) = EnergyEquations.metKcal(m, weight, durMin)
+        fun band(x: Double, lo: Double, hi: Double) = x.coerceIn(met(lo), met(hi))
+        val claude = w.claudeKcal?.takeIf { it.isFinite() && it > 0 }?.let {
+            // A trimmed window keeps its share of the session's estimate.
+            if (win.trimmed && win.originalDurationS > 0) it * durS.toDouble() / win.originalDurationS else it
+        }
+        val external = w.externalKcal?.takeIf { it.isFinite() && it > 0 }
+        var assumed = false
+        val anaerobic = 1.0 + EnergyEquations.ANAEROBIC_SHARE
+        val (gross, method) = when (cat) {
+            SportCategory.STRENGTH -> when {
+                claude != null -> band(claude, 3.0, 8.0) to EnergyMethod.CLAUDE
+                coverage >= HR_COVERAGE_STRENGTH && hrr != null ->
+                    met(if (hrr < 0.35) 3.5 else if (hrr <= 0.55) 5.0 else 6.0) * anaerobic to EnergyMethod.MET
+                external != null -> external to EnergyMethod.EXTERNAL
+                else -> { assumed = true; met(5.0) * anaerobic to EnergyMethod.MET }
+            }
+            SportCategory.INTERVAL -> when {
+                coverage >= HR_COVERAGE -> band(w.hr.grossKcal(body.sex, weight, age, bmrRatePerS), 5.0, 11.0) to EnergyMethod.HEART_RATE
+                claude != null -> band(claude, 5.0, 11.0) to EnergyMethod.CLAUDE
+                external != null -> external to EnergyMethod.EXTERNAL
+                else -> { assumed = true; met(7.0) * anaerobic to EnergyMethod.MET }
+            }
+            SportCategory.CARDIO, SportCategory.OTHER -> when {
+                coverage >= HR_COVERAGE -> w.hr.grossKcal(body.sex, weight, age, bmrRatePerS) to EnergyMethod.HEART_RATE
+                claude != null -> band(claude, 3.0, 12.0) to EnergyMethod.CLAUDE
+                external != null -> external to EnergyMethod.EXTERNAL
+                else -> { assumed = true; met(if (cat == SportCategory.CARDIO) 6.0 else 4.0) to EnergyMethod.MET }
+            }
+            SportCategory.WALK -> when {
+                w.strapSteps != null && w.strapSteps > 0 ->
+                    EnergyEquations.stepsKcal(w.strapSteps, weight, height) + basalWindow to EnergyMethod.STEPS
+                claude != null -> band(claude, 2.0, 6.0) to EnergyMethod.CLAUDE
+                external != null -> external to EnergyMethod.EXTERNAL
+                else -> { assumed = true; met(3.5) to EnergyMethod.MET }
+            }
+            SportCategory.GENTLE -> when {
+                claude != null -> band(claude, 1.5, 4.0) to EnergyMethod.CLAUDE
+                external != null -> external to EnergyMethod.EXTERNAL
+                else -> met(2.5) to EnergyMethod.MET
+            }
+        }
+        val net = (gross - basalWindow).coerceAtLeast(0.0)
+        val epocShare = when (cat) {
+            SportCategory.STRENGTH, SportCategory.INTERVAL -> EnergyEquations.EPOC_HARD
+            SportCategory.CARDIO, SportCategory.OTHER ->
+                if (durMin >= 50.0 && (hrr ?: 0.0) >= 0.70) EnergyEquations.EPOC_HARD else EnergyEquations.EPOC_MODERATE
+            SportCategory.WALK, SportCategory.GENTLE -> 0.0
+        }
+        return WorkoutEnergy(
+            key = win.key,
+            sport = win.row.sport,
+            category = cat,
+            source = win.row.source,
+            startTs = win.startTs,
+            endTs = win.endTs,
+            durationS = durS,
+            grossKcal = gross,
+            netKcal = net,
+            epocKcal = EnergyEquations.epoc(net, epocShare),
+            method = method,
+            coverage = coverage,
+            meanBpm = w.hr.meanBpm,
+            meanHrr = hrr,
+            trimmed = win.trimmed,
+            assumed = assumed,
+        )
+    }
+
+    /** Steps the phone counted inside a window: the strap's if it has them, else the sport's cadence, else none. */
+    fun phoneStepsInWindow(w: WindowInputs): Int {
+        w.strapSteps?.let { return it }
+        val cadence = SportCategory.assumedCadence(w.window.row.sport) ?: return 0
+        return (cadence * w.window.durationS / 60.0).toInt()
+    }
+
+    fun compose(inputs: DayInputs): DayEnergy {
+        val body = inputs.body
+        val fraction = inputs.fraction.coerceIn(0.0, 1.0)
+        val missing = LinkedHashSet<EnergyMissing>()
+        val blend = EnergyEquations.basalBlend(inputs.trainingDays28)
+        val bmr = EnergyEquations.bmr(body.weightKg, body.heightCm, body.ageYears, body.sex, inputs.trainingDays28)
+        if (bmr == null) missing += EnergyMissing.PROFILE
+        val bmrRate = bmr?.div(86_400.0)
+
+        val workouts = if (bmrRate != null) inputs.windows.map { workoutEnergy(it, body, bmrRate) } else emptyList()
+        if (workouts.any { it.assumed }) missing += EnergyMissing.WORKOUT_DATA
+        val workoutsNet = workouts.sumOf { it.netKcal }
+        val epoc = workouts.sumOf { it.epocKcal }
+
+        val strapInWindows = inputs.windows.sumOf { it.strapSteps ?: 0 }
+        val phoneInWindows = inputs.windows.sumOf { phoneStepsInWindow(it) }
+        val strapFree = inputs.strapDaySteps?.let { (it - strapInWindows).coerceAtLeast(0) }
+        val phoneFree = inputs.phoneDaySteps?.let { (it - phoneInWindows).coerceAtLeast(0) }
+        val steps: StepsEnergy? = when {
+            bmrRate == null -> null
+            strapFree != null || phoneFree != null -> {
+                val (free, source) = if (strapFree != null && (phoneFree == null || strapFree >= phoneFree)) {
+                    strapFree to StepsSource.STRAP
+                } else {
+                    phoneFree!! to StepsSource.PHONE
+                }
+                StepsEnergy(
+                    freeSteps = free,
+                    source = source,
+                    kcal = EnergyEquations.stepsKcal(free, body.weightKg!!, body.heightCm!!),
+                    strapDaySteps = inputs.strapDaySteps,
+                    phoneDaySteps = inputs.phoneDaySteps,
+                    inWorkoutSteps = if (source == StepsSource.STRAP) strapInWindows else phoneInWindows,
+                )
+            }
+            else -> EnergyEquations.median(inputs.priorStepsKcal)?.let {
+                StepsEnergy(null, StepsSource.ESTIMATED, it, null, null, 0)
+            }
+        }
+        if (steps == null && bmrRate != null) missing += EnergyMissing.STEPS
+
+        val tef = EnergyEquations.tef(inputs.meals.flatMap { it.items })
+        if (tef == null) missing += EnergyMissing.MEALS
+
+        val basal = bmr?.times(fraction)
+        val active = if (bmrRate == null) null else (steps?.kcal ?: 0.0) + workoutsNet + epoc
+        val total = if (basal == null || active == null) null else basal + active + (tef ?: 0.0)
+        val projected = if (total == null || bmr == null) total else total + bmr * (1.0 - fraction)
+        return DayEnergy(
+            day = inputs.day,
+            fraction = fraction,
+            bmrKcal = bmr,
+            basalKcal = basal,
+            weightKg = body.weightKg,
+            basalBlend = blend,
+            steps = steps,
+            workouts = workouts,
+            workoutsNetKcal = workoutsNet,
+            epocKcal = epoc,
+            tefKcal = tef,
+            totalKcal = total,
+            activeKcal = active,
+            projectedKcal = projected,
+            missing = missing,
+            diagnostics = inputs.diagnostics,
+        )
+    }
+}
diff --git a/android/app/src/main/java/com/noop/energy/HrIntegral.kt b/android/app/src/main/java/com/noop/energy/HrIntegral.kt
new file mode 100644
index 000000000..f4883e5f9
--- /dev/null
+++ b/android/app/src/main/java/com/noop/energy/HrIntegral.kt
@@ -0,0 +1,114 @@
+package com.noop.energy
+
+import com.noop.analytics.Calories
+import com.noop.analytics.WorkoutDetector
+import com.noop.data.HrSample
+import kotlin.math.min
+
+/**
+ * victor:energy — one workout window's heart rate reduced to the sums the Keytel model needs, with the
+ * weight factored OUT so a later weigh-in reprices a cached day without reading its samples again.
+ *
+ * Same walk as upstream's `Calories.estimateBoutCalories`: samples sorted by time, each carrying the time
+ * to the next (capped at 150 s, the last one 1 s); a sample under resting + 30 % of the reserve is rest,
+ * the others are active and their Keytel rate is linear in HR and weight, so Σ rate·dt splits into
+ * Σ min(HR, HRmax)·dt and Σ dt. The only departure is the per-sample floor at zero, applied to the window
+ * sum instead: at exercise heart rates the Keytel rate is far above zero, so the two agree.
+ */
+data class HrIntegral(
+    /** Samples in the window. */
+    val samples: Int,
+    /** Distinct minutes with at least one sample: the coverage witness. */
+    val coveredMin: Int,
+    /** Mean bpm over the samples, or null with none. */
+    val meanBpm: Double?,
+    /** Seconds credited to active samples (≥ threshold). */
+    val activeS: Double,
+    /** Σ min(bpm, HRmax) · dt over the active samples. */
+    val activeBpmS: Double,
+    /** Seconds credited to samples under the threshold (counted at the basal rate). */
+    val restS: Double,
+    /** The day's resting HR the threshold and the Uth VO₂max used; null means upstream's 60 default and the base model. */
+    val restingHr: Double?,
+    /** The effective HRmax used (profile override, else Tanaka unrounded). */
+    val hrMax: Double,
+) {
+    val isEmpty: Boolean get() = samples == 0
+
+    /** Mean %HRR of the window, for the lifting MET and the EPOC share; null without a mean or a reserve. */
+    fun meanHrr(): Double? {
+        val mean = meanBpm ?: return null
+        val rest = restingHr ?: return null
+        val reserve = hrMax - rest
+        if (reserve <= 0) return null
+        return (mean - rest) / reserve
+    }
+
+    /** Gross Keytel energy of the active seconds (kcal), for [weightKg] and [ageYears]. */
+    fun activeKcal(sex: String, weightKg: Double, ageYears: Double): Double {
+        if (activeS <= 0.0) return 0.0
+        val c = Calories.resolveCoeffs(sex)
+        val vo2 = Calories.vo2maxFor(hrMax, restingHr)
+        val kj = if (vo2 != null) {
+            c.fitHR * activeBpmS + (c.fitVO2 * vo2 + c.fitWeight * weightKg + c.fitAge * ageYears + c.fitAlpha) * activeS
+        } else {
+            c.workoutHR * activeBpmS + (c.workoutWeight * weightKg + c.workoutAge * ageYears + c.workoutAlpha) * activeS
+        }
+        return kj.coerceAtLeast(0.0) / Calories.workoutDivisor
+    }
+
+    /** Gross energy of the window: Keytel on the active seconds plus basal on the resting ones. */
+    fun grossKcal(sex: String, weightKg: Double, ageYears: Double, bmrRatePerS: Double): Double =
+        activeKcal(sex, weightKg, ageYears) + bmrRatePerS * restS
+
+    companion object {
+        val EMPTY_HRMAX = 220.0
+
+        fun empty(restingHr: Double?, hrMax: Double): HrIntegral = HrIntegral(0, 0, null, 0.0, 0.0, 0.0, restingHr, hrMax)
+
+        /**
+         * Reduce [samples] (any order; those outside [startTs, endTs] are dropped) against the window's day
+         * parameters. [hrMax] null keeps upstream's 220 fallback.
+         */
+        fun of(samples: List<HrSample>, startTs: Long, endTs: Long, restingHr: Double?, hrMax: Double?): HrIntegral {
+            val effMax = hrMax ?: EMPTY_HRMAX
+            val ordered = samples.filter { it.ts in startTs..endTs }.sortedBy { it.ts }
+            if (ordered.isEmpty()) return empty(restingHr, effMax)
+            val effResting = restingHr ?: 60.0
+            val threshold = effResting + Calories.activeHRRFraction * (effMax - effResting)
+            var activeS = 0.0
+            var activeBpmS = 0.0
+            var restS = 0.0
+            var bpmSum = 0L
+            val minutes = HashSet<Long>()
+            for (i in ordered.indices) {
+                val s = ordered[i]
+                val dt = if (i < ordered.size - 1) {
+                    val gap = (ordered[i + 1].ts - s.ts).toDouble()
+                    if (gap > 0) min(gap, WorkoutDetector.mergeGapS) else 1.0
+                } else {
+                    1.0
+                }
+                val bpm = s.bpm.toDouble()
+                bpmSum += s.bpm
+                minutes += s.ts / 60L
+                if (bpm < threshold) {
+                    restS += dt
+                } else {
+                    activeS += dt
+                    activeBpmS += min(bpm, effMax) * dt
+                }
+            }
+            return HrIntegral(
+                samples = ordered.size,
+                coveredMin = minutes.size,
+                meanBpm = bpmSum.toDouble() / ordered.size,
+                activeS = activeS,
+                activeBpmS = activeBpmS,
+                restS = restS,
+                restingHr = restingHr,
+                hrMax = effMax,
+            )
+        }
+    }
+}
diff --git a/android/app/src/main/java/com/noop/energy/SportCategory.kt b/android/app/src/main/java/com/noop/energy/SportCategory.kt
new file mode 100644
index 000000000..f6ed2629c
--- /dev/null
+++ b/android/app/src/main/java/com/noop/energy/SportCategory.kt
@@ -0,0 +1,77 @@
+package com.noop.energy
+
+/**
+ * victor:energy — how a workout's energy is estimated, by sport. Keyed on upstream's catalogue names
+ * ([com.noop.ingest.ExerciseTypes]: Health Connect types + the EXTRA list) plus the names the importers
+ * write; a sport not listed (free text, "detected", "Workout") is [OTHER] and follows the cardio rule
+ * with a lower default. The science behind each rule is in `CONTEXT/modelo-energia.md`.
+ */
+enum class SportCategory {
+    /** Continuous cardio: heart rate (Keytel) when the strap covered the window. */
+    CARDIO,
+    /** Lifting: Claude's estimate from the sets, else a MET by mean %HRR; heart rate over-reads it. */
+    STRENGTH,
+    /** HIIT / CrossFit / boot camp: heart rate, bounded to MET 5-11. */
+    INTERVAL,
+    /** Walking and hiking: steps. */
+    WALK,
+    /** Yoga, stretching and the like: MET 2.5. */
+    GENTLE,
+    /** Unknown sport: the cardio rule, MET 4 when nothing else is known. */
+    OTHER;
+
+    /** Whether a window of this category counts as a training day for the basal-equation blend. */
+    val trainsForBasal: Boolean get() = this == CARDIO || this == STRENGTH || this == INTERVAL
+
+    companion object {
+        private val WALK_SPORTS = setOf("Walking", "Hiking", "Treadmill walk", "Rucking", "Nordic walking")
+
+        /** Running sports, whose step cadence (160/min) is assumed when a phone-counted window has no strap steps. */
+        private val RUN_SPORTS = setOf("Running", "Treadmill run")
+
+        private val STRENGTH_SPORTS = setOf(
+            "Strength", "Strength Training", "Weightlifting", "Bodybuilding", "Powerlifting", "Calisthenics",
+        )
+
+        private val INTERVAL_SPORTS = setOf("HIIT", "CrossFit", "Boot camp")
+
+        private val GENTLE_SPORTS = setOf(
+            "Yoga", "Pilates", "Stretching", "Meditation", "Billiards", "Darts", "Gaming", "Fishing", "Archery",
+            "Bowling", "Curling",
+        )
+
+        private val CARDIO_SPORTS = setOf(
+            "Running", "Treadmill run", "Cycling", "Indoor cycle", "Spinning", "Mountain biking",
+            "Open-water swim", "Pool swim", "Rowing", "Row machine", "Elliptical", "Stair climber", "Jump rope",
+            "Boxing", "Kickboxing", "Martial arts", "Jiu jitsu", "Judo", "Muay Thai", "Fencing",
+            "Basketball", "Soccer", "Baseball", "Softball", "Ice Hockey", "Field hockey", "Handball", "Water polo",
+            "Volleyball", "Sand volleyball", "Badminton", "Tennis", "Squash", "Racquetball", "Table tennis",
+            "Padel", "Pickleball", "Frisbee", "Disc golf", "Lacrosse", "Rugby", "American football",
+            "Australian football", "Gaelic football", "Hurling/Camogie", "Cricket", "Netball", "Spikeball",
+            "Dancing", "Ballet", "Breakdancing", "Cheerleading", "Gymnastics", "Parkour", "Climbing",
+            "Skiing", "Snowboarding", "Snowshoeing", "Ice skating", "Inline skating", "Skateboarding",
+            "Surfing", "Kayaking", "Stand-up paddleboard", "Kiteboarding", "Sailing",
+        )
+
+        private fun lookup(set: Set<String>, sport: String): Boolean = set.any { it.equals(sport, ignoreCase = true) }
+
+        fun of(sport: String): SportCategory {
+            val s = sport.trim()
+            return when {
+                lookup(WALK_SPORTS, s) -> WALK
+                lookup(STRENGTH_SPORTS, s) -> STRENGTH
+                lookup(INTERVAL_SPORTS, s) -> INTERVAL
+                lookup(GENTLE_SPORTS, s) -> GENTLE
+                lookup(CARDIO_SPORTS, s) -> CARDIO
+                else -> OTHER
+            }
+        }
+
+        /** Steps per minute assumed for a window the strap did not count: walking 100, running 160, else none. */
+        fun assumedCadence(sport: String): Int? = when {
+            lookup(RUN_SPORTS, sport.trim()) -> 160
+            of(sport) == WALK -> 100
+            else -> null
+        }
+    }
+}
diff --git a/android/app/src/test/java/com/noop/energy/DayEnergyModelTest.kt b/android/app/src/test/java/com/noop/energy/DayEnergyModelTest.kt
new file mode 100644
index 000000000..5ffd0938c
--- /dev/null
+++ b/android/app/src/test/java/com/noop/energy/DayEnergyModelTest.kt
@@ -0,0 +1,173 @@
+package com.noop.energy
+
+import android.content.Context
+import androidx.room.Room
+import com.noop.data.AppleDaily
+import com.noop.data.DailyMetric
+import com.noop.data.HrSample
+import com.noop.data.MetricSeriesRow
+import com.noop.data.StepSample
+import com.noop.data.WhoopDatabase
+import com.noop.data.WhoopRepository
+import com.noop.data.WorkoutRow
+import com.noop.ui.ProfileStore
+import kotlinx.coroutines.runBlocking
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.annotation.Config
+import java.io.File
+import java.time.Instant
+import java.time.LocalDate
+import java.time.ZoneId
+import java.time.temporal.ChronoUnit
+
+/**
+ * victor:energy — the loader over a real (in-memory) store: the strap's steps inside the run are not free
+ * steps, the run logged by the strap and by the phone is one run, heart rate outside it earns nothing,
+ * the phone's count competes with the strap's, and the cache serves the second read.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34], manifest = Config.NONE)
+class DayEnergyModelTest {
+
+    private val ctx: Context = RuntimeEnvironment.getApplication()
+    private lateinit var db: WhoopDatabase
+    private lateinit var repo: WhoopRepository
+
+    private val zone: ZoneId = ZoneId.systemDefault()
+    private val day = "2026-10-10"
+    private val start = EnergyDays.startEpochS(day, zone)
+    private val runStart = start + 6 * 3600          // 10:00
+    private val runEnd = runStart + 3600              // 11:00
+    private val now = EnergyDays.startEpochS("2026-10-12", zone)
+
+    @Before
+    fun setUp() = runBlocking {
+        db = Room.inMemoryDatabaseBuilder(ctx, WhoopDatabase::class.java).allowMainThreadQueries().build()
+        repo = WhoopRepository(db)
+        DayEnergyModel.invalidate(ctx)
+    }
+
+    @After
+    fun tearDown() = db.close()
+
+    private fun profile() {
+        val p = ProfileStore.from(ctx)
+        p.sex = "male"
+        p.weightKg = 80.0
+        p.heightCm = 180.0
+        p.setAge(26)
+    }
+
+    /** One locomotion tick a second over [from, to): the counter climbs by one per sample. */
+    private fun walking(from: Long, to: Long, counterAt: Int): List<StepSample> =
+        (from until to).mapIndexed { i, ts -> StepSample("my-whoop", ts, (counterAt + i) and 0xFFFF, activityClass = 1) }
+
+    private suspend fun seedDay() {
+        repo.upsertMetricSeries(
+            listOf(MetricSeriesRow("health-connect", "2026-10-01", "weight", 82.0), MetricSeriesRow("health-connect", day, "weight", 80.0)),
+        )
+        repo.upsertDailyMetrics(listOf(DailyMetric("my-whoop", day, restingHr = 55)))
+        repo.upsertWorkouts(
+            listOf(
+                WorkoutRow("my-whoop", runStart, runEnd, "Running", "my-whoop", avgHr = 150, maxHr = 160),
+                WorkoutRow("health-connect", runStart + 30, runEnd, "Running", "health-connect", energyKcal = 500.0),
+            ),
+        )
+        repo.insertHr((runStart..runEnd step 2).map { HrSample("my-whoop", it, 150) })   // every other second
+        // A walk from 08:00 to 09:00 and the run itself, both at one tick a second; still before and between
+        // (the counter is cumulative: each stretch's first tick is the increment from the sample before it).
+        db.whoopDao().insertSteps(
+            listOf(StepSample("my-whoop", start + 4 * 3600 - 1, 99, activityClass = 0)) +
+                walking(start + 4 * 3600, start + 5 * 3600, 100) +
+                listOf(StepSample("my-whoop", start + 5 * 3600 + 1800, 99 + 3600, activityClass = 0)) +
+                walking(runStart, runEnd, 100 + 3600),
+        )
+    }
+
+    @Test
+    fun theDayIsComposedFromTheStoresWithNothingCountedTwice() = runBlocking {
+        profile()
+        seedDay()
+        val before = DayEnergyModel.version.value
+        val e = DayEnergyModel.day(ctx, repo, "my-whoop", day, now)!!
+
+        // One run, not two: the strap's and the phone's rows collapsed, and priced on the strap's pulse.
+        val run = e.workouts.single()
+        assertEquals(EnergyMethod.HEART_RATE, run.method)
+        assertEquals(1.0, run.coverage, 0.0)
+        assertTrue(run.netKcal > 300.0)
+
+        // The run's 3 600 ticks are not free steps: only the morning walk is.
+        assertEquals(StepsSource.STRAP, e.steps!!.source)
+        assertEquals(3600, e.steps!!.freeSteps)
+        assertEquals(3600, e.steps!!.inWorkoutSteps)
+
+        // Basal from the scale's averaged weight (82 → 81.8), the age ON that day, one training day in 28: Mifflin.
+        assertEquals(81.8, e.weightKg!!, 0.01)
+        assertEquals(0.0, e.basalBlend, 0.0)
+        val dob = Instant.ofEpochMilli(ProfileStore.from(ctx).dateOfBirthMillis).atZone(zone).toLocalDate()
+        val ageThatDay = ChronoUnit.YEARS.between(dob, LocalDate.parse(day)).toDouble()
+        assertEquals(10.0 * 81.8 + 6.25 * 180 - 5 * ageThatDay + 5, e.bmrKcal!!, 0.1)
+        assertNull(e.tefKcal)
+        assertEquals(setOf(EnergyMissing.MEALS), e.missing)
+        assertEquals(e.bmrKcal!! + e.steps!!.kcal + run.netKcal + run.epocKcal, e.totalKcal!!, 1e-6)
+        assertEquals(1.0, e.fraction, 0.0)
+
+        // The reduction was cached and announced; a second read is served from it, quietly.
+        assertTrue(DayEnergyModel.version.value > before)
+        assertTrue(File(File(ctx.filesDir, "energy"), "days.json").exists())
+        val afterFirst = DayEnergyModel.version.value
+        assertEquals(e, DayEnergyModel.day(ctx, repo, "my-whoop", day, now))
+        assertEquals(afterFirst, DayEnergyModel.version.value)
+
+        // Hard pulse outside the window lands (a late offload): re-reduced, worth nothing, and nothing to announce.
+        repo.insertHr((start + 8 * 3600..start + 8 * 3600 + 1800).map { HrSample("my-whoop", it, 170) })
+        val again = DayEnergyModel.day(ctx, repo, "my-whoop", day, now)!!
+        assertEquals(e, again)
+        assertEquals(afterFirst, DayEnergyModel.version.value)
+        // Pulse INSIDE the window lands (the odd seconds, harder): the run is repriced and announced.
+        repo.insertHr((runStart + 1..runEnd step 2).map { HrSample("my-whoop", it, 170) })
+        val denser = DayEnergyModel.day(ctx, repo, "my-whoop", day, now)!!
+        assertTrue(denser.workouts.single().grossKcal > run.grossKcal)
+        assertTrue(DayEnergyModel.version.value > afterFirst)
+        val afterDenser = DayEnergyModel.version.value
+
+        // The phone counted more over the calendar day: its free steps win, the strap's run steps still come off.
+        repo.upsertAppleDaily(listOf(AppleDaily("health-connect", day, steps = 12_000, activeKcal = 700.0, basalKcal = 1800.0)))
+        val phone = DayEnergyModel.day(ctx, repo, "my-whoop", day, now)!!
+        assertEquals(StepsSource.PHONE, phone.steps!!.source)
+        assertEquals(12_000 - 3600, phone.steps!!.freeSteps)
+        assertEquals(700.0, phone.diagnostics.phoneActiveKcal!!, 0.0)   // diagnostics only, never in the total
+        val repriced = denser.workouts.single()
+        assertEquals(phone.bmrKcal!! + phone.steps!!.kcal + repriced.netKcal + repriced.epocKcal, phone.totalKcal!!, 1e-6)
+        assertEquals(afterDenser, DayEnergyModel.version.value)   // the phone row is read fresh: no reduction moved
+    }
+
+    @Test
+    fun withoutAProfileThereIsNoBurn() = runBlocking {
+        seedDay()
+        val e = DayEnergyModel.day(ctx, repo, "my-whoop", day, now)!!
+        assertNull(e.totalKcal)
+        assertTrue(EnergyMissing.PROFILE in e.missing)
+        assertTrue(e.workouts.isEmpty())
+    }
+
+    @Test
+    fun aScreensRowsFindTheirEnergyByKeyOrByOverlap() = runBlocking {
+        profile()
+        seedDay()
+        val strapRow = WorkoutRow("my-whoop", runStart, runEnd, "Running", "my-whoop")
+        val phoneRow = WorkoutRow("health-connect", runStart + 30, runEnd, "Running", "health-connect")
+        val byKey = DayEnergyModel.workouts(ctx, repo, "my-whoop", listOf(strapRow, phoneRow), now)
+        assertEquals(2, byKey.size)
+        assertEquals(byKey.getValue(WorkoutKey.of(strapRow)), byKey.getValue(WorkoutKey.of(phoneRow)))
+    }
+}
