+package com.noop.energy
+
+import com.noop.food.FoodItem
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+/** victor:energy — each equation against the worked numbers of CONTEXT/modelo-energia.md (80 kg, 180 cm, 26 y, male). */
+class EnergyEquationsTest {
+
+    @Test
+    fun tenHaafAndMifflinGiveTheirPublishedFigures() {
+        assertEquals(2021.7, EnergyEquations.tenHaaf(80.0, 180.0, 26.0, 1.0), 0.1)
+        assertEquals(1800.0, EnergyEquations.mifflin(80.0, 180.0, 26.0, 1.0), 0.1)
+        // Women: −161; non-binary the midpoint −78 and half the Ten Haaf sex term.
+        assertEquals(1634.0, EnergyEquations.mifflin(80.0, 180.0, 26.0, 0.0), 0.1)
+        assertEquals(1717.0, EnergyEquations.mifflin(80.0, 180.0, 26.0, 0.5), 0.1)
+        assertEquals(1830.7, EnergyEquations.tenHaaf(80.0, 180.0, 26.0, 0.0), 0.1)
+    }
+
+    @Test
+    fun theBasalBlendLeansFromMifflinToTenHaafWithTrainingDays() {
+        assertEquals(0.0, EnergyEquations.basalBlend(0), 0.0)
+        assertEquals(0.0, EnergyEquations.basalBlend(4), 0.0)     // one day a week: Mifflin
+        assertEquals(0.5, EnergyEquations.basalBlend(8), 0.0)     // two a week: halfway
+        assertEquals(1.0, EnergyEquations.basalBlend(12), 0.0)    // three a week: Ten Haaf
+        assertEquals(1.0, EnergyEquations.basalBlend(28), 0.0)
+        assertEquals(1800.0, EnergyEquations.bmr(80.0, 180.0, 26.0, "male", 0)!!, 0.1)
+        assertEquals(2021.7, EnergyEquations.bmr(80.0, 180.0, 26.0, "male", 12)!!, 0.1)
+        assertEquals(1910.9, EnergyEquations.bmr(80.0, 180.0, 26.0, "male", 8)!!, 0.1)
+    }
+
+    @Test
+    fun basalIsNullWithoutWeightHeightOrAge() {
+        assertNull(EnergyEquations.bmr(null, 180.0, 26.0, "male", 12))
+        assertNull(EnergyEquations.bmr(80.0, null, 26.0, "male", 12))
+        assertNull(EnergyEquations.bmr(80.0, 180.0, null, "male", 12))
+        assertNull(EnergyEquations.bmr(0.0, 180.0, 26.0, "male", 12))
+    }
+
+    @Test
+    fun theDaysWeightIsAnExponentialAverageOfTheWeighInsUpToThatDay() {
+        val readings = listOf("2026-10-01" to 82.0, "2026-10-02" to 81.0, "2026-10-05" to 80.0)
+        assertNull(EnergyEquations.weightOn("2026-09-30", readings))
+        assertEquals(82.0, EnergyEquations.weightOn("2026-10-01", readings)!!, 0.0)
+        assertEquals(81.9, EnergyEquations.weightOn("2026-10-02", readings)!!, 0.01)
+        assertEquals(81.9, EnergyEquations.weightOn("2026-10-04", readings)!!, 0.01)   // nothing new: unchanged
+        assertEquals(81.71, EnergyEquations.weightOn("2026-10-05", readings)!!, 0.01)
+        // A later weigh-in never moves an earlier day.
+        assertEquals(81.9, EnergyEquations.weightOn("2026-10-02", readings + ("2026-10-06" to 70.0))!!, 0.01)
+    }
+
+    @Test
+    fun stepsAreWalkingKilometresAtHalfAKcalPerKg() {
+        assertEquals(5.229, EnergyEquations.stepsKm(7000, 180.0), 0.001)
+        assertEquals(230.1, EnergyEquations.stepsKcal(7000, 80.0, 180.0), 0.1)
+        assertEquals(0.0, EnergyEquations.stepsKcal(0, 80.0, 180.0), 0.0)
+    }
+
+    @Test
+    fun metMinutesAndEpoc() {
+        assertEquals(490.0, EnergyEquations.metKcal(5.0, 80.0, 70.0), 0.01)
+        assertEquals(47.0, EnergyEquations.epoc(392.0, 0.12), 0.1)
+        assertEquals(100.0, EnergyEquations.epoc(2000.0, 0.12), 0.0)   // capped
+        assertEquals(0.0, EnergyEquations.epoc(-50.0, 0.12), 0.0)
+    }
+
+    @Test
+    fun thermicEffectByMacrosOrTenPercentWithoutThem() {
+        val meal = listOf(
+            FoodItem("steak", "200 g", 640.0, 160.0, 0.0, 0.0),
+            FoodItem("rice", "350 g", 1120.0, 0.0, 280.0, 0.0),
+            FoodItem("oil", "85 g", 765.0, 0.0, 0.0, 85.0),
+        )
+        assertEquals(259.3, EnergyEquations.tef(meal)!!, 0.1)
+        assertEquals(50.0, EnergyEquations.tefOf(FoodItem("mystery", "1", 500.0, 0.0, 0.0, 0.0)), 0.0)
+        assertNull(EnergyEquations.tef(emptyList()))
+        // Half the steak eaten: half the thermic effect (the item already holds what was eaten).
+        assertEquals(80.0, EnergyEquations.tefOf(FoodItem("steak", "200 g", 320.0, 80.0, 0.0, 0.0, eaten = 0.5)), 0.0)
+    }
+
+    @Test
+    fun median() {
+        assertNull(EnergyEquations.median(emptyList()))
+        assertEquals(3.0, EnergyEquations.median(listOf(5.0, 1.0, 3.0))!!, 0.0)
+        assertEquals(2.5, EnergyEquations.median(listOf(4.0, 1.0, 2.0, 3.0))!!, 0.0)
+    }
+}
diff --git a/android/app/src/test/java/com/noop/energy/EnergyModelTest.kt b/android/app/src/test/java/com/noop/energy/EnergyModelTest.kt
