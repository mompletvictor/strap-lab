+package com.noop.energy
+
+import org.json.JSONObject
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** victor:energy — the day cache survives a round trip and forgets another model version. */
+class EnergyCacheTest {
+
+    private val raw = DayRaw(
+        day = "2026-10-19",
+        setupKey = "v=1;w=1|2|Running;rhr=55.0;max=189.8",
+        hrKey = "my-whoop=86400:1792467599",
+        stepsKey = "my-whoop:1792380000:1792467599",
+        strapTicks = 9123,
+        windows = listOf(
+            WindowRaw(1L, 2L, "Running", HrIntegral(3601, 61, 150.0, 3601.0, 540_150.0, 0.0, 55.0, 189.8), 1200),
+            WindowRaw(3L, 4L, "Yoga", HrIntegral.empty(null, 220.0), null),
+        ),
+    )
+
+    @Test
+    fun roundTrip() {
+        val text = EnergyCacheCodec.encode(mapOf(raw.day to raw))
+        assertEquals(EnergyModel.VERSION, JSONObject(text).getInt("version"))
+        assertEquals(mapOf(raw.day to raw), EnergyCacheCodec.decode(text))
+    }
+
+    @Test
+    fun aDocumentOfAnotherVersionDecodesEmpty() {
+        val text = EnergyCacheCodec.encode(mapOf(raw.day to raw)).replace("\"version\":${EnergyModel.VERSION}", "\"version\":999")
+        assertTrue(EnergyCacheCodec.decode(text).isEmpty())
+    }
+
+    @Test
+    fun aDayWithoutStrapSamplesKeepsNullNotZero() {
+        val none = raw.copy(strapTicks = null, windows = emptyList())
+        val back = EnergyCacheCodec.decode(EnergyCacheCodec.encode(mapOf(none.day to none))).getValue(none.day)
+        assertEquals(null, back.strapTicks)
+    }
+}
