@@ -0,0 +1,58 @@
+package com.noop.energy
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.time.LocalDateTime
+import java.time.ZoneId
+
+/** victor:energy — the logical day: 04:00 to 04:00, honest around the clock change. */
+class EnergyDaysTest {
+
+    private val madrid = ZoneId.of("Europe/Madrid")
+
+    private fun at(text: String): Long = LocalDateTime.parse(text).atZone(madrid).toEpochSecond()
+
+    @Test
+    fun theDayRollsAtFourInTheMorning() {
+        assertEquals("2026-10-19", EnergyDays.dayOf(at("2026-10-19T23:59:00"), madrid))
+        assertEquals("2026-10-19", EnergyDays.dayOf(at("2026-10-20T01:30:00"), madrid))   // the late dinner
+        assertEquals("2026-10-19", EnergyDays.dayOf(at("2026-10-20T03:59:59"), madrid))
+        assertEquals("2026-10-20", EnergyDays.dayOf(at("2026-10-20T04:00:00"), madrid))
+        assertEquals(at("2026-10-19T04:00:00"), EnergyDays.startEpochS("2026-10-19", madrid))
+        assertEquals(at("2026-10-20T04:00:00"), EnergyDays.endEpochS("2026-10-19", madrid))
+        assertEquals(86_400L, EnergyDays.durationS("2026-10-19", madrid))
+    }
+
+    @Test
+    fun theNightTheClocksGoBackMakesATwentyFiveHourDay() {
+        // 2026-10-25 03:00 CEST becomes 02:00 CET: that hour is in the logical day of 2026-10-24.
+        assertEquals(90_000L, EnergyDays.durationS("2026-10-24", madrid))
+        assertEquals(86_400L, EnergyDays.durationS("2026-10-25", madrid))
+        // A dinner at 01:30 that night is still the 24th …
+        val dinner = at("2026-10-25T01:30:00")
+        assertEquals("2026-10-24", EnergyDays.dayOf(dinner, madrid))
+        // … and at that moment 21.5 of the day's 25 hours have gone, not 21.5 of 24.
+        assertEquals(21.5 / 25.0, EnergyDays.fraction("2026-10-24", dinner, madrid), 1e-9)
+        // After the change (the second 02:30, CET) 23.5 hours have gone.
+        val secondHalfThree = LocalDateTime.parse("2026-10-25T02:30:00").atZone(madrid).withLaterOffsetAtOverlap().toEpochSecond()
+        assertEquals(23.5 / 25.0, EnergyDays.fraction("2026-10-24", secondHalfThree, madrid), 1e-9)
+        assertTrue(EnergyDays.isOpen("2026-10-24", secondHalfThree, madrid))
+        assertFalse(EnergyDays.isOpen("2026-10-24", at("2026-10-25T04:00:00"), madrid))
+    }
+
+    @Test
+    fun theSpringChangeMakesATwentyThreeHourDay() {
+        assertEquals(82_800L, EnergyDays.durationS("2026-03-28", madrid))
+    }
+
+    @Test
+    fun fractionIsClampedAndPastDaysAreWhole() {
+        assertEquals(1.0, EnergyDays.fraction("2026-10-19", at("2026-10-25T12:00:00"), madrid), 0.0)
+        assertEquals(0.0, EnergyDays.fraction("2026-10-19", at("2026-10-01T12:00:00"), madrid), 0.0)
+        assertEquals(0.5, EnergyDays.fraction("2026-10-19", at("2026-10-19T16:00:00"), madrid), 1e-9)
+        assertEquals(listOf("2026-10-30", "2026-10-31", "2026-11-01"), EnergyDays.days("2026-10-30", "2026-11-01"))
+        assertEquals("2026-09-21", EnergyDays.plusDays("2026-10-19", -28))
+    }
+}
