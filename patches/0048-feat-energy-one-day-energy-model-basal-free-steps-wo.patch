+package com.noop.energy
+
+import android.content.Context
+import com.noop.ai.AiCoach
+import com.noop.analytics.ScaleBody
+import com.noop.analytics.StepsCounter
+import com.noop.analytics.StrainScorer
+import com.noop.data.AppleDaily
+import com.noop.data.DailyMetric
+import com.noop.data.StepSample
+import com.noop.data.WhoopRepository
+import com.noop.data.WorkoutRow
+import com.noop.food.FoodEntry
+import com.noop.food.FoodStore
+import com.noop.ingest.HealthConnectImporter
+import com.noop.ingest.VictorHcRefresh
+import com.noop.training.TrainingAnalyzer
+import com.noop.training.TrainingEnergy
+import com.noop.training.TrainingStore
+import com.noop.ui.ProfileStore
+import com.noop.ui.WorkoutEditing
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.drop
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+import java.time.Instant
+import java.time.LocalDate
+import java.time.ZoneId
+import java.time.temporal.ChronoUnit
+import java.util.TreeMap
+import kotlin.math.max
+import kotlin.math.roundToLong
+
+/**
+ * victor:energy — the loader of the day-energy model: gathers each day's inputs from the stores (profile,
+ * scale, daily rows, workouts of every source, exercise log, food log, phone aggregates), reduces the raw
+ * streams through the cache ([EnergyCacheFile]) and composes with [EnergyModel]. Everything a screen
+ * shows about energy out comes from [day] or [range]; [version] moves when a result may have changed.
+ *
+ * Reads: one pass over the stores per call, and the raw streams only for days whose cache is missing or
+ * stale — the last [RECENT_DAYS] days are probed by stream fingerprint on every read, older ones only
+ * rebuild when their window set, heart-rate parameters or the model version change.
+ */
+object DayEnergyModel {
+
+    /** Days re-validated against their streams on every read: a late strap offload lands within these. */
+    const val RECENT_DAYS = 21L
+
+    /** Days of free-step history behind the estimate of a day with no step count. */
+    const val STEPS_MEMORY_DAYS = 14L
+
+    private const val SAMPLE_LIMIT = 200_000
+
+    private val mutex = Mutex()
+    private var cache: MutableMap<String, DayRaw>? = null
+
+    private val _version = MutableStateFlow(0)
+    /** Bumps when a day's figures may have changed: new strap data reduced, a meal, a session, a phone refresh. */
+    val version: StateFlow<Int> = _version.asStateFlow()
+
+    /** One day, composed with the step history before it. Null only when [day] is not a date. */
+    suspend fun day(
+        ctx: Context,
+        repo: WhoopRepository,
+        strapId: String,
+        day: String,
+        nowEpochS: Long = System.currentTimeMillis() / 1000L,
+    ): DayEnergy? = range(ctx, repo, strapId, day, day, nowEpochS)[day]
+
+    /**
+     * Every day from [from] to [to] (inclusive, "yyyy-MM-dd"), oldest first. A few store reads for the
+     * whole span, however long; raw streams only for stale days.
+     */
+    suspend fun range(
+        ctx: Context,
+        repo: WhoopRepository,
+        strapId: String,
+        from: String,
+        to: String,
+        nowEpochS: Long = System.currentTimeMillis() / 1000L,
+    ): Map<String, DayEnergy> = withContext(Dispatchers.IO) {
+        mutex.withLock { compute(ctx.applicationContext, repo, strapId, from, to, nowEpochS) }
+    }
+
+    /**
+     * The energy of each of [rows] (a screen's list), keyed by [WorkoutKey], computed over the days they
+     * fall on; a row the model has no window for (dismissed, or collapsed into another) is absent.
+     */
+    suspend fun workouts(
+        ctx: Context,
+        repo: WhoopRepository,
+        strapId: String,
+        rows: List<WorkoutRow>,
+        nowEpochS: Long = System.currentTimeMillis() / 1000L,
+    ): Map<WorkoutKey, WorkoutEnergy> {
+        if (rows.isEmpty()) return emptyMap()
+        val zone = ZoneId.systemDefault()
+        val days = rows.map { EnergyDays.dayOf(it.startTs, zone) }
+        val computed = range(ctx, repo, strapId, days.min(), days.max(), nowEpochS)
+        val out = HashMap<WorkoutKey, WorkoutEnergy>()
+        for (r in rows) lookup(computed, r, zone)?.let { out[WorkoutKey.of(r)] = it }
+        return out
+    }
+
+    /**
+     * Pure: the energy of [row] among [days]: by natural key, else the window of the same sport the row
+     * overlaps (the row the screen kept of a cross-source pair may not be the one the model kept).
+     */
+    fun lookup(days: Map<String, DayEnergy>, row: WorkoutRow, zone: ZoneId = ZoneId.systemDefault()): WorkoutEnergy? {
+        val day = days[EnergyDays.dayOf(row.startTs, zone)] ?: return null
+        val key = WorkoutKey.of(row)
+        day.workouts.firstOrNull { it.key == key }?.let { return it }
+        val sport = WorkoutEditing.sportKey(row.sport)
+        return day.workouts.firstOrNull { w ->
+            WorkoutEditing.sportKey(w.sport) == sport && minOf(w.endTs, row.endTs) > maxOf(w.startTs, row.startTs)
+        }
+    }
+
+    /** Forget every reduced day (a "recalculate" control); the next read rebuilds them. */
+    suspend fun invalidate(ctx: Context) = withContext(Dispatchers.IO) {
+        mutex.withLock {
+            cache = HashMap()
+            EnergyCacheFile.delete(ctx.applicationContext)
+        }
+        _version.update { it + 1 }
+    }
+
+    /**
+     * Follow the stores whose change moves a day's figures without any stream arriving: the exercise log,
+     * the food log, a phone refresh and a workout row rewritten with a session's figures. Call once from
+     * the application; strap syncs are seen through the fingerprints on the next read.
+     */
+    fun watch(scope: CoroutineScope) {
+        scope.launch { TrainingStore.sessions.drop(1).collect { _version.update { it + 1 } } }
+        scope.launch { FoodStore.entries.drop(1).collect { _version.update { it + 1 } } }
+        scope.launch { VictorHcRefresh.version.drop(1).collect { _version.update { it + 1 } } }
+        scope.launch { TrainingAnalyzer.rowsChanged.drop(1).collect { _version.update { it + 1 } } }
+    }
+
+    // ── Inputs ─────────────────────────────────────────────────────────────────────────────────────
+
+    private class Profile(
+        val sex: String,
+        val weightKg: Double?,
+        val heightCm: Double?,
+        val dob: LocalDate?,
+        val hrMaxOverride: Int,
+        val ticksPerStep: Double,
+    ) {
+        fun ageOn(day: String): Double? = dob?.let { ChronoUnit.YEARS.between(it, LocalDate.parse(day)).toDouble() }
+
+        /** The effective HRmax on [day]: the manual override, else Tanaka unrounded; null with no age. */
+        fun hrMaxOn(day: String): Double? =
+            if (hrMaxOverride > 0) hrMaxOverride.toDouble() else ageOn(day)?.let { StrainScorer.tanakaHRmax(it) }
+
+        fun steps(ticks: Int): Int = (ticks.toDouble() / max(ticksPerStep, 0.5)).roundToLong().coerceAtMost(Int.MAX_VALUE.toLong()).toInt()
+    }
+
+    /**
+     * The profile with "never filled in" told apart from its defaults: ProfileStore answers 75 kg / 178 cm /
+     * 30 y for an empty store, and this model must show "no profile" instead. Read the flags BEFORE
+     * ProfileStore's date of birth, whose getter writes a default when none is stored.
+     */
+    private fun profile(ctx: Context): Profile {
+        val prefs = ctx.getSharedPreferences(ProfileStore.PREFS, Context.MODE_PRIVATE)
+        val weightSet = prefs.contains("weight_kg")
+        val heightSet = prefs.contains("height_cm")
+        val ageSet = prefs.contains("date_of_birth") || prefs.contains("age")
+        val p = ProfileStore.from(ctx)
+        return Profile(
+            sex = p.sex,
+            weightKg = if (weightSet) p.weightKg else null,
+            heightCm = if (heightSet) p.heightCm else null,
+            dob = if (ageSet) Instant.ofEpochMilli(p.dateOfBirthMillis).atZone(ZoneId.systemDefault()).toLocalDate() else null,
+            hrMaxOverride = p.hrMaxOverride,
+            ticksPerStep = p.stepTicksPerStep,
+        )
+    }
+
+    private class PhoneDay(val steps: Int?, val activeKcal: Double?, val basalKcal: Double?)
+
+    private fun phoneDays(rows: List<AppleDaily>): Map<String, PhoneDay> {
+        val out = HashMap<String, PhoneDay>()
+        for (r in rows) {
+            val cur = out[r.day]
+            out[r.day] = PhoneDay(
+                steps = listOfNotNull(cur?.steps, r.steps?.takeIf { it > 0 }).maxOrNull(),
+                activeKcal = cur?.activeKcal ?: r.activeKcal?.takeIf { it > 0 },
+                basalKcal = cur?.basalKcal ?: r.basalKcal?.takeIf { it > 0 },
+            )
+        }
+        return out
+    }
+
+    /**
+     * The day's step samples across the strap union, with the last sample BEFORE the day in front: the
+     * counter is cumulative, so the first increment of a window needs its predecessor (as the cycle engine
+     * reads it); without one the first tick of every day and window would be lost.
+     */
+    private suspend fun stepSamplesUnion(repo: WhoopRepository, strapId: String, from: Long, to: Long): List<StepSample> {
+        val byTs = LinkedHashMap<Long, StepSample>()
+        var before: StepSample? = null
+        for (id in WhoopRepository.importedSourceIdsFor(strapId)) {
+            repo.stepSampleBefore(id, from)?.let { p -> if (before == null || p.ts > before!!.ts) before = p }
+            for (s in repo.stepSamples(id, from, to, SAMPLE_LIMIT)) byTs.putIfAbsent(s.ts, s)
+        }
+        return listOfNotNull(before) + byTs.values.sortedBy { it.ts }
+    }
+
+    /**
+     * Raw ticks in [from, to] over [samples] (sorted): the samples inside plus the last one before, so the
+     * first increment counts. Null with no sample inside (no count); 0 with samples but no movement.
+     */
+    private fun ticks(samples: List<StepSample>, from: Long, to: Long): Int? {
+        val inWindow = samples.filter { it.ts in from..to }
+        if (inWindow.isEmpty()) return null
+        val before = samples.lastOrNull { it.ts < from }
+        val window = listOfNotNull(before) + inWindow
+        if (window.size < 2) return null
+        return StepsCounter.stepsInWindow(window) ?: 0
+    }
+
+    /** The day's heart-rate witness: count and newest ts per raw source (an index walk, no rows). */
+    private suspend fun hrKey(repo: WhoopRepository, strapId: String, startS: Long, endS: Long): String =
+        repo.hrUnionFingerprint(strapId, startS, endS - 1)
+
+    /** The day's step witness: first and last sample ts per imported source. An offload that fills a gap
+     *  in the middle moves the heart-rate witness of the same day, which is probed alongside. */
+    private suspend fun stepsKey(repo: WhoopRepository, strapId: String, startS: Long, endS: Long): String {
+        val parts = ArrayList<String>()
+        for (id in WhoopRepository.importedSourceIdsFor(strapId)) {
+            val c = repo.stepTimestampCoverage(id, startS, endS)
+            parts += "$id:${c.firstTs ?: 0}:${c.lastTs ?: 0}"
+        }
+        return parts.joinToString(",")
+    }
+
+    private fun setupKey(windows: List<Window>, restingHr: Double?, hrMax: Double?): String =
+        "v=${EnergyModel.VERSION};w=" + windows.joinToString(",") { "${it.startTs}|${it.endTs}|${it.row.sport}" } +
+            ";rhr=$restingHr;max=$hrMax"
+
+    // ── The pass ───────────────────────────────────────────────────────────────────────────────────
+
+    private suspend fun compute(
+        ctx: Context,
+        repo: WhoopRepository,
+        strapId: String,
+        from: String,
+        to: String,
+        nowEpochS: Long,
+    ): Map<String, DayEnergy> {
+        val zone = ZoneId.systemDefault()
+        val lookFrom = EnergyDays.plusDays(from, -STEPS_MEMORY_DAYS)
+        val blendFrom = EnergyDays.plusDays(from, -27L - STEPS_MEMORY_DAYS)
+        val today = EnergyDays.dayOf(nowEpochS, zone)
+        val recentFrom = EnergyDays.plusDays(today, -RECENT_DAYS)
+        val days = cache ?: EnergyCacheFile.read(ctx).also { cache = it }
+
+        val profile = profile(ctx)
+        val weights = runCatching {
+            repo.metricSeries(HealthConnectImporter.HC_DEVICE, ScaleBody.KEY_WEIGHT, "0000-01-01", to).map { it.day to it.value }
+        }.getOrDefault(emptyList())
+        val daily = runCatching { repo.daysMerged(strapId) }.getOrDefault(emptyList())
+        val restingByDay = TreeMap<String, Double>()
+        val strapTotalByDay = HashMap<String, Double>()
+        for (d: DailyMetric in daily) {
+            d.restingHr?.takeIf { it > 0 }?.let { restingByDay[d.day] = it.toDouble() }
+            d.activeKcalEst?.takeIf { it > 0 }?.let { strapTotalByDay[d.day] = it }
+        }
+        val rows = runCatching {
+            AiCoach(repo) { strapId }.visibleWorkoutRows(EnergyDays.startEpochS(blendFrom, zone), EnergyDays.endEpochS(to, zone) - 1)
+        }.getOrDefault(emptyList())
+        val windowsByDay: Map<String, List<Window>> = rows.groupBy { EnergyDays.dayOf(it.startTs, zone) }
+            .mapValues { (_, dayRows) -> EnergyModel.windows(dayRows) }
+        val claudeByKey = HashMap<WorkoutKey, Double>()
+        for (s in TrainingEnergy.onePerWorkout(runCatching { TrainingStore.load(ctx) }.getOrDefault(emptyList()))) {
+            val kcal = s.analysis?.totalKcal?.takeIf { it > 0 } ?: continue
+            claudeByKey[WorkoutKey(s.startTs, s.sport)] = kcal
+        }
+        val mealsByDay: Map<String, List<FoodEntry>> = runCatching { FoodStore.load(ctx) }.getOrDefault(emptyList()).groupBy { it.day }
+        val phone = phoneDays(
+            runCatching { repo.appleDaily(HealthConnectImporter.HC_DEVICE, lookFrom, to) + repo.appleDaily("apple-health", lookFrom, to) }
+                .getOrDefault(emptyList()),
+        )
+
+        var changed = false
+        val priorSteps = ArrayList<Double>()
+        val out = LinkedHashMap<String, DayEnergy>()
+        for (day in EnergyDays.days(lookFrom, to)) {
+            val startS = EnergyDays.startEpochS(day, zone)
+            val endS = EnergyDays.endEpochS(day, zone)
+            val restingHr = restingByDay.floorEntry(day)?.value
+            val hrMax = profile.hrMaxOn(day)
+            val windows = windowsByDay[day] ?: emptyList()
+            val setup = setupKey(windows, restingHr, hrMax)
+            val recent = day >= recentFrom
+            val cached = days[day]
+            val hrKey = if (recent) runCatching { hrKey(repo, strapId, startS, endS) }.getOrNull() else null
+            val stepsKey = if (recent) runCatching { stepsKey(repo, strapId, startS, endS) }.getOrNull() else null
+            val setupStale = cached == null || cached.setupKey != setup
+            val stepsStale = setupStale || (stepsKey != null && cached!!.stepsKey != stepsKey)
+            val hrStale = setupStale || (hrKey != null && cached!!.hrKey != hrKey)
+            val raw = if (!stepsStale && !hrStale) {
+                cached!!
+            } else {
+                // Steps: the day's samples, re-read only when their witness moved; else the cached ticks.
+                val samples = if (stepsStale) runCatching { stepSamplesUnion(repo, strapId, startS, endS - 1) }.getOrDefault(emptyList()) else emptyList()
+                val dayTicks = if (stepsStale) ticks(samples, startS, endS - 1) else cached!!.strapTicks
+                val reduced = windows.map { w ->
+                    val old = cached?.window(w.startTs, w.endTs, w.row.sport)
+                    val hr = when {
+                        !hrStale && old != null -> old.hr
+                        w.durationS <= 0L -> HrIntegral.empty(restingHr, hrMax ?: HrIntegral.EMPTY_HRMAX)
+                        else -> {
+                            val hrSamples = runCatching { repo.hrSamplesUnion(strapId, w.startTs, w.endTs, SAMPLE_LIMIT) }.getOrDefault(emptyList())
+                            HrIntegral.of(hrSamples, w.startTs, w.endTs, restingHr, hrMax)
+                        }
+                    }
+                    val wTicks = if (stepsStale || old == null) ticks(samples, w.startTs, w.endTs) else old.strapTicks
+                    WindowRaw(w.startTs, w.endTs, w.row.sport, hr, wTicks)
+                }
+                DayRaw(day, setup, hrKey ?: cached?.hrKey ?: "", stepsKey ?: cached?.stepsKey ?: "", dayTicks, reduced).also {
+                    days[day] = it
+                    // Only a reduction whose CONTENT moved is a change worth announcing or writing: a live
+                    // heart-rate stream outside any window moves today's witness on every read and nothing
+                    // else, and a version bump on each of those would have a screen reloading in a loop.
+                    if (cached == null || cached.strapTicks != it.strapTicks || cached.windows != it.windows) changed = true
+                }
+            }
+            val age = profile.ageOn(day)
+            val body = BodyInputs(
+                sex = profile.sex,
+                weightKg = EnergyEquations.weightOn(day, weights) ?: profile.weightKg,
+                heightCm = profile.heightCm,
+                ageYears = age,
+            )
+            val inputs = DayInputs(
+                day = day,
+                fraction = EnergyDays.fraction(day, nowEpochS, zone),
+                body = body,
+                trainingDays28 = EnergyModel.trainingDays28(day, windowsByDay),
+                strapDaySteps = raw.strapTicks?.let { profile.steps(it) },
+                phoneDaySteps = phone[day]?.steps,
+                windows = windows.map { w ->
+                    val wr = raw.window(w.startTs, w.endTs, w.row.sport)
+                    WindowInputs(
+                        window = w,
+                        hr = wr?.hr ?: HrIntegral.empty(restingHr, hrMax ?: HrIntegral.EMPTY_HRMAX),
+                        strapSteps = wr?.strapTicks?.let { profile.steps(it) },
+                        claudeKcal = claudeByKey[w.key],
+                        externalKcal = EnergyModel.externalKcal(w.row),
+                    )
+                },
+                meals = mealsByDay[day] ?: emptyList(),
+                priorStepsKcal = priorSteps.takeLast(STEPS_MEMORY_DAYS.toInt()),
+                diagnostics = EnergyDiagnostics(
+                    strapTotalKcal = strapTotalByDay[day],
+                    phoneActiveKcal = phone[day]?.activeKcal,
+                    phoneBasalKcal = phone[day]?.basalKcal,
+                ),
+            )
+            val energy = EnergyModel.compose(inputs)
+            energy.steps?.takeIf { it.source != StepsSource.ESTIMATED }?.let { priorSteps += it.kcal }
+            if (day >= from) out[day] = energy
+        }
+        if (changed) {
+            runCatching { EnergyCacheFile.write(ctx, days) }
+            _version.update { it + 1 }
+        }
+        return out
+    }
+}
