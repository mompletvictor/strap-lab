+package com.noop.ai
+
+import com.noop.analytics.ScaleBody
+import com.noop.data.WhoopRepository
+import com.noop.ingest.ScaleImport
+import java.util.Locale
+import kotlin.math.roundToInt
+
+/**
+ * victor:scale — one compact English line about the smart-scale body composition for the AI coach's data
+ * context, e.g.
+ *
+ * `BODY (smart scale, latest 2026-10-15): weight 78.2 kg (-0.6 kg vs 7d, -1.4 kg vs 30d), body fat 18.1%
+ * (-0.3 pp vs 7d), lean mass 61.0 kg, bone 3.1 kg, water 45.2 kg, BMR 1780 kcal`
+ *
+ * Null when there is no scale data, so the caller can simply skip it. Not wired here: AiCoach calls it.
+ * Metric units always (kg, %, kcal) since this is prompt text, not display. A metric whose newest reading
+ * is older than the headline day says so ("as of ..."); a missing figure is omitted, never dashed.
+ */
+object ScaleCoachContext {
+
+    /** Reads the stored Health Connect scale series and formats [line]; null when there is none. */
+    suspend fun line(repo: WhoopRepository): String? = line(ScaleImport.snapshot(repo))
+
+    /** Pure formatter behind [line]; null for a null snapshot or one with no metric. */
+    fun line(snapshot: ScaleBody.Snapshot?): String? {
+        val s = snapshot ?: return null
+        val parts = ArrayList<String>()
+        s.weight?.let { parts += item("weight", "${f1(it.value)} kg", it, s.day, "kg") }
+        s.bodyFat?.let { parts += item("body fat", "${f1(it.value)}%", it, s.day, "pp") }
+        s.leanMass?.let { parts += item("lean mass", "${f1(it.value)} kg", it, s.day, null) }
+        s.boneMass?.let { parts += item("bone", "${f1(it.value)} kg", it, s.day, null) }
+        s.bodyWater?.let { parts += item("water", "${f1(it.value)} kg", it, s.day, null) }
+        s.bmr?.let { parts += item("BMR", "${it.value.roundToInt()} kcal", it, s.day, null) }
+        if (parts.isEmpty()) return null
+        return "BODY (smart scale, latest ${s.day}): " + parts.joinToString(", ")
+    }
+
+    private fun item(label: String, value: String, m: ScaleBody.Metric, day: String, deltaUnit: String?): String {
+        val notes = ArrayList<String>()
+        if (m.day != day) notes += "as of ${m.day}"
+        if (deltaUnit != null) {
+            m.vs7d?.let { notes += "${signed(it)} $deltaUnit vs 7d" }
+            m.vs30d?.let { notes += "${signed(it)} $deltaUnit vs 30d" }
+        }
+        return if (notes.isEmpty()) "$label $value" else "$label $value (${notes.joinToString(", ")})"
+    }
+
+    private fun f1(v: Double): String = String.format(Locale.US, "%.1f", v)
+
+    /** "+0.4" / "-0.6"; a change that rounds to zero reads "+0.0", never "-0.0". */
+    private fun signed(v: Double): String {
+        val s = String.format(Locale.US, "%+.1f", v)
+        return if (s == "-0.0") "+0.0" else s
+    }
+}
