+package com.noop.ai
+
+import com.noop.analytics.ScaleBody
+import com.noop.analytics.ScaleBody.Metric
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+/** victor:scale — the one-line BODY context the AI coach receives. */
+class ScaleCoachContextTest {
+
+    private fun snapshot(
+        weight: Metric? = null,
+        bodyFat: Metric? = null,
+        leanMass: Metric? = null,
+        boneMass: Metric? = null,
+        bodyWater: Metric? = null,
+        bmr: Metric? = null,
+    ) = ScaleBody.Snapshot(
+        day = "2026-10-15", readingAt = null,
+        weight = weight, bodyFat = bodyFat, leanMass = leanMass,
+        boneMass = boneMass, bodyWater = bodyWater, bmr = bmr,
+        weightTrend = emptyList(),
+    )
+
+    @Test
+    fun fullReadingFormatsAsOneCompactLine() {
+        val line = ScaleCoachContext.line(
+            snapshot(
+                weight = Metric("2026-10-15", 78.2, vs7d = -0.6, vs30d = -1.4),
+                bodyFat = Metric("2026-10-15", 18.1, vs7d = -0.3),
+                leanMass = Metric("2026-10-15", 61.0),
+                boneMass = Metric("2026-10-15", 3.1),
+                bodyWater = Metric("2026-10-15", 45.2),
+                bmr = Metric("2026-10-15", 1780.4),
+            ),
+        )
+        assertEquals(
+            "BODY (smart scale, latest 2026-10-15): weight 78.2 kg (-0.6 kg vs 7d, -1.4 kg vs 30d), " +
+                "body fat 18.1% (-0.3 pp vs 7d), lean mass 61.0 kg, bone 3.1 kg, water 45.2 kg, BMR 1780 kcal",
+            line,
+        )
+    }
+
+    @Test
+    fun onlyWhatTheScaleWroteAndOlderMetricsSayWhen() {
+        val line = ScaleCoachContext.line(
+            snapshot(
+                weight = Metric("2026-10-15", 78.24, vs7d = 0.4),
+                bodyFat = Metric("2026-10-12", 18.4),
+            ),
+        )
+        assertEquals(
+            "BODY (smart scale, latest 2026-10-15): weight 78.2 kg (+0.4 kg vs 7d), body fat 18.4% (as of 2026-10-12)",
+            line,
+        )
+    }
+
+    @Test
+    fun aChangeThatRoundsToZeroIsNeverNegativeZero() {
+        val line = ScaleCoachContext.line(snapshot(weight = Metric("2026-10-15", 78.2, vs7d = -0.04)))
+        assertEquals("BODY (smart scale, latest 2026-10-15): weight 78.2 kg (+0.0 kg vs 7d)", line)
+    }
+
+    @Test
+    fun noScaleDataMeansNoLine() {
+        assertNull(ScaleCoachContext.line(null as ScaleBody.Snapshot?))
+        assertNull(ScaleCoachContext.line(snapshot()))
+    }
+
+    @Test
+    fun lineFromRealSeriesEndToEnd() {
+        val s = ScaleBody.snapshot(
+            mapOf(
+                ScaleBody.KEY_WEIGHT to listOf(
+                    ScaleBody.Reading("2026-09-15", 79.6),
+                    ScaleBody.Reading("2026-10-08", 78.8),
+                    ScaleBody.Reading("2026-10-15", 78.2),
+                ),
+                ScaleBody.KEY_BONE_MASS to listOf(ScaleBody.Reading("2026-10-15", 3.1)),
+            ),
+        )
+        assertEquals(
+            "BODY (smart scale, latest 2026-10-15): weight 78.2 kg (-0.6 kg vs 7d, -1.4 kg vs 30d), bone 3.1 kg",
+            ScaleCoachContext.line(s),
+        )
+    }
+}
