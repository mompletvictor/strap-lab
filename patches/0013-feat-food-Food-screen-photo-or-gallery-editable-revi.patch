+@Composable
+private fun TodayCard(totals: FoodTotals, meals: Int, burned: Double?) {
+    NoopCard(tint = Palette.accent) {
+        Column(verticalArrangement = Arrangement.spacedBy(Metrics.space12)) {
+            Row(verticalAlignment = Alignment.CenterVertically) {
+                Overline(uiString(R.string.victor_food_today))
+                Spacer(Modifier.weight(1f))
+                if (meals > 0) {
+                    Text(
+                        uiPlural(R.plurals.victor_food_meals, meals, meals),
+                        style = NoopType.caption,
+                        color = Palette.textSecondary,
+                    )
+                }
+            }
+            Row(verticalAlignment = Alignment.Bottom, horizontalArrangement = Arrangement.spacedBy(Metrics.space6)) {
+                Text(whole(totals.kcal), style = NoopType.display(48f), color = Palette.textPrimary)
+                Text(
+                    uiString(R.string.victor_food_kcal),
+                    style = NoopType.headline,
+                    color = Palette.textSecondary,
+                    modifier = Modifier.padding(bottom = Metrics.space8),
+                )
+            }
+            Row(Modifier.fillMaxWidth()) {
+                MacroStat(uiString(R.string.victor_food_protein), totals.proteinG, Palette.metricCyan, Modifier.weight(1f))
+                MacroStat(uiString(R.string.victor_food_carbs), totals.carbsG, Palette.metricAmber, Modifier.weight(1f))
+                MacroStat(uiString(R.string.victor_food_fat), totals.fatG, Palette.metricRose, Modifier.weight(1f))
+            }
+            if (burned != null) {
+                Text(
+                    uiString(R.string.victor_food_burned, whole(burned)),
+                    style = NoopType.subhead,
+                    color = Palette.textSecondary,
+                )
+            }
+        }
+    }
+}
+
+@Composable
+private fun MacroStat(label: String, grams: Double, accent: Color, modifier: Modifier) {
+    Column(modifier, verticalArrangement = Arrangement.spacedBy(Metrics.space2)) {
+        Text(label, style = NoopType.caption, color = accent)
+        Text(uiString(R.string.victor_food_grams, whole(grams)), style = NoopType.chartValue, color = Palette.textPrimary)
+    }
+}
+
+@Composable
+private fun DayCard(label: String, entries: List<FoodEntry>, onEdit: (FoodEntry) -> Unit, onDelete: (FoodEntry) -> Unit) {
+    val t = FoodTotals.ofEntries(entries)
+    NoopCard {
+        Column(verticalArrangement = Arrangement.spacedBy(Metrics.space8)) {
+            Row(verticalAlignment = Alignment.CenterVertically) {
+                Text(label, style = NoopType.headline, color = Palette.textPrimary, modifier = Modifier.weight(1f))
+                Text("${whole(t.kcal)} ${uiString(R.string.victor_food_kcal)}", style = NoopType.bodyNumber, color = Palette.textPrimary)
+            }
+            Text(macrosLine(t), style = NoopType.caption, color = Palette.textSecondary)
+            SettingsRowDivider()
+            EntryList(entries, onEdit, onDelete)
+        }
+    }
+}
+
+@Composable
+private fun EntryList(entries: List<FoodEntry>, onEdit: (FoodEntry) -> Unit, onDelete: (FoodEntry) -> Unit) {
+    Column {
+        entries.forEachIndexed { i, e ->
+            if (i > 0) SettingsRowDivider()
+            EntryRow(e, onEdit = { onEdit(e) }, onDelete = { onDelete(e) })
+        }
+    }
+}
+
+@Composable
+private fun EntryRow(entry: FoodEntry, onEdit: () -> Unit, onDelete: () -> Unit) {
+    val ctx = LocalContext.current
+    val time = remember(entry.timestamp) { DateFormat.getTimeFormat(ctx).format(Date(entry.timestamp)) }
+    val title = entry.items.joinToString(", ") { it.name }.ifBlank { entry.note }
+    Row(
+        modifier = Modifier
+            .fillMaxWidth()
+            .clip(RoundedCornerShape(Metrics.cornerSm))
+            .clickable(onClick = onEdit)
+            .padding(vertical = Metrics.space6),
+        verticalAlignment = Alignment.CenterVertically,
+        horizontalArrangement = Arrangement.spacedBy(Metrics.space12),
+    ) {
+        FoodThumb(entry.thumbnailPath, ThumbSize)
+        Column(Modifier.weight(1f), verticalArrangement = Arrangement.spacedBy(Metrics.space2)) {
+            Text(title, style = NoopType.body, color = Palette.textPrimary, maxLines = 2, overflow = TextOverflow.Ellipsis)
+            Text(
+                "$time · ${macrosLine(entry.totals)}",
+                style = NoopType.caption,
+                color = Palette.textSecondary,
+                maxLines = 1,
+                overflow = TextOverflow.Ellipsis,
+            )
+        }
+        Text("${whole(entry.kcal)} ${uiString(R.string.victor_food_kcal)}", style = NoopType.bodyNumber, color = Palette.textPrimary)
+        IconButton(onClick = onDelete) {
+            Icon(
+                Icons.Outlined.DeleteOutline,
+                contentDescription = uiString(R.string.victor_food_delete),
+                tint = Palette.textTertiary,
+            )
+        }
+    }
+}
+
+/** A stored thumbnail (by its path relative to the food dir), or a placeholder glyph. */
+@Composable
+internal fun FoodThumb(relativePath: String?, size: Dp) {
+    val ctx = LocalContext.current
+    val bitmap by produceState<ImageBitmap?>(null, relativePath) {
+        value = if (relativePath == null) {
+            null
+        } else {
+            withContext(Dispatchers.IO) {
+                runCatching {
+                    BitmapFactory.decodeFile(FoodStore.thumbFile(ctx, relativePath).absolutePath)?.asImageBitmap()
+                }.getOrNull()
+            }
+        }
+    }
+    ThumbBox(bitmap, Modifier.size(size))
+}
+
+@Composable
+internal fun ThumbBox(bitmap: ImageBitmap?, modifier: Modifier) {
+    Box(
+        modifier = modifier
+            .clip(RoundedCornerShape(Metrics.cornerSm))
+            .background(Palette.surfaceInset),
+        contentAlignment = Alignment.Center,
+    ) {
+        if (bitmap != null) {
+            Image(bitmap, contentDescription = null, contentScale = ContentScale.Crop, modifier = Modifier.matchParentSize())
+        } else {
+            Icon(Icons.Filled.Restaurant, contentDescription = null, tint = Palette.textTertiary, modifier = Modifier.size(Metrics.iconSmall))
+        }
+    }
+}
+
+internal fun macrosLine(t: FoodTotals): String =
+    uiString(R.string.victor_food_macros, whole(t.proteinG), whole(t.carbsG), whole(t.fatG))
+
+internal fun whole(v: Double): String = v.roundToInt().toString()
+
+private fun dayLabel(day: String, today: String, locale: Locale): String {
+    val d = runCatching { LocalDate.parse(day) }.getOrNull() ?: return day
+    val t = runCatching { LocalDate.parse(today) }.getOrNull() ?: return day
+    if (d == t.minusDays(1)) return uiString(R.string.victor_food_yesterday)
+    val pattern = if (d.year == t.year) "EEE d MMM" else "EEE d MMM yyyy"
+    return d.format(DateTimeFormatter.ofPattern(pattern, locale)).replaceFirstChar { it.titlecase(locale) }
+}
+
+/**
+ * Today's burned calories, resolved exactly like the Today "Calories" card (#616): the phone's imported
+ * active energy first (Apple Health / Health Connect), else NOOP's on-device strap estimate. Null when
+ * neither has the day.
+ */
+private suspend fun burnedOn(vm: AppViewModel, day: String): Double? {
+    val repo = vm.repo
+    val imported = (repo.appleDaily("apple-health", day, day) + repo.appleDaily("health-connect", day, day))
+        .firstNotNullOfOrNull { r -> r.activeKcal?.takeIf { it > 0 } }
+    if (imported != null) return imported
+    return repo.resolvedSeries("active_kcal", "my-whoop", day, day, strapDeviceId = vm.activeStrapId)
+        .points.firstOrNull()?.value?.takeIf { it > 0 }
+}
