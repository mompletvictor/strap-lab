@@ -0,0 +1,207 @@
+package com.noop.food
+
+import android.app.Application
+import androidx.lifecycle.AndroidViewModel
+import androidx.lifecycle.viewModelScope
+import com.noop.NoopApplication
+import com.noop.R
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import java.io.InputStream
+import java.util.UUID
+
+/**
+ * victor:food — state for [FoodScreen]: the log (from [FoodStore]) and the one open sheet. Scoped to
+ * the Food destination, so an analysis in flight survives rotation and the camera round-trip.
+ */
+class FoodViewModel(app: Application) : AndroidViewModel(app) {
+
+    private val repo = (app as NoopApplication).repository
+
+    val entries: StateFlow<List<FoodEntry>> = FoodStore.entries
+
+    private val _draft = MutableStateFlow<FoodDraft?>(null)
+    val draft: StateFlow<FoodDraft?> = _draft.asStateFlow()
+
+    /** A one-shot message (string resource) for a toast; cleared by [consumeNotice]. */
+    private val _notice = MutableStateFlow<Int?>(null)
+    val notice: StateFlow<Int?> = _notice.asStateFlow()
+
+    private var analysis: Job? = null
+
+    init {
+        viewModelScope.launch {
+            runCatching {
+                FoodStore.load(app)
+                FoodStore.reconcile(app, repo)
+            }
+        }
+    }
+
+    /** A photo arrived (camera or gallery): prepare it off the main thread and open the sheet. */
+    fun onPhoto(open: () -> InputStream?, cleanup: () -> Unit = {}) {
+        viewModelScope.launch {
+            val prepared = withContext(Dispatchers.IO) {
+                try {
+                    FoodImage.prepare(open)
+                } finally {
+                    runCatching { cleanup() }
+                }
+            }
+            if (prepared == null) {
+                _notice.value = R.string.victor_food_photo_unreadable
+                return@launch
+            }
+            val now = System.currentTimeMillis()
+            _draft.value = FoodDraft(
+                entryId = null,
+                timestamp = now,
+                day = FoodDays.dayOf(now),
+                note = "",
+                items = emptyList(),
+                photoJpeg = prepared.jpeg,
+                thumbJpeg = prepared.thumb,
+                thumbPath = null,
+                confidence = null,
+                aiNotes = null,
+                stage = FoodStage.PREPARE,
+            )
+        }
+    }
+
+    fun setNote(note: String) = _draft.update { it?.copy(note = note.take(MAX_NOTE)) }
+
+    fun analyze() {
+        val d = _draft.value ?: return
+        val jpeg = d.photoJpeg ?: return
+        _draft.value = d.copy(stage = FoodStage.ANALYZING, error = null, errorDetail = null)
+        analysis?.cancel()
+        analysis = viewModelScope.launch {
+            val result = FoodVision.analyze(getApplication(), jpeg, d.note)
+            _draft.update { cur ->
+                if (cur == null || cur.stage != FoodStage.ANALYZING) {
+                    cur
+                } else {
+                    when (result) {
+                        is FoodResult.Ok -> cur.copy(
+                            stage = FoodStage.REVIEW,
+                            analyzed = true,
+                            items = result.estimate.items.map { FoodItemDraft.of(it) },
+                            confidence = result.estimate.confidence,
+                            aiNotes = result.estimate.notes.ifBlank { null },
+                        )
+                        is FoodResult.Failed -> cur.copy(
+                            stage = FoodStage.PREPARE,
+                            error = result.error,
+                            errorDetail = result.detail,
+                        )
+                    }
+                }
+            }
+        }
+    }
+
+    fun cancelAnalysis() {
+        analysis?.cancel()
+        _draft.update { it?.copy(stage = FoodStage.PREPARE) }
+    }
+
+    /** Skip (or recover from) the analysis: an empty row to type into. */
+    fun fillByHand() = _draft.update {
+        it?.copy(
+            stage = FoodStage.REVIEW,
+            items = it.items.ifEmpty { listOf(FoodItemDraft.EMPTY) },
+            error = null,
+            errorDetail = null,
+        )
+    }
+
+    fun edit(entry: FoodEntry) {
+        analysis?.cancel()
+        _draft.value = FoodDraft(
+            entryId = entry.id,
+            timestamp = entry.timestamp,
+            day = entry.day,
+            note = entry.note,
+            items = entry.items.map { FoodItemDraft.of(it) }.ifEmpty { listOf(FoodItemDraft.EMPTY) },
+            photoJpeg = null,
+            thumbJpeg = null,
+            thumbPath = entry.thumbnailPath,
+            confidence = entry.confidence,
+            aiNotes = entry.aiNotes,
+            stage = FoodStage.REVIEW,
+            analyzed = true,
+        )
+    }
+
+    fun updateItem(index: Int, item: FoodItemDraft) = _draft.update { d ->
+        d?.copy(items = d.items.mapIndexed { i, old -> if (i == index) item else old })
+    }
+
+    fun addItem() = _draft.update { d -> d?.copy(items = d.items + FoodItemDraft.EMPTY) }
+
+    fun removeItem(index: Int) = _draft.update { d ->
+        d?.copy(items = d.items.filterIndexed { i, _ -> i != index })
+    }
+
+    fun save() {
+        val d = _draft.value ?: return
+        if (!d.canSave) return
+        val items = d.items.filter { it.isMeaningful }.map { it.toItem() }
+        val totals = FoodTotals.ofItems(items)
+        val entry = FoodEntry(
+            id = d.entryId ?: UUID.randomUUID().toString(),
+            timestamp = d.timestamp,
+            day = d.day,
+            note = d.note.trim(),
+            items = items,
+            kcal = totals.kcal,
+            proteinG = totals.proteinG,
+            carbsG = totals.carbsG,
+            fatG = totals.fatG,
+            thumbnailPath = d.thumbPath,
+            confidence = d.confidence,
+            aiNotes = d.aiNotes,
+        )
+        _draft.value = d.copy(saving = true)
+        viewModelScope.launch {
+            val ok = runCatching { FoodStore.save(getApplication(), repo, entry, d.thumbJpeg) }.isSuccess
+            if (ok) {
+                _draft.value = null
+            } else {
+                _draft.update { it?.copy(saving = false) }
+                _notice.value = R.string.victor_food_save_failed
+            }
+        }
+    }
+
+    fun discard() {
+        analysis?.cancel()
+        _draft.value = null
+    }
+
+    fun delete(entry: FoodEntry) {
+        viewModelScope.launch {
+            runCatching { FoodStore.delete(getApplication(), repo, entry.id) }
+                .onFailure { _notice.value = R.string.victor_food_delete_failed }
+        }
+    }
+
+    fun notify(message: Int) {
+        _notice.value = message
+    }
+
+    fun consumeNotice() {
+        _notice.value = null
+    }
+
+    private companion object {
+        const val MAX_NOTE = 200
+    }
+}
