+/**
+ * victor:food — "Comida": log a meal by photo, Claude estimates it, every value is editable. Shows
+ * today's totals (beside today's burned calories, resolved exactly as the Today card does), today's
+ * meals and the previous days. Registered by a three-line hook in AppRoot.
+ */
+@Composable
+fun FoodScreen(vm: AppViewModel, onOpenCoach: () -> Unit) {
+    val ctx = LocalContext.current
+    val food: FoodViewModel = viewModel()
+    val entries by food.entries.collectAsStateWithLifecycle()
+    val draft by food.draft.collectAsStateWithLifecycle()
+    val notice by food.notice.collectAsStateWithLifecycle()
+    val locale = LocalConfiguration.current.locales[0] ?: Locale.getDefault()
+
+    val today = FoodDays.today()
+    val grouped = remember(entries) { FoodDays.groupedByDay(entries) }
+    val todayEntries = grouped.firstOrNull { it.first == today }?.second.orEmpty()
+    val previous = grouped.filter { it.first != today }
+    val todayTotals = FoodTotals.ofEntries(todayEntries)
+
+    val burned by produceState<Double?>(null, today) {
+        value = withContext(Dispatchers.IO) { runCatching { burnedOn(vm, today) }.getOrNull() }
+    }
+
+    LaunchedEffect(notice) {
+        notice?.let {
+            Toast.makeText(ctx, uiString(it), Toast.LENGTH_LONG).show()
+            food.consumeNotice()
+        }
+    }
+
+    // Camera: the capture file path survives the camera round-trip (and process death) as saveable state.
+    var pendingCapture by rememberSaveable { mutableStateOf<String?>(null) }
+    val takePicture = rememberLauncherForActivityResult(ActivityResultContracts.TakePicture()) { ok ->
+        val path = pendingCapture
+        pendingCapture = null
+        if (path != null) {
+            val file = File(path)
+            if (ok) food.onPhoto(open = { FileInputStream(file) }, cleanup = { file.delete() }) else file.delete()
+        }
+    }
+    fun launchCamera() {
+        val file = FoodImage.captureFile(ctx)
+        val uri = FileProvider.getUriForFile(ctx, "${ctx.packageName}.fileprovider", file)
+        pendingCapture = file.absolutePath
+        try {
+            takePicture.launch(uri)
+        } catch (e: ActivityNotFoundException) {
+            pendingCapture = null
+            food.notify(R.string.victor_food_no_camera)
+        }
+    }
+    val cameraPermission = rememberLauncherForActivityResult(ActivityResultContracts.RequestPermission()) { granted ->
+        if (granted) launchCamera() else food.notify(R.string.victor_food_camera_denied)
+    }
+    val pickPhoto = rememberLauncherForActivityResult(ActivityResultContracts.PickVisualMedia()) { uri ->
+        if (uri != null) food.onPhoto(open = { ctx.contentResolver.openInputStream(uri) })
+    }
+
+    var confirmDelete by remember { mutableStateOf<FoodEntry?>(null) }
+
+    LazyScreenScaffold(
+        title = uiString(R.string.victor_food_title),
+        subtitle = uiString(R.string.victor_food_subtitle),
+    ) {
+        item { TodayCard(todayTotals, todayEntries.size, burned) }
+        item {
+            Row(horizontalArrangement = Arrangement.spacedBy(Metrics.space12)) {
+                NoopButton(
+                    text = uiString(R.string.victor_food_photo),
+                    leadingIcon = Icons.Filled.PhotoCamera,
+                    kind = NoopButtonKind.Primary,
+                    modifier = Modifier.weight(1f),
+                ) {
+                    if (FoodImage.cameraPermissionNeeded(ctx)) {
+                        cameraPermission.launch(Manifest.permission.CAMERA)
+                    } else {
+                        launchCamera()
+                    }
+                }
+                NoopButton(
+                    text = uiString(R.string.victor_food_gallery),
+                    leadingIcon = Icons.Filled.PhotoLibrary,
+                    kind = NoopButtonKind.Secondary,
+                    modifier = Modifier.weight(1f),
+                ) {
+                    pickPhoto.launch(PickVisualMediaRequest(ActivityResultContracts.PickVisualMedia.ImageOnly))
+                }
+            }
+        }
+        item {
+            NoopCard {
+                Column(verticalArrangement = Arrangement.spacedBy(Metrics.space8)) {
+                    Overline(uiString(R.string.victor_food_today))
+                    if (todayEntries.isEmpty()) {
+                        Text(
+                            uiString(R.string.victor_food_today_empty),
+                            style = NoopType.subhead,
+                            color = Palette.textSecondary,
+                        )
+                    } else {
+                        EntryList(todayEntries, onEdit = food::edit, onDelete = { confirmDelete = it })
+                    }
+                }
+            }
+        }
+        if (previous.isNotEmpty()) {
+            item { Overline(uiString(R.string.victor_food_previous)) }
+            items(previous, key = { it.first }) { (day, list) ->
+                DayCard(dayLabel(day, today, locale), list, onEdit = food::edit, onDelete = { confirmDelete = it })
+            }
+        }
+        item {
+            Text(
+                uiString(R.string.victor_food_privacy),
+                style = NoopType.footnote,
+                color = Palette.textTertiary,
+                modifier = Modifier.padding(bottom = Metrics.space24),
+            )
+        }
+    }
+
+    draft?.let { FoodSheet(it, food, onOpenCoach) }
+
+    confirmDelete?.let { entry ->
+        AlertDialog(
+            onDismissRequest = { confirmDelete = null },
+            containerColor = Palette.surfaceOverlay,
+            title = { Text(uiString(R.string.victor_food_delete_title), style = NoopType.title2, color = Palette.textPrimary) },
+            text = { Text(uiString(R.string.victor_food_delete_body), style = NoopType.subhead, color = Palette.textSecondary) },
+            confirmButton = {
+                TextButton(onClick = {
+                    food.delete(entry)
+                    confirmDelete = null
+                }) {
+                    Text(uiString(R.string.victor_food_delete), style = NoopType.body, color = Palette.statusCritical)
+                }
+            },
+            dismissButton = {
+                TextButton(onClick = { confirmDelete = null }) {
+                    Text(uiString(R.string.victor_food_cancel), style = NoopType.body, color = Palette.textSecondary)
+                }
+            },
+        )
+    }
+}
