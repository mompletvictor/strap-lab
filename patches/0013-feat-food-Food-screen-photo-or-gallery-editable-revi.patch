+/**
+ * victor:food — the one sheet of the food log: prepare (photo + note) → analysing → review, or the
+ * review of an existing meal. While an analysis runs or a new estimate is under review, swiping the
+ * sheet away is blocked so a paid analysis is never lost by accident; Discard/Cancel are explicit.
+ */
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+internal fun FoodSheet(draft: FoodDraft, food: FoodViewModel, onOpenCoach: () -> Unit) {
+    val dismissible by rememberUpdatedState(
+        draft.stage == FoodStage.PREPARE || (draft.entryId != null && !draft.saving),
+    )
+    val confirm = remember { { v: SheetValue -> v != SheetValue.Hidden || dismissible } }
+    val sheetState = rememberModalBottomSheetState(skipPartiallyExpanded = true, confirmValueChange = confirm)
+    val preview: ImageBitmap? = remember(draft.thumbJpeg) {
+        draft.thumbJpeg?.let { bytes ->
+            runCatching { BitmapFactory.decodeByteArray(bytes, 0, bytes.size)?.asImageBitmap() }.getOrNull()
+        }
+    }
+
+    ModalBottomSheet(
+        onDismissRequest = { food.discard() },
+        sheetState = sheetState,
+        containerColor = Palette.surfaceBase,
+        contentColor = Palette.textPrimary,
+    ) {
+        Column(
+            modifier = Modifier
+                .fillMaxWidth()
+                .imePadding()
+                .verticalScroll(rememberScrollState())
+                .padding(horizontal = Metrics.screenPadding)
+                .padding(bottom = Metrics.space24),
+            verticalArrangement = Arrangement.spacedBy(Metrics.space16),
+        ) {
+            Text(
+                uiString(if (draft.entryId != null) R.string.victor_food_sheet_edit else R.string.victor_food_sheet_new),
+                style = NoopType.title2,
+                color = Palette.textPrimary,
+            )
+            when (draft.stage) {
+                FoodStage.PREPARE -> PrepareContent(draft, preview, food, onOpenCoach)
+                FoodStage.ANALYZING -> AnalyzingContent(preview, food)
+                FoodStage.REVIEW -> ReviewContent(draft, preview, food)
+            }
+        }
+    }
+}
+
+@Composable
+private fun PrepareContent(draft: FoodDraft, preview: ImageBitmap?, food: FoodViewModel, onOpenCoach: () -> Unit) {
+    if (preview != null) {
+        ThumbBox(preview, Modifier.fillMaxWidth().height(PreviewHeight))
+    }
+    NoteField(draft.note, food::setNote)
+    draft.error?.let { ErrorCard(it, draft.errorDetail, onOpenCoach) }
+    NoopButton(
+        text = uiString(R.string.victor_food_analyze),
+        leadingIcon = Icons.Filled.AutoAwesome,
+        kind = NoopButtonKind.Primary,
+        fullWidth = true,
+        enabled = draft.photoJpeg != null,
+    ) { food.analyze() }
+    Row(horizontalArrangement = Arrangement.spacedBy(Metrics.space12)) {
+        NoopButton(
+            text = uiString(R.string.victor_food_by_hand),
+            kind = NoopButtonKind.Secondary,
+            modifier = Modifier.weight(1f),
+        ) { food.fillByHand() }
+        NoopButton(
+            text = uiString(R.string.victor_food_discard),
+            kind = NoopButtonKind.Tertiary,
+            modifier = Modifier.weight(1f),
+        ) { food.discard() }
+    }
+}
+
+@Composable
+private fun AnalyzingContent(preview: ImageBitmap?, food: FoodViewModel) {
+    if (preview != null) {
+        ThumbBox(preview, Modifier.fillMaxWidth().height(PreviewHeight))
+    }
+    Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(Metrics.space12)) {
+        CircularProgressIndicator(color = Palette.accent, modifier = Modifier.size(Metrics.iconButton))
+        Text(uiString(R.string.victor_food_analyzing), style = NoopType.subhead, color = Palette.textSecondary)
+    }
+    NoopButton(
+        text = uiString(R.string.victor_food_cancel),
+        kind = NoopButtonKind.Secondary,
+        fullWidth = true,
+    ) { food.cancelAnalysis() }
+}
+
+@Composable
+private fun ReviewContent(draft: FoodDraft, preview: ImageBitmap?, food: FoodViewModel) {
+    Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(Metrics.space12)) {
+        if (preview != null) ThumbBox(preview, Modifier.size(SmallPreview)) else FoodThumb(draft.thumbPath, SmallPreview)
+        Column(Modifier.weight(1f), verticalArrangement = Arrangement.spacedBy(Metrics.space4)) {
+            Overline(uiString(R.string.victor_food_review))
+            confidenceLabel(draft.confidence)?.let { (label, color) ->
+                Text(label, style = NoopType.caption, color = color)
+            }
+        }
+    }
+    draft.aiNotes?.let { Text(it, style = NoopType.subhead, color = Palette.textSecondary) }
+    if (draft.analyzed && draft.items.isEmpty()) {
+        Text(uiString(R.string.victor_food_no_items), style = NoopType.subhead, color = Palette.statusWarning)
+    }
+    draft.items.forEachIndexed { i, item ->
+        ItemEditor(item, onChange = { food.updateItem(i, it) }, onRemove = { food.removeItem(i) })
+    }
+    NoopButton(
+        text = uiString(R.string.victor_food_add_item),
+        leadingIcon = Icons.Filled.Add,
+        kind = NoopButtonKind.Tertiary,
+    ) { food.addItem() }
+
+    val t = draft.totals
+    NoopCard(tint = Palette.accent) {
+        Row(verticalAlignment = Alignment.CenterVertically) {
+            Column(Modifier.weight(1f), verticalArrangement = Arrangement.spacedBy(Metrics.space2)) {
+                Overline(uiString(R.string.victor_food_total))
+                Text(macrosLine(t), style = NoopType.caption, color = Palette.textSecondary)
+            }
+            Text("${whole(t.kcal)} ${uiString(R.string.victor_food_kcal)}", style = NoopType.chartValueLarge, color = Palette.textPrimary)
+        }
+    }
+
+    NoteField(draft.note, food::setNote)
+    NoopButton(
+        text = uiString(R.string.victor_food_save),
+        leadingIcon = Icons.Filled.Check,
+        kind = NoopButtonKind.Primary,
+        fullWidth = true,
+        enabled = draft.canSave,
+    ) { food.save() }
+    Row(horizontalArrangement = Arrangement.spacedBy(Metrics.space12)) {
+        if (draft.photoJpeg != null) {
+            NoopButton(
+                text = uiString(R.string.victor_food_reanalyze),
+                kind = NoopButtonKind.Secondary,
+                enabled = !draft.saving,
+                modifier = Modifier.weight(1f),
+            ) { food.analyze() }
+        }
+        NoopButton(
+            text = uiString(if (draft.entryId != null) R.string.victor_food_cancel else R.string.victor_food_discard),
+            kind = NoopButtonKind.Tertiary,
+            enabled = !draft.saving,
+            modifier = Modifier.weight(1f),
+        ) { food.discard() }
+    }
+}
+
+@Composable
+private fun ItemEditor(item: FoodItemDraft, onChange: (FoodItemDraft) -> Unit, onRemove: () -> Unit) {
+    NoopCard(padding = Metrics.space12) {
+        Column(verticalArrangement = Arrangement.spacedBy(Metrics.space8)) {
+            Row(verticalAlignment = Alignment.CenterVertically) {
+                OutlinedTextField(
+                    value = item.name,
+                    onValueChange = { onChange(item.copy(name = it.take(80))) },
+                    label = { Text(uiString(R.string.victor_food_item_name)) },
+                    singleLine = true,
+                    textStyle = NoopType.body,
+                    colors = foodFieldColors(),
+                    modifier = Modifier.weight(1f),
+                )
+                IconButton(onClick = onRemove) {
+                    Icon(Icons.Filled.Close, contentDescription = uiString(R.string.victor_food_item_remove), tint = Palette.textTertiary)
+                }
+            }
+            OutlinedTextField(
+                value = item.portion,
+                onValueChange = { onChange(item.copy(portion = it.take(60))) },
+                label = { Text(uiString(R.string.victor_food_item_portion)) },
+                singleLine = true,
+                textStyle = NoopType.body,
+                colors = foodFieldColors(),
+                modifier = Modifier.fillMaxWidth(),
+            )
+            Row(horizontalArrangement = Arrangement.spacedBy(Metrics.space8)) {
+                AmountField(item.kcal, R.string.victor_food_item_kcal, Modifier.weight(1f)) { onChange(item.copy(kcal = it)) }
+                AmountField(item.protein, R.string.victor_food_item_protein, Modifier.weight(1f)) { onChange(item.copy(protein = it)) }
+            }
+            Row(horizontalArrangement = Arrangement.spacedBy(Metrics.space8)) {
+                AmountField(item.carbs, R.string.victor_food_item_carbs, Modifier.weight(1f)) { onChange(item.copy(carbs = it)) }
+                AmountField(item.fat, R.string.victor_food_item_fat, Modifier.weight(1f)) { onChange(item.copy(fat = it)) }
+            }
+        }
+    }
+}
+
+@Composable
+private fun AmountField(value: String, labelRes: Int, modifier: Modifier, onChange: (String) -> Unit) {
+    OutlinedTextField(
+        value = value,
+        onValueChange = { v ->
+            if (v.length <= MAX_AMOUNT_CHARS && v.all { it.isDigit() || it == '.' || it == ',' }) onChange(v)
+        },
+        label = { Text(uiString(labelRes)) },
+        singleLine = true,
+        textStyle = NoopType.bodyNumber,
+        keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Decimal),
+        colors = foodFieldColors(),
+        modifier = modifier,
+    )
+}
+
+@Composable
+private fun NoteField(note: String, onChange: (String) -> Unit) {
+    OutlinedTextField(
+        value = note,
+        onValueChange = onChange,
+        label = { Text(uiString(R.string.victor_food_note_label)) },
+        placeholder = { Text(uiString(R.string.victor_food_note_hint)) },
+        maxLines = 3,
+        textStyle = NoopType.body,
+        colors = foodFieldColors(),
+        modifier = Modifier.fillMaxWidth(),
+    )
+}
+
+@Composable
+private fun ErrorCard(error: FoodError, detail: String?, onOpenCoach: () -> Unit) {
+    NoopCard(tint = Palette.statusWarning) {
+        Column(verticalArrangement = Arrangement.spacedBy(Metrics.space8)) {
+            Text(uiString(errorMessage(error)), style = NoopType.subhead, color = Palette.textPrimary)
+            if (detail != null) Text(detail, style = NoopType.footnote, color = Palette.textTertiary)
+            if (error == FoodError.NO_KEY || error == FoodError.KEY_REJECTED || error == FoodError.BAD_REQUEST) {
+                NoopButton(text = uiString(R.string.victor_food_open_coach), kind = NoopButtonKind.Tertiary) { onOpenCoach() }
+            }
+        }
+    }
+}
+
+internal fun errorMessage(error: FoodError): Int = when (error) {
+    FoodError.NO_KEY -> R.string.victor_food_err_no_key
+    FoodError.KEY_REJECTED -> R.string.victor_food_err_key
+    FoodError.BUSY -> R.string.victor_food_err_busy
+    FoodError.SERVER -> R.string.victor_food_err_server
+    FoodError.BAD_REQUEST -> R.string.victor_food_err_bad_request
+    FoodError.OFFLINE -> R.string.victor_food_err_offline
+    FoodError.TIMEOUT -> R.string.victor_food_err_timeout
+    FoodError.NETWORK -> R.string.victor_food_err_network
+    FoodError.REFUSAL -> R.string.victor_food_err_refusal
+    FoodError.UNREADABLE -> R.string.victor_food_err_unreadable
+    FoodError.IMAGE -> R.string.victor_food_err_image
+}
+
+@Composable
+private fun confidenceLabel(confidence: String?) = when (confidence) {
+    "high" -> uiString(R.string.victor_food_confidence_high) to Palette.statusPositive
+    "medium" -> uiString(R.string.victor_food_confidence_medium) to Palette.textSecondary
+    "low" -> uiString(R.string.victor_food_confidence_low) to Palette.statusWarning
+    else -> null
+}
+
+@Composable
+private fun foodFieldColors() = OutlinedTextFieldDefaults.colors(
+    focusedTextColor = Palette.textPrimary,
+    unfocusedTextColor = Palette.textPrimary,
+    disabledTextColor = Palette.textTertiary,
+    cursorColor = Palette.accent,
+    focusedBorderColor = Palette.accent,
+    unfocusedBorderColor = Palette.hairline,
+    disabledBorderColor = Palette.hairline,
+    focusedLabelColor = Palette.accent,
+    unfocusedLabelColor = Palette.textSecondary,
+    focusedPlaceholderColor = Palette.textTertiary,
+    unfocusedPlaceholderColor = Palette.textTertiary,
+    focusedContainerColor = Palette.surfaceInset,
+    unfocusedContainerColor = Palette.surfaceInset,
+    disabledContainerColor = Palette.surfaceInset,
+)
