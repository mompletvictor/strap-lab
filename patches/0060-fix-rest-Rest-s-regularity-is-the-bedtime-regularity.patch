+    // ── Bedtime regularity ────────────────────────────────────────────────────────────────────────────
+
+    /**
+     * Each local wake day's main-night span (bridged onset → wake): the day's sessions grouped by the local
+     * day they END on, the main night picked and bridged by [SleepStageTotals.mainNightGroupIndices] at that
+     * night's own UTC offset (so a DST night is read on its own clock). No learned habitual time: the pick
+     * must come from the sessions alone, so the pass and the screen cannot pick differently; it differs
+     * from the hero's only on a day whose two candidate sleeps are within 90 minutes of each other.
+     */
+    fun mainNightSpans(sleeps: List<SleepSession>, zone: ZoneId = ZoneId.systemDefault()): SortedMap<String, Pair<Long, Long>> {
+        val out = java.util.TreeMap<String, Pair<Long, Long>>()
+        val byDay = sleeps.filter { it.endTs > it.effectiveStartTs }
+            .groupBy { Instant.ofEpochSecond(it.endTs).atZone(zone).toLocalDate().toString() }
+        for ((day, blocks) in byDay) {
+            val sorted = blocks.sortedBy { it.effectiveStartTs }
+            val offset = zone.rules.getOffset(Instant.ofEpochSecond(sorted.last().endTs)).totalSeconds.toLong()
+            val idx = SleepStageTotals.mainNightGroupIndices(
+                sorted.map { SleepStageTotals.NightBlock(it.effectiveStartTs, it.endTs) }, offset, null,
+            ) ?: continue
+            out[day] = idx.minOf { sorted[it].effectiveStartTs } to idx.maxOf { sorted[it].endTs }
+        }
+        return out
+    }
+
+    /** The main-night spans that score [day]: the last 14 within 28 days up to and including it. */
+    fun regularityWindow(spans: SortedMap<String, Pair<Long, Long>>, day: String): List<Pair<Long, Long>> {
+        val from = runCatching { LocalDate.parse(day).minusDays(REGULARITY_WINDOW_DAYS - 1L).toString() }
+            .getOrDefault(day)
+        return spans.subMap(from, day + "\u0000").values.toList().takeLast(REGULARITY_WINDOW_NIGHTS)
+    }
+
+    /**
+     * Circular standard deviation (minutes) of clock times given as minutes after midnight: bedtimes on a
+     * 24-hour circle, so 23:50 and 00:10 are 20 minutes apart and a day sleeper's spread reads like anyone
+     * else's (the card used to fold onsets before noon onto the next day, which broke for onsets near noon).
+     * For spreads of an hour or two it equals the ordinary SD within seconds.
+     */
+    fun circularSdMinutes(minutesOfDay: List<Double>): Double {
+        if (minutesOfDay.isEmpty()) return 0.0
+        val k = 2.0 * PI / 1440.0
+        val c = minutesOfDay.sumOf { cos(it * k) } / minutesOfDay.size
+        val s = minutesOfDay.sumOf { sin(it * k) } / minutesOfDay.size
+        val r = hypot(c, s).coerceAtMost(1.0)
+        if (r <= 0.0) return Double.POSITIVE_INFINITY
+        return sqrt(-2.0 * ln(r)) / k
+    }
+
+    /**
+     * Pure: each night's bedtime regularity (0..1), from the merged sleep sessions the Sleep screen reads.
+     * `1 - SD / 120 min` of the local bedtimes (the main night's bridged onset, [mainNightSpans]) of the
+     * nights in [regularityWindow], clamped; null under [REGULARITY_MIN_NIGHTS]. [importedPct] is WHOOP's own
+     * imported consistency (0..100) by day, which wins its night.
+     */
+    fun bedtimeRegularity(
+        sleeps: List<SleepSession>,
+        importedPct: Map<String, Double> = emptyMap(),
+        zone: ZoneId = ZoneId.systemDefault(),
+    ): Map<String, Double> {
+        val spans = mainNightSpans(sleeps, zone)
+        val out = LinkedHashMap<String, Double>(spans.size * 2)
+        for (day in spans.keys) {
+            val window = regularityWindow(spans, day)
+            if (window.size < REGULARITY_MIN_NIGHTS) continue
+            val minutes = window.map { (onset, _) ->
+                val t = Instant.ofEpochSecond(onset).atZone(zone)
+                t.hour * 60.0 + t.minute + t.second / 60.0
+            }
+            out[day] = (1.0 - circularSdMinutes(minutes) / BEDTIME_SD_ZERO_MIN).coerceIn(0.0, 1.0)
+        }
+        return withImported(out, importedPct)
+    }
+
+    /**
+     * [regularityByDay] with WHOOP's imported consistency (0..100) winning its night, the card's old
+     * precedence. The same instance back when nothing changes (the published map already carries them), so
+     * a screen's memo holds.
+     */
+    fun withImported(regularityByDay: Map<String, Double>, importedPct: Map<String, Double>): Map<String, Double> {
+        if (importedPct.all { (day, pct) -> regularityByDay[day] == (pct / 100.0).coerceIn(0.0, 1.0) }) {
+            return regularityByDay
+        }
+        val out = LinkedHashMap(regularityByDay)
+        for ((day, pct) in importedPct) out[day] = (pct / 100.0).coerceIn(0.0, 1.0)
+        return out
+    }
