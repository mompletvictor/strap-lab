--- /dev/null
+++ b/android/app/src/main/java/com/noop/ingest/VictorHcRefresh.kt
@@ -0,0 +1,218 @@
+package com.noop.ingest
+
+import android.content.Context
+import androidx.health.connect.client.HealthConnectClient
+import androidx.health.connect.client.records.ActiveCaloriesBurnedRecord
+import androidx.health.connect.client.records.BloodPressureRecord
+import androidx.health.connect.client.records.BodyFatRecord
+import androidx.health.connect.client.records.LeanBodyMassRecord
+import androidx.health.connect.client.records.Record
+import androidx.health.connect.client.records.StepsRecord
+import androidx.health.connect.client.records.TotalCaloriesBurnedRecord
+import androidx.health.connect.client.records.WeightRecord
+import androidx.health.connect.client.request.ReadRecordsRequest
+import androidx.health.connect.client.time.TimeRangeFilter
+import com.noop.analytics.ScaleBody
+import com.noop.data.AppleDaily
+import com.noop.data.LabMarkerRow
+import com.noop.data.MetricSeriesRow
+import com.noop.data.WhoopRepository
+import com.noop.ui.HealthConnectWeightSync
+import com.noop.ui.ProfileStore
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+import java.time.Instant
+import java.time.LocalDate
+import java.time.ZoneId
+import kotlin.math.round
+import kotlin.reflect.KClass
+
+/**
+ * victor:fresh — keeps what changes during the day current between the full Health Connect imports, which
+ * run on app open at most every 6-24 h and read ten years. This reads the last two local days of steps and
+ * calories, the smart-scale weigh-in (weight, body fat, lean mass, bone, water, BMR) and blood pressure, so
+ * it can run every time Today comes to the front and before every AI Coach reply: a morning weigh-in then
+ * reaches the coach, the Food balance and the profile weight, not only the «Mi día» card.
+ *
+ * Same rules as [HealthConnectImporter.import] for the days it touches (per-source sums with the max across
+ * sources, the latest reading of the day, our own writes skipped), the same category selection and grants,
+ * and it only ever fills or updates columns: a zero or a missing read never blanks a stored figure.
+ */
+object VictorHcRefresh {
+
+    /** Today's screen and the coach can both ask within seconds; one read serves both. */
+    private const val MIN_INTERVAL_MS = 2 * 60_000L
+    private const val PAGE_SIZE = 5000
+
+    private val lock = Mutex()
+    @Volatile private var lastRunMs = 0L
+
+    private val _version = MutableStateFlow(0)
+    /** Bumped after every refresh that wrote something, so screens that read the store can reload. */
+    val version: StateFlow<Int> = _version.asStateFlow()
+
+    /** Best-effort; true when it wrote something. Never throws. */
+    suspend fun refresh(ctx: Context, repo: WhoopRepository): Boolean = withContext(Dispatchers.IO) {
+        lock.withLock {
+            if (System.currentTimeMillis() - lastRunMs < MIN_INTERVAL_MS) return@withLock false
+            val wrote = runCatching { run(ctx.applicationContext, repo) }.getOrDefault(false)
+            lastRunMs = System.currentTimeMillis()
+            if (wrote) _version.value++
+            wrote
+        }
+    }
+
+    private class DayAcc {
+        val steps = HashMap<String, Long>()
+        val totalKcal = HashMap<String, Double>()
+        val activeKcal = HashMap<String, Double>()
+    }
+
+    private suspend fun run(ctx: Context, repo: WhoopRepository): Boolean {
+        if (HealthConnectImporter.sdkStatus(ctx) != HealthConnectClient.SDK_AVAILABLE) return false
+        val client = HealthConnectImporter.client(ctx)
+        val granted = client.permissionController.getGrantedPermissions()
+        val types = HealthConnectImporter.readableRecordTypes(HealthConnectImporter.selectedCategories(ctx), granted)
+        if (types.isEmpty()) return false
+
+        val zone = ZoneId.systemDefault()
+        val today = LocalDate.now(zone)
+        val days = listOf(today.minusDays(1).toString(), today.toString())
+        // #1002 slack, as upstream's live steps top-up: a record keyed by its own offset can start before
+        // the phone's midnight. Only records that land on [days] are kept, so each kept day is read whole.
+        val filter = TimeRangeFilter.between(today.minusDays(2).atStartOfDay(zone).toInstant(), Instant.now())
+        val self = ctx.packageName
+        fun dayOf(at: Instant, offset: java.time.ZoneOffset?): String? =
+            HealthConnectImporter.localDayKey(at, offset, zone).takeIf { it in days }
+
+        suspend fun <T : Record> read(type: KClass<T>, onRecord: (T) -> Unit) {
+            if (type in types) readAll(client, type, filter, self, onRecord)
+        }
+
+        val acc = days.associateWith { DayAcc() }
+        read(StepsRecord::class) { r ->
+            dayOf(r.startTime, r.startZoneOffset)?.let { acc.getValue(it).steps.merge(r.metadata.dataOrigin.packageName, r.count) { a, b -> a + b } }
+        }
+        read(TotalCaloriesBurnedRecord::class) { r ->
+            dayOf(r.startTime, r.startZoneOffset)?.let {
+                acc.getValue(it).totalKcal.merge(r.metadata.dataOrigin.packageName, r.energy.inKilocalories) { a, b -> a + b }
+            }
+        }
+        read(ActiveCaloriesBurnedRecord::class) { r ->
+            dayOf(r.startTime, r.startZoneOffset)?.let {
+                acc.getValue(it).activeKcal.merge(r.metadata.dataOrigin.packageName, r.energy.inKilocalories) { a, b -> a + b }
+            }
+        }
+
+        val scale = ScaleImport.Accumulator()
+        read(WeightRecord::class) { r ->
+            dayOf(r.time, r.zoneOffset)?.let { scale.add(it, ScaleBody.KEY_WEIGHT, r.time.epochSecond, r.weight.inKilograms) }
+        }
+        read(BodyFatRecord::class) { r ->
+            dayOf(r.time, r.zoneOffset)?.let { scale.add(it, ScaleBody.KEY_BODY_FAT, r.time.epochSecond, r.percentage.value) }
+        }
+        read(LeanBodyMassRecord::class) { r ->
+            dayOf(r.time, r.zoneOffset)?.let { scale.add(it, ScaleBody.KEY_LEAN_MASS, r.time.epochSecond, r.mass.inKilograms) }
+        }
+        for (type in ScaleImport.RECORD_TYPES) {
+            @Suppress("UNCHECKED_CAST")
+            read(type as KClass<Record>) { r ->
+                val e = ScaleImport.entry(r)
+                val at = ScaleImport.stamp(r)
+                if (e != null && at != null) dayOf(at.first, at.second)?.let { scale.add(it, e.first, at.first.epochSecond, e.second) }
+            }
+        }
+
+        val bloodPressure = ArrayList<LabMarkerRow>()
+        read(BloodPressureRecord::class) { r ->
+            if (dayOf(r.time, r.zoneOffset) != null) {
+                bloodPressure += HealthConnectImporter.bloodPressureRows(
+                    r.systolic.inMillimetersOfMercury, r.diastolic.inMillimetersOfMercury, r.time,
+                )
+            }
+        }
+
+        val scaleRows = scale.rows(HealthConnectImporter.HC_DEVICE)
+        val weightByDay = scaleRows.filter { it.key == ScaleBody.KEY_WEIGHT }.associate { it.day to it.value }
+        val existing = repo.appleDaily(HealthConnectImporter.HC_DEVICE, days.first(), days.last()).associateBy { it.day }
+        val apple = days.mapNotNull { day ->
+            val a = acc.getValue(day)
+            merge(
+                existing[day], day,
+                steps = HealthConnectImporter.maxSourceLong(a.steps),
+                totalKcal = HealthConnectImporter.maxSourceDouble(a.totalKcal),
+                activeKcal = HealthConnectImporter.maxSourceDouble(a.activeKcal),
+                weightKg = weightByDay[day],
+            )
+        }
+        val heightCm = runCatching { ProfileStore.from(ctx).heightCm }.getOrDefault(0.0)
+        val series = scaleRows + weightByDay.mapNotNull { (day, kg) ->
+            HealthConnectImporter.derivedBmi(kg, heightCm)?.let { MetricSeriesRow(HealthConnectImporter.HC_DEVICE, day, "bmi", it) }
+        }
+
+        if (apple.isNotEmpty()) {
+            repo.upsertDevice(HealthConnectImporter.HC_DEVICE, name = "Health Connect")
+            repo.upsertAppleDaily(apple)
+        }
+        if (series.isNotEmpty()) repo.upsertMetricSeries(series)
+        if (bloodPressure.isNotEmpty()) repo.upsertLabMarkers(bloodPressure)
+        ScaleImport.rememberNewest(ctx, scale, onlyNewer = true)
+        if (weightByDay.isNotEmpty()) runCatching { HealthConnectWeightSync.syncFromRepository(ctx, repo) }
+        return apple.isNotEmpty() || series.isNotEmpty() || bloodPressure.isNotEmpty()
+    }
+
+    /**
+     * Pure: [existing] (the stored Health Connect row for [day], or null) with the fresh figures laid over
+     * it, exactly as the full import would write them; null when nothing changes. A zero or null figure
+     * keeps the stored one: "nothing read" must never wipe a good number.
+     */
+    internal fun merge(
+        existing: AppleDaily?,
+        day: String,
+        steps: Long,
+        totalKcal: Double,
+        activeKcal: Double,
+        weightKg: Double?,
+    ): AppleDaily? {
+        val base = existing ?: AppleDaily(deviceId = HealthConnectImporter.HC_DEVICE, day = day)
+        val basal = if (totalKcal > 0.0) (totalKcal - activeKcal).takeIf { it > 0.0 }?.let(::round1) else null
+        val updated = base.copy(
+            steps = if (steps > 0L) steps.toInt() else base.steps,
+            activeKcal = if (activeKcal > 0.0) round1(activeKcal) else base.activeKcal,
+            basalKcal = basal ?: base.basalKcal,
+            weightKg = weightKg?.let(::round2) ?: base.weightKg,
+        )
+        return updated.takeIf { it != base }
+    }
+
+    private suspend fun <T : Record> readAll(
+        client: HealthConnectClient,
+        type: KClass<T>,
+        filter: TimeRangeFilter,
+        selfPackage: String,
+        onRecord: (T) -> Unit,
+    ) {
+        var pageToken: String? = null
+        try {
+            do {
+                val response = client.readRecords(ReadRecordsRequest(type, filter, pageSize = PAGE_SIZE, pageToken = pageToken))
+                for (record in response.records) {
+                    if (HealthConnectImporter.isSelfWritten(record.metadata.dataOrigin.packageName, selfPackage)) continue
+                    onRecord(record)
+                }
+                pageToken = response.pageToken
+            } while (pageToken != null)
+        } catch (e: Exception) {
+            // A type that fails is simply left as stored, like the full import's per-type catch (#34).
+            if (e is kotlin.coroutines.cancellation.CancellationException) throw e
+        }
+    }
+
+    private fun round1(x: Double) = round(x * 10.0) / 10.0
+    private fun round2(x: Double) = round(x * 100.0) / 100.0
+}
