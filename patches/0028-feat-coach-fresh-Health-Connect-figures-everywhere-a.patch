+package com.noop.ai
+
+import com.noop.analytics.DaytimeStress
+import java.time.ZoneId
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+/** victor:coach-stress — the coach sees the Stress screen's own 0-3 score. */
+class VictorCoachStressTest {
+    private val zone = ZoneId.of("Europe/Madrid")
+
+    @Test
+    fun dailyScoreTrendAndTodayByTheHour() {
+        val peak = DaytimeStress.HourPoint(hour = 11, startTs = 0, level = 2.61, meanHr = 88.0, rmssd = 22.0)
+        val today = DaytimeStress.Result(
+            hours = listOf(peak), sustainedHigh = true, sustainedRun = 2, dayMean = 1.44, peak = peak,
+            activityMaskedHours = 1, highStressMinutes = 120,
+        )
+        val daily = VictorCoachStress.Daily(
+            day = "2026-10-18", score = 1.23, rhrDelta = 3.4, hrvDelta = -8.2,
+            trend = listOf("2026-10-16" to 0.8, "2026-10-17" to 1.06),
+        )
+        assertEquals(
+            "STRESS (the app's Stress screen, 0-3: under 1 low, 1-2 medium, 2+ high; resting HR up and HRV down vs " +
+                "the user's previous 30 days): 2026-10-18 1.2 medium (resting HR +3 bpm, HRV -8 ms vs baseline); " +
+                "earlier days 10-16 0.8, 10-17 1.1; today by the hour (waking hours, average 1.4, peak 2.6 at 11:00, " +
+                "120 min in high, 1 h left out as exercise, high for the last 2 h)",
+            VictorCoachStress.line(daily, today, zone),
+        )
+    }
+
+    @Test
+    fun noScoreAndNoScoredHourMeansNoLine() {
+        assertNull(VictorCoachStress.line(null, null, zone))
+        assertNull(VictorCoachStress.line(null, DaytimeStress.Result.EMPTY, zone))
+    }
+}
