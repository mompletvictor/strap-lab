+import java.time.ZoneId
+import java.util.Locale
+import kotlin.math.roundToInt
+
+/**
+ * victor:coach-stress — the STRESS line: the same 0-3 score, band and recent days the Stress screen shows
+ * ([StressModel], resting HR up + HRV down against the previous 30 days), plus today hour by hour from the
+ * same [DaytimeStress] read the screen draws. Upstream's coach only had a Baevsky index over today's beats,
+ * a different number from the one on screen, so the coach and the app could disagree about the same day.
+ */
+internal object VictorCoachStress {
+
+    private const val TREND_DAYS = 7
+
+    suspend fun line(ctx: Context, repo: WhoopRepository, strapId: String, zone: ZoneId = ZoneId.systemDefault()): String? {
+        val days = repo.daysMerged(strapId)
+        // The screen's own read: the stored daily "stress" values under the canonical id, 0-3.
+        val stored = runCatching { repo.metricSeries(WhoopRepository.WHOOP_SOURCE, "stress", "0000-01-01", "9999-12-31") }
+            .getOrDefault(emptyList())
+            .associate { it.day to it.value.coerceIn(0.0, 3.0) }
+        val model = StressModel.build(days, stored)
+        val today = runCatching { todayByHour(ctx, repo, strapId, zone) }.getOrNull()
+        val daily = model?.let { m ->
+            Daily(
+                day = m.fullTrend.lastOrNull()?.day,
+                score = m.score,
+                rhrDelta = m.rhrDelta,
+                hrvDelta = m.hrvDelta,
+                trend = m.fullTrend.dropLast(1).takeLast(TREND_DAYS - 1).map { it.day to it.value },
+            )
+        }
+        return line(daily, today, zone)
+    }
+
+    internal data class Daily(
+        val day: String?,
+        val score: Double,
+        val rhrDelta: Double?,
+        val hrvDelta: Double?,
+        /** Earlier days, oldest first. */
+        val trend: List<Pair<String, Double>>,
+    )
+
+    /** Pure: null when there is neither a daily score nor a scored hour today. */
+    internal fun line(daily: Daily?, today: DaytimeStress.Result?, zone: ZoneId): String? {
+        val parts = ArrayList<String>()
+        daily?.let { d ->
+            val deltas = listOfNotNull(
+                d.rhrDelta?.let { "resting HR ${signed(it)} bpm" },
+                d.hrvDelta?.let { "HRV ${signed(it)} ms" },
+            )
+            val vs = if (deltas.isEmpty()) "" else " (${deltas.joinToString(", ")} vs baseline)"
+            parts += "${d.day ?: "latest"} ${f1(d.score)} ${band(d.score)}$vs"
+            if (d.trend.isNotEmpty()) {
+                parts += "earlier days " + d.trend.joinToString(", ") { (day, v) -> "${day.substring(5)} ${f1(v)}" }
+            }
+        }
+        today?.takeIf { it.dayMean != null }?.let { t ->
+            val bits = buildList {
+                add("average ${f1(t.dayMean!!)}")
+                t.peak?.let { p -> p.level?.let { add("peak ${f1(it)} at ${"%02d".format(Locale.ROOT, p.hour)}:00") } }
+                add("${t.highStressMinutes} min in high")
+                if (t.activityMaskedHours > 0) add("${t.activityMaskedHours} h left out as exercise")
+                if (t.sustainedHigh) add("high for the last ${t.sustainedRun} h")
+            }
+            parts += "today by the hour (waking hours, " + bits.joinToString(", ") + ")"
+        }
+        if (parts.isEmpty()) return null
+        return "STRESS (the app's Stress screen, 0-3: under 1 low, 1-2 medium, 2+ high; resting HR up and HRV " +
+            "down vs the user's previous 30 days): " + parts.joinToString("; ")
+    }
+
+    /** The screen's intraday read ([DaytimeStress], hourly), without the half-hour display timeline. */
+    private suspend fun todayByHour(ctx: Context, repo: WhoopRepository, strapId: String, zone: ZoneId): DaytimeStress.Result? =
+        withContext(Dispatchers.Default) {
+            val now = System.currentTimeMillis() / 1000L
+            val window = stressLocalDayWindowContaining(now, zone)
+            val hr = repo.hrSamplesUnion(strapId, window.fromEpochSecond, now, limit = 200_000)
+            if (hr.size < DaytimeStress.minHourHrSamples) return@withContext null
+            val rr = repo.rrIntervalsUnion(strapId, window.fromEpochSecond, now, limit = 200_000)
+            val gravity = repo.gravitySamplesUnion(strapId, window.fromEpochSecond, now, limit = 200_000)
+            val tz = zone.rules.getOffset(Instant.ofEpochSecond(now)).totalSeconds.toLong()
+            val mode = selectedDaytimeStressMode(repo, strapId, window.day, zone, NoopPrefs.stressPersonalBaseline(ctx))
+            DaytimeStress.analyze(hr, rr, gravity, tz, mode)
+        }
+
+    private fun band(score: Double) = when (StressBand.forScore(score)) {
+        StressBand.Low -> "low"
+        StressBand.Medium -> "medium"
+        StressBand.High -> "high"
+    }
+
+    private fun f1(v: Double) = String.format(Locale.ROOT, "%.1f", v)
+
+    private fun signed(v: Double): String = v.roundToInt().let { if (it > 0) "+$it" else "$it" }
+}
