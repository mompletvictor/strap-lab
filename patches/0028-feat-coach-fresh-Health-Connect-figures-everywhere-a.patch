+package com.noop.ai
+
+import android.content.Context
+import androidx.room.Room
+import com.noop.analytics.HydrationStore
+import com.noop.data.DailyMetric
+import com.noop.data.MetricSeriesRow
+import com.noop.data.WhoopDatabase
+import com.noop.data.WhoopRepository
+import com.noop.ui.ProfileStore
+import kotlinx.coroutines.runBlocking
+import org.junit.After
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.annotation.Config
+import java.time.LocalDate
+
+/**
+ * victor:fresh — the coach's data block end to end over a real (in-memory) store: once this morning's
+ * weigh-in is in the store, the coach quotes it, and the Settings weight no longer competes with it.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34], manifest = Config.NONE)
+class VictorCoachBlockTest {
+
+    private val ctx: Context = RuntimeEnvironment.getApplication()
+    private lateinit var db: WhoopDatabase
+    private lateinit var repo: WhoopRepository
+
+    @Before
+    fun setUp() {
+        db = Room.inMemoryDatabaseBuilder(ctx, WhoopDatabase::class.java).allowMainThreadQueries().build()
+        repo = WhoopRepository(db)
+    }
+
+    @After
+    fun tearDown() = db.close()
+
+    @Test
+    fun todaysWeighInReachesTheCoachAndEverySectionIsThere() = runBlocking {
+        val today = LocalDate.now()
+        ProfileStore.from(ctx).weightKg = 80.0   // typed once in Settings, never updated
+        repo.upsertMetricSeries(
+            listOf(
+                MetricSeriesRow("health-connect", today.minusDays(1).toString(), "weight", 79.1),
+                MetricSeriesRow("health-connect", today.toString(), "weight", 78.4),
+            ),
+        )
+        // A fortnight of strap days, so the Stress screen's score has a baseline to compare with.
+        repo.upsertDailyMetrics(
+            (0..14).map { i ->
+                DailyMetric(
+                    deviceId = "my-whoop", day = today.minusDays(14L - i).toString(),
+                    totalSleepMin = 420.0, restingHr = 55 + i % 3, avgHrv = 60.0 + i % 5,
+                )
+            },
+        )
+        HydrationStore.log(repo, 500)
+
+        val block = VictorCoachExtras.block(ctx, repo, "my-whoop")!!
+
+        assertTrue(block, block.startsWith("DATA AS OF $today"))
+        assertTrue(block, block.contains("weight: see BODY"))
+        assertTrue(block, block.contains("BODY (smart scale, latest $today"))
+        assertTrue(block, block.contains("weight 78.4 kg"))
+        assertFalse(block, block.contains("80.0 kg"))
+        assertTrue(block, block.contains("STRESS (the app's Stress screen"))
+        assertTrue(block, block.contains("WATER: today 500 ml so far"))
+    }
+}
