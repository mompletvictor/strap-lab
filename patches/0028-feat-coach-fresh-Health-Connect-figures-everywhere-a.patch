+package com.noop.ingest
+
+import com.noop.data.AppleDaily
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+/** victor:fresh — the two-day Health Connect top-up only ever fills or updates, never blanks. */
+class VictorHcRefreshTest {
+
+    private val stored = AppleDaily(
+        deviceId = "health-connect", day = "2026-10-18",
+        steps = 1200, activeKcal = 80.0, basalKcal = 600.0, vo2max = 44.0, avgHr = 71, weightKg = 79.10,
+    )
+
+    @Test
+    fun morningWeighInReplacesYesterdaysWeightAndKeepsEverythingElse() {
+        val row = VictorHcRefresh.merge(stored, "2026-10-18", steps = 3400, totalKcal = 900.0, activeKcal = 150.0, weightKg = 78.456)!!
+        assertEquals(3400, row.steps)
+        assertEquals(150.0, row.activeKcal!!, 0.0)
+        assertEquals(750.0, row.basalKcal!!, 0.0)
+        assertEquals(78.46, row.weightKg!!, 0.0)
+        assertEquals(44.0, row.vo2max!!, 0.0)
+        assertEquals(71, row.avgHr)
+    }
+
+    @Test
+    fun nothingReadNeverWipesAStoredFigure() {
+        assertNull(VictorHcRefresh.merge(stored, "2026-10-18", steps = 0, totalKcal = 0.0, activeKcal = 0.0, weightKg = null))
+    }
+
+    @Test
+    fun aDayWithNoStoredRowStartsOne() {
+        val row = VictorHcRefresh.merge(null, "2026-10-18", steps = 0, totalKcal = 0.0, activeKcal = 0.0, weightKg = 78.4)!!
+        assertEquals("health-connect", row.deviceId)
+        assertEquals("2026-10-18", row.day)
+        assertEquals(78.4, row.weightKg!!, 0.0)
+        assertNull(row.steps)
+    }
+
+    @Test
+    fun basalIsTotalMinusActiveLikeTheFullImport() {
+        val onlyTotal = VictorHcRefresh.merge(null, "2026-10-18", steps = 0, totalKcal = 1500.0, activeKcal = 0.0, weightKg = null)!!
+        assertEquals(1500.0, onlyTotal.basalKcal!!, 0.0)
+        assertNull(onlyTotal.activeKcal)
+        val activeAboveTotal = VictorHcRefresh.merge(stored, "2026-10-18", steps = 0, totalKcal = 100.0, activeKcal = 300.0, weightKg = null)!!
+        assertEquals(600.0, activeAboveTotal.basalKcal!!, 0.0)
+        assertEquals(300.0, activeAboveTotal.activeKcal!!, 0.0)
+    }
+}
