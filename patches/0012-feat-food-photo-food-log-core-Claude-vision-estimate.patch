--- /dev/null
+++ b/android/app/src/test/java/com/noop/food/FoodVisionRequestTest.kt
@@ -0,0 +1,90 @@
+package com.noop.food
+
+import org.json.JSONObject
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** victor:food — the Messages API body for a photo: shape, structured output, and the banned params. */
+class FoodVisionRequestTest {
+
+    private val banned = listOf("temperature", "top_p", "top_k", "thinking", "tool_choice")
+
+    @Test
+    fun structuredBodyCarriesImageThenTextAndTheSchema() {
+        val body = FoodVision.buildRequestBody("claude-opus-5-5", "QUJD", "media ración", structured = true)
+
+        assertEquals(setOf("model", "max_tokens", "messages", "output_config"), body.keySet())
+        assertEquals("claude-opus-5-5", body.getString("model"))
+        assertEquals(16000, body.getInt("max_tokens"))
+
+        val messages = body.getJSONArray("messages")
+        assertEquals(1, messages.length())
+        val msg = messages.getJSONObject(0)
+        assertEquals("user", msg.getString("role"))
+        val content = msg.getJSONArray("content")
+        assertEquals(2, content.length())
+
+        val image = content.getJSONObject(0)
+        assertEquals("image", image.getString("type"))
+        val source = image.getJSONObject("source")
+        assertEquals("base64", source.getString("type"))
+        assertEquals("image/jpeg", source.getString("media_type"))
+        assertEquals("QUJD", source.getString("data"))
+
+        val text = content.getJSONObject(1)
+        assertEquals("text", text.getString("type"))
+        assertTrue(text.getString("text").contains("\"media ración\""))
+        assertTrue(text.getString("text").contains("Spanish"))
+
+        val format = body.getJSONObject("output_config").getJSONObject("format")
+        assertEquals("json_schema", format.getString("type"))
+        assertEquals(FoodVision.outputSchema().toString(), format.getJSONObject("schema").toString())
+    }
+
+    @Test
+    fun neverSendsParamsClaude5Rejects() {
+        for (structured in listOf(true, false)) {
+            val body = FoodVision.buildRequestBody("m", "x", "", structured)
+            for (k in banned) assertFalse("$k must not be sent", body.has(k))
+            assertFalse(body.toString().contains("\"temperature\""))
+        }
+    }
+
+    @Test
+    fun fallbackBodyDropsOutputConfigAndAsksForJsonInThePrompt() {
+        val body = FoodVision.buildRequestBody("m", "x", "  ", structured = false)
+        assertEquals(setOf("model", "max_tokens", "messages"), body.keySet())
+        val prompt = body.getJSONArray("messages").getJSONObject(0).getJSONArray("content")
+            .getJSONObject(1).getString("text")
+        assertTrue(prompt.contains("(none)"))
+        assertTrue(prompt.contains("ONLY one JSON object"))
+        assertTrue(prompt.contains("\"total_kcal\""))
+    }
+
+    @Test
+    fun schemaIsStrictAndRequiresEveryField() {
+        val schema = FoodVision.outputSchema()
+        assertFalse(schema.getBoolean("additionalProperties"))
+        assertEquals(keysOf(schema.getJSONObject("properties")), requiredOf(schema))
+
+        val item = schema.getJSONObject("properties").getJSONObject("items").getJSONObject("items")
+        assertFalse(item.getBoolean("additionalProperties"))
+        assertEquals(
+            setOf("name", "portion", "kcal", "protein_g", "carbs_g", "fat_g"),
+            requiredOf(item),
+        )
+        assertEquals(keysOf(item.getJSONObject("properties")), requiredOf(item))
+
+        val confidence = schema.getJSONObject("properties").getJSONObject("confidence").getJSONArray("enum")
+        assertEquals(listOf("low", "medium", "high"), (0 until confidence.length()).map { confidence.getString(it) })
+    }
+
+    private fun keysOf(o: JSONObject): Set<String> = o.keySet().toSet()
+
+    private fun requiredOf(o: JSONObject): Set<String> {
+        val arr = o.getJSONArray("required")
+        return (0 until arr.length()).map { arr.getString(it) }.toSet()
+    }
