@@ -0,0 +1,94 @@
+package com.noop.food
+
+import java.util.Locale
+import kotlin.math.roundToLong
+
+/** victor:food — one item as the review sheet edits it: numbers stay text until saved. */
+data class FoodItemDraft(
+    val name: String,
+    val portion: String,
+    val kcal: String,
+    val protein: String,
+    val carbs: String,
+    val fat: String,
+) {
+    fun toItem() = FoodItem(
+        name = name.trim(),
+        portion = portion.trim(),
+        kcal = parseAmount(kcal),
+        proteinG = parseAmount(protein),
+        carbsG = parseAmount(carbs),
+        fatG = parseAmount(fat),
+    )
+
+    /** Worth saving: named, or carrying energy. */
+    val isMeaningful: Boolean get() = name.isNotBlank() || parseAmount(kcal) > 0.0
+
+    companion object {
+        val EMPTY = FoodItemDraft("", "", "", "", "", "")
+
+        fun of(i: FoodItem) = FoodItemDraft(
+            name = i.name,
+            portion = i.portion,
+            kcal = formatAmount(i.kcal),
+            protein = formatAmount(i.proteinG),
+            carbs = formatAmount(i.carbsG),
+            fat = formatAmount(i.fatG),
+        )
+
+        /** "12,5" and "12.5" both read as 12.5; blank, junk, negative → 0. */
+        fun parseAmount(s: String): Double =
+            round1(s.trim().replace(',', '.').toDoubleOrNull() ?: 0.0)
+
+        /** Whole numbers without decimals, otherwise one decimal. Locale-free so it parses back. */
+        fun formatAmount(v: Double): String {
+            val r = round1(v)
+            return if (r == r.roundToLong().toDouble()) r.roundToLong().toString()
+            else String.format(Locale.ROOT, "%.1f", r)
+        }
+    }
+}
+
+enum class FoodStage { PREPARE, ANALYZING, REVIEW }
+
+/**
+ * victor:food — the sheet's working copy of a meal: a new photo on its way through analysis, or an
+ * existing entry being edited ([entryId] set). [photoJpeg] lives only in memory. A plain class (not a
+ * data class) on purpose: it holds byte arrays, and every update must reach the StateFlow.
+ */
+class FoodDraft(
+    val entryId: String?,
+    val timestamp: Long,
+    val day: String,
+    val note: String,
+    val items: List<FoodItemDraft>,
+    val photoJpeg: ByteArray?,
+    val thumbJpeg: ByteArray?,
+    val thumbPath: String?,
+    val confidence: String?,
+    val aiNotes: String?,
+    val stage: FoodStage,
+    /** True once Claude has answered for this photo (an empty item list then means "no food seen"). */
+    val analyzed: Boolean = false,
+    val error: FoodError? = null,
+    val errorDetail: String? = null,
+    val saving: Boolean = false,
+) {
+    fun copy(
+        note: String = this.note,
+        items: List<FoodItemDraft> = this.items,
+        confidence: String? = this.confidence,
+        aiNotes: String? = this.aiNotes,
+        stage: FoodStage = this.stage,
+        analyzed: Boolean = this.analyzed,
+        error: FoodError? = this.error,
+        errorDetail: String? = this.errorDetail,
+        saving: Boolean = this.saving,
+    ) = FoodDraft(
+        entryId, timestamp, day, note, items, photoJpeg, thumbJpeg, thumbPath,
+        confidence, aiNotes, stage, analyzed, error, errorDetail, saving,
+    )
+
+    val totals: FoodTotals get() = FoodTotals.ofItems(items.map { it.toItem() })
+    val canSave: Boolean get() = !saving && items.any { it.isMeaningful }
+}
diff --git a/android/app/src/main/java/com/noop/food/FoodImage.kt b/android/app/src/main/java/com/noop/food/FoodImage.kt
new file mode 100644
index 00000000..0a1cfd78
--- /dev/null
+++ b/android/app/src/main/java/com/noop/food/FoodImage.kt
@@ -0,0 +1,126 @@
+package com.noop.food
+
+import android.Manifest
+import android.content.Context
+import android.content.pm.PackageManager
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import android.graphics.Matrix
+import android.media.ExifInterface
+import java.io.ByteArrayOutputStream
+import java.io.File
+import java.io.InputStream
+import kotlin.math.max
+import kotlin.math.roundToInt
+
+/**
+ * victor:food — photo preparation: one decode gives the analysis JPEG (≤ [MAX_EDGE] px on the long
+ * edge, EXIF rotation applied, kept in memory only) and a small thumbnail for the log. The
+ * full-resolution photo is never stored.
+ */
+object FoodImage {
+
+    /** The API's recommended long edge; larger images are downscaled server-side anyway. */
+    const val MAX_EDGE = 1568
+    const val JPEG_QUALITY = 85
+
+    /** Raw JPEG ceiling: base64 adds a third, so this keeps the request well under the 5 MB image cap. */
+    const val MAX_BYTES = 3_500_000
+    const val THUMB_EDGE = 320
+    private const val THUMB_QUALITY = 80
+
+    class Prepared(val jpeg: ByteArray, val thumb: ByteArray)
+
+    /**
+     * Decode the image [open] yields (called up to three times: bounds, EXIF, pixels). Null when it
+     * cannot be read or decoded. Blocking: call off the main thread.
+     */
+    fun prepare(open: () -> InputStream?): Prepared? = runCatching {
+        val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+        open()?.use { BitmapFactory.decodeStream(it, null, bounds) }
+        if (bounds.outWidth <= 0 || bounds.outHeight <= 0) return null
+
+        // BitmapFactory drops EXIF, so read the orientation from its own stream first.
+        val orientation = runCatching {
+            open()?.use { ExifInterface(it).getAttributeInt(ExifInterface.TAG_ORIENTATION, ExifInterface.ORIENTATION_NORMAL) }
+        }.getOrNull() ?: ExifInterface.ORIENTATION_NORMAL
+
+        val opts = BitmapFactory.Options().apply { inSampleSize = sampleSize(bounds.outWidth, bounds.outHeight, MAX_EDGE) }
+        val decoded = open()?.use { BitmapFactory.decodeStream(it, null, opts) } ?: return null
+        val upright = scaleAndOrient(decoded, MAX_EDGE, orientation)
+        val jpeg = encodeUnder(upright, MAX_BYTES)
+        val (tw, th) = fitWithin(upright.width, upright.height, THUMB_EDGE)
+        val thumbBitmap = Bitmap.createScaledBitmap(upright, tw, th, true)
+        val thumb = encode(thumbBitmap, THUMB_QUALITY)
+        if (thumbBitmap !== upright) thumbBitmap.recycle()
+        upright.recycle()
+        if (jpeg == null) null else Prepared(jpeg, thumb)
+    }.getOrNull()
+
+    /** Where the camera writes before analysis (cache, shared via the app's FileProvider `food/` path). */
+    fun captureFile(ctx: Context): File =
+        File(File(ctx.cacheDir, "food").apply { mkdirs() }, "capture.jpg")
+
+    /**
+     * TakePicture needs no permission unless the app DECLARES CAMERA in its manifest; then the
+     * permission must be granted first or the launch throws. True when a runtime request is needed.
+     */
+    fun cameraPermissionNeeded(ctx: Context): Boolean {
+        val declared = runCatching {
+            @Suppress("DEPRECATION")
+            ctx.packageManager.getPackageInfo(ctx.packageName, PackageManager.GET_PERMISSIONS)
+                .requestedPermissions?.contains(Manifest.permission.CAMERA) == true
+        }.getOrDefault(false)
+        return declared && ctx.checkSelfPermission(Manifest.permission.CAMERA) != PackageManager.PERMISSION_GRANTED
+    }
+
+    /** Largest power-of-two subsample that keeps the long edge at or above [maxEdge] (exact fit happens later). */
+    internal fun sampleSize(width: Int, height: Int, maxEdge: Int): Int {
+        var sample = 1
+        while (max(width, height) / (sample * 2) >= maxEdge) sample *= 2
+        return sample
+    }
+
+    /** The size that fits [width]×[height] within [maxEdge] on the long edge, never upscaling. */
+    internal fun fitWithin(width: Int, height: Int, maxEdge: Int): Pair<Int, Int> {
+        val longest = max(width, height)
+        if (longest <= maxEdge) return width to height
+        val f = maxEdge.toDouble() / longest
+        return max(1, (width * f).roundToInt()) to max(1, (height * f).roundToInt())
+    }
+
+    private fun scaleAndOrient(src: Bitmap, maxEdge: Int, orientation: Int): Bitmap {
+        val (w, _) = fitWithin(src.width, src.height, maxEdge)
+        val factor = w.toFloat() / src.width
+        val m = Matrix()
+        if (factor != 1f) m.postScale(factor, factor)
+        when (orientation) {
+            ExifInterface.ORIENTATION_FLIP_HORIZONTAL -> m.postScale(-1f, 1f)
+            ExifInterface.ORIENTATION_ROTATE_180 -> m.postRotate(180f)
+            ExifInterface.ORIENTATION_FLIP_VERTICAL -> m.postScale(1f, -1f)
+            ExifInterface.ORIENTATION_TRANSPOSE -> { m.postRotate(90f); m.postScale(-1f, 1f) }
+            ExifInterface.ORIENTATION_ROTATE_90 -> m.postRotate(90f)
+            ExifInterface.ORIENTATION_TRANSVERSE -> { m.postRotate(270f); m.postScale(-1f, 1f) }
+            ExifInterface.ORIENTATION_ROTATE_270 -> m.postRotate(270f)
+        }
+        if (m.isIdentity) return src
+        val out = Bitmap.createBitmap(src, 0, 0, src.width, src.height, m, true)
+        if (out !== src) src.recycle()
+        return out
+    }
+
+    private fun encode(b: Bitmap, quality: Int): ByteArray =
+        ByteArrayOutputStream().use { out ->
+            b.compress(Bitmap.CompressFormat.JPEG, quality, out)
+            out.toByteArray()
+        }
+
+    /** [JPEG_QUALITY] first, stepping down only if a very detailed photo would exceed [limit]. */
+    private fun encodeUnder(b: Bitmap, limit: Int): ByteArray? {
+        for (q in listOf(JPEG_QUALITY, 75, 65, 50)) {
+            val bytes = encode(b, q)
+            if (bytes.size <= limit) return bytes
+        }
+        return null
+    }
+}
diff --git a/android/app/src/main/java/com/noop/food/FoodModels.kt b/android/app/src/main/java/com/noop/food/FoodModels.kt
