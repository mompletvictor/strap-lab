@@ -0,0 +1,62 @@
+package com.noop.food
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** victor:food — the on-disk JSON round-trips exactly and refuses to read garbage as an empty log. */
+class FoodStoreCodecTest {
+
+    private val full = FoodEntry(
+        id = "e1",
+        timestamp = 1792152000000L,
+        day = "2026-10-16",
+        note = "media ración, sin aceite \"casero\"",
+        items = listOf(
+            FoodItem("Lentejas con chorizo", "1 plato (300 g)", 420.0, 22.5, 48.0, 14.3),
+            FoodItem("Pan", "1 rebanada", 80.0, 2.7, 15.0, 0.9),
+        ),
+        kcal = 500.0, proteinG = 25.2, carbsG = 63.0, fatG = 15.2,
+        thumbnailPath = "thumbs/e1.jpg",
+        confidence = "medium",
+        aiNotes = "Ración estimada por el tamaño del plato.",
+    )
+
+    private val bare = FoodEntry(
+        id = "e2", timestamp = 1792100000000L, day = "2026-10-15", note = "",
+        items = listOf(FoodItem("Café con leche", "", 60.0, 3.0, 5.0, 3.0)),
+        kcal = 60.0, proteinG = 3.0, carbsG = 5.0, fatG = 3.0,
+        thumbnailPath = null,
+    )
+
+    @Test
+    fun roundTripKeepsEveryFieldAndTheLedger() {
+        val state = FoodState(
+            entries = listOf(bare, full),
+            synced = mapOf(
+                "2026-10-15" to FoodTotals(60.0, 3.0, 5.0, 3.0),
+                "2026-10-16" to FoodTotals(500.0, 25.2, 63.0, 15.2),
+            ),
+        )
+        val decoded = FoodStoreCodec.decode(FoodStoreCodec.encode(state))
+        assertEquals(state, decoded)
+        assertEquals(null, decoded.entries[0].confidence)
+        assertEquals(null, decoded.entries[0].thumbnailPath)
+    }
+
+    @Test
+    fun entriesComeBackOldestFirstAndUnknownFieldsAreIgnored() {
+        val json = """{"version":7,"future":true,"entries":[
+            {"id":"b","ts":20,"day":"2026-10-16","items":[],"kcal":1,"extra":"x"},
+            {"id":"a","ts":10,"day":"2026-10-16","items":[],"kcal":2},
+            {"id":"","ts":5,"day":"2026-10-16","items":[]}]}"""
+        val s = FoodStoreCodec.decode(json)
+        assertEquals(listOf("a", "b"), s.entries.map { it.id })
+        assertTrue(s.synced.isEmpty())
+    }
+
+    @Test(expected = Exception::class)
+    fun garbageIsAnErrorNotAnEmptyLog() {
+        FoodStoreCodec.decode("{\"something\":\"else\"}")
+    }
+}
diff --git a/android/app/src/test/java/com/noop/food/FoodVisionReplyTest.kt b/android/app/src/test/java/com/noop/food/FoodVisionReplyTest.kt
new file mode 100644
index 00000000..d05e6ef9
--- /dev/null
+++ b/android/app/src/test/java/com/noop/food/FoodVisionReplyTest.kt
@@ -0,0 +1,134 @@
+package com.noop.food
+
+import kotlinx.coroutines.runBlocking
+import org.json.JSONObject
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.net.SocketTimeoutException
+import java.net.UnknownHostException
+
+/** victor:food — reading replies (structured and fallback) and the retry/error flow, without a network. */
+class FoodVisionReplyTest {
+
+    private val estimateJson = """
+        {"items":[
+           {"name":"Tortilla de patatas","portion":"1 porción (150 g)","kcal":280,"protein_g":10.5,"carbs_g":20,"fat_g":17.2},
+           {"name":"Pan","portion":"40 g","kcal":"100","protein_g":3.4,"carbs_g":20.1,"fat_g":0.5}],
+         "total_kcal":380,"total_protein_g":13.9,"total_carbs_g":40.1,"total_fat_g":17.7,
+         "confidence":"MEDIUM","notes":"Supongo aceite de oliva en la tortilla."}
+    """.trimIndent()
+
+    private fun reply(text: String, stop: String = "end_turn"): String =
+        JSONObject()
+            .put(
+                "content",
+                org.json.JSONArray()
+                    .put(JSONObject().put("type", "thinking").put("thinking", "").put("signature", "sig"))
+                    .put(JSONObject().put("type", "text").put("text", text)),
+            )
+            .put("stop_reason", stop)
+            .toString()
+
+    @Test
+    fun structuredReplyAfterAThinkingBlockParses() {
+        val result = FoodVision.parseReply(reply(estimateJson))
+        assertTrue(result is FoodResult.Ok)
+        val e = (result as FoodResult.Ok).estimate
+        assertEquals(2, e.items.size)
+        assertEquals("Tortilla de patatas", e.items[0].name)
+        assertEquals(280.0, e.items[0].kcal, 0.0)
+        assertEquals(100.0, e.items[1].kcal, 0.0) // a number sent as a string still reads
+        assertEquals("medium", e.confidence)
+        assertEquals("Supongo aceite de oliva en la tortilla.", e.notes)
+        assertEquals(FoodTotals(380.0, 13.9, 40.1, 17.7), e.reportedTotals)
+        assertEquals(FoodTotals(380.0, 13.9, 40.1, 17.7), FoodTotals.ofItems(e.items))
+    }
+
+    @Test
+    fun fallbackTextWithProseAndFenceParses() {
+        val text = "Claro, aquí va la estimación:\n```json\n$estimateJson\n```\nEspero que sirva {de ayuda}."
+        val result = FoodVision.parseReply(reply(text))
+        assertTrue(result is FoodResult.Ok)
+        assertEquals(2, (result as FoodResult.Ok).estimate.items.size)
+    }
+
+    @Test
+    fun firstJsonObjectRespectsBracesInsideStrings() {
+        val text = """nota {no json} y luego {"items":[{"name":"Salsa {casera}","portion":"\"1\" cda","kcal":50,"protein_g":0,"carbs_g":2,"fat_g":5}],"notes":"x"} fin"""
+        val json = FoodVision.extractFirstJsonObject(text)!!
+        assertEquals("Salsa {casera}", JSONObject(json).getJSONArray("items").getJSONObject(0).getString("name"))
+        assertNull(FoodVision.extractFirstJsonObject("sin objeto aquí"))
+    }
+
+    @Test
+    fun insaneValuesAreClampedAndBlankRowsDropped() {
+        val text = """{"items":[{"name":"Agua","portion":"","kcal":-5,"protein_g":"abc","carbs_g":0,"fat_g":0},
+            {"name":"","portion":"","kcal":0,"protein_g":0,"carbs_g":0,"fat_g":0}],
+            "total_kcal":0,"total_protein_g":0,"total_carbs_g":0,"total_fat_g":0,"confidence":"sure","notes":""}"""
+        val e = FoodVision.parseEstimate(text)!!
+        assertEquals(1, e.items.size)
+        assertEquals(0.0, e.items[0].kcal, 0.0)
+        assertEquals(0.0, e.items[0].proteinG, 0.0)
+        assertNull(e.confidence)
+    }
+
+    @Test
+    fun notFoodIsAnEmptyEstimateNotAnError() {
+        val text = """{"items":[],"total_kcal":0,"total_protein_g":0,"total_carbs_g":0,"total_fat_g":0,"confidence":"low","notes":"La foto no muestra comida."}"""
+        val result = FoodVision.parseReply(reply(text))
+        assertTrue(result is FoodResult.Ok)
+        val e = (result as FoodResult.Ok).estimate
+        assertTrue(e.items.isEmpty())
+        assertEquals("La foto no muestra comida.", e.notes)
+    }
+
+    @Test
+    fun refusalEmptyAndJunkRepliesFail() {
+        val refusal = """{"content":[],"stop_reason":"refusal"}"""
+        assertEquals(FoodResult.Failed(FoodError.REFUSAL), FoodVision.parseReply(refusal))
+        assertEquals(FoodResult.Failed(FoodError.UNREADABLE), FoodVision.parseReply(reply("", stop = "max_tokens")))
+        assertEquals(FoodResult.Failed(FoodError.UNREADABLE), FoodVision.parseReply(reply("no puedo ver bien la foto")))
+        assertEquals(FoodResult.Failed(FoodError.UNREADABLE), FoodVision.parseReply("<html>"))
+    }
+
+    @Test
+    fun outputConfigRejectionRetriesOncePlain() = runBlocking {
+        val sent = ArrayList<JSONObject>()
+        val result = FoodVision.run("old-model", "x", "") { body ->
+            sent += JSONObject(body)
+            if (sent.size == 1) {
+                400 to """{"type":"error","error":{"type":"invalid_request_error","message":"output_config.format: not supported for this model"}}"""
+            } else {
+                200 to reply(estimateJson)
+            }
+        }
+        assertTrue(result is FoodResult.Ok)
+        assertEquals(2, sent.size)
+        assertTrue(sent[0].has("output_config"))
+        assertFalse(sent[1].has("output_config"))
+    }
+
+    @Test
+    fun otherFailuresMapWithoutRetry() = runBlocking {
+        fun statusRun(code: Int, body: String = "{}"): Pair<FoodResult, Int> {
+            var calls = 0
+            val r = runBlocking { FoodVision.run("m", "x", "") { calls++; code to body } }
+            return r to calls
+        }
+        val imageError = """{"type":"error","error":{"message":"Could not process image: unsupported image format"}}"""
+        assertEquals(FoodResult.Failed(FoodError.BAD_REQUEST, "Could not process image: unsupported image format") to 1, statusRun(400, imageError))
+        assertEquals(FoodError.KEY_REJECTED, (statusRun(401).first as FoodResult.Failed).error)
+        assertEquals(FoodError.BUSY, (statusRun(429).first as FoodResult.Failed).error)
+        assertEquals(FoodError.BUSY, (statusRun(529).first as FoodResult.Failed).error)
+        assertEquals(FoodError.SERVER, (statusRun(500).first as FoodResult.Failed).error)
+        assertEquals(FoodError.IMAGE, (statusRun(413).first as FoodResult.Failed).error)
+
+        val offline = FoodVision.run("m", "x", "") { throw UnknownHostException("api.anthropic.com") }
+        assertEquals(FoodResult.Failed(FoodError.OFFLINE), offline)
+        val slow = FoodVision.run("m", "x", "") { throw SocketTimeoutException("timeout") }
+        assertEquals(FoodResult.Failed(FoodError.TIMEOUT), slow)
+    }
+}
diff --git a/android/app/src/test/java/com/noop/food/FoodVisionRequestTest.kt b/android/app/src/test/java/com/noop/food/FoodVisionRequestTest.kt
new file mode 100644
