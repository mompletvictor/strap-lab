+++ b/android/app/src/main/java/com/noop/food/FoodCoachContext.kt
@@ -0,0 +1,48 @@
+package com.noop.food
+
+import android.content.Context
+import java.time.LocalDate
+import kotlin.math.roundToInt
+
+/**
+ * victor:food — one compact English line about the photo food log for the AI Coach prompt. Not wired
+ * here: the Coach adds it to its context. Numbers are whole (no locale-dependent decimals).
+ */
+object FoodCoachContext {
+
+    private const val PREFIX = "FOOD LOG (photo estimates): "
+    private const val WINDOW_DAYS = 7L
+
+    /** Null when nothing is logged today or in the previous 7 days. Reads the log from disk. */
+    suspend fun line(ctx: Context, today: LocalDate = LocalDate.now()): String? =
+        line(FoodStore.load(ctx), today)
+
+    /**
+     * Pure. Example: `FOOD LOG (photo estimates): today 1850 kcal (P 120 g, C 180 g, F 60 g) from 3 meals;
+     * previous 7 days avg 2100 kcal/day over 6 logged days`. Today is left out of the average because it
+     * is still in progress.
+     */
+    internal fun line(entries: List<FoodEntry>, today: LocalDate): String? {
+        val todayKey = today.toString()
+        val todayEntries = entries.filter { it.day == todayKey }
+        val from = today.minusDays(WINDOW_DAYS).toString()
+        val prior = entries.filter { it.day >= from && it.day < todayKey }.groupBy { it.day }
+        if (todayEntries.isEmpty() && prior.isEmpty()) return null
+
+        val parts = ArrayList<String>(2)
+        if (todayEntries.isNotEmpty()) {
+            val t = FoodTotals.ofEntries(todayEntries)
+            val n = todayEntries.size
+            parts += "today ${t.kcal.roundToInt()} kcal (P ${t.proteinG.roundToInt()} g, " +
+                "C ${t.carbsG.roundToInt()} g, F ${t.fatG.roundToInt()} g) from $n ${if (n == 1) "meal" else "meals"}"
+        } else {
+            parts += "today nothing logged yet"
+        }
+        if (prior.isNotEmpty()) {
+            val avg = prior.values.map { FoodTotals.ofEntries(it).kcal }.average().roundToInt()
+            val d = prior.size
+            parts += "previous $WINDOW_DAYS days avg $avg kcal/day over $d logged ${if (d == 1) "day" else "days"}"
+        }
+        return PREFIX + parts.joinToString("; ")
+    }
+}
