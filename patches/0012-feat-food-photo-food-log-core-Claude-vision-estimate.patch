index 00000000..160dbeef
--- /dev/null
+++ b/android/app/src/main/java/com/noop/food/FoodModels.kt
@@ -0,0 +1,104 @@
+package com.noop.food
+
+import java.time.Instant
+import java.time.LocalDate
+import java.time.ZoneId
+import kotlin.math.roundToLong
+
+/*
+ * victor:food — the photo food log's value types. Fork-owned: nothing here is shared with upstream,
+ * and nothing is stored in Room except the day totals FoodNutritionSync mirrors into the
+ * nutrition lane.
+ */
+
+/** One food the estimate (or the wearer) listed, with its portion and macros for that portion. */
+data class FoodItem(
+    val name: String,
+    val portion: String,
+    val kcal: Double,
+    val proteinG: Double,
+    val carbsG: Double,
+    val fatG: Double,
+)
+
+/** Energy and macros, summed. Values are always finite and non-negative. */
+data class FoodTotals(
+    val kcal: Double,
+    val proteinG: Double,
+    val carbsG: Double,
+    val fatG: Double,
+) {
+    operator fun plus(o: FoodTotals) =
+        FoodTotals(kcal + o.kcal, proteinG + o.proteinG, carbsG + o.carbsG, fatG + o.fatG)
+
+    /** One decimal everywhere: what is stored, shown and compared, so float noise never leaks. */
+    fun rounded() = FoodTotals(round1(kcal), round1(proteinG), round1(carbsG), round1(fatG))
+
+    companion object {
+        val ZERO = FoodTotals(0.0, 0.0, 0.0, 0.0)
+
+        fun ofItems(items: List<FoodItem>): FoodTotals =
+            items.fold(ZERO) { acc, i -> acc + FoodTotals(i.kcal, i.proteinG, i.carbsG, i.fatG) }.rounded()
+
+        fun ofEntries(entries: List<FoodEntry>): FoodTotals =
+            entries.fold(ZERO) { acc, e -> acc + e.totals }.rounded()
+    }
+}
+
+/**
+ * One logged meal. [day] is the LOCAL calendar day the meal was logged on, fixed at creation so a
+ * later time-zone change never moves it. [kcal]/[proteinG]/[carbsG]/[fatG] are the sum of [items]
+ * at save time. [thumbnailPath] is relative to the food directory (see FoodStore.foodDir); the
+ * full-resolution photo is never kept.
+ */
+data class FoodEntry(
+    val id: String,
+    val timestamp: Long,
+    val day: String,
+    val note: String,
+    val items: List<FoodItem>,
+    val kcal: Double,
+    val proteinG: Double,
+    val carbsG: Double,
+    val fatG: Double,
+    val thumbnailPath: String?,
+    val confidence: String? = null,
+    val aiNotes: String? = null,
+) {
+    val totals: FoodTotals get() = FoodTotals(kcal, proteinG, carbsG, fatG)
+}
+
+/** What Claude returned for one photo, already sanitised. */
+data class FoodEstimate(
+    val items: List<FoodItem>,
+    /** The totals the model reported; the app always re-sums [items] rather than trusting these. */
+    val reportedTotals: FoodTotals,
+    /** "low" | "medium" | "high", or null when the reply had none. */
+    val confidence: String?,
+    val notes: String,
+)
+
+/** Day bucketing and per-day totals over the log. Pure. */
+object FoodDays {
+
+    fun dayOf(timestampMs: Long, zone: ZoneId = ZoneId.systemDefault()): String =
+        Instant.ofEpochMilli(timestampMs).atZone(zone).toLocalDate().toString()
+
+    fun today(zone: ZoneId = ZoneId.systemDefault()): String = LocalDate.now(zone).toString()
+
+    /** The day's totals, or null when nothing is logged that day (distinct from a logged 0 kcal). */
+    fun totalsFor(entries: List<FoodEntry>, day: String): FoodTotals? {
+        val ofDay = entries.filter { it.day == day }
+        return if (ofDay.isEmpty()) null else FoodTotals.ofEntries(ofDay)
+    }
+
+    /** Days newest first; within a day, meals in the order they were eaten. */
+    fun groupedByDay(entries: List<FoodEntry>): List<Pair<String, List<FoodEntry>>> =
+        entries.groupBy { it.day }
+            .toSortedMap(compareByDescending { it })
+            .map { (day, list) -> day to list.sortedBy { it.timestamp } }
+}
+
+/** Finite, non-negative, one decimal. */
+internal fun round1(v: Double): Double =
+    if (!v.isFinite() || v <= 0.0) 0.0 else (v * 10.0).roundToLong() / 10.0
diff --git a/android/app/src/main/java/com/noop/food/FoodNutritionSync.kt b/android/app/src/main/java/com/noop/food/FoodNutritionSync.kt
new file mode 100644
index 00000000..6a1b02b4
--- /dev/null
+++ b/android/app/src/main/java/com/noop/food/FoodNutritionSync.kt
@@ -0,0 +1,86 @@
+package com.noop.food
+
+import com.noop.data.MetricSeriesRow
+import com.noop.data.WhoopRepository
+import com.noop.ingest.NutritionCsvImporter
+import kotlin.math.abs
+
+/**
+ * victor:food — mirrors the photo log's day totals into NOOP's existing nutrition lane, so Explore,
+ * Compare and Data Sources show them with no reader changes.
+ *
+ * Why the SAME source id as the CSV importer ("nutrition-csv") rather than a source of our own:
+ * every nutrition reader is hard-wired to that one source (Explore scans it for keys, Compare's
+ * catalogue names it per metric, Data Sources counts it, and the repository's source resolution
+ * treats nutrition as single-source by design). A second source would need hooks in each of those
+ * upstream screens and would show two "Calories in" metrics side by side.
+ *
+ * metricSeries is keyed (deviceId, day, key) and written with @Upsert, so a CSV import is already
+ * per-day last-writer-wins against its own earlier imports. The photo log joins that lane at day
+ * granularity with three rules that keep CSV imports intact:
+ *  1. It only ever writes the four intake keys (never `weight`), and only for days that have photo
+ *     entries. Days without photo entries are never touched.
+ *  2. A day with photo entries shows the photo totals: an edit there overwrites that day's intake
+ *     values. A later CSV import of the same day replaces them again until the next photo edit of
+ *     that day (the same last-writer-wins the importer has with itself).
+ *  3. It remembers what it last wrote per day (the ledger). When a day loses its last photo entry,
+ *     a key is deleted only if the stored value is still exactly what the photo log wrote, so a CSV
+ *     value imported over it in the meantime survives.
+ */
+internal object FoodNutritionSync {
+
+    const val SOURCE_ID: String = NutritionCsvImporter.SOURCE_ID
+
+    /** The four intake keys of the nutrition vocabulary, in a fixed order. */
+    val KEYS: List<String> = listOf(
+        NutritionCsvImporter.KEY_CALORIES_IN,
+        NutritionCsvImporter.KEY_PROTEIN_G,
+        NutritionCsvImporter.KEY_CARBS_G,
+        NutritionCsvImporter.KEY_FAT_G,
+    )
+
+    /** Values compare equal within this tolerance (everything is stored at one decimal). */
+    private const val EPSILON = 0.05
+
+    data class Plan(
+        val upserts: List<MetricSeriesRow>,
+        val deleteKeys: List<String>,
+        /** The ledger value to remember for the day afterwards; null = forget the day. */
+        val ledger: FoodTotals?,
+    )
+
+    fun valuesOf(t: FoodTotals): Map<String, Double> = mapOf(
+        KEYS[0] to t.kcal,
+        KEYS[1] to t.proteinG,
+        KEYS[2] to t.carbsG,
+        KEYS[3] to t.fatG,
+    )
+
+    /**
+     * Pure: what to write for [day] given its current photo [totals] (null = no entries left), the
+     * totals the photo log [lastWritten] there, and the values [stored] in the lane right now.
+     */
+    fun plan(day: String, totals: FoodTotals?, lastWritten: FoodTotals?, stored: Map<String, Double?>): Plan {
+        if (totals != null) {
+            val rows = valuesOf(totals.rounded()).map { (k, v) -> MetricSeriesRow(SOURCE_ID, day, k, v) }
+            return Plan(upserts = rows, deleteKeys = emptyList(), ledger = totals.rounded())
+        }
+        if (lastWritten == null) return Plan(emptyList(), emptyList(), null)
+        val ours = valuesOf(lastWritten)
+        val deletes = KEYS.filter { k ->
+            val now = stored[k] ?: return@filter false
+            val wrote = ours[k] ?: return@filter false
+            abs(now - wrote) < EPSILON
+        }
+        return Plan(upserts = emptyList(), deleteKeys = deletes, ledger = null)
+    }
+
+    /** Read the lane's current values for [day] (only needed when a day may be cleared). */
+    suspend fun storedValues(repo: WhoopRepository, day: String): Map<String, Double?> =
+        KEYS.associateWith { k -> repo.metricSeries(SOURCE_ID, k, day, day).firstOrNull()?.value }
+
+    suspend fun apply(repo: WhoopRepository, day: String, plan: Plan) {
+        if (plan.upserts.isNotEmpty()) repo.upsertMetricSeries(plan.upserts)
+        for (k in plan.deleteKeys) repo.deleteMetricSeriesPoint(SOURCE_ID, day, k)
+    }
+}
diff --git a/android/app/src/main/java/com/noop/food/FoodStore.kt b/android/app/src/main/java/com/noop/food/FoodStore.kt
new file mode 100644
index 00000000..52ade9e6
--- /dev/null
+++ b/android/app/src/main/java/com/noop/food/FoodStore.kt
@@ -0,0 +1,253 @@
+package com.noop.food
+
+import android.content.Context
+import com.noop.data.WhoopRepository
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.File
+
+/** victor:food — everything the food log persists: the meals and the nutrition-lane ledger. */
+internal data class FoodState(
+    val entries: List<FoodEntry> = emptyList(),
+    /** Per day, the totals the photo log last wrote into the nutrition lane (see FoodNutritionSync). */
+    val synced: Map<String, FoodTotals> = emptyMap(),
+)
+
+/**
+ * victor:food — JSON codec for [FoodState]. Pure, so the round trip is JVM-testable. Unknown fields
+ * are ignored and missing optional ones default, so the format can grow without a migration.
+ */
+internal object FoodStoreCodec {
+
+    const val VERSION = 1
+
+    fun encode(state: FoodState): String {
+        val entries = JSONArray()
+        for (e in state.entries) {
+            val items = JSONArray()
+            for (i in e.items) {
+                items.put(
+                    JSONObject()
+                        .put("name", i.name)
+                        .put("portion", i.portion)
+                        .put("kcal", i.kcal)
+                        .put("protein_g", i.proteinG)
+                        .put("carbs_g", i.carbsG)
+                        .put("fat_g", i.fatG),
+                )
+            }
+            val o = JSONObject()
+                .put("id", e.id)
+                .put("ts", e.timestamp)
+                .put("day", e.day)
+                .put("note", e.note)
+                .put("items", items)
+                .put("kcal", e.kcal)
+                .put("protein_g", e.proteinG)
+                .put("carbs_g", e.carbsG)
+                .put("fat_g", e.fatG)
+            e.thumbnailPath?.let { o.put("thumb", it) }
+            e.confidence?.let { o.put("confidence", it) }
+            e.aiNotes?.let { o.put("ai_notes", it) }
+            entries.put(o)
+        }
+        val synced = JSONObject()
+        for ((day, t) in state.synced.toSortedMap()) synced.put(day, totalsJson(t))
+        return JSONObject()
+            .put("version", VERSION)
+            .put("entries", entries)
+            .put("synced", synced)
+            .toString()
+    }
+
+    /** Throws on text that is not a food-log document, so a corrupt file is never mistaken for empty. */
+    fun decode(text: String): FoodState {
+        val root = JSONObject(text)
+        val arr = root.getJSONArray("entries")
+        val entries = ArrayList<FoodEntry>(arr.length())
+        for (n in 0 until arr.length()) {
+            val o = arr.optJSONObject(n) ?: continue
+            val id = o.optString("id").takeIf { it.isNotBlank() } ?: continue
+            val ts = o.optLong("ts", 0L)
+            val itemsArr = o.optJSONArray("items") ?: JSONArray()
+            val items = (0 until itemsArr.length()).mapNotNull { i ->
+                val io = itemsArr.optJSONObject(i) ?: return@mapNotNull null
+                FoodItem(
+                    name = io.optString("name"),
+                    portion = io.optString("portion"),
+                    kcal = round1(io.optDouble("kcal", 0.0)),
+                    proteinG = round1(io.optDouble("protein_g", 0.0)),
+                    carbsG = round1(io.optDouble("carbs_g", 0.0)),
+                    fatG = round1(io.optDouble("fat_g", 0.0)),
+                )
+            }
+            entries += FoodEntry(
+                id = id,
+                timestamp = ts,
+                day = o.optString("day").takeIf { it.isNotBlank() } ?: FoodDays.dayOf(ts),
+                note = o.optString("note"),
+                items = items,
+                kcal = round1(o.optDouble("kcal", 0.0)),
+                proteinG = round1(o.optDouble("protein_g", 0.0)),
+                carbsG = round1(o.optDouble("carbs_g", 0.0)),
+                fatG = round1(o.optDouble("fat_g", 0.0)),
+                thumbnailPath = o.optString("thumb").takeIf { it.isNotBlank() },
+                confidence = o.optString("confidence").takeIf { it.isNotBlank() },
+                aiNotes = o.optString("ai_notes").takeIf { it.isNotBlank() },
+            )
+        }
+        val synced = LinkedHashMap<String, FoodTotals>()
+        root.optJSONObject("synced")?.let { s ->
+            for (day in s.keys()) {
+                val t = s.optJSONObject(day) ?: continue
+                synced[day] = FoodTotals(
+                    round1(t.optDouble("kcal", 0.0)),
+                    round1(t.optDouble("protein_g", 0.0)),
+                    round1(t.optDouble("carbs_g", 0.0)),
+                    round1(t.optDouble("fat_g", 0.0)),
+                )
+            }
+        }
+        return FoodState(entries.sortedBy { it.timestamp }, synced)
+    }
+
+    private fun totalsJson(t: FoodTotals) = JSONObject()
+        .put("kcal", t.kcal)
+        .put("protein_g", t.proteinG)
+        .put("carbs_g", t.carbsG)
+        .put("fat_g", t.fatG)
+}
+
+/**
+ * victor:food — the food log on disk: `files/food/log.json` plus small thumbnails under
+ * `files/food/thumbs/`. App-private, never in the Room DB. Every mutation re-syncs the touched
+ * days into the nutrition lane (see [FoodNutritionSync]). All calls are serialized by one mutex
+ * and run on [Dispatchers.IO].
+ */
+object FoodStore {
+
+    private const val DIR = "food"
+    private const val FILE = "log.json"
+    private const val THUMBS = "thumbs"
+
+    private val mutex = Mutex()
+    private var cache: FoodState? = null
+
+    private val _entries = MutableStateFlow<List<FoodEntry>>(emptyList())
+    /** The log, oldest first. Empty until the first [load]. */
+    val entries: StateFlow<List<FoodEntry>> = _entries.asStateFlow()
+
+    fun foodDir(ctx: Context): File = File(ctx.applicationContext.filesDir, DIR)
+
+    /** Resolve an entry's relative [FoodEntry.thumbnailPath]. */
+    fun thumbFile(ctx: Context, relativePath: String): File = File(foodDir(ctx), relativePath)
+
+    suspend fun load(ctx: Context): List<FoodEntry> = withContext(Dispatchers.IO) {
+        mutex.withLock { state(ctx).entries }
+    }
+
+    /**
+     * Add or replace [entry] (matched by id). [newThumbJpeg], when given, replaces the thumbnail.
+     * Then rewrites the nutrition lane for the entry's day (and its old day, if it moved).
+     */
+    suspend fun save(ctx: Context, repo: WhoopRepository, entry: FoodEntry, newThumbJpeg: ByteArray?) =
+        withContext(Dispatchers.IO) {
+            mutex.withLock {
+                val current = state(ctx)
+                val old = current.entries.firstOrNull { it.id == entry.id }
+                var toSave = entry
+                if (newThumbJpeg != null) {
+                    val rel = "$THUMBS/${entry.id}.jpg"
+                    val f = thumbFile(ctx, rel)
+                    f.parentFile?.mkdirs()
+                    f.writeBytes(newThumbJpeg)
+                    toSave = entry.copy(thumbnailPath = rel)
+                }
+                val entries = current.entries.filterNot { it.id == entry.id } + toSave
+                var next = current.copy(entries = entries.sortedBy { it.timestamp })
+                persist(ctx, next)
+                next = syncDays(repo, next, setOfNotNull(toSave.day, old?.day))
+                persist(ctx, next)
+            }
+        }
+
+    /** Delete the entry with [id] and its thumbnail, then rewrite (or clear) its day in the lane. */
+    suspend fun delete(ctx: Context, repo: WhoopRepository, id: String) = withContext(Dispatchers.IO) {
+        mutex.withLock {
+            val current = state(ctx)
+            val old = current.entries.firstOrNull { it.id == id } ?: return@withLock
+            old.thumbnailPath?.let { runCatching { thumbFile(ctx, it).delete() } }
+            var next = current.copy(entries = current.entries.filterNot { it.id == id })
+            persist(ctx, next)
+            next = syncDays(repo, next, setOf(old.day))
+            persist(ctx, next)
+        }
+    }
+
+    /**
+     * Repair pass: re-sync every day whose ledger disagrees with its entries (a write that failed
+     * half-way, e.g. the app was killed between the file and the DB). It compares the ledger with
+     * the log, never with the DB, so it does not fight a CSV import made on purpose.
+     */
+    suspend fun reconcile(ctx: Context, repo: WhoopRepository) = withContext(Dispatchers.IO) {
+        mutex.withLock {
+            val current = state(ctx)
+            val days = (current.entries.map { it.day } + current.synced.keys).toSet()
+            val stale = days.filter { d -> FoodDays.totalsFor(current.entries, d) != current.synced[d] }.toSet()
+            if (stale.isNotEmpty()) persist(ctx, syncDays(repo, current, stale))
+        }
+    }
+
+    private suspend fun syncDays(repo: WhoopRepository, state: FoodState, days: Set<String>): FoodState {
+        val ledger = state.synced.toMutableMap()
+        for (day in days) {
+            val totals = FoodDays.totalsFor(state.entries, day)
+            val stored = if (totals == null && ledger[day] != null) {
+                FoodNutritionSync.storedValues(repo, day)
+            } else {
+                emptyMap()
+            }
+            val plan = FoodNutritionSync.plan(day, totals, ledger[day], stored)
+            FoodNutritionSync.apply(repo, day, plan)
+            if (plan.ledger != null) ledger[day] = plan.ledger else ledger.remove(day)
+        }
+        return state.copy(synced = ledger)
+    }
+
+    /** Caller holds [mutex]. A corrupt file is set aside (never silently overwritten) and the log starts empty. */
+    private fun state(ctx: Context): FoodState {
+        cache?.let { return it }
+        val file = File(foodDir(ctx), FILE)
+        val loaded = if (!file.exists()) {
+            FoodState()
+        } else {
+            runCatching { FoodStoreCodec.decode(file.readText()) }.getOrElse {
+                runCatching { file.renameTo(File(foodDir(ctx), "$FILE.corrupt-${System.currentTimeMillis()}")) }
+                FoodState()
+            }
+        }
+        cache = loaded
+        _entries.value = loaded.entries
+        return loaded
+    }
+
+    /** Caller holds [mutex]. Write-then-rename so a crash mid-write never leaves half a file. */
+    private fun persist(ctx: Context, state: FoodState) {
+        val dir = foodDir(ctx).apply { mkdirs() }
+        val tmp = File(dir, "$FILE.tmp")
+        tmp.writeText(FoodStoreCodec.encode(state))
+        if (!tmp.renameTo(File(dir, FILE))) {
+            File(dir, FILE).writeText(FoodStoreCodec.encode(state))
+            tmp.delete()
+        }
+        cache = state
+        _entries.value = state.entries
+    }
+}
diff --git a/android/app/src/main/java/com/noop/food/FoodVision.kt b/android/app/src/main/java/com/noop/food/FoodVision.kt
new file mode 100644
index 00000000..adcefae0
--- /dev/null
+++ b/android/app/src/main/java/com/noop/food/FoodVision.kt
@@ -0,0 +1,332 @@
+package com.noop.food
+
+import android.content.Context
+import com.noop.ai.AiCoach
+import com.noop.ai.AiKeyStore
+import com.noop.ai.AiProvider
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.withContext
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.RequestBody.Companion.toRequestBody
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.IOException
+import java.io.InterruptedIOException
+import java.net.ConnectException
+import java.net.SocketTimeoutException
+import java.net.UnknownHostException
+import java.util.Base64
+import java.util.concurrent.TimeUnit
+
+/** victor:food — why an analysis did not produce an estimate. The UI maps each to a string. */
+enum class FoodError {
+    NO_KEY,
+    KEY_REJECTED,
+    BUSY,
+    SERVER,
+    BAD_REQUEST,
+    OFFLINE,
+    TIMEOUT,
+    NETWORK,
+    REFUSAL,
+    UNREADABLE,
+    IMAGE,
+}
+
+sealed interface FoodResult {
+    data class Ok(val estimate: FoodEstimate) : FoodResult
+    /** [detail] is the provider's own error text, when it sent one (never the key or the image). */
+    data class Failed(val error: FoodError, val detail: String? = null) : FoodResult
+}
+
+/**
+ * victor:food — the one network call of the food log: a photo (plus the wearer's note) to the
+ * Anthropic Messages API, answered as structured JSON.
+ *
+ * Same opt-in posture and raw-HTTP idiom as [AiCoach]: nothing is sent until the wearer has saved
+ * an Anthropic key in the Coach settings and taps Analyse; only the downscaled photo and the note
+ * leave the phone. Claude 5.x rejects `temperature`, `top_p`, `thinking` and `tool_choice`, so the
+ * body never carries them; its replies start with a thinking block, so text is read through
+ * [AiCoach.anthropicReplyText], never `content[0]`.
+ */
+object FoodVision {
+
+    private const val API_VERSION = "2023-06-01"
+    private val JSON = "application/json; charset=utf-8".toMediaType()
+
+    // Thinking models can take a while on a photo: generous read/call budgets.
+    private val http: OkHttpClient = OkHttpClient.Builder()
+        .connectTimeout(20, TimeUnit.SECONDS)
+        .writeTimeout(60, TimeUnit.SECONDS)
+        .readTimeout(120, TimeUnit.SECONDS)
+        .callTimeout(180, TimeUnit.SECONDS)
+        .build()
+
+    /** Analyse one JPEG. Needs the Anthropic key from the Coach settings; [FoodError.NO_KEY] otherwise. */
+    suspend fun analyze(ctx: Context, jpeg: ByteArray, note: String): FoodResult = withContext(Dispatchers.IO) {
+        val app = ctx.applicationContext
+        val key = AiKeyStore.read(app, AiProvider.ANTHROPIC) ?: return@withContext FoodResult.Failed(FoodError.NO_KEY)
+        val model = AiKeyStore.readModel(app, AiProvider.ANTHROPIC)
+        val base64 = Base64.getEncoder().encodeToString(jpeg)
+        run(model, base64, note) { body -> post(AiProvider.ANTHROPIC.endpoint, key, body) }
+    }
+
+    /**
+     * The request/retry/parse flow over an injectable [send] (body JSON in, status + body out), so
+     * it is testable without a network. One retry without `output_config` when the model rejects
+     * structured output (an older model id).
+     */
+    internal suspend fun run(
+        model: String,
+        imageBase64: String,
+        note: String,
+        send: suspend (String) -> Pair<Int, String>,
+    ): FoodResult {
+        var structured = true
+        while (true) {
+            val (code, body) = try {
+                send(buildRequestBody(model, imageBase64, note, structured).toString())
+            } catch (e: CancellationException) {
+                throw e
+            } catch (e: UnknownHostException) {
+                return FoodResult.Failed(FoodError.OFFLINE)
+            } catch (e: ConnectException) {
+                return FoodResult.Failed(FoodError.OFFLINE)
+            } catch (e: SocketTimeoutException) {
+                return FoodResult.Failed(FoodError.TIMEOUT)
+            } catch (e: InterruptedIOException) {
+                return FoodResult.Failed(FoodError.TIMEOUT)
+            } catch (e: IOException) {
+                return FoodResult.Failed(FoodError.NETWORK)
+            }
+            if (code in 200..299) return parseReply(body)
+            if (structured && shouldRetryWithoutStructuredOutput(code, body)) {
+                structured = false
+                continue
+            }
+            return FoodResult.Failed(errorForStatus(code), apiErrorMessage(body))
+        }
+    }
+
+    // MARK: - Request (pure)
+
+    /** The JSON schema the reply must follow. All fields required, no extras (structured output rules). */
+    internal fun outputSchema(): JSONObject {
+        fun num() = JSONObject().put("type", "number")
+        fun str() = JSONObject().put("type", "string")
+        val item = JSONObject()
+            .put("type", "object")
+            .put(
+                "properties",
+                JSONObject()
+                    .put("name", str())
+                    .put("portion", str())
+                    .put("kcal", num())
+                    .put("protein_g", num())
+                    .put("carbs_g", num())
+                    .put("fat_g", num()),
+            )
+            .put("required", JSONArray(listOf("name", "portion", "kcal", "protein_g", "carbs_g", "fat_g")))
+            .put("additionalProperties", false)
+        return JSONObject()
+            .put("type", "object")
+            .put(
+                "properties",
+                JSONObject()
+                    .put("items", JSONObject().put("type", "array").put("items", item))
+                    .put("total_kcal", num())
+                    .put("total_protein_g", num())
+                    .put("total_carbs_g", num())
+                    .put("total_fat_g", num())
+                    .put("confidence", JSONObject().put("type", "string").put("enum", JSONArray(listOf("low", "medium", "high"))))
+                    .put("notes", str()),
+            )
+            .put(
+                "required",
+                JSONArray(
+                    listOf(
+                        "items", "total_kcal", "total_protein_g", "total_carbs_g", "total_fat_g",
+                        "confidence", "notes",
+                    ),
+                ),
+            )
+            .put("additionalProperties", false)
+    }
+
+    internal fun prompt(note: String, structured: Boolean): String = buildString {
+        append("Estimate the nutrition of the meal in this photo.\n")
+        append("- List each distinct food or drink you can see as one item.\n")
+        append("- Estimate a realistic portion for each from visual cues (plate and cutlery size, hands, packaging) ")
+        append("and write it in plain units (g, ml, units).\n")
+        append("- Give kcal, protein_g, carbs_g and fat_g for that portion from standard food composition data. ")
+        append("Include oil, butter, sauces and dressings you can reasonably infer.\n")
+        append("- The user's note describes what was actually eaten; when it conflicts with the photo, follow the note.\n")
+        append("- total_* must equal the sum of the items.\n")
+        append("- confidence: high when foods and amounts are clear, medium when portions are uncertain, ")
+        append("low when the photo is unclear or the food is hard to identify.\n")
+        append("- Write name, portion and notes in Spanish (Spain). notes: one or two short sentences with ")
+        append("the main assumptions.\n")
+        append("- If the photo does not show food or drink, return no items, zero totals, confidence low, ")
+        append("and say so in notes.\n")
+        val trimmed = note.trim()
+        append("\nUser's note: ")
+        append(if (trimmed.isEmpty()) "(none)" else "\"$trimmed\"")
+        if (!structured) {
+            append("\n\nReply with ONLY one JSON object, no other text, matching this JSON schema:\n")
+            append(outputSchema().toString())
+        }
+    }
+
+    /**
+     * The Messages API body: model, reply cap, one user turn of [image, text], and (when
+     * [structured]) `output_config.format` with [outputSchema]. Never temperature/top_p/thinking/
+     * tool_choice: Claude 5.x answers those with HTTP 400.
+     */
+    internal fun buildRequestBody(model: String, imageBase64: String, note: String, structured: Boolean): JSONObject {
+        val image = JSONObject()
+            .put("type", "image")
+            .put(
+                "source",
+                JSONObject()
+                    .put("type", "base64")
+                    .put("media_type", "image/jpeg")
+                    .put("data", imageBase64),
+            )
+        val text = JSONObject().put("type", "text").put("text", prompt(note, structured))
+        val message = JSONObject()
+            .put("role", "user")
+            .put("content", JSONArray().put(image).put(text))
+        val body = JSONObject()
+            .put("model", model)
+            .put("max_tokens", AiCoach.ANTHROPIC_MAX_TOKENS)
+            .put("messages", JSONArray().put(message))
+        if (structured) {
+            body.put(
+                "output_config",
+                JSONObject().put("format", JSONObject().put("type", "json_schema").put("schema", outputSchema())),
+            )
+        }
+        return body
+    }
+
+    /** A 400 that names the structured-output parameter means "this model cannot do it": retry plain. */
+    internal fun shouldRetryWithoutStructuredOutput(code: Int, body: String): Boolean {
+        if (code != 400) return false
+        val msg = (apiErrorMessage(body) ?: body).lowercase()
+        if ("output_config" in msg || "output_format" in msg || "json_schema" in msg) return true
+        return "format" in msg && "image" !in msg
+    }
+
+    internal fun errorForStatus(code: Int): FoodError = when (code) {
+        401, 403 -> FoodError.KEY_REJECTED
+        413 -> FoodError.IMAGE
+        429, 529 -> FoodError.BUSY
+        in 500..599 -> FoodError.SERVER
+        else -> FoodError.BAD_REQUEST
+    }
+
+    // MARK: - Reply (pure)
+
+    /** A 2xx body to a result: refusal, unreadable, or a sanitised estimate. */
+    internal fun parseReply(body: String): FoodResult {
+        val json = runCatching { JSONObject(body) }.getOrNull()
+            ?: return FoodResult.Failed(FoodError.UNREADABLE)
+        if (json.optString("stop_reason") == "refusal") return FoodResult.Failed(FoodError.REFUSAL)
+        val text = AiCoach.anthropicReplyText(json)
+        val estimate = if (text.isEmpty()) null else parseEstimate(text)
+        return if (estimate != null) FoodResult.Ok(estimate) else FoodResult.Failed(FoodError.UNREADABLE)
+    }
+
+    /** The estimate in [text]: the whole text as JSON, else the first JSON object inside it. */
+    internal fun parseEstimate(text: String): FoodEstimate? {
+        val obj = runCatching { JSONObject(text.trim()) }.getOrNull()
+            ?: extractFirstJsonObject(text)?.let { runCatching { JSONObject(it) }.getOrNull() }
+            ?: return null
+        val arr = obj.optJSONArray("items") ?: return null
+        val items = (0 until arr.length()).mapNotNull { i ->
+            val o = arr.optJSONObject(i) ?: return@mapNotNull null
+            FoodItem(
+                name = o.optString("name").trim(),
+                portion = o.optString("portion").trim(),
+                kcal = round1(o.optDouble("kcal", 0.0)),
+                proteinG = round1(o.optDouble("protein_g", 0.0)),
+                carbsG = round1(o.optDouble("carbs_g", 0.0)),
+                fatG = round1(o.optDouble("fat_g", 0.0)),
+            )
+        }.filter { it.name.isNotEmpty() || it.kcal > 0.0 }
+        val reported = FoodTotals(
+            round1(obj.optDouble("total_kcal", 0.0)),
+            round1(obj.optDouble("total_protein_g", 0.0)),
+            round1(obj.optDouble("total_carbs_g", 0.0)),
+            round1(obj.optDouble("total_fat_g", 0.0)),
+        )
+        val confidence = obj.optString("confidence").trim().lowercase().takeIf { it in setOf("low", "medium", "high") }
+        return FoodEstimate(items, reported, confidence, obj.optString("notes").trim())
+    }
+
+    /** The first balanced `{...}` in [text] (strings and escapes respected), or null. Tolerates ```json fences. */
+    internal fun extractFirstJsonObject(text: String): String? {
+        var start = text.indexOf('{')
+        while (start >= 0) {
+            var depth = 0
+            var inString = false
+            var escaped = false
+            for (i in start until text.length) {
+                val c = text[i]
+                if (inString) {
+                    when {
+                        escaped -> escaped = false
+                        c == '\\' -> escaped = true
+                        c == '"' -> inString = false
+                    }
+                    continue
+                }
+                when (c) {
+                    '"' -> inString = true
+                    '{' -> depth++
+                    '}' -> {
+                        depth--
+                        if (depth == 0) {
+                            val candidate = text.substring(start, i + 1)
+                            if (runCatching { JSONObject(candidate) }.isSuccess) return candidate
+                            break
+                        }
+                    }
+                }
+            }
+            start = text.indexOf('{', start + 1)
+        }
+        return null
+    }
+
+    private fun apiErrorMessage(body: String): String? = runCatching {
+        JSONObject(body).optJSONObject("error")?.optString("message")?.takeIf { it.isNotBlank() }
+    }.getOrNull()
+
+    // MARK: - Transport
+
+    private suspend fun post(url: String, key: String, body: String): Pair<Int, String> =
+        withContext(Dispatchers.IO) {
+            val request = Request.Builder()
+                .url(url)
+                .addHeader("x-api-key", key)
+                .addHeader("anthropic-version", API_VERSION)
+                .addHeader("content-type", "application/json")
+                .post(body.toRequestBody(JSON))
+                .build()
+            val call = http.newCall(request)
+            // Leaving the sheet cancels the coroutine; cancel the socket too instead of waiting it out.
+            val handle = coroutineContext[Job]?.invokeOnCompletion { cause ->
+                if (cause is CancellationException) call.cancel()
+            }
+            try {
+                call.execute().use { resp -> resp.code to resp.body?.string().orEmpty() }
+            } finally {
+                handle?.dispose()
+            }
+        }
+}
