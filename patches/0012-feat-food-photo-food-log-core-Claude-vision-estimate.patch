@@ -0,0 +1,171 @@
+package com.noop.food
+
+import com.noop.data.MetricSeriesRow
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.time.LocalDate
+import java.time.ZoneId
+
+/** victor:food — day totals, the review draft's number handling, the nutrition-lane plan and the Coach line. */
+class FoodLogTest {
+
+    private fun entry(id: String, day: String, kcal: Double, p: Double = 10.0, c: Double = 20.0, f: Double = 5.0, ts: Long = 0L) =
+        FoodEntry(
+            id = id, timestamp = ts, day = day, note = "", items = emptyList(),
+            kcal = kcal, proteinG = p, carbsG = c, fatG = f, thumbnailPath = null,
+        )
+
+    // MARK: - Day totals
+
+    @Test
+    fun dayTotalsSumOnlyThatDayAndRoundToOneDecimal() {
+        val log = listOf(
+            entry("a", "2026-10-16", 500.04, 30.1, 40.0, 10.0),
+            entry("b", "2026-10-16", 700.03, 20.2, 80.0, 25.5),
+            entry("c", "2026-10-15", 1000.0),
+        )
+        assertEquals(FoodTotals(1200.1, 50.3, 120.0, 35.5), FoodDays.totalsFor(log, "2026-10-16"))
+        assertEquals(FoodTotals(1000.0, 10.0, 20.0, 5.0), FoodDays.totalsFor(log, "2026-10-15"))
+        assertNull("no entries is not the same as a logged zero", FoodDays.totalsFor(log, "2026-10-14"))
+    }
+
+    @Test
+    fun totalsStayFiniteAndNonNegative() {
+        val items = listOf(
+            FoodItem("a", "", 100.0, 1.0, 2.0, 3.0),
+            FoodItem("b", "", -150.0, Double.NaN, 1.0, 1.0),
+        )
+        // The sum is clamped field by field: a bad term zeroes only its own field.
+        val t = FoodTotals.ofItems(items)
+        assertEquals(0.0, t.kcal, 0.0)
+        assertEquals(0.0, t.proteinG, 0.0)
+        assertEquals(3.0, t.carbsG, 0.0)
+        assertEquals(4.0, t.fatG, 0.0)
+    }
+
+    @Test
+    fun groupedByDayIsNewestDayFirstAndMealsInOrder() {
+        val log = listOf(
+            entry("late", "2026-10-15", 1.0, ts = 300),
+            entry("today", "2026-10-16", 1.0, ts = 400),
+            entry("early", "2026-10-15", 1.0, ts = 100),
+        )
+        val g = FoodDays.groupedByDay(log)
+        assertEquals(listOf("2026-10-16", "2026-10-15"), g.map { it.first })
+        assertEquals(listOf("early", "late"), g[1].second.map { it.id })
+    }
+
+    @Test
+    fun dayOfUsesTheLocalCalendarDay() {
+        // 2026-10-16 23:30 in Madrid (UTC+2) is still the 16th locally, the 16th 21:30 in UTC.
+        val ts = 1792186200000L
+        assertEquals("2026-10-16", FoodDays.dayOf(ts, ZoneId.of("Europe/Madrid")))
+        assertEquals("2026-10-17", FoodDays.dayOf(ts, ZoneId.of("Asia/Tokyo")))
+    }
+
+    // MARK: - Review draft numbers
+
+    @Test
+    fun draftAmountsParseCommaAndDotAndFormatBack() {
+        assertEquals(12.5, FoodItemDraft.parseAmount("12,5"), 0.0)
+        assertEquals(12.5, FoodItemDraft.parseAmount(" 12.5 "), 0.0)
+        assertEquals(0.0, FoodItemDraft.parseAmount(""), 0.0)
+        assertEquals(0.0, FoodItemDraft.parseAmount("1,2,3"), 0.0)
+        assertEquals("250", FoodItemDraft.formatAmount(250.0))
+        assertEquals("3.4", FoodItemDraft.formatAmount(3.44))
+        val item = FoodItem("Arroz", "150 g", 195.0, 4.1, 42.3, 0.4)
+        assertEquals(item, FoodItemDraft.of(item).toItem())
+    }
+
+    // MARK: - Nutrition lane plan
+
+    private val keys = FoodNutritionSync.KEYS
+
+    @Test
+    fun aDayWithEntriesWritesAllFourIntakeKeysAndRemembersThem() {
+        val t = FoodTotals(1850.0, 120.0, 180.0, 60.0)
+        val plan = FoodNutritionSync.plan("2026-10-16", t, lastWritten = null, stored = emptyMap())
+        assertEquals(
+            listOf(
+                MetricSeriesRow("nutrition-csv", "2026-10-16", "calories_in", 1850.0),
+                MetricSeriesRow("nutrition-csv", "2026-10-16", "protein_g", 120.0),
+                MetricSeriesRow("nutrition-csv", "2026-10-16", "carbs_g", 180.0),
+                MetricSeriesRow("nutrition-csv", "2026-10-16", "fat_g", 60.0),
+            ),
+            plan.upserts,
+        )
+        assertTrue(plan.deleteKeys.isEmpty())
+        assertEquals(t, plan.ledger)
+        assertTrue("weight is never written", plan.upserts.none { it.key == "weight" })
+    }
+
+    @Test
+    fun clearingADayDeletesOnlyWhatThePhotoLogStillOwns() {
+        val wrote = FoodTotals(1850.0, 120.0, 180.0, 60.0)
+        // A CSV import later replaced calories and protein for that day; carbs/fat are still ours.
+        val stored = mapOf(keys[0] to 2100.0, keys[1] to 130.0, keys[2] to 180.0, keys[3] to 60.0)
+        val plan = FoodNutritionSync.plan("2026-10-16", null, wrote, stored)
+        assertTrue(plan.upserts.isEmpty())
+        assertEquals(listOf("carbs_g", "fat_g"), plan.deleteKeys)
+        assertNull(plan.ledger)
+    }
+
+    @Test
+    fun aDayThePhotoLogNeverWroteIsNeverTouched() {
+        val stored = mapOf(keys[0] to 2100.0, keys[1] to 130.0, keys[2] to 200.0, keys[3] to 70.0)
+        val plan = FoodNutritionSync.plan("2026-10-10", null, lastWritten = null, stored = stored)
+        assertTrue(plan.upserts.isEmpty())
+        assertTrue(plan.deleteKeys.isEmpty())
+        assertNull(plan.ledger)
+    }
+
+    @Test
+    fun alreadyDeletedValuesAreSkipped() {
+        val wrote = FoodTotals(500.0, 20.0, 50.0, 10.0)
+        val plan = FoodNutritionSync.plan("2026-10-16", null, wrote, keys.associateWith { null })
+        assertTrue(plan.deleteKeys.isEmpty())
+    }
+
+    // MARK: - Coach line
+
+    private val today = LocalDate.of(2026, 10, 16)
+
+    @Test
+    fun coachLineIsNullWithNothingRecent() {
+        assertNull(FoodCoachContext.line(emptyList(), today))
+        assertNull(FoodCoachContext.line(listOf(entry("old", "2026-10-01", 2000.0)), today))
+    }
+
+    @Test
+    fun coachLineSummarisesTodayAndThePreviousWeek() {
+        val log = listOf(
+            entry("t1", "2026-10-16", 600.0, 40.0, 60.0, 20.0),
+            entry("t2", "2026-10-16", 800.0, 50.0, 70.0, 25.0),
+            entry("t3", "2026-10-16", 450.0, 30.0, 50.0, 15.0),
+            entry("y1", "2026-10-15", 2000.0),
+            entry("y2", "2026-10-15", 200.0),
+            entry("d3", "2026-10-13", 1900.0),
+            entry("d8", "2026-10-09", 2500.0), // 7 days before today: inside the window
+            entry("d9", "2026-10-08", 9999.0), // 8 days before: outside
+        )
+        assertEquals(
+            "FOOD LOG (photo estimates): today 1850 kcal (P 120 g, C 180 g, F 60 g) from 3 meals; " +
+                "previous 7 days avg 2200 kcal/day over 3 logged days",
+            FoodCoachContext.line(log, today),
+        )
+    }
+
+    @Test
+    fun coachLineWithoutTodayOrWithoutHistory() {
+        assertEquals(
+            "FOOD LOG (photo estimates): today nothing logged yet; previous 7 days avg 2000 kcal/day over 1 logged day",
+            FoodCoachContext.line(listOf(entry("y", "2026-10-15", 2000.0)), today),
+        )
+        assertEquals(
+            "FOOD LOG (photo estimates): today 500 kcal (P 10 g, C 20 g, F 5 g) from 1 meal",
+            FoodCoachContext.line(listOf(entry("t", "2026-10-16", 500.0)), today),
+        )
+    }
+}
