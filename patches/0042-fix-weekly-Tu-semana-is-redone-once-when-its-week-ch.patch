 /**
@@ -65,6 +72,33 @@ object WeeklyReviews {
     fun dueWeekStart(now: LocalDateTime, locale: Locale = Locale.getDefault()): LocalDate =
         lastWeekStart(now.minusHours(READY_HOURS).toLocalDate(), locale)
 
+    /**
+     * The week's data as Claude is told it: each meal's id, day, kcal and macros, each workout seen (source,
+     * start, end, sport) and each of Claude's workout analyses (when, kcal, effort). Order-free.
+     */
+    fun signature(weekFood: List<FoodEntry>, weekWorkouts: List<WorkoutRow>, sessions: List<TrainingSession>): String {
+        val meals = weekFood.map { "m:${it.id}:${it.day}:${it.kcal}:${it.proteinG}:${it.carbsG}:${it.fatG}" }
+        val workouts = weekWorkouts.map { "w:${it.deviceId}:${it.startTs}:${it.endTs}:${it.sport}" }
+        val analyses = sessions.mapNotNull { s -> s.analysis?.let { "a:${s.id}:${it.atMs}:${it.totalKcal}:${it.effort}" } }
+        return Integer.toHexString((meals + workouts + analyses).sorted().joinToString("|").hashCode())
+    }
+
+    /**
+     * Whether [review] can still be redone at [now]: it has a sig (not older than 2026-10-20, not redone yet,
+     * see [storedSig]) and the next week's Wednesday has not ended, while it still guides that week.
+     */
+    fun redoOpen(review: WeeklyReview, now: LocalDateTime): Boolean {
+        if (review.sig == null) return false
+        val start = runCatching { LocalDate.parse(review.weekStart) }.getOrNull() ?: return false
+        return now.isBefore(start.plusWeeks(1).with(TemporalAdjusters.nextOrSame(DayOfWeek.WEDNESDAY)).plusDays(1).atStartOfDay())
+    }
+
+    /** Whether [review] is asked for again now that its week reads [sig]: its data changed while [redoOpen]. */
+    fun redoDue(review: WeeklyReview, sig: String, now: LocalDateTime): Boolean = redoOpen(review, now) && review.sig != sig
+
+    /** The sig a new review keeps: the week's for a first review, none for a redo, so a week is redone once at most. */
+    fun storedSig(previous: WeeklyReview?, sig: String): String? = if (previous == null) sig else null
+
     /** Enough to judge: three days with meals, or any workout. */
     fun hasEnough(foodDays: Int, workouts: Int): Boolean = foodDays >= 3 || workouts > 0
 
