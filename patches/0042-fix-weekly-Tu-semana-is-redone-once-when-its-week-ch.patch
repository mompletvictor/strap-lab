diff --git a/android/app/src/test/java/com/noop/weekly/WeeklyReviewTest.kt b/android/app/src/test/java/com/noop/weekly/WeeklyReviewTest.kt
index 09e55196..62daa389 100644
--- a/android/app/src/test/java/com/noop/weekly/WeeklyReviewTest.kt
+++ b/android/app/src/test/java/com/noop/weekly/WeeklyReviewTest.kt
@@ -144,4 +144,47 @@ class WeeklyReviewTest {
             line,
         )
     }
+
+    @Test
+    fun aChangedWeekIsReviewedAgainOnceUntilTheNextWednesday() {
+        val day = "2026-10-14"
+        fun meal(kcal: Double) = FoodEntry(
+            "e", LocalDate.parse(day).atTime(21, 0).atZone(madrid).toInstant().toEpochMilli(), day, "",
+            listOf(FoodItem("Pasta", "1", kcal, 12.0, 70.0, 9.0)), kcal, 12.0, 70.0, 9.0, emptyList(), meal = MealType.DINNER,
+        )
+        val start = LocalDate.of(2026, 10, 14).atTime(18, 0).atZone(madrid).toEpochSecond()
+        val gym = WorkoutRow("my-whoop", start, start + 3600, "Strength", "manual", durationS = 3600.0)
+        val sig0 = WeeklyReviews.signature(listOf(meal(600.0)), listOf(gym), emptyList())
+        // Reviewed on Monday 19 at 10:05: the first review keeps the week's sig.
+        val first = WeeklyReview("2026-10-12", 6, "", 5, "", 6, "", "", 1L, sig = WeeklyReviews.storedSig(null, sig0))
+        assertEquals(sig0, first.sig)
+        val tuesday = LocalDateTime.of(2026, 10, 20, 12, 0)
+        assertFalse("nothing changed", WeeklyReviews.redoDue(first, sig0, tuesday))
+        // The dinner is corrected on Tuesday: asked for again.
+        val sig1 = WeeklyReviews.signature(listOf(meal(850.0)), listOf(gym), emptyList())
+        assertTrue(WeeklyReviews.redoDue(first, sig1, tuesday))
+        // The redo keeps no sig: a second change is not asked for again.
+        val redone = first.copy(atMs = 2L, sig = WeeklyReviews.storedSig(first, sig1))
+        assertNull(redone.sig)
+        val sig2 = WeeklyReviews.signature(listOf(meal(900.0)), listOf(gym), emptyList())
+        assertFalse(WeeklyReviews.redoDue(redone, sig2, tuesday))
+        // Past the next Wednesday (21st, 23:59) nothing is redone; a review from before sigs never is.
+        assertTrue(WeeklyReviews.redoDue(first, sig1, LocalDateTime.of(2026, 10, 21, 23, 59)))
+        assertFalse(WeeklyReviews.redoDue(first, sig1, LocalDateTime.of(2026, 10, 22, 0, 0)))
+        assertFalse(WeeklyReviews.redoDue(first.copy(sig = null), sig1, tuesday))
+        // A new workout or a new analysis changes the week too; the order things are read in does not.
+        assertTrue(sig0 != WeeklyReviews.signature(listOf(meal(600.0)), listOf(gym, gym.copy(startTs = start + 86_400L, endTs = start + 90_000L)), emptyList()))
+        assertEquals(sig0, WeeklyReviews.signature(listOf(meal(600.0)), listOf(gym), emptyList()))
+        val session = com.noop.training.TrainingSession(
+            id = "s", mode = com.noop.training.TrainingMode.LOGGED, startTs = start, endTs = start + 3600, sport = "Strength",
+            description = "", exercises = emptyList(),
+            analysis = com.noop.training.TrainingAnalysis(380.0, 330.0, 430.0, 210.0, "", 5L, effort = 48.0),
+        )
+        assertTrue(sig0 != WeeklyReviews.signature(listOf(meal(600.0)), listOf(gym), listOf(session)))
+        // On disk: the sig round-trips, and a file written before it reads with none.
+        assertEquals(listOf(first), WeeklyReviews.decode(WeeklyReviews.encode(listOf(first))))
+        val old = WeeklyReviews.decode("""{"version":1,"reviews":[{"week":"2026-10-05","food_note":"","training_note":"","overall_note":"x","focus":"","at":3,"overall":5}]}""")
+        assertNull(old.single().sig)
+        assertFalse(WeeklyReviews.redoDue(old.single(), sig1, LocalDateTime.of(2026, 10, 6, 12, 0)))
+    }
