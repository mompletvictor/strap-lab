@@ -0,0 +1,30 @@
+package com.noop.training
+
+import android.content.Context
+import com.noop.NoopApplication
+import com.noop.ai.AiCoach
+import com.noop.ai.AiKeyStore
+import com.noop.ai.VictorCoachExtras
+
+/**
+ * victor:training — what a suggested workout is grounded in: exactly the data block the AI Coach sends (the
+ * 14-day strap table, recent workouts and the fork's extras, TRAINING LOG included), re-read fresh, and only
+ * with the same consent the coach asks for. Null without it, and the request then says so.
+ */
+internal object TrainingSuggestContext {
+
+    suspend fun block(ctx: Context): String? {
+        if (!AiKeyStore.readConsent(ctx)) return null
+        val app = ctx.applicationContext as NoopApplication
+        val repo = app.repository
+        val strapId = app.sourceCoordinator.activeDeviceId.value ?: app.activeDeviceId
+        val coach = AiCoach(repo) { strapId }
+        VictorCoachExtras.refresh(ctx, repo)
+        val days = runCatching { repo.daysMerged(strapId) }.getOrDefault(emptyList())
+        return buildString {
+            append(coach.buildContext(days))
+            runCatching { coach.recentWorkoutsBlock(ctx) }.getOrNull()?.takeIf { it.isNotBlank() }?.let { append("\n\n").append(it) }
+            runCatching { VictorCoachExtras.block(ctx, repo, strapId) }.getOrNull()?.let { append("\n\n").append(it) }
+        }
+    }
+}
