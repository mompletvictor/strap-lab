diff --git a/android/app/src/main/java/com/noop/food/FoodScorer.kt b/android/app/src/main/java/com/noop/food/FoodScorer.kt
new file mode 100644
index 00000000..6f54c6bb
--- /dev/null
+++ b/android/app/src/main/java/com/noop/food/FoodScorer.kt
@@ -0,0 +1,74 @@
+package com.noop.food
+
+import android.content.Context
+import com.noop.NoopApplication
+import com.noop.ai.AiKeyStore
+import com.noop.ai.AiProvider
+import com.noop.ai.ScaleCoachContext
+import com.noop.ai.VictorCoachVitals
+import com.noop.goals.VictorGoals
+import com.noop.goals.VictorGoalsStore
+import com.noop.ingest.ScaleImport
+import com.noop.training.TrainingAi
+import com.noop.training.TrainingAiResult
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.launch
+import java.time.LocalDateTime
+import java.util.concurrent.atomic.AtomicBoolean
+
+/**
+ * victor:scores — asks Claude for the mark of every meal of today and yesterday that is over and not scored
+ * as it is now ([MealScoring.due]). Called when the Food tab or the Today food card shows, so a meal gets its
+ * mark the next time the wearer looks after it is finished; one pass at a time, process-scoped. A failure
+ * (offline, no key) stops the pass and the next look tries again.
+ */
+object FoodScorer {
+
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+    private val running = AtomicBoolean(false)
+
+    fun scoreDue(ctx: Context) {
+        val app = ctx.applicationContext
+        if (!running.compareAndSet(false, true)) return
+        scope.launch {
+            try {
+                runCatching { pass(app) }
+            } finally {
+                running.set(false)
+            }
+        }
+    }
+
+    private suspend fun pass(ctx: Context) {
+        if (AiKeyStore.read(ctx, AiProvider.ANTHROPIC) == null) return
+        val entries = FoodStore.load(ctx)
+        val now = LocalDateTime.now()
+        val today = now.toLocalDate()
+        val due = MealScoring.due(entries, FoodStore.loadScores(ctx), now, setOf(today.toString(), today.minusDays(1).toString()))
+        if (due.isEmpty()) return
+        val person = personLines(ctx)
+        for ((day, meal) in due) {
+            val group = entries.filter { it.day == day && it.meal == meal }
+            val signature = MealScoring.signature(group)
+            val prompt = MealScoring.prompt(meal, day, group, entries.filter { it.day == day }, person)
+            when (val r = TrainingAi.ask(ctx, prompt, MealScoring.schema()) { MealScoring.parse(it, signature, System.currentTimeMillis()) }) {
+                is TrainingAiResult.Ok -> FoodStore.saveScore(ctx, MealScoring.key(day, meal), r.value)
+                is TrainingAiResult.Failed -> return
+            }
+        }
+    }
+
+    /** Profile, scale and goals, as the coach reads them, and only with the coach's data consent. */
+    private suspend fun personLines(ctx: Context): List<String> {
+        if (!AiKeyStore.readConsent(ctx)) return emptyList()
+        val repo = (ctx.applicationContext as NoopApplication).repository
+        val scale = runCatching { ScaleImport.snapshot(repo, ScaleImport.newestReading(ctx)) }.getOrNull()
+        return listOfNotNull(
+            runCatching { VictorCoachVitals.profileLine(ctx, scaleHasWeight = scale?.weight != null) }.getOrNull(),
+            ScaleCoachContext.line(scale),
+            runCatching { VictorGoals.coachLine(VictorGoalsStore.load(ctx), scale?.weight?.value) }.getOrNull(),
+        )
+    }
+}
