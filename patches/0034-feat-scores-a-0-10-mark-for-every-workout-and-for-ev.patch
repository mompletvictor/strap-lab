+package com.noop.training
+
+import androidx.compose.foundation.background
+import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.shape.RoundedCornerShape
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.Color
+import com.noop.ui.Metrics
+import com.noop.ui.NoopType
+import com.noop.ui.Palette
+
+/** victor:scores — a 0-10 mark as a small tinted pill: green from 7, amber from 4, red below. */
+@Composable
+fun ScoreBadge(score: Int, modifier: Modifier = Modifier) {
+    val tint = scoreColor(score)
+    Text(
+        "$score/10",
+        style = NoopType.captionNumber,
+        color = tint,
+        modifier = modifier
+            .background(tint.copy(alpha = 0.16f), RoundedCornerShape(50))
+            .padding(horizontal = Metrics.space8, vertical = Metrics.space2),
+    )
+}
+
+fun scoreColor(score: Int): Color = when {
+    score >= 7 -> Palette.chargeColor
+    score >= 4 -> Palette.metricAmber
+    else -> Palette.statusCritical
+}
