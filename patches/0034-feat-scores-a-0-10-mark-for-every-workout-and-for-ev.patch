diff --git a/android/app/src/test/java/com/noop/food/MealScoringTest.kt b/android/app/src/test/java/com/noop/food/MealScoringTest.kt
new file mode 100644
index 00000000..857e5d5e
--- /dev/null
+++ b/android/app/src/test/java/com/noop/food/MealScoringTest.kt
@@ -0,0 +1,85 @@
+package com.noop.food
+
+import org.json.JSONObject
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.time.LocalDate
+import java.time.LocalDateTime
+import java.time.ZoneId
+
+/** victor:scores — a meal is marked whole, once it is over, and again only when it changes. */
+class MealScoringTest {
+
+    private val madrid = ZoneId.of("Europe/Madrid")
+    private val day = "2026-10-19"
+
+    private fun entry(id: String, h: Int, m: Int, meal: MealType, kcal: Double = 100.0) = FoodEntry(
+        id = id,
+        timestamp = LocalDate.parse(day).atTime(h, m).atZone(madrid).toInstant().toEpochMilli(),
+        day = day,
+        note = "",
+        items = listOf(FoodItem("Cosa $id", "1", kcal, 5.0, 10.0, 2.0)),
+        kcal = kcal, proteinG = 5.0, carbsG = 10.0, fatG = 2.0,
+        thumbnailPaths = emptyList(),
+        meal = meal,
+    )
+
+    private val coffee = entry("a", 8, 0, MealType.BREAKFAST)
+    private val eggs = entry("b", 8, 20, MealType.BREAKFAST, 180.0)
+    private val lunch = entry("c", 14, 30, MealType.LUNCH, 700.0)
+
+    private fun at(h: Int, m: Int) = LocalDate.parse(day).atTime(h, m)
+
+    @Test
+    fun aMealInItsSlotWaitsForTheRestOfIt() {
+        // 09:00, two breakfast photos in: still breakfast time, nothing to score.
+        assertEquals(emptyList<Pair<String, MealType>>(), MealScoring.due(listOf(coffee, eggs), emptyMap(), at(9, 0), setOf(day)))
+        // Past 10:30 the breakfast is over and is scored as ONE meal.
+        assertEquals(listOf(day to MealType.BREAKFAST), MealScoring.due(listOf(coffee, eggs), emptyMap(), at(10, 31), setOf(day)))
+    }
+
+    @Test
+    fun aLaterMealClosesTheEarlierOnesButNotItself() {
+        val due = MealScoring.due(listOf(coffee, eggs, lunch), emptyMap(), at(9, 30).plusHours(5), setOf(day))
+        assertEquals(listOf(day to MealType.BREAKFAST), due)
+        // A nibble does not close anything, and closes with the day.
+        val nibble = entry("n", 9, 0, MealType.NIBBLE)
+        assertEquals(emptyList<Pair<String, MealType>>(), MealScoring.due(listOf(coffee, nibble), emptyMap(), at(9, 30), setOf(day)))
+        assertEquals(listOf(day to MealType.BREAKFAST, day to MealType.NIBBLE), MealScoring.due(listOf(coffee, nibble), emptyMap(), LocalDateTime.of(2026, 10, 20, 0, 1), setOf(day)))
+    }
+
+    @Test
+    fun aScoredMealIsScoredAgainOnlyWhenItChanges() {
+        val sig = MealScoring.signature(listOf(eggs, coffee))
+        val scored = mapOf(MealScoring.key(day, MealType.BREAKFAST) to MealScore(8, "Bien", sig, 1L))
+        assertEquals(emptyList<Pair<String, MealType>>(), MealScoring.due(listOf(coffee, eggs), scored, at(11, 0), setOf(day)))
+        val toast = entry("t", 10, 0, MealType.BREAKFAST)
+        assertEquals(listOf(day to MealType.BREAKFAST), MealScoring.due(listOf(coffee, eggs, toast), scored, at(11, 0), setOf(day)))
+        // Edited amounts change the signature too; other days are left alone.
+        assertEquals(listOf(day to MealType.BREAKFAST), MealScoring.due(listOf(coffee, eggs.copy(kcal = 250.0)), scored, at(11, 0), setOf(day)))
+        assertEquals(emptyList<Pair<String, MealType>>(), MealScoring.due(listOf(coffee, eggs), emptyMap(), at(11, 0), setOf("2026-10-18")))
+    }
+
+    @Test
+    fun thePromptHasTheWholeMealAndTheRestOfTheDay() {
+        val p = MealScoring.prompt(MealType.BREAKFAST, day, listOf(coffee, eggs), listOf(coffee, eggs, lunch), listOf("GOALS: lose fat"))
+        assertTrue(p.contains("MEAL: breakfast on $day"))
+        assertTrue(p.contains("280 kcal in total"))
+        assertTrue(p.contains("- Cosa b (1): 180 kcal, P 5 g, C 10 g, F 2 g"))
+        assertTrue(p.contains("Rest of that day: lunch 700 kcal"))
+        assertTrue(p.trim().endsWith("GOALS: lose fat"))
+    }
+
+    @Test
+    fun theReplyIsClampedAndScoresRoundTrip() {
+        assertEquals(10, MealScoring.parse(JSONObject("""{"score":12,"note":"x"}"""), "s", 0L)!!.score)
+        assertEquals(7, MealScoring.parse(JSONObject("""{"score":6.6,"note":"x"}"""), "s", 0L)!!.score)
+        assertNull(MealScoring.parse(JSONObject("""{"note":"x"}"""), "s", 0L))
+        val state = FoodState(entries = listOf(coffee), scores = mapOf("k" to MealScore(8, "Proteína y fruta.", "sig", 5L)))
+        assertEquals(state, FoodStoreCodec.decode(FoodStoreCodec.encode(state)))
+        val line = FoodCoachContext.line(listOf(coffee, eggs), LocalDate.parse(day), mapOf(MealScoring.key(day, MealType.BREAKFAST) to MealScore(8, "", MealScoring.signature(listOf(coffee, eggs)), 1L)))
+        assertTrue(line!!.contains("breakfast 280 (meal score 8/10)"))
+    }
+}
