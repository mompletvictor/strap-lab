@@ -0,0 +1,376 @@
+package com.noop.data
+
+import android.content.Context
+import android.util.Log
+import com.noop.ui.NoopPrefs
+import org.json.JSONObject
+import java.io.File
+import java.io.FileInputStream
+import java.io.FileOutputStream
+import java.io.IOException
+import java.io.InputStream
+import java.io.OutputStream
+import java.util.zip.ZipEntry
+import java.util.zip.ZipInputStream
+import java.util.zip.ZipOutputStream
+
+/**
+ * victor:backup — the fork's own data inside the `.noopbak`, which upstream's archive (the SQLite,
+ * `settings.json` and `manifest.json`) leaves out: the food log with its thumbnails (`files/food`), the
+ * workouts' exercises and Claude's analyses (`files/training`), the weekly reviews (`files/weekly`) and
+ * the fork's user preferences in `noop_prefs` ([PREFS]). Without them, restoring onto a new phone brought
+ * back the strap history but an empty Food tab, workouts without exercises and no weeks.
+ *
+ * Entries, all optional and all under [PREFIX]: `victor/prefs.json`, `victor/files/<dir>/<path>` for every
+ * file of the three folders, and `victor/end.json` closing them ([END_ENTRY]). [DataBackup.exportTo] writes
+ * them after `settings.json` and before `manifest.json`, so the DB entry stays first and an older importer,
+ * which picks entries by their file name, never meets one of ours under a name it knows ([RESERVED_NAMES]
+ * are refused on both sides).
+ *
+ * Restore is all or nothing for our part, and never fails the DB restore (the same rule upstream applies
+ * to `settings.json`): [DataBackup.importFrom] calls [restore] only after the new database has landed and
+ * passed its check, so a rolled-back DB restore never reaches it. Every entry is checked before anything
+ * live is touched (no `..`, no absolute paths, only the three folders, size caps); one bad entry and none
+ * of ours is applied. A folder the backup carries replaces the device's one whole; a folder it does not
+ * carry (every older backup) is left exactly as it was. The stores ([com.noop.food.FoodStore],
+ * [com.noop.training.TrainingStore], [com.noop.weekly.WeeklyReviewer]) read their file again on the next
+ * launch, which is the restart upstream already asks for after a restore.
+ *
+ * Never in the copy: the Claude key and the coach's consent (encrypted in `noop_ai_secure_prefs`, never
+ * read here), the Tasker token, and any per-phone state (see [PREFS]).
+ */
+internal object VictorBackupFiles {
+
+    private const val TAG = "VictorBackup"
+
+    /** Every entry of ours starts with this. */
+    const val PREFIX = "victor/"
+
+    private const val FILES_PREFIX = "victor/files/"
+
+    /** The preferences entry ([PREFS] only). */
+    const val PREFS_ENTRY = "victor/prefs.json"
+
+    /**
+     * Written after all of ours with their count. A copy cut exactly between two entries still reads as a
+     * clean end, so without it a half-carried folder could replace a whole one.
+     */
+    const val END_ENTRY = "victor/end.json"
+
+    /** The app-private folders under `filesDir` that hold the fork's data. */
+    val DIRS: List<String> = listOf("food", "training", "weekly")
+
+    /** Upstream's entry names: an importer that matches by file name must never meet one of ours. */
+    private val RESERVED_NAMES = setOf("noop-backup.sqlite", BackupSettingsCodec.ENTRY_NAME, BackupManifest.ENTRY_NAME)
+
+    /** Caps, far above a real log (a thumbnail is tens of KB) and checked on export and on restore. */
+    const val MAX_ENTRY_BYTES = 64L * 1024 * 1024
+    const val MAX_TOTAL_BYTES = 2L * 1024 * 1024 * 1024
+    const val MAX_ENTRIES = 100_000
+    private const val MAX_PREFS_BYTES = 64L * 1024
+    private const val MAX_DEPTH = 4
+    private val SEGMENT = Regex("[A-Za-z0-9][A-Za-z0-9._-]{0,127}")
+
+    /** Where a restore is staged and where the replaced folders wait until the swap is done. */
+    private const val STAGING = "victor-restore.staging"
+    private const val ASIDE_SUFFIX = ".victor-restore-old"
+
+    enum class Kind { BOOL, STRING }
+
+    /**
+     * The fork's preferences that travel, all in `noop_prefs`: the goals, the coach's agenda switch, the
+     * "Mi día" view and the automatic-vibration switch. Left out on purpose: `victor.tasker.token` (a
+     * secret) and `victor.tasker.enabled` (the bridge belongs to that phone's Tasker), `victor.gtasks.connected`
+     * (the Google grant is per phone and its token is never stored), `victor.scale.newestReading*` (that
+     * phone's Health Connect watermark) and `victor.today.quietCards.v1` (once per install).
+     */
+    val PREFS: Map<String, Kind> = linkedMapOf(
+        "victor.goals.goal" to Kind.STRING,
+        "victor.goals.targetWeightKg" to Kind.STRING,
+        "victor.goals.dailyKcal" to Kind.STRING,
+        "victor.goals.note" to Kind.STRING,
+        "victor.coach.agenda" to Kind.BOOL,
+        "victor.day.view" to Kind.STRING,
+        "victor.haptics.automatic" to Kind.BOOL,
+    )
+
+    // ── Preferences (pure JSON + whitelist) ─────────────────────────────────────
+
+    /** The whitelisted, correctly typed subset of [values] as `prefs.json`, or null when there is none. */
+    fun encodePrefs(values: Map<String, Any?>): String? {
+        val obj = JSONObject()
+        for ((key, kind) in PREFS) coerce(values[key], kind)?.let { obj.put(key, it) }
+        return if (obj.length() == 0) null else obj.toString()
+    }
+
+    /** A `prefs.json` down to its whitelisted, correctly typed keys; anything malformed is dropped. */
+    fun decodePrefs(json: String): Map<String, Any> {
+        val obj = runCatching { JSONObject(json) }.getOrNull() ?: return emptyMap()
+        val out = LinkedHashMap<String, Any>()
+        for ((key, kind) in PREFS) {
+            if (obj.has(key)) coerce(obj.opt(key), kind)?.let { out[key] = it }
+        }
+        return out
+    }
+
+    private fun coerce(value: Any?, kind: Kind): Any? = when (kind) {
+        Kind.BOOL -> value as? Boolean
+        Kind.STRING -> (value as? String)?.take(1_000)
+    }
+
+    // ── Export ──────────────────────────────────────────────────────────────────
+
+    /** Live wrapper for [DataBackup.exportTo]: this phone's folders and preferences. */
+    fun writeEntries(zip: ZipOutputStream, context: Context) {
+        val app = context.applicationContext
+        writeEntries(zip, app.filesDir, prefsSnapshot(app))
+    }
+
+    /**
+     * Write our entries into [zip]: [prefsJson] when given, every file [plan] keeps, then [END_ENTRY]. A
+     * file that cannot be opened (deleted meanwhile) is skipped; a failure WRITING the archive propagates,
+     * so the export fails as a whole, as upstream's does. Nothing at all is written when there is nothing.
+     */
+    @Throws(IOException::class)
+    fun writeEntries(zip: ZipOutputStream, filesDir: File, prefsJson: String?) {
+        var written = 0
+        if (prefsJson != null) {
+            zip.putNextEntry(ZipEntry(PREFS_ENTRY))
+            zip.write(prefsJson.toByteArray(Charsets.UTF_8))
+            zip.closeEntry()
+            written++
+        }
+        for ((name, file) in plan(filesDir)) {
+            val input = runCatching { FileInputStream(file) }.getOrNull() ?: continue
+            input.use {
+                zip.putNextEntry(ZipEntry(name))
+                copyBounded(it, zip, MAX_ENTRY_BYTES)
+                zip.closeEntry()
+            }
+            written++
+        }
+        if (written == 0) return
+        zip.putNextEntry(ZipEntry(END_ENTRY))
+        zip.write(JSONObject().put("entries", written).toString().toByteArray(Charsets.UTF_8))
+        zip.closeEntry()
+    }
+
+    /**
+     * Entry name → file for every file of [DIRS] under [filesDir], sorted. Skips `.tmp` files (a write in
+     * flight) and names the restore would refuse. A folder that breaks a cap is left out WHOLE: restoring
+     * replaces a folder, so half of one would lose data.
+     */
+    fun plan(filesDir: File): List<Pair<String, File>> {
+        val out = ArrayList<Pair<String, File>>()
+        var total = 0L
+        for (dir in DIRS) {
+            val root = File(filesDir, dir)
+            if (!root.isDirectory) continue
+            val files = root.walkTopDown()
+                .filter { it.isFile && !it.name.endsWith(".tmp") }
+                .mapNotNull { f ->
+                    val rel = f.relativeTo(root).invariantSeparatorsPath
+                    val name = FILES_PREFIX + dir + "/" + rel
+                    if (relativePathOf(name) == null) null else name to f
+                }
+                .sortedBy { it.first }
+                .toList()
+            val bytes = files.sumOf { it.second.length() }
+            val fits = files.all { it.second.length() <= MAX_ENTRY_BYTES } &&
+                total + bytes <= MAX_TOTAL_BYTES && out.size + files.size <= MAX_ENTRIES
+            if (!fits) continue
+            out += files
+            total += bytes
+        }
+        return out
+    }
+
+    // ── Restore ─────────────────────────────────────────────────────────────────
+
+    /** What [restoreInto] did. */
+    sealed interface Restored {
+        /** The backup carries nothing of ours (every older backup): nothing was touched. */
+        data object Absent : Restored
+
+        /** [dirs] replaced the device's folders; [prefs] are the preferences to apply. */
+        data class Done(val dirs: Set<String>, val prefs: Map<String, Any>) : Restored
+
+        /** Our part was refused or could not be applied, and the device's files are as they were. */
+        data class Skipped(val reason: String) : Restored
+    }
+
+    /**
+     * Live wrapper for [DataBackup.importFrom], called once the new database is in place. Never throws:
+     * our part can only add to a restore, never fail it.
+     */
+    fun restore(context: Context, open: () -> InputStream?) {
+        val app = context.applicationContext
+        val result = runCatching {
+            open()?.use { restoreInto(app.filesDir, it) } ?: Restored.Skipped("could not reopen the backup")
+        }.getOrElse { Restored.Skipped(it.message ?: it.javaClass.simpleName) }
+        when (result) {
+            is Restored.Done -> runCatching { applyPrefs(app, result.prefs) }
+            is Restored.Skipped -> runCatching { Log.w(TAG, "Fork data not restored: ${result.reason}") }
+            Restored.Absent -> Unit
+        }
+    }
+
+    /**
+     * Stage our entries of the backup in [input] under [filesDir], check them all, then swap the carried
+     * folders in. The staging folder is gone afterwards whatever happens.
+     */
+    fun restoreInto(
+        filesDir: File,
+        input: InputStream,
+        maxEntryBytes: Long = MAX_ENTRY_BYTES,
+        maxTotalBytes: Long = MAX_TOTAL_BYTES,
+        maxEntries: Int = MAX_ENTRIES,
+    ): Restored {
+        val staging = File(filesDir, STAGING)
+        try {
+            staging.deleteRecursively()
+            val staged = stage(input, staging, maxEntryBytes, maxTotalBytes, maxEntries)
+            if (staged !is Restored.Done) return staged
+            if (!swapIn(File(staging, "files"), staged.dirs, filesDir)) {
+                return Restored.Skipped("could not move the restored folders into place")
+            }
+            return staged
+        } finally {
+            staging.deleteRecursively()
+        }
+    }
+
+    /** Copy our entries into [staging], refusing the lot on the first bad one. */
+    private fun stage(
+        input: InputStream,
+        staging: File,
+        maxEntryBytes: Long,
+        maxTotalBytes: Long,
+        maxEntries: Int,
+    ): Restored {
+        val filesRoot = File(staging, "files")
+        val rootPath = filesRoot.canonicalPath + File.separator
+        val dirs = LinkedHashSet<String>()
+        var prefs: Map<String, Any>? = null
+        var count = 0
+        var total = 0L
+        var declared: Int? = null
+        try {
+            ZipInputStream(input).use { zip ->
+                var entry = zip.nextEntry
+                while (entry != null) {
+                    val name = entry.name
+                    when {
+                        !name.startsWith(PREFIX) || entry.isDirectory -> Unit
+                        declared != null -> return Restored.Skipped("entry after the end marker: $name")
+                        name == END_ENTRY -> {
+                            val buf = java.io.ByteArrayOutputStream()
+                            if (!copyBounded(zip, buf, 1_024)) return Restored.Skipped("end marker too large")
+                            declared = runCatching { JSONObject(buf.toString(Charsets.UTF_8.name())).getInt("entries") }
+                                .getOrDefault(-1)
+                        }
+                        name == PREFS_ENTRY -> {
+                            if (prefs != null) return Restored.Skipped("prefs.json twice")
+                            val buf = java.io.ByteArrayOutputStream()
+                            if (!copyBounded(zip, buf, MAX_PREFS_BYTES)) return Restored.Skipped("prefs.json too large")
+                            prefs = decodePrefs(buf.toString(Charsets.UTF_8.name()))
+                        }
+                        else -> {
+                            val segments = relativePathOf(name) ?: return Restored.Skipped("refused entry name: $name")
+                            val dest = File(filesRoot, segments.joinToString(File.separator))
+                            if (!dest.canonicalPath.startsWith(rootPath)) return Restored.Skipped("entry escapes its folder: $name")
+                            if (dest.exists()) return Restored.Skipped("entry twice: $name")
+                            if (++count > maxEntries) return Restored.Skipped("too many entries")
+                            dest.parentFile?.mkdirs()
+                            val cap = minOf(maxEntryBytes, maxTotalBytes - total)
+                            val ok = FileOutputStream(dest).use { out -> copyBounded(zip, out, cap) }
+                            if (!ok) return Restored.Skipped("entry too large: $name")
+                            total += dest.length()
+                            dirs += segments.first()
+                        }
+                    }
+                    entry = zip.nextEntry
+                }
+            }
+        } catch (e: IOException) {
+            return Restored.Skipped("unreadable archive: ${e.message}")
+        }
+        val carried = count + (if (prefs != null) 1 else 0)
+        if (carried == 0 && declared == null) return Restored.Absent
+        if (declared != carried) return Restored.Skipped("incomplete: $carried of ${declared ?: "?"} entries")
+        return Restored.Done(dirs, prefs.orEmpty())
+    }
+
+    /**
+     * Move each staged folder in place of the live one. The live one is first renamed aside (same
+     * filesystem, so each step is atomic), and any failure puts every folder back as it was.
+     */
+    private fun swapIn(stagedRoot: File, dirs: Set<String>, filesDir: File): Boolean {
+        val done = ArrayList<String>()
+        for (dir in dirs.sorted()) {
+            val live = File(filesDir, dir)
+            val aside = File(filesDir, dir + ASIDE_SUFFIX)
+            aside.deleteRecursively()
+            val hadLive = live.exists()
+            val ok = (!hadLive || live.renameTo(aside)) && File(stagedRoot, dir).renameTo(live)
+            if (!ok) {
+                if (hadLive && aside.exists()) { live.deleteRecursively(); aside.renameTo(live) }
+                for (prev in done.asReversed()) {
+                    val prevLive = File(filesDir, prev)
+                    val prevAside = File(filesDir, prev + ASIDE_SUFFIX)
+                    prevLive.deleteRecursively()
+                    if (prevAside.exists()) prevAside.renameTo(prevLive)
+                }
+                return false
+            }
+            done += dir
+        }
+        for (dir in done) File(filesDir, dir + ASIDE_SUFFIX).deleteRecursively()
+        return true
+    }
+
+    /**
+     * The path segments under `victor/files/` of a valid entry name, or null: the first segment one of
+     * [DIRS], at most [MAX_DEPTH] more, each plain ([SEGMENT]: no `..`, no hidden names, no separators),
+     * and never one of upstream's [RESERVED_NAMES].
+     */
+    fun relativePathOf(name: String): List<String>? {
+        if (!name.startsWith(FILES_PREFIX)) return null
+        val segments = name.removePrefix(FILES_PREFIX).split('/')
+        if (segments.size < 2 || segments.size > MAX_DEPTH + 1) return null
+        if (segments.first() !in DIRS) return null
+        if (segments.any { !SEGMENT.matches(it) }) return null
+        if (segments.last() in RESERVED_NAMES) return null
+        return segments
+    }
+
+    // ── SharedPreferences boundary ──────────────────────────────────────────────
+
+    private fun prefsSnapshot(context: Context): String? =
+        runCatching { encodePrefs(context.getSharedPreferences(NoopPrefs.NAME, Context.MODE_PRIVATE).all) }.getOrNull()
+
+    private fun applyPrefs(context: Context, values: Map<String, Any>) {
+        if (values.isEmpty()) return
+        val editor = context.getSharedPreferences(NoopPrefs.NAME, Context.MODE_PRIVATE).edit()
+        for ((key, value) in values) {
+            when (value) {
+                is Boolean -> editor.putBoolean(key, value)
+                is String -> editor.putString(key, value)
+            }
+        }
+        editor.apply()
+    }
+
+    /** Copy at most [cap] bytes; false (with the copy cut short) when [input] holds more. */
+    private fun copyBounded(input: InputStream, out: OutputStream, cap: Long): Boolean {
+        val buffer = ByteArray(DEFAULT_BUFFER_SIZE)
+        var total = 0L
+        while (true) {
+            val read = input.read(buffer)
+            if (read < 0) return true
+            if (total + read > cap) return false
+            out.write(buffer, 0, read)
+            total += read
+        }
+    }
+}
