+package com.noop.data
+
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import java.io.ByteArrayInputStream
+import java.io.ByteArrayOutputStream
+import java.io.File
+import java.util.zip.ZipEntry
+import java.util.zip.ZipInputStream
+import java.util.zip.ZipOutputStream
+
+/**
+ * victor:backup — the fork's files and preferences inside the `.noopbak` ([VictorBackupFiles]), driven with
+ * real archives and real folders: the round trip, older backups, the zip-slip and size refusals, and the
+ * secrets that must never travel. The archives are written in the order [DataBackup.exportTo] uses (DB,
+ * settings, ours, manifest), so upstream's staging and write checks are exercised against the same shape.
+ */
+class VictorBackupFilesTest {
+
+    @get:Rule val tmp = TemporaryFolder()
+
+    private val sqliteMagic = "SQLite format 3\u0000".toByteArray(Charsets.ISO_8859_1)
+    private val dbBody = sqliteMagic + ByteArray(4_096) { (it % 251).toByte() }
+    private val thumb = ByteArray(20_000).also { java.util.Random(7).nextBytes(it) }
+
+    /** A phone's `filesDir` with a food log (and a thumbnail), workouts, weeks and some upstream files. */
+    private fun sourcePhone(): File {
+        val dir = tmp.newFolder("source")
+        File(dir, "food/thumbs").mkdirs()
+        File(dir, "food/log.json").writeText("""{"v":1,"entries":[{"id":"meal1","kcal":640}]}""")
+        File(dir, "food/thumbs/meal1-0.jpg").writeBytes(thumb)
+        File(dir, "food/log.json.tmp").writeText("half a write")
+        File(dir, "training").mkdirs()
+        File(dir, "training/sessions.json").writeText("""[{"id":"s1","exercises":["press banca"]}]""")
+        File(dir, "weekly").mkdirs()
+        File(dir, "weekly/reviews.json").writeText("""[{"weekStart":"2026-10-12"}]""")
+        File(dir, "diagnostics").mkdirs()
+        File(dir, "diagnostics/oura-steps.jsonl").writeText("not ours")
+        File(dir, "avatar.jpg").writeBytes(byteArrayOf(1, 2, 3))
+        return dir
+    }
+
+    private val phonePrefs: Map<String, Any?> = mapOf(
+        "victor.goals.goal" to "loseFat",
+        "victor.goals.targetWeightKg" to "78.5",
+        "victor.goals.dailyKcal" to "2200",
+        "victor.goals.note" to "Sin gluten",
+        "victor.coach.agenda" to true,
+        "victor.day.view" to "week",
+        "victor.haptics.automatic" to false,
+        "victor.tasker.enabled" to true,
+        "victor.tasker.token" to "0123456789abcdef01234567",
+        "victor.gtasks.connected" to true,
+        "victor.scale.newestReadingAt" to 1_790_000_000L,
+        "victor.scale.newestReadingDay" to "2026-10-19",
+        "victor.today.quietCards.v1" to true,
+        "noop.onboarded" to true,
+        "api_key" to "sk-ant-secret",
+    )
+
+    /** A `.noopbak` in [DataBackup.exportTo]'s entry order; [files] null = an older backup with nothing of ours. */
+    private fun backup(files: File?, prefsJson: String?, settingsJson: String? = """{"profile.age":26}"""): ByteArray {
+        val out = ByteArrayOutputStream()
+        ZipOutputStream(out).use { zip ->
+            zip.putNextEntry(ZipEntry("noop-backup.sqlite"))
+            zip.write(dbBody)
+            zip.closeEntry()
+            if (settingsJson != null) {
+                zip.putNextEntry(ZipEntry("settings.json"))
+                zip.write(settingsJson.toByteArray())
+                zip.closeEntry()
+            }
+            if (files != null) VictorBackupFiles.writeEntries(zip, files, prefsJson)
+            zip.putNextEntry(ZipEntry("manifest.json"))
+            zip.write("""{"platform":"android"}""".toByteArray())
+            zip.closeEntry()
+        }
+        return out.toByteArray()
+    }
+
+    /** DB entry plus hand-made entries of ours, for the hostile cases. */
+    private fun backupWith(vararg entries: Pair<String, ByteArray>): ByteArray {
+        val out = ByteArrayOutputStream()
+        ZipOutputStream(out).use { zip ->
+            zip.putNextEntry(ZipEntry("noop-backup.sqlite"))
+            zip.write(dbBody)
+            zip.closeEntry()
+            for ((name, bytes) in entries) {
+                zip.putNextEntry(ZipEntry(name))
+                zip.write(bytes)
+                zip.closeEntry()
+            }
+        }
+        return out.toByteArray()
+    }
+
+    private fun entryNames(bytes: ByteArray): List<String> = ZipInputStream(ByteArrayInputStream(bytes)).use { zip ->
+        generateSequence { zip.nextEntry }.map { it.name }.toList()
+    }
+
+    /** A phone that already has some food and weeks of its own. */
+    private fun targetPhone(): File {
+        val dir = tmp.newFolder("target")
+        File(dir, "food/thumbs").mkdirs()
+        File(dir, "food/log.json").writeText("device food")
+        File(dir, "food/thumbs/old-0.jpg").writeBytes(byteArrayOf(9, 9))
+        File(dir, "weekly").mkdirs()
+        File(dir, "weekly/reviews.json").writeText("device weeks")
+        return dir
+    }
+
+    private fun leftovers(dir: File): List<String> =
+        dir.listFiles().orEmpty().map { it.name }.filter { it.contains("victor-restore") }
+
+    @Test
+    fun `round trip brings back food with thumbnails, workouts, weeks and prefs`() {
+        val source = sourcePhone()
+        val bytes = backup(source, VictorBackupFiles.encodePrefs(phonePrefs))
+
+        // Upstream's write-side checks still pass with our entries inside.
+        assertTrue(DataBackup.backupStreamIsIntact(ByteArrayInputStream(bytes)))
+        assertTrue(DataBackup.hasEndOfCentralDirectory(bytes))
+        val names = entryNames(bytes)
+        assertEquals(
+            listOf(
+                "noop-backup.sqlite", "settings.json", "victor/prefs.json", "victor/files/food/log.json",
+                "victor/files/food/thumbs/meal1-0.jpg", "victor/files/training/sessions.json",
+                "victor/files/weekly/reviews.json", "victor/end.json", "manifest.json",
+            ),
+            names,
+        )
+
+        // Upstream's staging still finds the DB and settings.
+        val stagedDb = tmp.newFile()
+        val stagedSettings = File(tmp.root, "staged-settings.json")
+        val archive = File(tmp.root, "b.noopbak").apply { writeBytes(bytes) }
+        assertEquals(
+            DataBackup.StageResult.OK,
+            DataBackup.stageBackupSqlite(archive.inputStream(), DataBackup.peekHeader(archive), stagedDb, stagedSettings),
+        )
+        assertArrayEquals(dbBody, stagedDb.readBytes())
+        assertEquals("""{"profile.age":26}""", stagedSettings.readText())
+
+        val phone = tmp.newFolder("new-phone")
+        val result = VictorBackupFiles.restoreInto(phone, ByteArrayInputStream(bytes))
+        assertTrue(result is VictorBackupFiles.Restored.Done)
+        result as VictorBackupFiles.Restored.Done
+        assertEquals(setOf("food", "training", "weekly"), result.dirs)
+        for (path in listOf("food/log.json", "food/thumbs/meal1-0.jpg", "training/sessions.json", "weekly/reviews.json")) {
+            assertArrayEquals(path, File(source, path).readBytes(), File(phone, path).readBytes())
+        }
+        assertFalse("a write in flight is not backed up", File(phone, "food/log.json.tmp").exists())
+        assertFalse("upstream's own files are not ours to carry", File(phone, "diagnostics").exists())
+        assertFalse(File(phone, "avatar.jpg").exists())
+        assertEquals(
+            mapOf(
+                "victor.goals.goal" to "loseFat",
+                "victor.goals.targetWeightKg" to "78.5",
+                "victor.goals.dailyKcal" to "2200",
+                "victor.goals.note" to "Sin gluten",
+                "victor.coach.agenda" to true,
+                "victor.day.view" to "week",
+                "victor.haptics.automatic" to false,
+            ),
+            result.prefs,
+        )
+        assertEquals(emptyList<String>(), leftovers(phone))
+    }
+
+    @Test
+    fun `secrets and per-phone state never reach the copy`() {
+        val json = VictorBackupFiles.encodePrefs(phonePrefs)!!
+        for (key in listOf("victor.tasker.token", "victor.tasker.enabled", "victor.gtasks.connected",
+                           "victor.scale.newestReadingAt", "victor.scale.newestReadingDay",
+                           "victor.today.quietCards.v1", "noop.onboarded", "api_key")) {
+            assertFalse(key, json.contains(key))
+        }
+        assertFalse(json.contains("0123456789abcdef01234567"))
+        assertFalse(json.contains("sk-ant-secret"))
+
+        // Nothing in the whole copy holds them either, entry names or contents (read back inflated).
+        val bytes = backup(sourcePhone(), json)
+        assertFalse(entryNames(bytes).any { it.contains("shared_prefs") || it.contains("secure") })
+        val contents = ZipInputStream(ByteArrayInputStream(bytes)).use { zip ->
+            generateSequence { zip.nextEntry }.map { String(zip.readBytes(), Charsets.ISO_8859_1) }.toList()
+        }
+        for (secret in listOf("victor.tasker.token", "0123456789abcdef01234567", "sk-ant-secret", "api_key")) {
+            assertFalse(secret, contents.any { it.contains(secret) })
+        }
+
+        assertNull(VictorBackupFiles.encodePrefs(mapOf("victor.tasker.token" to "x", "api_key" to "y")))
+    }
+
+    @Test
+    fun `a hand-edited prefs entry cannot switch on the Tasker bridge or smuggle wrong types`() {
+        val hostile = """{"victor.tasker.enabled":true,"victor.tasker.token":"known","victor.gtasks.connected":true,
+            "victor.coach.agenda":"yes","victor.goals.dailyKcal":2200,"victor.day.view":"month"}"""
+        assertEquals(mapOf<String, Any>("victor.day.view" to "month"), VictorBackupFiles.decodePrefs(hostile))
+        assertEquals(emptyMap<String, Any>(), VictorBackupFiles.decodePrefs("not json"))
+    }
+
+    @Test
+    fun `an older backup without our entries leaves the phone's files alone`() {
+        val phone = targetPhone()
+        val result = VictorBackupFiles.restoreInto(phone, ByteArrayInputStream(backup(files = null, prefsJson = null)))
+        assertEquals(VictorBackupFiles.Restored.Absent, result)
+        assertEquals("device food", File(phone, "food/log.json").readText())
+        assertTrue(File(phone, "food/thumbs/old-0.jpg").exists())
+        assertEquals("device weeks", File(phone, "weekly/reviews.json").readText())
+        assertEquals(emptyList<String>(), leftovers(phone))
+    }
+
+    @Test
+    fun `a carried folder replaces the phone's whole and one not carried is untouched`() {
+        val source = tmp.newFolder("food-only")
+        File(source, "food/thumbs").mkdirs()
+        File(source, "food/log.json").writeText("backup food")
+        File(source, "food/thumbs/new-0.jpg").writeBytes(thumb)
+        val phone = targetPhone()
+
+        val result = VictorBackupFiles.restoreInto(phone, ByteArrayInputStream(backup(source, prefsJson = null)))
+
+        assertEquals(VictorBackupFiles.Restored.Done(setOf("food"), emptyMap()), result)
+        assertEquals("backup food", File(phone, "food/log.json").readText())
+        assertTrue(File(phone, "food/thumbs/new-0.jpg").exists())
+        assertFalse("the replaced folder does not keep stale thumbnails", File(phone, "food/thumbs/old-0.jpg").exists())
+        assertEquals("device weeks", File(phone, "weekly/reviews.json").readText())
+        assertEquals(emptyList<String>(), leftovers(phone))
+    }
+
+    @Test
+    fun `an entry climbing out with dot-dot is refused and nothing is written`() {
+        val phone = targetPhone()
+        val bytes = backupWith(
+            "victor/files/food/log.json" to "evil food".toByteArray(),
+            "victor/files/food/../../shared_prefs/noop_prefs.xml" to "<map/>".toByteArray(),
+        )
+        val result = VictorBackupFiles.restoreInto(phone, ByteArrayInputStream(bytes))
+        assertTrue(result is VictorBackupFiles.Restored.Skipped)
+        assertEquals("device food", File(phone, "food/log.json").readText())
+        assertFalse(File(phone, "shared_prefs").exists())
+        assertFalse(File(phone.parentFile, "shared_prefs").exists())
+        assertEquals(emptyList<String>(), leftovers(phone))
+    }
+
+    @Test
+    fun `entry names outside the three folders or with tricks are refused`() {
+        for (name in listOf(
+            "victor/files/food/../x", "victor/files/../food/x", "/victor/files/food/x", "victor/files/food/..",
+            "victor/files/food/.hidden", "victor/files/food//x", "victor/files/food/a\\..\\b",
+            "victor/files/shared_prefs/noop_prefs.xml", "victor/files/databases/noop.db", "victor/files/food",
+            "victor/files/food/settings.json", "victor/files/food/thumbs/noop-backup.sqlite",
+            "victor/files/food/a/b/c/d/e.json",
+        )) {
+            assertNull(name, VictorBackupFiles.relativePathOf(name))
+        }
+        assertEquals(listOf("food", "thumbs", "meal1-0.jpg"), VictorBackupFiles.relativePathOf("victor/files/food/thumbs/meal1-0.jpg"))
+        assertEquals(listOf("food", "log.json.corrupt-1790000000000"),
+            VictorBackupFiles.relativePathOf("victor/files/food/log.json.corrupt-1790000000000"))
+    }
+
+    @Test
+    fun `a file named like an upstream entry is not exported, so old importers never mistake it`() {
+        val source = sourcePhone()
+        File(source, "food/settings.json").writeText("""{"profile.age":99}""")
+        val bytes = backup(source, prefsJson = null, settingsJson = null)
+        assertFalse(entryNames(bytes).any { it.endsWith("/settings.json") })
+
+        // With no settings entry, upstream reads the archive to the end and must stage none.
+        val archive = File(tmp.root, "no-settings.noopbak").apply { writeBytes(bytes) }
+        val stagedSettings = File(tmp.root, "staged-settings.json")
+        assertEquals(
+            DataBackup.StageResult.OK,
+            DataBackup.stageBackupSqlite(archive.inputStream(), DataBackup.peekHeader(archive), tmp.newFile(), stagedSettings),
+        )
+        assertFalse(stagedSettings.exists())
+    }
+
+    @Test
+    fun `an oversized entry is refused whole`() {
+        val phone = targetPhone()
+        val bytes = backup(sourcePhone(), prefsJson = null)
+        val result = VictorBackupFiles.restoreInto(phone, ByteArrayInputStream(bytes), maxEntryBytes = 1_000)
+        assertTrue(result is VictorBackupFiles.Restored.Skipped)
+        assertEquals("device food", File(phone, "food/log.json").readText())
+        assertFalse(File(phone, "training").exists())
+        assertEquals(emptyList<String>(), leftovers(phone))
+    }
+
+    @Test
+    fun `a copy that ends cleanly between two of our entries is not taken as complete`() {
+        val phone = targetPhone()
+        // What a ZipInputStream sees when a file is cut exactly at an entry boundary: a clean end, with the
+        // food log there but its thumbnails and the end marker missing.
+        val bytes = backupWith("victor/files/food/log.json" to "half the food".toByteArray())
+        val result = VictorBackupFiles.restoreInto(phone, ByteArrayInputStream(bytes))
+        assertTrue(result.toString(), result is VictorBackupFiles.Restored.Skipped)
+        assertEquals("device food", File(phone, "food/log.json").readText())
+        assertTrue(File(phone, "food/thumbs/old-0.jpg").exists())
+        assertEquals(emptyList<String>(), leftovers(phone))
+    }
+
+    @Test
+    fun `a backup cut short inside our entries changes nothing`() {
+        val phone = targetPhone()
+        val bytes = backup(sourcePhone(), VictorBackupFiles.encodePrefs(phonePrefs))
+        val cut = bytes.copyOf(bytes.size - 2_000)   // inside the last of our entries
+        val result = VictorBackupFiles.restoreInto(phone, ByteArrayInputStream(cut))
+        assertTrue(result.toString(), result is VictorBackupFiles.Restored.Skipped)
+        assertEquals("device food", File(phone, "food/log.json").readText())
+        assertFalse(File(phone, "training").exists())
+        assertEquals(emptyList<String>(), leftovers(phone))
+    }
+}
