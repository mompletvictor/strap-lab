+package com.noop.ai
+
+import android.content.Context
+import com.noop.data.WhoopRepository
+import com.noop.goals.VictorGoals
+import com.noop.goals.VictorGoalsStore
+import com.noop.ingest.ScaleImport
+
+/**
+ * victor:person — who the wearer is, for the prompts beside the coach (a meal's mark, the week's review, a
+ * workout's estimate): the PROFILE, the smart-scale BODY and the GOALS lines, read as the coach reads them,
+ * and only with the coach's data consent (all null without it). One place, so the three prompts cannot drift.
+ */
+internal data class VictorPersonLines(val profile: String?, val body: String?, val goals: String?) {
+
+    /** The lines present, in the coach's order. */
+    val lines: List<String> get() = listOfNotNull(profile, body, goals)
+
+    companion object {
+        val NONE = VictorPersonLines(null, null, null)
+
+        suspend fun load(ctx: Context, repo: WhoopRepository): VictorPersonLines {
+            if (!AiKeyStore.readConsent(ctx)) return NONE
+            val scale = runCatching { ScaleImport.snapshot(repo, ScaleImport.newestReading(ctx)) }.getOrNull()
+            return VictorPersonLines(
+                profile = runCatching { VictorCoachVitals.profileLine(ctx, scaleHasWeight = scale?.weight != null) }.getOrNull(),
+                body = ScaleCoachContext.line(scale),
+                goals = runCatching { VictorGoals.coachLine(VictorGoalsStore.load(ctx), scale?.weight?.value) }.getOrNull(),
+            )
+        }
+    }
+}
