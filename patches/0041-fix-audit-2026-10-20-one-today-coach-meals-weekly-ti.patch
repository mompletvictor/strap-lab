+        assertFalse(TrainingAnalyzer.recheckDue(sparse, end + 15 * day))
+        // Never analysed (a failed try) keeps the short window: no paid retries for two weeks.
+        assertFalse(TrainingAnalyzer.recheckDue(logged.copy(analysis = null), now))
+        assertFalse(TrainingAnalyzer.recheckDue(sparse.copy(endTs = null), now))
