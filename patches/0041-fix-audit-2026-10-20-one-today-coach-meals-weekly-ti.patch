--- /dev/null
+++ b/android/app/src/test/java/com/noop/food/VictorWiringAuditTest.kt
@@ -0,0 +1,70 @@
+package com.noop.food
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+/**
+ * victor:audit-2026-10-20 — wiring that has no logic function to assert against, so this reads the sources (the
+ * idiom of ResolvedSeriesCallSiteAuditTest and TodayWorkoutTapTest). `//` comments are stripped first: the
+ * comments name the very symbols asserted on.
+ */
+class VictorWiringAuditTest {
+
+    private fun mainRoot(): File {
+        val userDir = File(System.getProperty("user.dir") ?: ".")
+        val candidates = listOf(userDir, File(userDir, "app"), File(userDir, "android/app"), File(userDir, "../android/app"))
+        return candidates.map { File(it, "src/main/java/com/noop") }.firstOrNull { it.isDirectory }
+            ?: error("could not locate the app sources from ${userDir.absolutePath}")
+    }
+
+    private fun code(rel: String): String =
+        File(mainRoot(), rel).readText().lines().joinToString("\n") { it.substringBefore("//") }
+
+    @Test
+    fun everyForkSurfaceUsesTheOneToday() {
+        // "Today" is FoodDays.today() (04:00 roll, as upstream's Today); a calendar date flips the coach, the meal
+        // marks and the week at midnight while Today still shows the evening.
+        val files = listOf(
+            "food/TodayFoodSection.kt", "food/FoodScreen.kt", "food/FoodHistory.kt", "food/FoodSheet.kt",
+            "food/FoodCoachContext.kt", "food/FoodScorer.kt", "ai/VictorCoachExtras.kt",
+            "weekly/WeeklyReviewer.kt", "weekly/WeeklyCard.kt",
+        )
+        for (f in files) {
+            assertFalse("$f reads the calendar date as today", code(f).contains("LocalDate.now("))
+        }
+    }
+
+    @Test
+    fun theFoodCardsReloadTheBurnWhenTheStrapOrAnImportLands() {
+        val files = listOf("food/TodayFoodSection.kt", "food/FoodScreen.kt", "food/FoodHistory.kt")
+        var loads = 0
+        for (f in files) {
+            val lines = code(f).lines()
+            lines.forEachIndexed { i, line ->
+                if (!line.contains("produceState")) return@forEachIndexed
+                val body = lines.subList(i, minOf(i + 4, lines.size)).joinToString("\n")
+                if (body.contains("FoodEnergy.load") || body.contains("FoodAdaptive.load")) {
+                    loads++
+                    assertTrue("$f:${i + 1} loads the burn without the energy inputs key", line.contains("inputs"))
+                }
+            }
+        }
+        // Today's card, Food's Today card, «Tu gasto real», each history day and the Historial charts.
+        assertEquals(5, loads)
+    }
+
+    @Test
+    fun theWearersProfileScaleAndGoalsAreReadInOnePlace() {
+        // The meal marks, the week's review and the workout estimate each had their own copy of these lines.
+        val callers = mainRoot().walkTopDown().filter { it.isFile && it.name.endsWith(".kt") }
+            .filter { f ->
+                val c = f.readText().lines().joinToString("\n") { it.substringBefore("//") }
+                c.contains("VictorCoachVitals.profileLine(") || c.contains("VictorGoals.coachLine(")
+            }
+            .map { it.name }.toSet()
+        assertEquals(setOf("VictorCoachExtras.kt", "VictorPersonLines.kt"), callers)
+    }
+}
