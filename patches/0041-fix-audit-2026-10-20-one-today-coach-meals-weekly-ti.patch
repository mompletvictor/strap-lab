+/**
+ * Pure: the balance line's text and kcal (negative = deficit), or null with no meal logged, as the coach
+ * leaves it out then too: "if you eat nothing more, a deficit of 1,800" reads as a fast, not as nothing logged.
+ */
+internal fun balanceLine(intakeKcal: Double, meals: Int, energy: FoodEnergy): Pair<Int, Double>? {
+    if (meals == 0) return null
+    val balance = if (energy.isToday) energy.projectedBalance(intakeKcal) else energy.balance(intakeKcal)
+    val label = when {
+        energy.isToday && balance < 0 -> R.string.victor_food_projected_deficit
+        energy.isToday -> R.string.victor_food_projected_surplus
+        balance < 0 -> R.string.victor_food_balance_deficit
+        else -> R.string.victor_food_balance_surplus
+    }
+    return label to balance
