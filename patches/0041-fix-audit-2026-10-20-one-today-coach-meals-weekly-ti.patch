+        val full = logged.copy(analysis = logged.analysis!!.copy(hrSamples = 3_400))
+        assertTrue(TrainingAnalyzer.recheckDue(sparse, now))
+        assertFalse(TrainingAnalyzer.recheckDue(full, now))
