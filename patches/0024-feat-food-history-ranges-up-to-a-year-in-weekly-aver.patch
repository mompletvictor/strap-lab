+    @Test
+    fun longRangesPlotMondayWeeksOfLoggedDayAveragesWithoutToday() {
+        val es = java.util.Locale("es", "ES")
+        // Saturday 17 Oct 2026. Week of Mon 5 Oct: two logged days; week of Mon 12: one day plus today.
+        val entries = listOf(
+            meal(LocalDate.of(2026, 10, 5), 2000.0, p = 100.0),
+            meal(LocalDate.of(2026, 10, 7), 2400.0, p = 140.0),
+            meal(LocalDate.of(2026, 10, 13), 1800.0),
+            meal(today, 300.0),
+        )
+        val energy = mapOf(burned(LocalDate.of(2026, 10, 5), 2500.0), burned(LocalDate.of(2026, 10, 6), 2700.0))
+        val days = FoodHistory.days(entries, energy, today, FoodHistory.Range.QUARTER)
+        val weeks = FoodHistory.points(days, weekly = true, today = today, locale = es)
+        assertEquals(LocalDate.of(2026, 10, 12), weeks.last().day)
+        assertEquals(1800.0, weeks.last().eaten!!.kcal, 0.0) // today's 300 left out
+        val w5 = weeks.first { it.day == LocalDate.of(2026, 10, 5) }
+        assertEquals(2200.0, w5.eaten!!.kcal, 0.0)
+        assertEquals(120.0, w5.eaten!!.proteinG, 0.0)
+        assertEquals(2600.0, w5.burnedKcal!!, 0.0)
+        assertTrue(weeks.all { it.day.dayOfWeek == java.time.DayOfWeek.MONDAY })
+        assertEquals(days, FoodHistory.points(days, weekly = false, today = today, locale = es))
+    }
