 /** victor:food — the Food tab's history: how intake (and its balance) moved, and where it comes from. */
 internal object FoodHistory {
 
-    enum class Range(val days: Int) { WEEK(7), MONTH(30), QUARTER(90) }
+    /** How far back the history goes; past a month the charts plot weekly averages ([weekly]). */
+    enum class Range(val days: Int, val weekly: Boolean) {
+        WEEK(7, false),
+        MONTH(30, false),
+        QUARTER(91, true),
+        HALF(182, true),
+        YEAR(364, true),
+    }
+
+    /**
+     * Pure. What the charts plot: the days themselves, or for a long [Range.weekly] range one point per
+     * week (starting on the locale's first weekday) holding the averages of its logged days. Today stays
+     * out of a weekly average: half a day would drag the current week down.
+     */
+    fun points(days: List<HistoryDay>, weekly: Boolean, today: LocalDate, locale: Locale): List<HistoryDay> {
+        if (!weekly) return days
+        val first = WeekFields.of(locale).firstDayOfWeek
+        return days.filter { it.day != today }
+            .groupBy { it.day.with(TemporalAdjusters.previousOrSame(first)) }
+            .toSortedMap()
+            .map { (start, week) ->
+                val eaten = week.mapNotNull { it.eaten }
+                val burned = week.mapNotNull { it.burnedKcal }
+                HistoryDay(
+                    start,
+                    eaten.takeIf { it.isNotEmpty() }?.let { list ->
+                        FoodTotals(
+                            list.map { it.kcal }.average(),
+                            list.map { it.proteinG }.average(),
+                            list.map { it.carbsG }.average(),
+                            list.map { it.fatG }.average(),
+                        ).rounded()
+                    },
+                    burned.takeIf { it.isNotEmpty() }?.average(),
+                )
+            }
+    }
 
     /** Pure. The [range] days ending today, oldest first; burn only where it means something (see below). */
     fun days(entries: List<FoodEntry>, energy: Map<String, FoodEnergy>, today: LocalDate, range: Range): List<HistoryDay> {
