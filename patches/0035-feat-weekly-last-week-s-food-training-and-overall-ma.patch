+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+import java.io.File
+import java.time.LocalDate
+import java.time.ZoneId
+import java.util.concurrent.atomic.AtomicBoolean
+
+/**
+ * victor:weekly — the reviews on disk (`files/weekly/reviews.json`, the last 12 weeks) and the pass that asks
+ * Claude for last week's once the week is over. Called when the Today food card shows: the first look on or
+ * after a Monday reviews the week before it. A week with too little logged is skipped without a request, and
+ * a failure (offline, no key) leaves it for the next look.
+ */
+object WeeklyReviewer {
+
+    private const val DIR = "weekly"
+    private const val FILE = "reviews.json"
+    private const val KEEP = 12
+
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+    private val running = AtomicBoolean(false)
+    private val mutex = Mutex()
+    private var cache: List<WeeklyReview>? = null
+
+    private val _reviews = MutableStateFlow<List<WeeklyReview>>(emptyList())
+    /** Oldest first. Empty until the first [load]. */
+    val reviews: StateFlow<List<WeeklyReview>> = _reviews.asStateFlow()
+
+    suspend fun load(ctx: Context): List<WeeklyReview> = withContext(Dispatchers.IO) { mutex.withLock { state(ctx) } }
+
+    fun ensure(ctx: Context) {
+        val app = ctx.applicationContext
+        if (!running.compareAndSet(false, true)) return
+        scope.launch {
+            try {
+                runCatching { pass(app) }
+            } finally {
+                running.set(false)
+            }
+        }
+    }
+
+    private suspend fun pass(ctx: Context) {
+        val zone = ZoneId.systemDefault()
+        val start = WeeklyReviews.lastWeekStart(LocalDate.now(zone))
+        if (load(ctx).any { it.weekStart == start.toString() }) return
+        if (AiKeyStore.read(ctx, AiProvider.ANTHROPIC) == null) return
+        val app = ctx.applicationContext as NoopApplication
+        val repo = app.repository
+        val strapId = app.sourceCoordinator.activeDeviceId.value ?: app.activeDeviceId
+        val end = start.plusDays(6)
+        val fromS = start.atStartOfDay(zone).toEpochSecond()
+        val toS = end.plusDays(1).atStartOfDay(zone).toEpochSecond()
+
+        val food = FoodStore.load(ctx).filter { it.day >= start.toString() && it.day <= end.toString() }
+        val workouts = runCatching { repo.workoutsUnion(strapId, fromS, toS) }.getOrDefault(emptyList())
+            .filter { it.startTs in fromS until toS }
+        if (!WeeklyReviews.hasEnough(food.map { it.day }.distinct().size, workouts.size)) return
+
+        val sessions = TrainingStore.load(ctx).filter { !it.isLive && it.startTs in fromS until toS }
+        val energy = runCatching { FoodEnergy.loadRange(ctx, repo, strapId, start.toString(), end.toString()) }.getOrDefault(emptyMap())
+        val prompt = WeeklyReviews.prompt(
+            weekStart = start,
+            weekFood = food,
+            mealScores = FoodStore.loadScores(ctx),
+            energy = energy,
+            kcalTarget = VictorGoalsStore.load(ctx).dailyKcalTarget,
+            weekWorkouts = workouts,
+            sessions = sessions,
+            personLines = personLines(ctx, repo, strapId),
+            zone = zone,
+        )
+        val r = TrainingAi.ask(ctx, prompt, WeeklyReviews.schema()) { WeeklyReviews.parse(it, start.toString(), System.currentTimeMillis()) }
+        if (r is TrainingAiResult.Ok) save(ctx, r.value)
+    }
+
+    /** With the coach's consent only: profile, scale, goals and the strap's daily table, as the coach reads them. */
+    private suspend fun personLines(ctx: Context, repo: com.noop.data.WhoopRepository, strapId: String): List<String> {
+        if (!AiKeyStore.readConsent(ctx)) return emptyList()
+        val scale = runCatching { ScaleImport.snapshot(repo, ScaleImport.newestReading(ctx)) }.getOrNull()
+        val days = runCatching { repo.daysMerged(strapId) }.getOrDefault(emptyList())
+        return listOfNotNull(
+            runCatching { VictorCoachVitals.profileLine(ctx, scaleHasWeight = scale?.weight != null) }.getOrNull(),
+            ScaleCoachContext.line(scale),
+            runCatching { VictorGoals.coachLine(VictorGoalsStore.load(ctx), scale?.weight?.value) }.getOrNull(),
+            runCatching { AiCoach(repo) { strapId }.buildContext(days) }.getOrNull(),
+        )
+    }
+
+    private suspend fun save(ctx: Context, review: WeeklyReview) = withContext(Dispatchers.IO) {
+        mutex.withLock {
+            val next = (state(ctx).filterNot { it.weekStart == review.weekStart } + review).sortedBy { it.weekStart }.takeLast(KEEP)
+            val dir = File(ctx.applicationContext.filesDir, DIR).apply { mkdirs() }
+            val tmp = File(dir, "$FILE.tmp")
+            tmp.writeText(WeeklyReviews.encode(next))
+            if (!tmp.renameTo(File(dir, FILE))) {
+                File(dir, FILE).writeText(WeeklyReviews.encode(next))
+                tmp.delete()
+            }
+            cache = next
+            _reviews.value = next
+        }
+    }
+
+    /** Caller holds [mutex]. A corrupt file is set aside and the list starts empty. */
+    private fun state(ctx: Context): List<WeeklyReview> {
+        cache?.let { return it }
+        val dir = File(ctx.applicationContext.filesDir, DIR)
+        val file = File(dir, FILE)
+        val loaded = if (!file.exists()) {
+            emptyList()
+        } else {
+            runCatching { WeeklyReviews.decode(file.readText()) }.getOrElse {
+                runCatching { file.renameTo(File(dir, "$FILE.corrupt-${System.currentTimeMillis()}")) }
+                emptyList()
+            }
+        }
+        cache = loaded
+        _reviews.value = loaded
+        return loaded
+    }
+}
