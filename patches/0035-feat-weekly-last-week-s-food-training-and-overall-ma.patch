+package com.noop.weekly
+
+import com.noop.data.WorkoutRow
+import com.noop.food.FoodEntry
+import com.noop.food.FoodItem
+import com.noop.food.MealScore
+import com.noop.food.MealScoring
+import com.noop.food.MealType
+import org.json.JSONObject
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.time.LocalDate
+import java.time.ZoneId
+
+/** victor:weekly — which week, what Claude is told, how the answer is read and kept. */
+class WeeklyReviewTest {
+
+    private val madrid = ZoneId.of("Europe/Madrid")
+
+    @Test
+    fun theReviewedWeekIsTheLastFinishedMondayToSunday() {
+        // Monday 19 Oct → the week of Monday 12; Sunday 25 Oct → still the week of the 12th.
+        assertEquals(LocalDate.of(2026, 10, 12), WeeklyReviews.lastWeekStart(LocalDate.of(2026, 10, 19)))
+        assertEquals(LocalDate.of(2026, 10, 12), WeeklyReviews.lastWeekStart(LocalDate.of(2026, 10, 25)))
+        assertEquals(LocalDate.of(2026, 10, 19), WeeklyReviews.lastWeekStart(LocalDate.of(2026, 10, 26)))
+        assertTrue(WeeklyReviews.hasEnough(3, 0))
+        assertTrue(WeeklyReviews.hasEnough(0, 1))
+        assertFalse(WeeklyReviews.hasEnough(2, 0))
+    }
+
+    @Test
+    fun thePromptHasEveryDayTheMealsTheirMarksAndTheWorkouts() {
+        val day = "2026-10-14"
+        val eggs = FoodEntry(
+            "e", LocalDate.parse(day).atTime(8, 30).atZone(madrid).toInstant().toEpochMilli(), day, "",
+            listOf(FoodItem("Huevos", "2", 180.0, 12.0, 1.0, 13.0)), 180.0, 12.0, 1.0, 13.0, emptyList(), meal = MealType.BREAKFAST,
+        )
+        val start = LocalDate.of(2026, 10, 14).atTime(18, 0).atZone(madrid).toEpochSecond()
+        val gym = WorkoutRow("my-whoop", start, start + 3600, "Strength", "manual", durationS = 3600.0, energyKcal = 220.0, avgHr = 118)
+        val p = WeeklyReviews.prompt(
+            weekStart = LocalDate.of(2026, 10, 12),
+            weekFood = listOf(eggs),
+            mealScores = mapOf(MealScoring.key(day, MealType.BREAKFAST) to MealScore(8, "", MealScoring.signature(listOf(eggs)), 1L)),
+            energy = emptyMap(),
+            kcalTarget = 2200,
+            weekWorkouts = listOf(gym),
+            sessions = emptyList(),
+            personLines = emptyList(),
+            zone = madrid,
+        )
+        assertTrue(p.contains("WEEK: 2026-10-12 (Monday) to 2026-10-18 (Sunday). Daily intake target: 2200 kcal."))
+        assertTrue(p.contains("- 2026-10-12: nothing logged"))
+        assertTrue(p.contains("- 2026-10-14: 180 kcal (P 12 g, C 1 g, F 13 g). breakfast 180 kcal [8/10] (Huevos)"))
+        assertTrue(p.contains("- 2026-10-14 18:00 Strength, 60 min, HR avg 118, 220 kcal by HR"))
+        assertTrue(p.contains("the coach's data consent is off"))
+    }
+
+    @Test
+    fun theAnswerIsReadWithAreasTooThinToJudgeAndRoundTrips() {
+        val r = WeeklyReviews.parse(
+            JSONObject("""{"food_score":7.4,"food_note":"Buena proteína.","training_score":-1,"training_note":"","overall_score":6,"overall_note":"Falta entrenar.","focus":"Tres sesiones de fuerza."}"""),
+            "2026-10-12", 9L,
+        )!!
+        assertEquals(7, r.food)
+        assertNull(r.training)
+        assertEquals(6, r.overall)
+        assertEquals(listOf(r), WeeklyReviews.decode(WeeklyReviews.encode(listOf(r))))
+        assertNull(WeeklyReviews.parse(JSONObject("""{"food_score":5}"""), "2026-10-12", 9L))
+        val line = WeeklyReviews.coachLine(r)
+        assertEquals(
+            "LAST WEEK REVIEW (week of 2026-10-12, by Claude): food 7/10 («Buena proteína.»); overall 6/10 («Falta entrenar.»); focus for this week: «Tres sesiones de fuerza.»",
+            line,
+        )
+    }
+}
