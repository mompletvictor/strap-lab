+private val ChartHeight = 170.dp
+
+/** Bars: eaten per day; dots + line: burned; dashed line: the daily goal. */
+@Composable
+private fun KcalChart(days: List<HistoryDay>, target: Int?) {
+    val eatenColor = Palette.accent
+    val burnColor = Palette.textSecondary
+    val goalColor = Palette.chargeColor
+    val grid = Palette.hairline
+    val top = max(
+        1.0,
+        listOfNotNull(days.mapNotNull { it.eaten?.kcal }.maxOrNull(), days.mapNotNull { it.burnedKcal }.maxOrNull(), target?.toDouble()).maxOrNull() ?: 1.0,
+    ) * 1.1
+    Canvas(Modifier.fillMaxWidth().height(ChartHeight)) {
+        drawGrid(grid)
+        val slot = size.width / days.size
+        val barW = (slot * 0.62f).coerceAtLeast(1.5f)
+        days.forEachIndexed { i, d ->
+            val kcal = d.eaten?.kcal ?: return@forEachIndexed
+            val h = (kcal / top * size.height).toFloat()
+            drawRoundRect(eatenColor, Offset(i * slot + (slot - barW) / 2, size.height - h), Size(barW, h), CornerRadius(barW / 3))
+        }
+        var prev: Offset? = null
+        days.forEachIndexed { i, d ->
+            val b = d.burnedKcal ?: run { prev = null; return@forEachIndexed }
+            val p = Offset(i * slot + slot / 2, size.height - (b / top * size.height).toFloat())
+            prev?.let { drawLine(burnColor, it, p, strokeWidth = 2.dp.toPx()) }
+            drawCircle(burnColor, radius = (if (days.size > 40) 1.5f else 3f).dp.toPx(), center = p)
+            prev = p
+        }
+        target?.let {
+            val y = size.height - (it / top * size.height).toFloat()
+            drawLine(goalColor, Offset(0f, y), Offset(size.width, y), strokeWidth = 1.5.dp.toPx(), pathEffect = PathEffect.dashPathEffect(floatArrayOf(12f, 10f)))
+        }
+    }
+}
+
+/** Stacked grams per day: protein, carbs, fat. */
+@Composable
+private fun MacroChart(days: List<HistoryDay>) {
+    val colors = listOf(Palette.metricCyan, Palette.metricAmber, Palette.metricRose)
+    val grid = Palette.hairline
+    val top = max(1.0, days.mapNotNull { d -> d.eaten?.let { it.proteinG + it.carbsG + it.fatG } }.maxOrNull() ?: 1.0) * 1.1
+    Canvas(Modifier.fillMaxWidth().height(ChartHeight)) {
+        drawGrid(grid)
+        val slot = size.width / days.size
+        val barW = (slot * 0.62f).coerceAtLeast(1.5f)
+        days.forEachIndexed { i, d ->
+            val t = d.eaten ?: return@forEachIndexed
+            var base = size.height
+            listOf(t.proteinG, t.carbsG, t.fatG).forEachIndexed { k, g ->
+                val h = (g / top * size.height).toFloat()
+                if (h > 0f) drawRect(colors[k], Offset(i * slot + (slot - barW) / 2, base - h), Size(barW, h))
+                base -= h
+            }
+        }
+    }
+}
+
+private fun DrawScope.drawGrid(color: Color) {
+    for (k in 1..3) {
+        val y = size.height * k / 4f
+        drawLine(color, Offset(0f, y), Offset(size.width, y), strokeWidth = 1f)
+    }
+    drawLine(color, Offset(0f, size.height), Offset(size.width, size.height), strokeWidth = 1.dp.toPx())
+}
+
+/** Average kcal per meal type, as horizontal bars. */
+@Composable
+private fun MealBars(meals: List<Pair<MealType, Double>>) {
+    val top = meals.maxOf { it.second }.coerceAtLeast(1.0)
+    Column(verticalArrangement = Arrangement.spacedBy(Metrics.space8)) {
+        meals.forEach { (meal, kcal) ->
+            Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(Metrics.space8)) {
+                Text(uiString(mealLabel(meal)), style = NoopType.subhead, color = Palette.textPrimary, modifier = Modifier.width(96.dp))
+                Box(Modifier.weight(1f).height(14.dp)) {
+                    Box(
+                        Modifier
+                            .fillMaxWidth((kcal / top).toFloat().coerceIn(0.02f, 1f))
+                            .height(14.dp)
+                            .clip(RoundedCornerShape(50))
+                            .background(Palette.accent),
+                    )
+                }
+                Text(whole(kcal), style = NoopType.bodyNumber, color = Palette.textSecondary, modifier = Modifier.width(52.dp))
+            }
+        }
+    }
+}
+
+@OptIn(ExperimentalLayoutApi::class)
+@Composable
+private fun Legend(items: List<Pair<Color, String>>) {
+    FlowRow(horizontalArrangement = Arrangement.spacedBy(Metrics.space12)) {
+        items.forEach { (c, label) ->
+            Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(Metrics.space4)) {
+                Box(Modifier.size(10.dp).clip(RoundedCornerShape(50)).background(c))
+                Text(label, style = NoopType.caption, color = Palette.textSecondary)
+            }
+        }
+    }
+}
+
+/** First, middle and last day under a chart. */
+@Composable
+private fun AxisDates(days: List<HistoryDay>) {
+    val locale = LocalConfiguration.current.locales[0] ?: Locale.getDefault()
+    val fmt = DateTimeFormatter.ofPattern("d MMM", locale)
+    Row(Modifier.fillMaxWidth()) {
+        Text(days.first().day.format(fmt), style = NoopType.caption, color = Palette.textTertiary)
+        Spacer(Modifier.weight(1f))
+        if (days.size > 2) Text(days[days.size / 2].day.format(fmt), style = NoopType.caption, color = Palette.textTertiary)
+        Spacer(Modifier.weight(1f))
+        Text(days.last().day.format(fmt), style = NoopType.caption, color = Palette.textTertiary)
+    }
+}
