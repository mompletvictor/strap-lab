+/** victor:food — one day of the history: what was eaten (null = nothing logged) and burned (null = unknown). */
+internal data class HistoryDay(val day: LocalDate, val eaten: FoodTotals?, val burnedKcal: Double?)
+
+/** Averages over the logged days, today left out (it is still going). */
+internal data class HistorySummary(val loggedDays: Int, val avgKcal: Double?, val avgProteinG: Double?, val avgBalance: Double?)
+
+/** victor:food — the Food tab's history: how intake (and its balance) moved, and where it comes from. */
+internal object FoodHistory {
+
+    enum class Range(val days: Int) { WEEK(7), MONTH(30), QUARTER(90) }
+
+    /** Pure. The [range] days ending today, oldest first; burn only where it means something (see below). */
+    fun days(entries: List<FoodEntry>, energy: Map<String, FoodEnergy>, today: LocalDate, range: Range): List<HistoryDay> {
+        val byDay = entries.groupBy { it.day }
+        return (range.days - 1 downTo 0).map { back ->
+            val d = today.minusDays(back.toLong())
+            val key = d.toString()
+            val eaten = byDay[key]?.let { FoodTotals.ofEntries(it) }
+            // A resting-only figure says nothing on its own: plot it only where it backs a balance.
+            val burned = energy[key]?.takeIf { it.source != EnergySource.BASAL || eaten != null }?.burnedKcal
+            HistoryDay(d, eaten, burned)
+        }
+    }
+
+    /** Pure. Today never counts: its intake is half a day. */
+    fun summary(days: List<HistoryDay>, today: LocalDate): HistorySummary {
+        val logged = days.filter { it.day != today && it.eaten != null }
+        if (logged.isEmpty()) return HistorySummary(0, null, null, null)
+        val balances = logged.mapNotNull { d -> d.burnedKcal?.let { d.eaten!!.kcal - it } }
+        return HistorySummary(
+            loggedDays = logged.size,
+            avgKcal = logged.map { it.eaten!!.kcal }.average(),
+            avgProteinG = logged.map { it.eaten!!.proteinG }.average(),
+            avgBalance = balances.takeIf { it.isNotEmpty() }?.average(),
+        )
+    }
+
+    /** Pure. Average kcal of each meal type over the days it was logged, in the order of the day. */
+    fun mealAverages(entries: List<FoodEntry>, from: LocalDate, today: LocalDate): List<Pair<MealType, Double>> {
+        val inRange = entries.filter { it.day >= from.toString() && it.day < today.toString() }
+        return MealType.entries.mapNotNull { meal ->
+            val perDay = inRange.filter { it.meal == meal }.groupBy { it.day }.values.map { list -> list.sumOf { it.kcal } }
+            perDay.takeIf { it.isNotEmpty() }?.let { meal to it.average() }
+        }
+    }
+}
+
+/**
+ * victor:food — the Historial view of the Food tab: a range picker, the averages, and three charts
+ * (eaten vs burned with the goal, macros, kcal by meal). Burn comes from [FoodEnergy.loadRange], the same
+ * resolver as every other balance in the app.
+ */
+@OptIn(ExperimentalLayoutApi::class)
+@Composable
+internal fun FoodHistorySection(vm: AppViewModel, entries: List<FoodEntry>, kcalTarget: Int?) {
+    val ctx = LocalContext.current
+    val today = FoodDays.today().let { LocalDate.parse(it) }
+    var range by rememberSaveable { mutableStateOf(FoodHistory.Range.MONTH) }
+    val from = today.minusDays(range.days.toLong() - 1)
+    val energy by produceState(emptyMap<String, FoodEnergy>(), range, entries) {
+        value = withContext(Dispatchers.IO) {
+            runCatching { FoodEnergy.loadRange(ctx, vm.repo, vm.activeStrapId, from.toString(), today.toString()) }.getOrDefault(emptyMap())
+        }
+    }
+    val days = FoodHistory.days(entries, energy, today, range)
+    val summary = FoodHistory.summary(days, today)
+
+    Column(verticalArrangement = Arrangement.spacedBy(Metrics.space16)) {
+        FlowRow(horizontalArrangement = Arrangement.spacedBy(6.dp)) {
+            FoodHistory.Range.entries.forEach { r ->
+                FoodChip(uiString(rangeLabel(r)), selected = range == r) { range = r }
+            }
+        }
+        NoopCard {
+            Row(Modifier.fillMaxWidth()) {
+                Stat(uiString(R.string.victor_food_history_avg), summary.avgKcal?.let { "${whole(it)} kcal" }, Modifier.weight(1f))
+                Stat(
+                    uiString(R.string.victor_food_history_balance),
+                    summary.avgBalance?.let { (if (it > 0) "+" else "") + whole(it) },
+                    Modifier.weight(1f),
+                    color = summary.avgBalance?.let { if (it < 0) Palette.chargeColor else Palette.metricAmber },
+                )
+                Stat(uiString(R.string.victor_food_protein), summary.avgProteinG?.let { "${whole(it)} g" }, Modifier.weight(1f))
+            }
+        }
+        if (summary.loggedDays == 0 && days.none { it.eaten != null }) {
+            Text(uiString(R.string.victor_food_history_empty), style = NoopType.subhead, color = Palette.textSecondary)
+            return@Column
+        }
+        ChartCard(uiString(R.string.victor_food_history_kcal_title)) {
+            KcalChart(days, kcalTarget)
+            Legend(
+                listOf(
+                    Palette.accent to uiString(R.string.victor_food_history_eaten),
+                    Palette.textSecondary to uiString(R.string.victor_food_history_burned),
+                ) + listOfNotNull(kcalTarget?.let { Palette.chargeColor to uiString(R.string.victor_food_history_goal) }),
+            )
+            AxisDates(days)
+        }
+        ChartCard(uiString(R.string.victor_food_history_macros_title)) {
+            MacroChart(days)
+            Legend(
+                listOf(
+                    Palette.metricCyan to uiString(R.string.victor_food_protein),
+                    Palette.metricAmber to uiString(R.string.victor_food_carbs),
+                    Palette.metricRose to uiString(R.string.victor_food_fat),
+                ),
+            )
+            AxisDates(days)
+        }
+        val meals = FoodHistory.mealAverages(entries, from, today)
+        if (meals.isNotEmpty()) {
+            ChartCard(uiString(R.string.victor_food_history_meals_title)) { MealBars(meals) }
+        }
+    }
+}
