+/** victor:day — "‹ 13 – 19 oct ›", with a way back to today once the wearer has moved away. */
+@Composable
+internal fun PeriodBar(label: String, atToday: Boolean, onPrevious: () -> Unit, onNext: () -> Unit, onToday: () -> Unit) {
+    Row(verticalAlignment = Alignment.CenterVertically) {
+        IconButton(onClick = onPrevious) {
+            Icon(Icons.Filled.ChevronLeft, contentDescription = uiString(R.string.victor_day_previous), tint = Palette.textSecondary)
+        }
+        Text(
+            label,
+            style = NoopType.headline,
+            color = Palette.textPrimary,
+            textAlign = TextAlign.Center,
+            modifier = Modifier.weight(1f).clickable(onClick = onToday),
+        )
+        IconButton(onClick = onNext) {
+            Icon(Icons.Filled.ChevronRight, contentDescription = uiString(R.string.victor_day_next), tint = Palette.textSecondary)
+        }
+        if (!atToday) FoodChip(uiString(R.string.victor_day_back_today), selected = false, small = true, onClick = onToday)
+    }
+}
+
+/**
+ * victor:day — the month at a glance: a dot under a day with calendar events (accent) and one for tasks
+ * due (warning). Tapping a day shows its list underneath.
+ */
+@Composable
+internal fun MonthGrid(
+    month: YearMonth,
+    today: LocalDate,
+    selected: LocalDate,
+    hasEvents: (LocalDate) -> Boolean,
+    hasTasks: (LocalDate) -> Boolean,
+    locale: Locale,
+    onSelect: (LocalDate) -> Unit,
+) {
+    val first = DayCalendar.firstDayOfWeek(locale)
+    Column(verticalArrangement = Arrangement.spacedBy(Metrics.space4)) {
+        Row(Modifier.fillMaxWidth()) {
+            (0L until 7L).map { first.plus(it) }.forEach { dow ->
+                Text(
+                    dow.getDisplayName(TextStyle.NARROW, locale).uppercase(locale),
+                    style = NoopType.caption,
+                    color = Palette.textTertiary,
+                    textAlign = TextAlign.Center,
+                    modifier = Modifier.weight(1f),
+                )
+            }
+        }
+        DayCalendar.monthCells(month, locale).chunked(7).forEach { week ->
+            Row(Modifier.fillMaxWidth()) {
+                week.forEach { day ->
+                    Box(Modifier.weight(1f).height(44.dp), contentAlignment = Alignment.Center) {
+                        if (day != null) DayCell(day, day == today, day == selected, hasEvents(day), hasTasks(day)) { onSelect(day) }
+                    }
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun DayCell(day: LocalDate, isToday: Boolean, isSelected: Boolean, events: Boolean, tasks: Boolean, onClick: () -> Unit) {
+    Column(
+        horizontalAlignment = Alignment.CenterHorizontally,
+        verticalArrangement = Arrangement.spacedBy(2.dp),
+        modifier = Modifier.clip(CircleShape).clickable(onClick = onClick),
+    ) {
+        Box(
+            Modifier
+                .size(30.dp)
+                .clip(CircleShape)
+                .background(if (isSelected) Palette.accent else Color.Transparent),
+            contentAlignment = Alignment.Center,
+        ) {
+            Text(
+                day.dayOfMonth.toString(),
+                style = if (isToday) NoopType.headline else NoopType.subhead,
+                color = when {
+                    isSelected -> Palette.surfaceBase
+                    isToday -> Palette.accent
+                    else -> Palette.textPrimary
+                },
+            )
+        }
+        Row(horizontalArrangement = Arrangement.spacedBy(2.dp)) {
+            if (events) Box(Modifier.size(5.dp).clip(CircleShape).background(Palette.accent))
+            if (tasks) Box(Modifier.size(5.dp).clip(CircleShape).background(Palette.statusWarning))
+            if (!events && !tasks) Box(Modifier.size(5.dp))
+        }
+    }
+}
+
+/** victor:day — the Google Tasks block when there is no list to show: connect, reconnect, loading, failed. */
+@Composable
+internal fun TasksStatus(state: TasksState, onConnect: () -> Unit) {
+    when (state) {
+        TasksState.NotConnected -> Action(uiString(R.string.victor_day_tasks_connect), onConnect)
+        TasksState.NeedsConsent -> Action(uiString(R.string.victor_day_tasks_reconnect), onConnect)
+        TasksState.Loading -> CircularProgressIndicator(color = Palette.accent, strokeWidth = 2.dp, modifier = Modifier.size(18.dp))
+        is TasksState.Failed -> Quiet(
+            uiString(
+                when (state.reason) {
+                    TasksError.NOT_CONFIGURED -> R.string.victor_day_tasks_not_configured
+                    TasksError.OFFLINE -> R.string.victor_day_tasks_offline
+                    TasksError.SERVER -> R.string.victor_day_tasks_failed
+                },
+            ),
+        )
+        is TasksState.Ready -> Unit
+    }
+}
