+package com.noop.food
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+import java.time.LocalDate
+
+/** victor:food — the history view's days, averages and per-meal breakdown. */
+class FoodHistoryTest {
+
+    private val today = LocalDate.of(2026, 10, 17)
+
+    private fun meal(day: LocalDate, kcal: Double, meal: MealType = MealType.LUNCH, p: Double = 30.0) = FoodEntry(
+        id = "$day-$kcal-$meal", timestamp = 0L, day = day.toString(), note = "", items = emptyList(),
+        kcal = kcal, proteinG = p, carbsG = 0.0, fatG = 0.0, thumbnailPaths = emptyList(), meal = meal,
+    )
+
+    private fun burned(day: LocalDate, kcal: Double) =
+        day.toString() to FoodEnergy.resolve(kcal, null, null, null, 1.0)!!
+
+    @Test
+    fun daysEndTodayOldestFirstWithGapsForUnloggedDays() {
+        val entries = listOf(meal(today, 500.0), meal(today.minusDays(2), 2000.0))
+        val days = FoodHistory.days(entries, mapOf(burned(today.minusDays(2), 2600.0)), today, FoodHistory.Range.WEEK)
+        assertEquals(7, days.size)
+        assertEquals(today.minusDays(6), days.first().day)
+        assertEquals(today, days.last().day)
+        assertNull(days[5].eaten) // yesterday: nothing logged
+        assertEquals(2000.0, days[4].eaten!!.kcal, 0.0)
+        assertEquals(2600.0, days[4].burnedKcal!!, 0.0)
+        // Resting-only days without food draw no burn point; with food they do (they back a balance).
+        val restOnly = mapOf(today.minusDays(1).toString() to FoodEnergy.resolve(null, null, null, 1800.0, 1.0)!!)
+        assertNull(FoodHistory.days(emptyList(), restOnly, today, FoodHistory.Range.WEEK)[5].burnedKcal)
+        assertEquals(1800.0, FoodHistory.days(listOf(meal(today.minusDays(1), 900.0)), restOnly, today, FoodHistory.Range.WEEK)[5].burnedKcal!!, 0.0)
+    }
+
+    @Test
+    fun averagesLeaveTodayOut() {
+        val entries = listOf(
+            meal(today, 400.0, p = 20.0),
+            meal(today.minusDays(1), 2200.0, p = 150.0),
+            meal(today.minusDays(2), 1800.0, p = 110.0),
+        )
+        val energy = mapOf(burned(today.minusDays(1), 2500.0), burned(today.minusDays(2), 2400.0))
+        val s = FoodHistory.summary(FoodHistory.days(entries, energy, today, FoodHistory.Range.WEEK), today)
+        assertEquals(2, s.loggedDays)
+        assertEquals(2000.0, s.avgKcal!!, 0.0)
+        assertEquals(130.0, s.avgProteinG!!, 0.0)
+        assertEquals(-450.0, s.avgBalance!!, 0.0)
+        assertNull(FoodHistory.summary(FoodHistory.days(emptyList(), emptyMap(), today, FoodHistory.Range.WEEK), today).avgKcal)
+    }
+
+    @Test
+    fun mealAveragesArePerLoggedDayInDayOrder() {
+        val d1 = today.minusDays(1)
+        val d2 = today.minusDays(2)
+        val entries = listOf(
+            meal(d1, 300.0, MealType.DINNER), meal(d1, 200.0, MealType.DINNER), // 500 on d1
+            meal(d2, 700.0, MealType.DINNER),
+            meal(d1, 450.0, MealType.BREAKFAST),
+            meal(today, 999.0, MealType.BREAKFAST), // today: left out
+        )
+        val avg = FoodHistory.mealAverages(entries, today.minusDays(29), today)
+        assertEquals(listOf(MealType.BREAKFAST to 450.0, MealType.DINNER to 600.0), avg)
+    }
+}
