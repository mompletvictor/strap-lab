+package com.noop.day
+
+import android.content.Context
+import androidx.annotation.StringRes
+import com.noop.R
+import java.time.DayOfWeek
+import java.time.LocalDate
+import java.time.YearMonth
+import java.time.format.DateTimeFormatter
+import java.time.temporal.TemporalAdjusters
+import java.time.temporal.WeekFields
+import java.util.Locale
+
+/** victor:day — how much of the calendar "Mi día" shows. */
+internal enum class DayView(val id: String, @StringRes val label: Int) {
+    DAY("day", R.string.victor_day_view_day),
+    WEEK("week", R.string.victor_day_view_week),
+    MONTH("month", R.string.victor_day_view_month),
+}
+
+/** victor:day — the periods behind the Día / Semana / Mes views. Pure apart from the remembered view. */
+internal object DayCalendar {
+
+    private const val PREFS = "noop_prefs"
+    private const val KEY_VIEW = "victor.day.view"
+
+    fun loadView(ctx: Context): DayView =
+        ctx.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE).getString(KEY_VIEW, null)
+            ?.let { id -> DayView.entries.firstOrNull { it.id == id } } ?: DayView.DAY
+
+    fun saveView(ctx: Context, view: DayView) {
+        ctx.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit().putString(KEY_VIEW, view.id).apply()
+    }
+
+    /** The locale's first weekday (Monday in Spain). */
+    fun firstDayOfWeek(locale: Locale): DayOfWeek = WeekFields.of(locale).firstDayOfWeek
+
+    /** The days [from, until) the [view] around [anchor] covers. */
+    fun range(view: DayView, anchor: LocalDate, locale: Locale): Pair<LocalDate, LocalDate> = when (view) {
+        DayView.DAY -> anchor to anchor.plusDays(1)
+        DayView.WEEK -> anchor.with(TemporalAdjusters.previousOrSame(firstDayOfWeek(locale))).let { it to it.plusDays(7) }
+        DayView.MONTH -> anchor.withDayOfMonth(1).let { it to it.plusMonths(1) }
+    }
+
+    /** [anchor] moved by [steps] days, weeks or months. */
+    fun shift(view: DayView, anchor: LocalDate, steps: Long): LocalDate = when (view) {
+        DayView.DAY -> anchor.plusDays(steps)
+        DayView.WEEK -> anchor.plusWeeks(steps)
+        DayView.MONTH -> anchor.plusMonths(steps)
+    }
+
+    /** "Sábado 17 oct", "13 – 19 oct", "28 sept – 4 oct", "Octubre 2026". */
+    fun label(view: DayView, anchor: LocalDate, locale: Locale): String = when (view) {
+        DayView.DAY -> dayTitle(anchor, locale)
+        DayView.WEEK -> {
+            val (from, until) = range(view, anchor, locale)
+            val to = until.minusDays(1)
+            val month = DateTimeFormatter.ofPattern("MMM", locale)
+            if (from.month == to.month) "${from.dayOfMonth} – ${to.dayOfMonth} ${to.format(month)}"
+            else "${from.dayOfMonth} ${from.format(month)} – ${to.dayOfMonth} ${to.format(month)}"
+        }
+        DayView.MONTH -> YearMonth.from(anchor).format(DateTimeFormatter.ofPattern("LLLL yyyy", locale)).capitalized(locale)
+    }
+
+    /** "Sábado 17 oct". */
+    fun dayTitle(day: LocalDate, locale: Locale): String =
+        day.format(DateTimeFormatter.ofPattern("EEEE d MMM", locale)).capitalized(locale)
+
+    /** The month grid: leading blank cells, then each day, in rows of seven starting on [firstDayOfWeek]. */
+    fun monthCells(month: YearMonth, locale: Locale): List<LocalDate?> {
+        val first = month.atDay(1)
+        val lead = (first.dayOfWeek.value - firstDayOfWeek(locale).value + 7) % 7
+        val cells = ArrayList<LocalDate?>(42)
+        repeat(lead) { cells += null }
+        for (d in 1..month.lengthOfMonth()) cells += month.atDay(d)
+        while (cells.size % 7 != 0) cells += null
+        return cells
+    }
+
+    private fun String.capitalized(locale: Locale) = replaceFirstChar { it.titlecase(locale) }
+}
