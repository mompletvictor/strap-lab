+package com.noop.day
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+import java.time.LocalDate
+import java.time.YearMonth
+import java.time.ZoneId
+import java.util.Locale
+
+/** victor:day — the Día / Semana / Mes periods, the month grid and what each day shows. */
+class DayCalendarTest {
+
+    private val es = Locale("es", "ES")
+    private val sat = LocalDate.of(2026, 10, 17)
+
+    @Test
+    fun weeksStartOnMondayInSpainAndMonthsOnTheFirst() {
+        assertEquals(LocalDate.of(2026, 10, 12) to LocalDate.of(2026, 10, 19), DayCalendar.range(DayView.WEEK, sat, es))
+        assertEquals(LocalDate.of(2026, 10, 1) to LocalDate.of(2026, 11, 1), DayCalendar.range(DayView.MONTH, sat, es))
+        assertEquals(sat to sat.plusDays(1), DayCalendar.range(DayView.DAY, sat, es))
+        assertEquals(LocalDate.of(2026, 11, 17), DayCalendar.shift(DayView.MONTH, sat, 1))
+        assertEquals(LocalDate.of(2026, 10, 10), DayCalendar.shift(DayView.WEEK, sat, -1))
+    }
+
+    @Test
+    fun labelsReadInSpanish() {
+        assertEquals("12 – 18 oct", DayCalendar.label(DayView.WEEK, sat, es))
+        assertEquals("28 sept – 4 oct", DayCalendar.label(DayView.WEEK, LocalDate.of(2026, 10, 1), es))
+        assertEquals("Octubre 2026", DayCalendar.label(DayView.MONTH, sat, es))
+        assertEquals("Sábado 17 oct", DayCalendar.label(DayView.DAY, sat, es))
+    }
+
+    @Test
+    fun monthGridPadsToWholeMondayFirstWeeks() {
+        // October 2026 starts on a Thursday: three blanks (L, M, X) before the 1st.
+        val cells = DayCalendar.monthCells(YearMonth.of(2026, 10), es)
+        assertEquals(0, cells.size % 7)
+        assertNull(cells[0]); assertNull(cells[2])
+        assertEquals(LocalDate.of(2026, 10, 1), cells[3])
+        assertEquals(LocalDate.of(2026, 10, 31), cells.filterNotNull().last())
+    }
+
+    @Test
+    fun eventsLandOnEveryDayTheyTouchAndTasksOnTheirDueDay() {
+        val madrid = ZoneId.of("Europe/Madrid")
+        fun at(d: LocalDate, h: Int) = d.atTime(h, 0).atZone(madrid).toInstant().toEpochMilli()
+        val mon = LocalDate.of(2026, 10, 12)
+        val events = listOf(
+            AgendaEvent("Gym", at(mon, 19), at(mon, 20), false),
+            AgendaEvent("Viaje", at(mon.plusDays(1), 18), at(mon.plusDays(3), 10), false),
+        )
+        val map = DayAgendaSource.byDay(events, mon, mon.plusDays(7), madrid)
+        assertEquals(listOf(mon, mon.plusDays(1), mon.plusDays(2), mon.plusDays(3)), map.keys.toList())
+        assertEquals(listOf("Viaje"), map[mon.plusDays(2)]!!.map { it.title })
+
+        val tasks = listOf(DayTask("b", sat, "L"), DayTask("A", sat, "L"), DayTask("vieja", sat.minusDays(2), "L"))
+        assertEquals(listOf("A", "b"), GoogleTasksSource.onDay(tasks, sat).map { it.title })
+        assertEquals(listOf("vieja", "A", "b"), GoogleTasksSource.forDay(tasks, sat).map { it.title })
+    }
+}
