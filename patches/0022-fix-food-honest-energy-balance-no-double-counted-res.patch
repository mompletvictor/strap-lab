@@ -0,0 +1,51 @@
+package com.noop.food
+
+import com.noop.analytics.AdaptiveExpenditureEngine
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.time.LocalDate
+
+/** victor:food — feeding the intake + weight-trend expenditure engine from the food log and the scale. */
+class FoodAdaptiveTest {
+
+    private val today = LocalDate.of(2026, 11, 30)
+
+    private fun meal(day: LocalDate, kcal: Double) = FoodEntry(
+        id = "$day-$kcal", timestamp = 0L, day = day.toString(), note = "", items = emptyList(),
+        kcal = kcal, proteinG = 0.0, carbsG = 0.0, fatG = 0.0, thumbnailPaths = emptyList(),
+    )
+
+    @Test
+    fun oneRowPerDayWithTodayAndOldDaysLeftOut() {
+        val entries = listOf(
+            meal(today, 900.0), // still in progress
+            meal(today.minusDays(1), 800.0), meal(today.minusDays(1), 1200.0),
+            meal(today.minusDays(50), 2000.0), // beyond six weeks
+        )
+        val weights = listOf(today.minusDays(1).toString() to 78.4, today.minusDays(3).toString() to 78.9)
+        val days = FoodAdaptive.days(entries, weights, today)
+        assertEquals(listOf(today.minusDays(3).toString(), today.minusDays(1).toString()), days.map { it.day })
+        assertEquals(2000.0, days.last().caloriesIn!!, 0.0)
+        assertEquals(78.4, days.last().weightKg!!, 0.0)
+        assertEquals(null, days.first().caloriesIn)
+        val b = FoodAdaptive.building(days)
+        assertEquals(1, b.intakeDays)
+        assertEquals(2, b.weightDays)
+    }
+
+    @Test
+    fun fourWeeksOfLogsGiveAnEstimateAndItsWindow() {
+        // 2200 kcal/day eaten while losing 0.05 kg/day → about 2200 + 0.05·7700 = 2585 kcal/day burned.
+        val entries = (1L..28L).map { meal(today.minusDays(it), 2200.0) }
+        val weights = (1L..28L step 2).map { today.minusDays(it).toString() to 80.0 - 0.05 * (28 - it) }
+        val days = FoodAdaptive.days(entries, weights, today)
+        val est = AdaptiveExpenditureEngine.estimate(days)
+        assertNotNull(est)
+        assertEquals(2585.0, est!!.estimatedDailyKcal, 1.0)
+        val window = FoodAdaptive.windowIntakeDays(days, est)
+        assertEquals(28, window.size)
+        assertTrue(window.all { it < today.toString() })
+    }
+}
