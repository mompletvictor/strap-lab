+package com.noop.food
+
+import android.content.Context
+import com.noop.analytics.AdaptiveExpenditureDay
+import com.noop.analytics.AdaptiveExpenditureEngine
+import com.noop.analytics.AdaptiveExpenditureEstimate
+import com.noop.analytics.ScaleBody
+import com.noop.data.WhoopRepository
+import com.noop.ingest.HealthConnectImporter
+import java.time.LocalDate
+
+/**
+ * victor:food — the check on the estimated burn: what the wearer REALLY spends, from what they log
+ * eating and how their weight moves (upstream's [AdaptiveExpenditureEngine], otherwise unused). Shown next
+ * to the app's own average estimate over the same days, so a burn estimate that runs high or low shows.
+ */
+internal sealed interface AdaptiveState {
+    /** [appAverageKcal]: the app's [FoodEnergy] burn averaged over the same logged days, when known. */
+    data class Ready(val estimate: AdaptiveExpenditureEstimate, val appAverageKcal: Double?) : AdaptiveState
+
+    /** Not enough history yet: logged-intake days and distinct weigh-in days in the lookback. */
+    data class Building(val intakeDays: Int, val weightDays: Int) : AdaptiveState
+}
+
+internal object FoodAdaptive {
+
+    /** The engine reads at most six weeks. */
+    const val LOOKBACK_DAYS = 42L
+
+    /**
+     * Pure. One input row per day that has a logged intake or a weigh-in, over the lookback. Today is left
+     * out: its intake is still growing and would read as a day of under-eating.
+     */
+    fun days(entries: List<FoodEntry>, weights: List<Pair<String, Double>>, today: LocalDate): List<AdaptiveExpenditureDay> {
+        val from = today.minusDays(LOOKBACK_DAYS).toString()
+        val until = today.toString()
+        val intake = entries.filter { it.day >= from && it.day < until }
+            .groupBy { it.day }
+            .mapValues { (_, list) -> FoodTotals.ofEntries(list).kcal }
+            .filterValues { it > 0 }
+        val weight = weights.filter { it.first >= from && it.first < until && it.second > 0 }.toMap()
+        return (intake.keys + weight.keys).sorted().map { AdaptiveExpenditureDay(it, intake[it], weight[it]) }
+    }
+
+    /** Pure. How far the history is from the engine's gates (shown while it cannot answer). */
+    fun building(days: List<AdaptiveExpenditureDay>): AdaptiveState.Building =
+        AdaptiveState.Building(
+            intakeDays = days.count { (it.caloriesIn ?: 0.0) > 0 },
+            weightDays = days.count { (it.weightKg ?: 0.0) > 0 },
+        )
+
+    /** Pure. The logged-intake days inside the window the estimate actually used. */
+    fun windowIntakeDays(days: List<AdaptiveExpenditureDay>, estimate: AdaptiveExpenditureEstimate): List<String> {
+        val last = days.lastOrNull()?.day ?: return emptyList()
+        val first = LocalDate.parse(last).minusDays(estimate.windowDays.toLong() - 1).toString()
+        return days.filter { it.day >= first && (it.caloriesIn ?: 0.0) > 0 }.map { it.day }
+    }
+
+    suspend fun load(ctx: Context, repo: WhoopRepository, strapId: String, today: LocalDate = LocalDate.now()): AdaptiveState {
+        val entries = runCatching { FoodStore.load(ctx) }.getOrDefault(emptyList())
+        val weights = runCatching {
+            repo.metricSeries(HealthConnectImporter.HC_DEVICE, ScaleBody.KEY_WEIGHT, today.minusDays(LOOKBACK_DAYS).toString(), today.toString())
+                .map { it.day to it.value }
+        }.getOrDefault(emptyList())
+        val days = days(entries, weights, today)
+        val estimate = AdaptiveExpenditureEngine.estimate(days) ?: return building(days)
+        val burns = windowIntakeDays(days, estimate).mapNotNull { day ->
+            runCatching { FoodEnergy.load(ctx, repo, strapId, day)?.burnedKcal }.getOrNull()
+        }
+        return AdaptiveState.Ready(estimate, burns.takeIf { it.isNotEmpty() }?.average())
+    }
+}
