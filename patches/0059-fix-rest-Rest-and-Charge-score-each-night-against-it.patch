@@ -0,0 +1,173 @@
+package com.noop.analytics
+
+import com.noop.data.DailyMetric
+import com.noop.data.MetricSeriesRow
+import java.time.LocalDate
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * victor:rest — [VictorSleepNeed]: one need and one regularity per night, from the nights before it (need)
+ * and up to it (regularity), and the analysis pass's rescoring of the stored Rest and Charge with them.
+ */
+class VictorSleepNeedTest {
+
+    @After fun tearDown() {
+        VictorSleepNeed.ageSource = { null }
+    }
+
+    private fun day(i: Int) = LocalDate.parse("2026-07-01").plusDays(i.toLong()).toString()
+
+    private fun night(i: Int, hours: Double?, deviceId: String = "my-whoop-noop") = DailyMetric(
+        deviceId = deviceId, day = day(i),
+        totalSleepMin = hours?.times(60.0), efficiency = hours?.let { 0.90 },
+        deepMin = hours?.times(60.0 * 0.15), remMin = hours?.times(60.0 * 0.22), lightMin = hours?.times(60.0 * 0.63),
+        avgHrv = 60.0, restingHr = 52, respRateBpm = 15.0,
+    )
+
+    @Test
+    fun theNeedIsTheUpperQuartileOfTheNightsBeforeAndLeavesTheNightItselfOut() {
+        val hours = listOf(7.0, 7.5, 8.0, 8.5, 9.0, 7.2, 7.8, 8.1, 7.4, 8.8)
+        val rows = hours.mapIndexed { i, h -> night(i, h) } + night(10, 12.0) + night(11, 7.5)
+        val nights = VictorSleepNeed.resolve(rows, age = 26)
+
+        assertEquals(RestScorer.personalizedNeedHours(hours, 26), nights.getValue(day(10)).needHours, 1e-12)
+        // The 12 h night does not raise its own bar, but it is history for the night after.
+        assertEquals(RestScorer.personalizedNeedHours(hours + 12.0, 26), nights.getValue(day(11)).needHours, 1e-12)
+        assertNotEquals(nights.getValue(day(10)).needHours, nights.getValue(day(11)).needHours)
+    }
+
+    @Test
+    fun theRegularityIncludesTheNightAndTheTwentyEightBeforeAtMost() {
+        val hours = (0 until 40).map { if (it % 2 == 0) 6.5 else 8.5 }
+        val nights = VictorSleepNeed.resolve(hours.mapIndexed { i, h -> night(i, h) }, age = 26)
+        val expected = VitalityEngine.sleepConsistency(hours.subList(12, 40))
+        assertEquals(expected!!, nights.getValue(day(39)).regularity!!, 1e-12)
+        assertEquals(VitalityEngine.sleepConsistency(hours.subList(0, 3))!!, nights.getValue(day(2)).regularity!!, 1e-12)
+    }
+
+    @Test
+    fun coldStartReadsThePopulationDefaultsAndNoRegularity() {
+        val nights = VictorSleepNeed.resolve(listOf(night(0, 9.0), night(1, 9.2), night(2, 9.1)), age = 26)
+        assertEquals(8.0, nights.getValue(day(2)).needHours, 0.0)   // fewer than 7 nights before it
+        assertNull(nights.getValue(day(1)).regularity)               // fewer than 3 nights
+        assertTrue(nights.getValue(day(2)).regularity != null)
+    }
+
+    @Test
+    fun onlyTheLastNinetyNightsSetTheNeedAndNoDataDaysAreSkipped() {
+        // Ten long nights long ago, then 90 nights of 7.5 h with a gap day: the long ones have aged out.
+        val rows = (0 until 10).map { night(it, 10.0) } + (10 until 100).map { night(it, 7.5) } +
+            night(100, null) + night(101, 7.5)
+        val nights = VictorSleepNeed.resolve(rows.shuffled(java.util.Random(7)), age = 26)
+        assertEquals(8.0, nights.getValue(day(101)).needHours, 0.0)   // 7.5 h upper quartile, floored at 8
+        assertEquals(10.0.coerceAtMost(RestScorer.maxNeedHours), nights.getValue(day(15)).needHours, 0.0)
+    }
+
+    @Test
+    fun aTeenagersNeedKeepsTheNineHourFloor() {
+        val rows = (0 until 20).map { night(it, 8.0) }
+        assertEquals(9.0, VictorSleepNeed.resolve(rows, age = 15).getValue(day(19)).needHours, 0.0)
+        assertEquals(8.0, VictorSleepNeed.resolve(rows, age = 40).getValue(day(19)).needHours, 0.0)
+        VictorSleepNeed.ageSource = { 15 }
+        assertEquals(9.0, VictorSleepNeed.nights(rows).getValue(day(19)).needHours, 0.0)
+        assertEquals(9.0, VictorSleepNeed.needHours(emptyMap(), null), 0.0)
+    }
+
+    @Test
+    fun restIsTheUpstreamCompositeWithTheNightsInputs() {
+        val row = night(30, 7.6)
+        val n = VictorSleepNeed.Night(needHours = 8.3, regularity = 0.9)
+        val expected = RestScorer.rest(
+            asleepSeconds = 7.6 * 3600, efficiency = 0.9, deepSeconds = 7.6 * 3600 * 0.15,
+            remSeconds = 7.6 * 3600 * 0.22, sleepNeedHours = 8.3, consistency = 0.9,
+        )
+        assertEquals(expected!!, VictorSleepNeed.rest(row, n)!!, 1e-9)
+        // No night resolved: exactly upstream's 8 h and neutral 0.5.
+        assertEquals(RestScorer.restFromDaily(row)!!, VictorSleepNeed.rest(row, null)!!, 0.0)
+    }
+
+    /**
+     * Each input moves only its own term: the need only the duration term (weight 0.50), the regularity only
+     * the consistency term (0.10). Rounding of the composite is to 1/100, hence the 0.01 tolerance.
+     */
+    @Test
+    fun theNeedAndTheRegularityEachMoveOnlyTheirOwnTerm() {
+        val row = night(30, 7.6)
+        val base = VictorSleepNeed.rest(row, VictorSleepNeed.Night(8.0, 0.5))!!
+        val needOnly = VictorSleepNeed.rest(row, VictorSleepNeed.Night(8.3, 0.5))!!
+        val regOnly = VictorSleepNeed.rest(row, VictorSleepNeed.Night(8.0, 0.9))!!
+        assertEquals(0.5 * (7.6 / 8.3 - 7.6 / 8.0) * 100.0, needOnly - base, 0.01)
+        assertEquals(0.1 * (0.9 - 0.5) * 100.0, regOnly - base, 0.01)
+        // A night past the need: the need no longer bites (duration is clamped at 100).
+        val long = night(31, 9.0)
+        assertEquals(
+            VictorSleepNeed.rest(long, VictorSleepNeed.Night(8.0, 0.9))!!,
+            VictorSleepNeed.rest(long, VictorSleepNeed.Night(8.3, 0.9))!!, 0.0,
+        )
+    }
+
+    @Test
+    fun rescoreReplacesTheStoredRestAndChargesWithIt() {
+        val history = (0 until 30).map { night(it, if (it % 3 == 0) 8.6 else 7.6) }
+        val nights = VictorSleepNeed.resolve(history, age = 26)
+        val dailies = history.takeLast(2).map { it.copy(recovery = 50.0) }.toMutableList()
+        val rows = mutableListOf(
+            MetricSeriesRow("my-whoop-noop", day(28), "sleep_performance", 1.0),   // the pass's old value
+            MetricSeriesRow("my-whoop-noop", day(28), "spo2_candidate", 95.0),
+            MetricSeriesRow("my-whoop", day(28), "sleep_performance", 77.0),       // an import: not ours
+        )
+        val seen = ArrayList<Pair<String, Double?>>()
+        val result = VictorSleepNeed.rescore(nights, "my-whoop-noop", dailies, rows) { row, rest ->
+            seen.add(row.day to rest)
+            (rest ?: 0.0) / 2.0
+        }
+
+        val r28 = VictorSleepNeed.rest(history[28], nights[day(28)])!!
+        val r29 = VictorSleepNeed.rest(history[29], nights[day(29)])!!
+        assertEquals(listOf(day(28) to r28, day(29) to r29), seen)
+        assertEquals(r28 / 2.0, dailies[0].recovery!!, 0.0)
+        assertEquals(r29 / 2.0, dailies[1].recovery!!, 0.0)
+        val ours = rows.filter { it.deviceId == "my-whoop-noop" && it.key == "sleep_performance" }
+        assertEquals(listOf(day(28) to r28, day(29) to r29), ours.map { it.day to it.value })
+        assertTrue(rows.any { it.key == "spo2_candidate" })
+        assertTrue(rows.any { it.deviceId == "my-whoop" && it.value == 77.0 })
+        assertEquals(r28 to r28 / 2.0, result[day(28)])
+    }
+
+    @Test
+    fun staleRestRewritesOnlyStoredPointsThatNoLongerMatch() {
+        val history = (0 until 20).map { night(it, if (it % 2 == 0) 8.4 else 7.4) }
+        val nights = VictorSleepNeed.resolve(history, age = 26)
+        val fresh = VictorSleepNeed.rest(history[10], nights[day(10)])!!
+        val stored = listOf(
+            MetricSeriesRow("my-whoop-noop", day(10), "sleep_performance", fresh),          // already right
+            MetricSeriesRow("my-whoop-noop", day(11), "sleep_performance", 80.0),           // upstream 8 h
+        )
+        val out = VictorSleepNeed.staleRest(nights, history, stored)
+        assertEquals(listOf(day(11)), out.map { it.day })
+        assertEquals(VictorSleepNeed.rest(history[11], nights[day(11)])!!, out.single().value, 0.0)
+        // No point stored for a day: nothing is created.
+        assertTrue(VictorSleepNeed.staleRest(nights, history, emptyList()).isEmpty())
+    }
+
+    @Test
+    fun theChargeTakesTheNeedOnlyThroughRest() {
+        // Charge has no need input of its own: with the same Rest it is the same Charge whatever the need.
+        val hrv = RecoveryScorer.DriverBaseline(mean = 60.0, spread = 8.0)
+        val rhr = RecoveryScorer.DriverBaseline(mean = 52.0, spread = 2.5)
+        fun charge(rest: Double) = RecoveryScorer.recovery(
+            hrv = 62.0, rhr = 51.0, resp = null, hrvBaseline = hrv, rhrBaseline = rhr, respBaseline = null,
+            sleepPerf = rest / 100.0,
+        )!!
+        val row = night(30, 7.6)
+        val a = VictorSleepNeed.rest(row, VictorSleepNeed.Night(8.3, 0.9))!!
+        val b = VictorSleepNeed.rest(row, VictorSleepNeed.Night(8.0, 0.5))!!
+        assertNotEquals(charge(a), charge(b), 0.0)
+        assertEquals(charge(a), charge(VictorSleepNeed.rest(row, VictorSleepNeed.Night(8.3, 0.9))!!), 0.0)
+    }
+}
