+package com.noop.ui
+
+import android.content.Context
+import androidx.room.Room
+import com.noop.analytics.Baselines
+import com.noop.analytics.ChargeBaselines
+import com.noop.analytics.ChargeDriverLabel
+import com.noop.analytics.IntelligenceEngine
+import com.noop.analytics.ProfileBaselines
+import com.noop.analytics.RecoveryScorer
+import com.noop.analytics.RestScorer
+import com.noop.analytics.UserProfile
+import com.noop.analytics.VictorSleepNeed
+import com.noop.data.DailyMetric
+import com.noop.data.MetricSeriesRow
+import com.noop.data.SleepSession
+import com.noop.data.WhoopDatabase
+import com.noop.data.WhoopRepository
+import java.time.LocalDate
+import kotlinx.coroutines.runBlocking
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotEquals
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertTrue
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.annotation.Config
+
+/**
+ * victor:rest — over a real (in-memory) store: the analysis pass's half (the merged history as it will read
+ * after the pass, [VictorSleepNeed.resolve], [VictorSleepNeed.rescore], the stale-Rest heal) and the screens'
+ * half (the merged rows they read after the pass) see the SAME need and regularity for each night, so the
+ * stored Rest and Charge, the Sleep screen's Rest, need, % of need, debt and regularity, the resolved series
+ * Today / Trends read and Today's Charge drivers all agree, for the re-scored nights and the older ones.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34], manifest = Config.NONE)
+class VictorRestAgreementTest {
+
+    private val ctx: Context = RuntimeEnvironment.getApplication()
+    private lateinit var db: WhoopDatabase
+    private lateinit var repo: WhoopRepository
+
+    private val strap = "my-whoop"
+    private val computed = "my-whoop-noop"
+    private val age = 26
+
+    @Before
+    fun setUp() {
+        db = Room.inMemoryDatabaseBuilder(ctx, WhoopDatabase::class.java).allowMainThreadQueries().build()
+        repo = WhoopRepository(db)
+        VictorSleepNeed.ageSource = { age }
+    }
+
+    @After
+    fun tearDown() {
+        VictorSleepNeed.ageSource = { null }
+        VictorSleepNeed.publish(emptyList())
+        db.close()
+    }
+
+    private fun day(i: Int) = LocalDate.parse("2026-07-01").plusDays(i.toLong()).toString()
+
+    /** A night of [hours] asleep, 90 % efficiency, 15 % deep and 22 % REM, with steady vitals. */
+    private fun night(i: Int, hours: Double, deviceId: String = computed, hrv: Double = 58.0 + (i % 5)) = DailyMetric(
+        deviceId = deviceId, day = day(i), totalSleepMin = hours * 60.0, efficiency = 0.90,
+        deepMin = hours * 60.0 * 0.15, remMin = hours * 60.0 * 0.22, lightMin = hours * 60.0 * 0.63,
+        avgHrv = hrv, restingHr = 52 + (i % 3), respRateBpm = 15.0,
+    )
+
+    /** ~7.8 h nights with a long one every fourth night: an upper quartile near 8.3 h. */
+    private fun hoursOf(i: Int) = if (i % 4 == 0) 8.6 else 7.5 + ((i * 37) % 9) / 10.0
+
+    /** The pass's Charge baselines (HRV ~60 ms, resting HR ~53 bpm, both usable). */
+    private val baselines = ProfileBaselines(
+        hrv = Baselines.foldHistory(List(14) { 58.0 + (it % 5) }, Baselines.hrvCfg),
+        restingHR = Baselines.foldHistory(List(14) { 52.0 + (it % 3) }, Baselines.restingHRCfg),
+    )
+
+    /** Charge as the pass scores it ([RecoveryScorer.recovery] over the row's own inputs) for a given Rest. */
+    private fun charge(row: DailyMetric, rest: Double?) = RecoveryScorer.recovery(
+        hrv = row.avgHrv!!, rhr = row.restingHr!!.toDouble(), resp = row.respRateBpm,
+        hrvBaseline = baselines.hrv!!, rhrBaseline = baselines.restingHR, respBaseline = baselines.resp,
+        sleepPerf = rest?.let { it / 100.0 } ?: row.efficiency, skinTempDev = row.skinTempDevC,
+    )
+
+    /**
+     * The store as earlier passes left it (upstream's Rest and Charge), then one pass over the last 21 days
+     * through the engine's own [IntelligenceEngine.applyPersonalRest], persisted as the pass persists.
+     */
+    private suspend fun storeThenPass(): Pair<List<DailyMetric>, List<IntelligenceEngine.Computed>> {
+        val old = (0 until 60).map { night(it, hoursOf(it)) }
+        repo.upsertDailyMetrics(old.map { it.copy(recovery = charge(it, RestScorer.restFromDaily(it))) })
+        repo.upsertMetricSeries(old.map { MetricSeriesRow(computed, it.day, "sleep_performance", RestScorer.restFromDaily(it)!!) })
+        // A WHOOP export night wins its day in the merge; a Health Connect bare total does not.
+        repo.upsertDailyMetrics(
+            listOf(
+                night(5, 9.4, deviceId = strap),
+                DailyMetric(deviceId = strap, day = day(50), totalSleepMin = 450.0),
+            ),
+        )
+
+        // This pass re-scored the last 21 nights, a little longer than the store had them, with upstream's
+        // Rest and Charge as the loop leaves them.
+        val fresh = (39 until 60).mapTo(ArrayList()) { i ->
+            night(i, hoursOf(i) + 0.1).let { it.copy(recovery = charge(it, RestScorer.restFromDaily(it))) }
+        }
+        val restRows = fresh.mapTo(ArrayList()) {
+            MetricSeriesRow(computed, it.day, "sleep_performance", RestScorer.restFromDaily(it)!!)
+        }
+        val out = fresh.mapTo(ArrayList()) {
+            IntelligenceEngine.Computed(it.day, it.recovery, it.strain, it.totalSleepMin, it.avgHrv, it.restingHr)
+        }
+        val traced = ArrayList<String>()
+        IntelligenceEngine.applyPersonalRest(
+            repo, strap, computed, UserProfile(age = age.toDouble()), baselines, fresh, restRows, out, day(39),
+            sleepTraceSink = { traced.add(it) }, recoveryTraceSink = { traced.add(it) },
+        )
+        assertTrue(traced.any { it.startsWith("rest personal day=${day(59)} need=") })
+        assertTrue(traced.any { it.startsWith("charge day=${day(59)} ") })
+        repo.upsertDailyMetrics(fresh)
+        repo.upsertMetricSeries(restRows)
+        return fresh to out
+    }
+
+    @Test
+    fun thePassResolvesFromTheHistoryTheScreensReadAfterIt() = runBlocking {
+        val (fresh, _) = storeThenPass()
+        val overlay = repo.daysMergedWith(strap, computed, fresh)
+        val merged = repo.daysMerged(strap)
+        fun sleep(d: DailyMetric) = listOf(d.day, d.totalSleepMin, d.efficiency, d.deepMin, d.remMin, d.lightMin)
+        assertEquals(merged.map(::sleep), overlay.map(::sleep))
+        assertEquals(9.4 * 60.0, merged.single { it.day == day(5) }.totalSleepMin!!, 1e-9)       // the export won
+        assertEquals((hoursOf(50) + 0.1) * 60.0, merged.single { it.day == day(50) }.totalSleepMin!!, 1e-9)
+    }
+
+    @Test
+    fun theSleepScreenShowsTheNeedAndRestTheStoredRestAndChargeUsed() = runBlocking {
+        val (fresh, out) = storeThenPass()
+        val merged = repo.daysMerged(strap)
+        val nights = VictorSleepNeed.resolve(merged, age)
+        val last = day(59)
+        val lastRow = merged.single { it.day == last }
+        val stored = repo.metricSeries(computed, "sleep_performance", "0000-00-00", "9999-99-99").associate { it.day to it.value }
+        val need = nights.getValue(last).needHours
+        assertTrue("a personal need above the 8 h default, near 8.3 h: $need", need in 8.2..8.6)
+
+        val model = buildSleepModel(merged, null, todayKey = last)!!
+        // «Necesitas» (the Hours vs Needed card reads the trend's last need) = the need Rest used.
+        assertEquals(need, model.trendNeedHours.last(), 0.0)
+        assertEquals(need * 60.0, model.sleepDebtLedger.needMin, 1e-9)
+        assertEquals(lastRow.totalSleepMin!! / (need * 60.0) * 100.0, model.hoursVsNeeded.latest!!, 1e-9)
+        // The Sleep screen's Rest = the stored Rest of that night.
+        assertEquals(stored.getValue(last), model.performance.latest!!, 0.0)
+
+        // Every re-scored night: the stored Rest is the one with that night's own need and regularity, and
+        // the metric-detail graphs read the same Rest, regularity and % of need.
+        val perf = buildSleepMetricPoints(merged, "performance").toMap()
+        val cons = buildSleepMetricPoints(merged, "consistency").toMap()
+        val hvn = buildSleepMetricPoints(merged, "hours_vs_needed").toMap()
+        for (row in fresh) {
+            val n = nights.getValue(row.day)
+            val expected = RestScorer.restFromDaily(row, consistency = n.regularity, sleepNeedHours = n.needHours)!!
+            assertEquals(expected, stored.getValue(row.day), 0.0)
+            assertEquals(expected, perf.getValue(row.day), 0.0)
+            assertEquals(n.regularity!! * 100.0, cons.getValue(row.day), 1e-9)
+            assertEquals(minOf(100.0, row.totalSleepMin!! / (n.needHours * 60.0) * 100.0), hvn.getValue(row.day), 1e-9)
+            // The stored Charge was scored with exactly that Rest (and only through it).
+            val storedCharge = repo.dailyMetrics(computed, row.day, row.day).single().recovery!!
+            assertEquals(charge(row, expected)!!, storedCharge, 0.0)
+            assertEquals(storedCharge, out.single { it.day == row.day }.recovery!!, 0.0)
+            assertNotEquals(charge(row, RestScorer.restFromDaily(row))!!, storedCharge, 1e-6)
+        }
+        // Upstream's figure would have differed: the change is real, not a no-op.
+        assertNotEquals(RestScorer.restFromDaily(lastRow)!!, stored.getValue(last), 0.01)
+    }
