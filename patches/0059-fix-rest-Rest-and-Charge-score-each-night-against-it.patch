diff --git a/android/app/src/main/java/com/noop/analytics/VictorSleepNeed.kt b/android/app/src/main/java/com/noop/analytics/VictorSleepNeed.kt
new file mode 100644
index 000000000..275890816
--- /dev/null
+++ b/android/app/src/main/java/com/noop/analytics/VictorSleepNeed.kt
@@ -0,0 +1,159 @@
+package com.noop.analytics
+
+import com.noop.data.DailyMetric
+import com.noop.data.MetricSeriesRow
+import java.util.Locale
+
+/**
+ * victor:rest — ONE personal sleep need and ONE sleep regularity per night, resolved from the nights of the
+ * merged daily history, so the stored Rest (Descanso), the sleep term of Charge (Carga) and the Sleep
+ * screen's need, % of need, debt and per-night regularity all read the same figures for the same night.
+ *
+ * Upstream computed the need four ways (the engine's upper quartile with the age floor, run once per pass
+ * over the scan window; the Sleep screen's upper quartile over all days with no age; the "Hours vs Needed"
+ * tile's mean floored at 7.5 h; the stored Rest's fixed 8 h) and the duration regularity two ways (the
+ * engine's 1 - CV, which only reached `DayResult.rest`, read by nobody, and the detail graph's SD / 90 min),
+ * while every stored Rest and Charge ran on 8 h and a neutral 0.5. The Consistency tile and the schedule
+ * card keep their BEDTIME regularity, a different measure that needs the sessions' onsets, not the rows.
+ *
+ * Night D (a DailyMetric day, the wake day of its main night):
+ *  - need = [RestScorer.personalizedNeedHours] (upper quartile, age floor, 9.5 h cap, population default
+ *    under 7 nights) over the [NEED_WINDOW_NIGHTS] nights with sleep BEFORE D. D itself is left out: a
+ *    need is what the night is measured against, so a long night must not raise its own bar.
+ *  - regularity = [VitalityEngine.sleepConsistency] (1 - coefficient of variation, null under 3 nights)
+ *    over the [REGULARITY_WINDOW_NIGHTS] nights with sleep up to and INCLUDING D: how well this night
+ *    fits the pattern, the reading upstream's Wave 0 (SL1/T1, `RestWiringImpactTest`) intended.
+ * A night is `totalSleepMin` > 0, the main-night asleep total Rest scores; naps only repay debt
+ * ([SleepDebt.creditedSleepMin]). Deterministic from the nights before D, so no column is stored: the
+ * analysis pass resolves it from [com.noop.data.WhoopRepository.daysMergedWith] (the merged history as it
+ * will read after the pass) and every screen from the merged rows it already holds (`recentDays`).
+ */
+object VictorSleepNeed {
+
+    /** The series key the Rest composite is stored under. */
+    const val REST_KEY: String = "sleep_performance"
+
+    /** Nights with sleep before D whose upper quartile sets D's need (a season of nights). */
+    const val NEED_WINDOW_NIGHTS: Int = 90
+
+    /** Nights with sleep up to D whose spread sets D's regularity (upstream's 28). */
+    const val REGULARITY_WINDOW_NIGHTS: Int = 28
+
+    /** One night's inputs to Rest: the need in hours and the regularity in 0..1 (null: too few nights). */
+    data class Night(val needHours: Double, val regularity: Double?)
+
+    /**
+     * The wearer's age for the need's population floor ([RestScorer.populationNeedFloorHours]). Installed by
+     * the application from the profile, the same store the analysis pass's [UserProfile] comes from; null
+     * (tests, nothing installed) reads the adult floor, as an unknown age does.
+     */
+    @Volatile var ageSource: () -> Int? = { null }
+
+    /** Pure: every day of [days] (any order) to its [Night]. */
+    fun resolve(days: List<DailyMetric>, age: Int?): Map<String, Night> {
+        val out = LinkedHashMap<String, Night>(days.size * 2)
+        val prior = ArrayList<Double>()
+        for (d in days.sortedBy { it.day }) {
+            if (d.day in out) continue
+            val own = d.totalSleepMin?.takeIf { it > 0.0 }?.let { it / 60.0 }
+            val need = RestScorer.personalizedNeedHours(prior.takeLast(NEED_WINDOW_NIGHTS), age)
+            val upTo = if (own != null) prior.takeLast(REGULARITY_WINDOW_NIGHTS - 1) + own
+            else prior.takeLast(REGULARITY_WINDOW_NIGHTS)
+            val regularity = VitalityEngine.sleepConsistency(upTo)
+            out[d.day] = Night(need, regularity)
+            if (own != null) prior.add(own)
+        }
+        return out
+    }
+
+    @Volatile private var memo: Triple<List<DailyMetric>, Int?, Map<String, Night>>? = null
+
+    /** [resolve] for a screen's merged rows with the installed age, kept for the last list instance. */
+    fun nights(days: List<DailyMetric>): Map<String, Night> {
+        val age = ageSource()
+        memo?.let { (list, a, map) -> if (list === days && a == age) return map }
+        return resolve(days, age).also { memo = Triple(days, age, it) }
+    }
+
+    /** The need (hours) [nights] holds for [day], or the population default when it has none. */
+    fun needHours(nights: Map<String, Night>, day: String?): Double =
+        day?.let { nights[it]?.needHours } ?: RestScorer.personalizedNeedHours(emptyList(), ageSource())
+
+    /** Rest of [daily] with its night's need and regularity; null night = upstream's 8 h and neutral 0.5. */
+    fun rest(daily: DailyMetric, night: Night?): Double? =
+        RestScorer.restFromDaily(daily, consistency = night?.regularity, sleepNeedHours = night?.needHours)
+
+    /** Rest of [daily] resolved against [days], the merged history the caller already reads. */
+    fun rest(daily: DailyMetric, days: List<DailyMetric>): Double? = rest(daily, nights(days)[daily.day])
+
+    @Volatile private var published: Map<String, Night> = emptyMap()
+
+    /** The app's merged history changed: kept for the readers handed one row and no history. */
+    fun publish(days: List<DailyMetric>) {
+        published = nights(days)
+    }
+
+    /** Rest of a lone [daily] (the resolver's daily-column fallback, Today's Charge drivers). */
+    fun restPublished(daily: DailyMetric): Double? = rest(daily, published[daily.day])
+
+    /**
+     * The analysis pass's half: each freshly scored row of [dailies] (all under [computedId]) gets the Rest
+     * of its night written into [metricRows] in place of the one the pass wrote, and the Charge [recovery]
+     * recomputes with it (the row's own HRV, resting HR, breathing and skin inputs, the pass's baselines).
+     * Rows and [metricRows] are updated in place; returns each rescored day's (rest, recovery).
+     */
+    fun rescore(
+        nights: Map<String, Night>,
+        computedId: String,
+        dailies: MutableList<DailyMetric>,
+        metricRows: MutableList<MetricSeriesRow>,
+        recovery: (DailyMetric, Double?) -> Double?,
+    ): Map<String, Pair<Double?, Double?>> {
+        val out = LinkedHashMap<String, Pair<Double?, Double?>>()
+        val days = HashSet<String>()
+        for (i in dailies.indices) {
+            val row = dailies[i]
+            val rest = rest(row, nights[row.day])
+            val charge = recovery(row, rest)
+            dailies[i] = row.copy(recovery = charge)
+            days.add(row.day)
+            out[row.day] = rest to charge
+        }
+        metricRows.removeAll { it.key == REST_KEY && it.deviceId == computedId && it.day in days }
+        for ((day, rc) in out) {
+            rc.first?.let { metricRows.add(MetricSeriesRow(deviceId = computedId, day = day, key = REST_KEY, value = it)) }
+        }
+        return out
+    }
+
+    /**
+     * Stored Rest of the days the pass did not rescore that no longer matches its night (the history
+     * before this resolver, an older night edited, an import arriving): [stored] is a computed source's
+     * daily rows and [storedRest] its `sleep_performance` points, both outside the pass's window. Only days
+     * that already carry a point are rewritten, so nothing new appears; a change under half a hundredth is
+     * left alone.
+     */
+    fun staleRest(
+        nights: Map<String, Night>,
+        stored: List<DailyMetric>,
+        storedRest: List<MetricSeriesRow>,
+    ): List<MetricSeriesRow> {
+        val rowByDay = stored.associateBy { it.day }
+        val out = ArrayList<MetricSeriesRow>()
+        for (point in storedRest) {
+            val row = rowByDay[point.day] ?: continue
+            val rest = rest(row, nights[point.day]) ?: continue
+            if (kotlin.math.abs(rest - point.value) >= 0.005) out.add(point.copy(value = rest))
+        }
+        return out
+    }
+
+    /** The Sleep test-mode line naming the need and regularity a night's stored Rest was scored with. */
+    fun traceLine(day: String, night: Night?, rest: Double?): String =
+        String.format(
+            Locale.US, "rest personal day=%s need=%.2f regularity=%s composite=%s", day,
+            night?.needHours ?: RestScorer.defaultSleepNeedHours,
+            night?.regularity?.let { String.format(Locale.US, "%.2f", it) } ?: "nil",
+            rest?.let { String.format(Locale.US, "%.2f", it) } ?: "nil",
+        )
+}
