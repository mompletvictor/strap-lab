+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * victor:rest — how much the stored Rest (Descanso) and Charge (Carga) move once each night is scored with
+ * its personal need and regularity ([VictorSleepNeed]) instead of upstream's 8 h and neutral 0.5. A person
+ * sleeping 7.85 ± 0.7 h (upper quartile ~8.3 h, regularity ~0.9) with three months of history; the last 30
+ * nights are compared, as the recompute window would rewrite them. Prints the table (read it in the test
+ * report) and pins the size of the change, so a later edit that moves it shows up here.
+ */
+class VictorRestImpactTest {
+
+    private data class Row(val day: String, val hours: Double, val oldRest: Double, val newRest: Double,
+                           val oldCharge: Double, val newCharge: Double, val need: Double, val reg: Double?,
+                           val needOnlyRest: Double)
+
+    private fun rows(seed: Long, nights: Int, compared: Int, meanH: Double, sdH: Double): List<Row> {
+        val rnd = Random(seed)
+        val days = (0 until nights).map { i ->
+            val h = (meanH + sdH * rnd.nextGaussian()).coerceIn(5.0, 10.0)
+            DailyMetric(
+                deviceId = "my-whoop-noop", day = LocalDate.parse("2026-07-01").plusDays(i.toLong()).toString(),
+                totalSleepMin = h * 60.0, efficiency = 0.88 + 0.05 * rnd.nextDouble(),
+                deepMin = h * 60.0 * (0.13 + 0.05 * rnd.nextDouble()), remMin = h * 60.0 * (0.20 + 0.04 * rnd.nextDouble()),
+                avgHrv = 60.0 + 7.0 * rnd.nextGaussian(), restingHr = (53.0 + 2.0 * rnd.nextGaussian()).toInt(),
+            )
+        }
+        val resolved = VictorSleepNeed.resolve(days, age = 26)
+        val hrvB = RecoveryScorer.DriverBaseline(mean = 60.0, spread = 6.0)
+        val rhrB = RecoveryScorer.DriverBaseline(mean = 53.0, spread = 2.0)
+        fun charge(d: DailyMetric, rest: Double) = RecoveryScorer.recovery(
+            hrv = d.avgHrv!!, rhr = d.restingHr!!.toDouble(), resp = null, hrvBaseline = hrvB,
+            rhrBaseline = rhrB, respBaseline = null, sleepPerf = rest / 100.0,
+        )!!
+        return days.takeLast(compared).map { d ->
+            val n = resolved.getValue(d.day)
+            val old = RestScorer.restFromDaily(d)!!
+            val new = VictorSleepNeed.rest(d, n)!!
+            val needOnly = VictorSleepNeed.rest(d, VictorSleepNeed.Night(n.needHours, null))!!
+            Row(d.day, d.totalSleepMin!! / 60.0, old, new, charge(d, old), charge(d, new), n.needHours, n.regularity, needOnly)
+        }
+    }
+
+    private fun median(xs: List<Double>) = xs.sorted().let { s -> (s[(s.size - 1) / 2] + s[s.size / 2]) / 2.0 }
+
+    private fun report(label: String, rs: List<Row>): Map<String, Double> {
+        println("── $label")
+        for (r in rs) println(String.format(Locale.US,
+            "%s  %.2f h  need %.2f reg %s  Rest %5.1f → %5.1f (%+5.1f)  Charge %5.1f → %5.1f (%+5.1f)",
+            r.day, r.hours, r.need, r.reg?.let { String.format(Locale.US, "%.2f", it) } ?: " nil",
+            r.oldRest, r.newRest, r.newRest - r.oldRest, r.oldCharge, r.newCharge, r.newCharge - r.oldCharge))
+        val dRest = rs.map { it.newRest - it.oldRest }
+        val dCharge = rs.map { it.newCharge - it.oldCharge }
+        val stats = mapOf(
+            "restMedianAbs" to median(dRest.map(::abs)), "restMaxAbs" to dRest.maxOf(::abs),
+            "restMean" to dRest.average(), "restUp" to dRest.count { it > 0 }.toDouble(),
+            "chargeMedianAbs" to median(dCharge.map(::abs)), "chargeMaxAbs" to dCharge.maxOf(::abs),
+            "chargeMean" to dCharge.average(),
+        )
+        println(String.format(Locale.US,
+            "Rest Δ: median |Δ| %.1f, max |Δ| %.1f, mean %+.1f, %d of %d up · Charge Δ: median |Δ| %.1f, max |Δ| %.1f, mean %+.1f",
+            stats["restMedianAbs"], stats["restMaxAbs"], stats["restMean"], stats["restUp"]!!.toInt(), rs.size,
+            stats["chargeMedianAbs"], stats["chargeMaxAbs"], stats["chargeMean"]))
+        val dNeed = rs.map { it.needOnlyRest - it.oldRest }
+        println(String.format(Locale.US,
+            "of which the need alone: Rest Δ mean %+.1f, min %+.1f, max %+.1f; the regularity alone: mean %+.1f",
+            dNeed.average(), dNeed.min(), dNeed.max(), rs.map { it.newRest - it.needOnlyRest }.average()))
+        return stats
+    }
+
+    @Test
+    fun aRegularSleeperWithAnEightPointThreeHourNeed() {
+        val rs = rows(seed = 20261020L, nights = 120, compared = 30, meanH = 7.85, sdH = 0.7)
+        val need = rs.map { it.need }.average()
+        val reg = rs.mapNotNull { it.reg }.average()
+        println(String.format(Locale.US, "need %.2f h, regularity %.2f", need, reg))
+        assertTrue("fixture need ~8.3 h: $need", need in 8.15..8.45)
+        assertTrue("fixture regularity ~0.9: $reg", reg in 0.86..0.94)
+        val s = report("30 nights, need ~8.3 h, regularity ~0.9", rs)
+        // Regularity 0.9 vs neutral 0.5 adds 4 points; the 8.3 h bar takes up to ~1.8 back on short nights.
+        assertTrue(s.getValue("restMedianAbs") in 1.5..4.5)
+        assertTrue(s.getValue("restMaxAbs") <= 5.0)
+        assertTrue(s.getValue("chargeMaxAbs") <= 3.0)
+    }
+
+    @Test
+    fun anIrregularShortSleeper() {
+        // 6.6 ± 1.3 h: the need stays at the 8 h floor, the regularity (~0.8) still lifts Rest a little.
+        val rs = rows(seed = 7L, nights = 120, compared = 30, meanH = 6.6, sdH = 1.3)
+        val s = report("30 nights, 6.6 ± 1.3 h", rs)
+        assertTrue(rs.all { it.need >= 8.0 })
+        assertTrue(s.getValue("restMaxAbs") <= 5.0)
+    }
+}
