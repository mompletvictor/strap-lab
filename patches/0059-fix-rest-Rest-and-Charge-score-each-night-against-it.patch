+package com.noop.analytics
+
+import java.io.File
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * victor:rest — "assert the single resolver" (AGENTS.md, two readouts of one fact): every Rest reader goes
+ * through [VictorSleepNeed], so a reader that scores Rest on upstream's 8 h and neutral 0.5 (or a fresh
+ * need of its own) cannot slip back in — including one an upstream release adds. Counted over the app's
+ * main sources with comments stripped.
+ */
+class VictorRestSingleResolverTest {
+
+    private fun sources(): List<File> {
+        val root = listOf(File("src/main/java"), File("app/src/main/java")).firstOrNull { it.isDirectory }
+        assertTrue("main sources not found from ${File(".").absolutePath}", root != null)
+        return root!!.walkTopDown().filter { it.isFile && it.extension == "kt" }.toList()
+    }
+
+    private fun callSites(token: String): Map<String, Int> {
+        val out = LinkedHashMap<String, Int>()
+        for (f in sources()) {
+            val n = f.readLines()
+                .map { it.substringBefore("//").trim() }
+                .filterNot { it.startsWith("*") || it.startsWith("/*") }
+                .count { it.contains(token) }
+            if (n > 0) out[f.name] = n
+        }
+        return out
+    }
+
+    @Test
+    fun restIsScoredOnlyThroughTheResolver() {
+        assertEquals(
+            "a Rest reader outside VictorSleepNeed: route it through VictorSleepNeed.rest / restPublished",
+            mapOf(
+                "VictorSleepNeed.kt" to 1,      // the resolver itself
+                "AnalyticsEngine.kt" to 1,      // the declaration
+                "IntelligenceEngine.kt" to 1,   // recomputeRecovery's default, overridden by applyPersonalRest
+            ),
+            callSites("restFromDaily("),
+        )
+    }
+
+    @Test
+    fun theNeedIsEstimatedOnlyByTheResolver() {
+        assertEquals(
+            "a sleep need computed outside VictorSleepNeed: read VictorSleepNeed.needHours",
+            mapOf(
+                "VictorSleepNeed.kt" to 2,      // the night's need and the cold-start default
+                "AnalyticsEngine.kt" to 1,      // the declaration
+                "IntelligenceEngine.kt" to 1,   // pass 1's run-wide need (DayResult.rest, read by nobody)
+            ),
+            callSites("personalizedNeedHours("),
+        )
+    }
+}
diff --git a/android/app/src/test/java/com/noop/analytics/VictorSleepNeedTest.kt b/android/app/src/test/java/com/noop/analytics/VictorSleepNeedTest.kt
