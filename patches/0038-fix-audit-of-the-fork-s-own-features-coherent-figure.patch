@@ -0,0 +1,30 @@
+package com.noop.ai
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.util.Locale
+
+/** victor:coach-lang — the coach answers in the phone's language and its chips read in Spanish. */
+class VictorCoachLangTest {
+
+    private val es = Locale("es", "ES")
+
+    @Test
+    fun aSpanishPhoneGetsSpanishRepliesWithTheAppsScoreNames() {
+        val note = VictorCoachLang.systemNote(es)
+        assertTrue(note.contains("Always reply in Spanish"))
+        assertTrue(note.contains("Carga (charge), Esfuerzo (effort) and Descanso (rest)"))
+        assertEquals("", VictorCoachLang.systemNote(Locale.US))
+        assertTrue(VictorCoachLang.systemNote(Locale.GERMANY).contains("Always reply in German"))
+    }
+
+    @Test
+    fun chipsAndTheRefusalReadInSpanish() {
+        assertEquals("Cuéntame más", VictorCoachLang.chip("Tell me more about that", es))
+        assertEquals("Analiza mi sueño", VictorCoachLang.chip("Analyse my sleep", es))
+        assertEquals("A new upstream chip", VictorCoachLang.chip("A new upstream chip", es))
+        assertEquals("Tell me more about that", VictorCoachLang.chip("Tell me more about that", Locale.US))
+        assertTrue(VictorCoachLang.refusal(es).startsWith("Claude no ha querido"))
+    }
+}
