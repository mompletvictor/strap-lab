@@ -0,0 +1,54 @@
+package com.noop.ai
+
+import java.util.Locale
+
+/**
+ * victor:coach-lang — the coach speaks the phone's language. Upstream's persona, the morning-brief
+ * instruction and the data block are English (prompts, not labels), so a brief generated with no user
+ * text came back in English on a Spanish phone. [systemNote] is appended to the system prompt at send
+ * time (the editable prompt in the Coach settings stays untouched), and [chip] shows upstream's English
+ * suggestion chips in Spanish; a chip upstream adds later simply stays in English.
+ */
+internal object VictorCoachLang {
+
+    fun systemNote(locale: Locale = Locale.getDefault()): String {
+        if (locale.language.isBlank() || locale.language == "en") return ""
+        val names = if (locale.language == "es") {
+            " In the app the three daily scores are called Carga (charge), Esfuerzo (effort) and Descanso (rest); use those names."
+        } else {
+            ""
+        }
+        return "\n\nAlways reply in ${locale.getDisplayLanguage(Locale.ENGLISH)}, the user's language, even though these " +
+            "instructions, the data and any earlier replies are in English.$names"
+    }
+
+    fun refusal(locale: Locale = Locale.getDefault()): String =
+        if (locale.language == "es") "Claude no ha querido responder a esto (filtro de seguridad). Reformúlalo o elige otro modelo."
+        else "Claude declined to answer this request (safety filter). Rephrase it or pick another model."
+
+    fun chip(text: String, locale: Locale = Locale.getDefault()): String =
+        if (locale.language == "es") ES[text] ?: text else text
+
+    private val ES = mapOf(
+        // CoachPrompts.SUGGESTIONS and CoachSuggestions.fallback
+        "How's my recovery trending this week?" to "¿Cómo va mi recuperación esta semana?",
+        "Should I train hard or take it easy today?" to "¿Entreno fuerte o suave hoy?",
+        "Why might my HRV be low lately?" to "¿Por qué tengo la VFC baja estos días?",
+        "How can I improve my sleep?" to "¿Cómo mejoro mi sueño?",
+        "What should today's training look like?" to "¿Qué entreno me toca hoy?",
+        "Analyse my sleep" to "Analiza mi sueño",
+        "Why am I run down?" to "¿Por qué estoy tan cansado?",
+        // CoachSuggestions, from today's bands
+        "Active recovery only today — what should I do?" to "Hoy solo recuperación activa: ¿qué hago?",
+        "Quality over volume today — plan my session" to "Hoy calidad antes que volumen: planifica mi sesión",
+        "Green light — how hard can I push today?" to "Luz verde: ¿cuánto puedo apretar hoy?",
+        "Why is my HRV trending down?" to "¿Por qué está bajando mi VFC?",
+        "I slept poorly — how do I recover today?" to "He dormido mal: ¿cómo me recupero hoy?",
+        "Have I done enough today, or push more?" to "¿He hecho suficiente hoy o aprieto más?",
+        // AiCoach.followUpSuggestions
+        "Tell me more about that" to "Cuéntame más",
+        "What should I do next?" to "¿Qué hago ahora?",
+        "How does today compare to this week?" to "¿Cómo va hoy frente al resto de la semana?",
+        "Give me a specific action plan" to "Dame un plan concreto",
+    )
+}
