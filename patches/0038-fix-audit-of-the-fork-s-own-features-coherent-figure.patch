+    /**
+     * The clock time of [ms] on [day] in minutes (0 before the day, 1440 after it). Clock time, not time
+     * elapsed since midnight: on the 23- and 25-hour days of a clock change the grid's hour labels are
+     * clock hours, and elapsed minutes put every event after the change an hour off.
+     */
+    private fun clockMinute(ms: Long, day: LocalDate, zone: ZoneId): Int {
+        val t = Instant.ofEpochMilli(ms).atZone(zone)
+        val d = t.toLocalDate()
+        return when {
+            d.isBefore(day) -> 0
+            d.isAfter(day) -> 24 * 60
+            else -> t.hour * 60 + t.minute
+        }
+    }
+
     /** Pure. All-day entries first, then by start time; untitled ones keep their place. */
