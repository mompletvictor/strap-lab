+        lookFrom: String,
+        blendFrom: String,
+        to: String,
+        zone: ZoneId,
+    ): Stores {
         val profile = profile(ctx)
         val weights = runCatching {
             repo.metricSeries(HealthConnectImporter.HC_DEVICE, ScaleBody.KEY_WEIGHT, "0000-01-01", to).map { it.day to it.value }
@@ -397,100 +441,111 @@ object DayEnergyModel {
             runCatching { repo.appleDaily(HealthConnectImporter.HC_DEVICE, lookFrom, to) + repo.appleDaily("apple-health", lookFrom, to) }
                 .getOrDefault(emptyList()),
         )
+        return Stores(profile, weights, restingByDay, strapTotalByDay, windowsByDay, claudeByKey, mealsByDay, phone)
+    }
 
