+        val phone = stores.phone[day]
+        return DayInputs(
+            day = day,
+            fraction = EnergyDays.fraction(day, nowEpochS, zone),
+            body = BodyInputs(
                 sex = profile.sex,
-                weightKg = EnergyEquations.weightOn(day, weights) ?: profile.weightKg,
+                weightKg = EnergyEquations.weightOn(day, stores.weights) ?: profile.weightKg,
