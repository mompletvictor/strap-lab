From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Victor Momplet <mompletvictor@gmail.com>
Date: Tue, 20 Oct 2026 17:20:47 +0200
Subject: [PATCH] perf(energy): split the day pass so ART compiles it

DayEnergyModel.compute was 18,896 code units, past ART's compiler limit, so it ran
interpreted on every read. The store reads, the per-day reduction and the model inputs
now live in their own functions (compute < 1,500; reduce 2,136; stores 1,990). Same
reads, same order, same results.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../java/com/noop/energy/DayEnergyModel.kt    | 235 +++++++++++-------
 1 file changed, 145 insertions(+), 90 deletions(-)

diff --git a/android/app/src/main/java/com/noop/energy/DayEnergyModel.kt b/android/app/src/main/java/com/noop/energy/DayEnergyModel.kt
index 012f28aec..2fb2276e5 100644
--- a/android/app/src/main/java/com/noop/energy/DayEnergyModel.kt
+++ b/android/app/src/main/java/com/noop/energy/DayEnergyModel.kt
@@ -352,6 +352,9 @@ object DayEnergyModel {
     /**
      * Compose [wanted] (sorted). With [lookback] the [STEPS_MEMORY_DAYS] days before the first are composed
      * too, unreturned, so a day without steps can borrow its neighbours' median; without it only [wanted].
+     *
+     * The pass is split into [stores], [reduce] and [inputs]: ART refuses to compile a method past its
+     * instruction limit and runs it interpreted on every call, and the pass in one piece was nearly twice it.
      */
     private suspend fun compute(
         ctx: Context,
@@ -370,7 +373,48 @@ object DayEnergyModel {
         val today = EnergyDays.dayOf(nowEpochS, zone)
         val recentFrom = EnergyDays.plusDays(today, -RECENT_DAYS)
         val days = cache(ctx)
+        val stores = stores(ctx, repo, strapId, lookFrom, blendFrom, to, zone)
 
+        var changed = false
+        val priorSteps = ArrayList<Double>()
+        val out = LinkedHashMap<String, DayEnergy>()
+        val toCompose = if (lookback) EnergyDays.days(lookFrom, to) else wanted
+        val wantedSet = wanted.toSet()
+        for (day in toCompose) {
+            val restingHr = stores.restingByDay.floorEntry(day)?.value
+            val hrMax = stores.profile.hrMaxOn(day)
+            val windows = stores.windowsByDay[day] ?: emptyList()
+            val (raw, moved) = reduce(repo, strapId, day, zone, day >= recentFrom, windows, restingHr, hrMax, days)
+            if (moved) changed = true
+            val energy = EnergyModel.compose(inputs(day, raw, stores, windows, restingHr, hrMax, priorSteps, nowEpochS, zone))
+            energy.steps?.takeIf { it.source != StepsSource.ESTIMATED }?.let { priorSteps += it.kcal }
+            if (day in wantedSet) out[day] = energy
+        }
+        if (changed) runCatching { mutex.withLock { EnergyCacheFile.write(ctx, HashMap(days)) } }
+        return out
+    }
+
+    /** What a pass reads from the stores once for its whole span. */
+    private class Stores(
+        val profile: Profile,
+        val weights: List<Pair<String, Double>>,
+        val restingByDay: TreeMap<String, Double>,
+        val strapTotalByDay: Map<String, Double>,
+        val windowsByDay: Map<String, List<Window>>,
+        val claudeByKey: Map<WorkoutKey, Double>,
+        val mealsByDay: Map<String, List<FoodEntry>>,
+        val phone: Map<String, PhoneDay>,
+    )
+
