+    /**
+     * [day]'s reduction: the cached one while its witnesses match, else re-read from the raw streams and put
+     * in [days]. The flag is true when the reduction's CONTENT moved, so the cache file needs rewriting.
+     */
+    private suspend fun reduce(
+        repo: WhoopRepository,
+        strapId: String,
+        day: String,
+        zone: ZoneId,
+        recent: Boolean,
+        windows: List<Window>,
+        restingHr: Double?,
+        hrMax: Double?,
+        days: ConcurrentHashMap<String, DayRaw>,
+    ): Pair<DayRaw, Boolean> {
+        val startS = EnergyDays.startEpochS(day, zone)
+        val endS = EnergyDays.endEpochS(day, zone)
+        val setup = setupKey(windows, restingHr, hrMax)
+        val cached = days[day]
+        val hrKey = if (recent) runCatching { hrKey(repo, strapId, startS, endS) }.getOrNull() else null
+        val stepsKey = if (recent) runCatching { stepsKey(repo, strapId, startS, endS) }.getOrNull() else null
+        val setupStale = cached == null || cached.setupKey != setup
+        val stepsStale = setupStale || (stepsKey != null && cached!!.stepsKey != stepsKey)
+        val hrStale = setupStale || (hrKey != null && cached!!.hrKey != hrKey)
+        if (!stepsStale && !hrStale) return cached!! to false
+        // Steps: the day's samples, re-read only when their witness moved; else the cached ticks.
+        // The unlogged minutes need the steps per minute too, so a heart-rate change re-reads them as well.
+        val samples = runCatching { stepSamplesUnion(repo, strapId, startS, endS - 1) }.getOrDefault(emptyList())
+        val dayTicks = if (stepsStale) ticks(samples, startS, endS - 1) else cached!!.strapTicks
+        // Heart rate: the whole day once; every window is a slice of it, and the rest is the unlogged minutes.
+        val dayHr: List<HrSample> = if (hrStale) runCatching { repo.hrSamplesUnion(strapId, startS, endS - 1, SAMPLE_LIMIT) }.getOrDefault(emptyList()) else emptyList()
+        val reduced = windows.map { w ->
+            val old = cached?.window(w.startTs, w.endTs, w.row.sport)
+            val hr = when {
+                !hrStale && old != null -> old.hr
+                w.durationS <= 0L -> HrIntegral.empty(restingHr, hrMax ?: HrIntegral.EMPTY_HRMAX)
+                else -> HrIntegral.of(dayHr, w.startTs, w.endTs, restingHr, hrMax)
             }
-            val age = profile.ageOn(day)
-            val body = BodyInputs(
+            val wTicks = if (stepsStale || old == null) ticks(samples, w.startTs, w.endTs) else old.strapTicks
+            WindowRaw(w.startTs, w.endTs, w.row.sport, hr, wTicks)
+        }
+        val unlogged = if (hrStale) {
+            val byMinute = UnloggedMinutes.ticksByMinute(samples)
+            UnloggedMinutes.of(dayHr, byMinute, windows, startS, endS, restingHr, hrMax).map { UnloggedRaw(it.minute, it.meanBpm, it.steps) }
+        } else {
+            cached!!.unlogged
+        }
+        val hasHr = if (hrStale) dayHr.isNotEmpty() else cached!!.hasHr
+        val raw = DayRaw(day, setup, hrKey ?: cached?.hrKey ?: "", stepsKey ?: cached?.stepsKey ?: "", dayTicks, reduced, hasHr, unlogged)
+        days[day] = raw
+        // The file is rewritten only for a reduction whose CONTENT moved: a live heart-rate stream
+        // outside any window moves today's witness on every read and nothing else.
+        return raw to (cached == null || !cached.sameContentAs(raw))
+    }
