+/**
+ * victor:weight — [resolveMetric] for a series keyed by its own days rather than by the strap's day rows, so
+ * a weigh-in on a day the strap has no row for still plots. Same calendar windows and widening order.
+ */
+private fun resolveSeries(byDay: Map<String, Double>, selected: TrendsRange): ResolvedMetric {
+    val all = byDay.toSortedMap().toList()
+    fun window(r: TrendsRange) = r.days?.let { n ->
+        val cutoff = LocalDate.now().minusDays((n - 1).toLong()).toString()
+        all.filter { it.first >= cutoff }
+    } ?: all
+    val eff = selected.widening.firstOrNull { window(it).isNotEmpty() } ?: TrendsRange.All
+    val pts = window(eff)
+    return ResolvedMetric(
+        values = pts.map { it.second },
+        dates = pts.map { it.first },
+        effective = eff,
+        widened = eff != selected,
+        caption = caption(pts.size, eff, selected),
+    )
+}
