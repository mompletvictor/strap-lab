@@ -0,0 +1,39 @@
+package com.noop.widget
+
+import android.content.Context
+import android.content.Intent
+import android.net.Uri
+import com.noop.ui.appLaunchIntent
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+
+/**
+ * victor:widget — what a button on the quick widget asked the app to open: the food camera or the
+ * training sheet. MainActivity hands the launch intent here, AppRoot navigates to the screen, and that
+ * screen takes the action exactly once ([consume]), so a recomposition or a rotation never re-opens it.
+ */
+object VictorWidgetAction {
+    const val FOOD_PHOTO = "food_photo"
+    const val TRAINING = "training"
+    private const val EXTRA = "com.noop.widget.VICTOR_ACTION"
+
+    private val _pending = MutableStateFlow<String?>(null)
+    val pending: StateFlow<String?> = _pending
+
+    /** The intent a widget button fires: the launcher entry (reuses the running app) plus the action. A
+     *  distinct data URI per action keeps the two buttons' PendingIntents apart. */
+    fun intent(context: Context, action: String): Intent =
+        appLaunchIntent(context).apply {
+            data = Uri.parse("noop-widget://$action")
+            putExtra(EXTRA, action)
+        }
+
+    fun accept(intent: Intent?) {
+        val action = intent?.getStringExtra(EXTRA) ?: return
+        if (action == FOOD_PHOTO || action == TRAINING) _pending.value = action
+        intent.removeExtra(EXTRA)
+    }
+
+    /** True once, for the screen that acts on [action]. */
+    fun consume(action: String): Boolean = _pending.compareAndSet(action, null)
+}
