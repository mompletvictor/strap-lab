+import androidx.glance.action.clickable
+import androidx.glance.appwidget.GlanceAppWidget
+import androidx.glance.appwidget.cornerRadius
+import androidx.glance.appwidget.provideContent
+import androidx.glance.background
+import androidx.glance.layout.Alignment
+import androidx.glance.layout.Box
+import androidx.glance.layout.Column
+import androidx.glance.layout.Row
+import androidx.glance.layout.Spacer
+import androidx.glance.layout.fillMaxSize
+import androidx.glance.layout.fillMaxWidth
+import androidx.glance.layout.height
+import androidx.glance.layout.padding
+import androidx.glance.layout.width
+import androidx.glance.semantics.contentDescription
+import androidx.glance.semantics.semantics
+import androidx.glance.text.FontWeight
+import androidx.glance.text.Text
+import androidx.glance.text.TextAlign
+import androidx.glance.text.TextStyle
+import androidx.glance.unit.ColorProvider
+import com.noop.R
+import com.noop.analytics.ClockFormat
+import com.noop.ui.ClockPrefs
+import com.noop.ui.MainActivity
+import com.noop.ui.uiString
+import java.util.Date
+
+/**
+ * victor:widget — the 3x3 quick widget: Rest · Charge · Effort, live heart rate and strap battery (the
+ * same snapshot as the 2x2 [NoopGlanceWidget], so the same honest "—" before a score exists), plus two
+ * buttons: Food opens the camera for a meal photo, Workout opens the training sheet (or the running
+ * workout). Tapping anywhere else opens the app. Offered as its own picker entry; the 2x2 stays as it is.
+ */
+class VictorQuickGlanceWidget : GlanceAppWidget() {
+
+    override suspend fun provideGlance(context: Context, id: GlanceId) {
+        val snap = runCatching { WidgetSnapshotStore.load(context) }.getOrDefault(WidgetSnapshot())
+        val dark = WidgetTheme.isDark(context)
+        provideContent { QuickContent(snap, dark) }
+    }
+
+    /** Same friendlier fallback as [NoopGlanceWidget.onCompositionError]; heals on the next push. */
+    override fun onCompositionError(context: Context, glanceId: GlanceId, appWidgetId: Int, throwable: Throwable) {
+        runCatching {
+            val rv = android.widget.RemoteViews(context.packageName, R.layout.noop_widget_error)
+            android.appwidget.AppWidgetManager.getInstance(context).updateAppWidget(appWidgetId, rv)
+        }
+    }
+}
+
+// The 2x2 widget's colours (kept local there too: Glance composes outside the app theme).
+private fun surface(dark: Boolean) = ColorProvider(if (dark) Color(0xFF0A1322) else Color(0xFFF4F1EA))
+private fun buttonFill(dark: Boolean) = ColorProvider(if (dark) Color(0xFF1A2940) else Color(0xFFE6DFD1))
+private fun textPrimary(dark: Boolean) = ColorProvider(if (dark) Color(0xFFF4F6F8) else Color(0xFF1A2230))
+private fun textSecondary(dark: Boolean) = ColorProvider(if (dark) Color(0xFF8A94A4) else Color(0xFF7C8696))
+
+private fun bandColor(recovery: Int, dark: Boolean): ColorProvider = ColorProvider(
+    when {
+        recovery >= 67 -> if (dark) Color(0xFFE8B84B) else Color(0xFFB07D17)
+        recovery >= 34 -> if (dark) Color(0xFFD98A3D) else Color(0xFFC2792E)
+        else -> if (dark) Color(0xFFE0662F) else Color(0xFFC84E1E)
+    },
+)
+
+private fun effortColor(dark: Boolean) = ColorProvider(if (dark) Color(0xFF4FB6A8) else Color(0xFF2E7D74))
+
+@Composable
+private fun QuickContent(snap: WidgetSnapshot, dark: Boolean) {
+    val context = LocalContext.current
+    val secondary = textSecondary(dark)
+    val primary = textPrimary(dark)
+    Column(
+        modifier = GlanceModifier
+            .fillMaxSize()
+            .background(surface(dark))
+            .cornerRadius(20.dp)
+            .clickable(actionStartActivity<MainActivity>())
+            .padding(horizontal = 12.dp, vertical = 12.dp),
+        horizontalAlignment = Alignment.CenterHorizontally,
+    ) {
+        Spacer(GlanceModifier.defaultWeight())
+        Row(modifier = GlanceModifier.fillMaxWidth(), verticalAlignment = Alignment.Bottom) {
+            Score(
+                uiString(R.string.l10n_noop_glance_widget_rest_cbaaa181), snap.restPct,
+                snap.restPct?.let { bandColor(it, dark) } ?: secondary, 30.sp, secondary,
+                GlanceModifier.defaultWeight(),
+            )
+            Score(
+                uiString(R.string.l10n_noop_glance_widget_charge_49a8cb83), snap.recoveryPct,
+                snap.recoveryPct?.let { bandColor(it, dark) } ?: secondary, 40.sp, secondary,
+                GlanceModifier.defaultWeight(),
+            )
+            Score(
+                uiString(R.string.l10n_noop_glance_widget_effort_660752e7), snap.effortPct,
+                snap.effortPct?.let { effortColor(dark) } ?: secondary, 30.sp, secondary,
+                GlanceModifier.defaultWeight(),
+            )
+        }
+        Spacer(GlanceModifier.height(14.dp))
+        val hrLabel = uiString(R.string.l10n_noop_glance_widget_heart_rate_410aa15c)
+        val batteryLabel = uiString(R.string.l10n_noop_glance_widget_strap_battery_a6c7f09c)
+        val hrDescription = snap.heartRate
+            ?.let { "$hrLabel ${uiString(R.string.l10n_today_screen_value_bpm_8f3a90c3, it)}" } ?: hrLabel
+        val batteryDescription = snap.batteryPct
+            ?.let { "$batteryLabel ${uiString(R.string.l10n_today_screen_pct_ee63e247, it)}" } ?: batteryLabel
+        Row(verticalAlignment = Alignment.CenterVertically) {
+            Text(
+                text = snap.heartRate?.let { "♥ $it" } ?: "♥ —",
+                // A carried-over reading is dimmed so it can't pass for a live one (as on the 2x2).
+                style = TextStyle(color = if (snap.heartRateStale) secondary else primary, fontSize = 20.sp, fontWeight = FontWeight.Medium),
+                modifier = GlanceModifier.semantics { contentDescription = hrDescription },
+            )
+            Spacer(GlanceModifier.width(20.dp))
+            Text(
+                text = snap.batteryPct?.let { "⚡ $it%" } ?: "⚡ —",
+                style = TextStyle(color = primary, fontSize = 20.sp, fontWeight = FontWeight.Medium),
+                modifier = GlanceModifier.semantics { contentDescription = batteryDescription },
+            )
+        }
+        Spacer(GlanceModifier.defaultWeight())
+        Row(modifier = GlanceModifier.fillMaxWidth()) {
+            ActionButton(
+                uiString(R.string.victor_widget_food), dark,
+                VictorWidgetAction.intent(context, VictorWidgetAction.FOOD_PHOTO), GlanceModifier.defaultWeight(),
+            )
+            Spacer(GlanceModifier.width(8.dp))
+            ActionButton(
+                uiString(R.string.victor_widget_training), dark,
+                VictorWidgetAction.intent(context, VictorWidgetAction.TRAINING), GlanceModifier.defaultWeight(),
+            )
+        }
+        Spacer(GlanceModifier.height(6.dp))
+        Text(
+            text = when {
+                snap.connected -> uiString(R.string.victor_widget_connected)
+                snap.updatedAtMs > 0L -> java.text.SimpleDateFormat(
+                    ClockFormat.hourMinutePattern(ClockPrefs.uses24Hour(context)), java.util.Locale.getDefault(),
+                ).format(Date(snap.updatedAtMs))
+                else -> uiString(R.string.victor_widget_open_app)
+            },
+            style = TextStyle(color = secondary, fontSize = 11.sp),
+        )
+    }
+}
+
+@Composable
+private fun Score(
+    label: String,
+    pct: Int?,
+    color: ColorProvider,
+    valueSize: TextUnit,
+    secondary: ColorProvider,
+    modifier: GlanceModifier,
+) {
+    Column(modifier = modifier, horizontalAlignment = Alignment.CenterHorizontally) {
+        Text(text = label, style = TextStyle(color = secondary, fontSize = 12.sp, fontWeight = FontWeight.Medium))
+        Text(text = pct?.let { "$it%" } ?: "—", style = TextStyle(color = color, fontSize = valueSize, fontWeight = FontWeight.Bold))
+    }
+}
+
+@Composable
+private fun ActionButton(label: String, dark: Boolean, intent: android.content.Intent, modifier: GlanceModifier) {
+    Box(
+        modifier = modifier
+            .height(56.dp)
+            .background(buttonFill(dark))
+            .cornerRadius(14.dp)
+            .clickable(androidx.glance.appwidget.action.actionStartActivity(intent)),
+        contentAlignment = Alignment.Center,
+    ) {
+        Text(
+            text = label,
+            style = TextStyle(color = textPrimary(dark), fontSize = 17.sp, fontWeight = FontWeight.Bold, textAlign = TextAlign.Center),
+        )
+    }
+}
