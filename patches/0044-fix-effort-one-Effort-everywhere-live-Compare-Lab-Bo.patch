+package com.noop.training
+
+import com.noop.ai.AiCoach
+import com.noop.analytics.IntelligenceEngine
+import com.noop.analytics.StepsEstimateEngine
+import com.noop.analytics.UserProfile
+import com.noop.analytics.WeeklyMetric
+import com.noop.ble.NotifyDayStateCache
+import com.noop.data.DailyMetric
+import com.noop.data.GravityWitness
+import com.noop.data.MetricSeriesRow
+import com.noop.data.WhoopDao
+import com.noop.data.WhoopRepository
+import com.noop.ui.buildWeeklyDigest
+import com.noop.ui.logicalDayKeyNow
+import kotlinx.coroutines.runBlocking
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.lang.reflect.Proxy
+import java.time.DayOfWeek
+import java.time.LocalDate
+import java.time.ZoneId
+import kotlin.coroutines.Continuation
+import kotlin.coroutines.EmptyCoroutineContext
+
+/**
+ * victor:training — the day's Effort with the gym extra is ONE number: every reader that shows or uses it
+ * (Compare and Lab Book through the resolved series, the widget, the Fitness Age pass, the coach's means)
+ * reads what Today and Trends read.
+ */
+class VictorEffortReadersTest {
+
+    private val zone = ZoneId.systemDefault()
+
+    /** Claude puts a gym session at 55 where its heart rate said 15: the day's Effort goes up. */
+    private fun gym(day: String, n: Int = 0) = TrainingSession(
+        id = "gym-$day-$n", mode = TrainingMode.LOGGED,
+        startTs = LocalDate.parse(day).atTime(18, 0).atZone(zone).toEpochSecond(),
+        endTs = LocalDate.parse(day).atTime(19, 15).atZone(zone).toEpochSecond(),
+        sport = "Strength", description = "", exercises = emptyList(),
+        analysis = TrainingAnalysis(430.0, null, null, 263.0, "", 1L, hrStrain = 15.0, effort = 55.0),
+    )
+
+    @After
+    fun noSessions() {
+        VictorDayEffort.update(emptyList())
+    }
+
+    /** Compare and Lab Book read the series resolver: the Effort there carries the extra, other keys do not. */
+    @Test
+    fun theResolvedEffortSeriesCarriesTheExtra() = runBlocking {
+        val rows = listOf(
+            DailyMetric("my-whoop-noop", "2026-10-18", strain = 30.0, recovery = 60.0),
+            DailyMetric("my-whoop-noop", "2026-10-19", strain = 18.0, recovery = 18.0),
+        )
+        val dao = Proxy.newProxyInstance(WhoopDao::class.java.classLoader, arrayOf(WhoopDao::class.java)) { _, method, args ->
+            when (method.name) {
+                "metricSeries" -> emptyList<MetricSeriesRow>()
+                "dailyMetricsRange" -> rows.filter { it.deviceId == args!![0] }
+                else -> throw UnsupportedOperationException("resolver must not call ${method.name}")
+            }
+        } as WhoopDao
+        val repo = WhoopRepository(dao)
+        VictorDayEffort.update(listOf(gym("2026-10-19")))
+
+        val effort = repo.resolvedSeries("strain", "my-whoop", "2026-10-01", "2026-10-31").values.toMap()
+        assertEquals(30.0, effort.getValue("2026-10-18"), 0.0)
+        val merged = VictorDayEffort.apply(rows, VictorDayEffort.boosts.value)[1].strain!!
+        assertEquals(merged, effort.getValue("2026-10-19"), 1e-9)
+        assertTrue(effort.getValue("2026-10-19") > 50.0)
+        // Only the Effort: a Charge of 18 stays 18.
+        assertEquals(18.0, repo.resolvedSeries("recovery", "my-whoop", "2026-10-01", "2026-10-31").values.toMap().getValue("2026-10-19"), 0.0)
+    }
+
+    /**
+     * The widget's Effort is today's, even before today has a Charge: the carry-over to the last scored day
+     * is for what comes from the night (Charge, Rest), and yesterday's 62 must not read as today's.
+     */
+    @Test
+    fun theWidgetEffortIsTodaysWhileChargeCarriesOver() {
+        val days = listOf(
+            DailyMetric("my-whoop", "2026-10-19", recovery = 70.0, strain = 62.0, totalSleepMin = 420.0),
+            DailyMetric("my-whoop", "2026-10-20", strain = 4.0),
+        )
+        val state = NotifyDayStateCache { null }.resolve(days, "2026-10-20", "2026-10-20", illnessEnabled = false)
+        assertEquals(4, state.widgetEffort)
+        assertEquals(70, state.widgetRecovery)
+    }
+
+    /**
+     * The scheduled Fitness Age pass and the "refresh" button write the same point: the pass's fresh rows get
+     * the extra the button's merged rows already carry. Five gym days lift 18 to ~55, past the 30 that makes
+     * a day "active", so without the extra the pass would write a different age.
+     */
+    @Test
+    fun theFitnessAgePassCountsTheGymExtraLikeTheRefreshButton() {
+        val week = (13..19).map { "2026-10-$it" }
+        val dailies = week.map { DailyMetric("strap-noop", it, restingHr = 55, strain = 18.0) }
+        VictorDayEffort.update(week.take(5).map { gym(it) })
+        val profile = UserProfile(age = 26.0, sex = "male")
+
+        val written = ArrayList<MetricSeriesRow>()
+        val dao = Proxy.newProxyInstance(WhoopDao::class.java.classLoader, arrayOf(WhoopDao::class.java)) { _, method, args ->
+            when (method.name) {
+                "upsertMetricSeriesWithProvenance" -> {
+                    @Suppress("UNCHECKED_CAST")
+                    written.addAll(args!![0] as List<MetricSeriesRow>)
+                    Unit
+                }
+                "upsertMetricSeries" -> Unit
+                "appleDaily", "gravitySamples" -> emptyList<Any>()
+                "gravityWitnessInWindow" -> GravityWitness(0, 0L)
+                else -> throw UnsupportedOperationException("unexpected ${method.name}")
+            }
+        } as WhoopDao
+        val method = IntelligenceEngine::class.java.declaredMethods.single { it.name == "persistFitnessVitalityAndSteps" }
+        method.isAccessible = true
+        val continuation = object : Continuation<Unit> {
+            override val context = EmptyCoroutineContext
+            override fun resumeWith(result: Result<Unit>) = result.getOrThrow()
+        }
+        method.invoke(
+            IntelligenceEngine, WhoopRepository(dao), dailies, emptyList<DailyMetric>(), profile, "strap-noop",
+            "2026-10-19", { _: String -> }, 0L, 0L, null, listOf("strap" to 0), "strap", 1.5,
+            { _: StepsEstimateEngine.Calibration -> }, null, continuation,
+        )
+
+        fun age(rows: List<MetricSeriesRow>) = rows.single { it.key == "fitness_age" }.value
+        val withExtra = age(IntelligenceEngine.fitnessAgeRows(VictorDayEffort.apply(dailies, VictorDayEffort.boosts.value), profile, "strap-noop", "2026-10-17"))
+        val heartRateOnly = age(IntelligenceEngine.fitnessAgeRows(dailies, profile, "strap-noop", "2026-10-17"))
+        assertNotEquals(heartRateOnly, withExtra, 0.1)
+        assertEquals(withExtra, age(written), 1e-9)
+    }
+
+    /** The coach's 30-day Effort and steps means are of finished days; today's half-day stays in its table. */
+    @Test
+    fun theCoachMeansSkipTheDayInProgress() {
+        val today = LocalDate.parse(logicalDayKeyNow())
+        val days = (3 downTo 1).map { DailyMetric("my-whoop", today.minusDays(it.toLong()).toString(), strain = 50.0, steps = 10_000) } +
+            DailyMetric("my-whoop", today.toString(), strain = 5.0, steps = 500)
+        val dao = Proxy.newProxyInstance(WhoopDao::class.java.classLoader, arrayOf(WhoopDao::class.java)) { _, method, _ ->
+            throw UnsupportedOperationException("buildContext must not touch the repo (${method.name})")
+        } as WhoopDao
+        val ctx = AiCoach(WhoopRepository(dao)).buildContext(days)
+        assertTrue(ctx, ctx.contains("charge -%, effort 50, rest"))
+        assertTrue(ctx, ctx.contains("steps 10000/day"))
+        assertTrue(ctx, ctx.contains("${today}: charge -, effort 5, "))
+    }
+
+    /** Trends' week digest averages the finished days' Effort; today's half-day would drag it down. */
+    @Test
+    fun theWeekDigestEffortMeanSkipsTheDayInProgress() {
+        val today = LocalDate.parse(logicalDayKeyNow())
+        val finished = generateSequence(today.with(DayOfWeek.MONDAY)) { it.plusDays(1) }.takeWhile { it < today }.toList()
+        val days = finished.map { DailyMetric("my-whoop", it.toString(), strain = 50.0) } +
+            DailyMetric("my-whoop", today.toString(), strain = 5.0)
+        val effort = buildWeeklyDigest(days, today.toString()).metrics.single { it.metric == WeeklyMetric.EFFORT }.thisWeek
+        assertEquals(finished.size, effort.n)
+        if (finished.isNotEmpty()) assertEquals(50.0, effort.mean, 1e-9)
+    }
+}
