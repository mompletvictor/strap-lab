+    /**
+     * Pure: whether the day before the latest row's night was hard, for the illness heads-up. The night it
+     * judges is the latest row's, so the session that explains a high heart rate or a low HRV is the DAY
+     * BEFORE's; and "hard" is that day's Effort (extra included, as merged rows carry it) in WHOOP's High band,
+     * 14 of 21 (upstream's CoachSuggestions.HIGH_STRAIN), not a count of workouts.
+     */
+    fun hardDayBefore(days: List<DailyMetric>): Boolean {
+        val latest = days.lastOrNull() ?: return false
+        val before = runCatching { LocalDate.parse(latest.day).minusDays(1).toString() }.getOrNull() ?: return false
+        val effort = days.lastOrNull { it.day == before }?.strain ?: return false
+        return effort >= StrainScorer.effortValueFromWhoopStrain(HARD_DAY_WHOOP)
+    }
+
+    private const val HARD_DAY_WHOOP = 14.0
+
+    /**
+     * Pure: a window's Effort values without the day still in progress (the logical day, and the local one past
+     * midnight). Effort accrues through the day, so its half-day would drag a mean down; its point still plots.
+     */
+    fun finishedDays(values: List<Double>, dates: List<String>, todayKey: String = com.noop.ui.logicalDayKeyNow()): List<Double> =
+        values.filterIndexed { i, _ -> dates.getOrNull(i)?.let { it < todayKey } ?: true }
