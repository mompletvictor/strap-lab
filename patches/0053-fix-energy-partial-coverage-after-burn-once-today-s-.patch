+
+    @Test
+    fun secondsTheStrapMissedCountAtBasalNotAgainstTheNet() {
+        // A 60-min run the strap covered 70 %: the net is Keytel's active seconds above basal, not that minus the
+        // basal of the whole hour (which left a 70 %-covered run ~30 % short).
+        val w = EnergyModel.windows(listOf(row("Running", 9 * 60, 60))).single()
+        val bmrRate = 2021.7 / 86_400.0
+        val full = HrIntegral.of(flat(150, w), w.startTs, w.endTs, 55.0, 194.0)
+        val partial = HrIntegral.of(flat(150, w).filter { it.ts < w.startTs + 42 * 60 }, w.startTs, w.endTs, 55.0, 194.0)
+        val whole = EnergyModel.workoutEnergy(WindowInputs(w, full, null, null, null), body, bmrRate)
+        val covered = EnergyModel.workoutEnergy(WindowInputs(w, partial, null, null, null), body, bmrRate)
+        assertEquals(0.7, covered.coverage, 0.02)
+        assertEquals(EnergyMethod.HEART_RATE, covered.method)
