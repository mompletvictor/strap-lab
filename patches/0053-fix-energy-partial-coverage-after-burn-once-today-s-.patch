+/**
+ * victor:energy — how long a cold day costs: a full day of 1 Hz heart rate (86 400 samples) and steps
+ * (86 400 samples) with an hour's run, reduced once, then served from the cache. Prints the timings; the
+ * phone is slower than this JVM, and the warm-up ([DayEnergyModel.warm]) runs it on a low-priority thread.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34], manifest = Config.NONE)
+class DayEnergyModelLoadTest {
+
+    private val ctx: Context = RuntimeEnvironment.getApplication()
+    private lateinit var db: WhoopDatabase
+    private lateinit var repo: WhoopRepository
+
+    @Before
+    fun setUp() = runBlocking {
+        db = Room.inMemoryDatabaseBuilder(ctx, WhoopDatabase::class.java).allowMainThreadQueries().build()
+        repo = WhoopRepository(db)
+        DayEnergyModel.invalidate(ctx)
+    }
+
+    @After
+    fun tearDown() = db.close()
+
+    @Test
+    fun aFullDayOfOneHertzStreamsReducesInSeconds() = runBlocking {
+        ProfileStore.from(ctx).apply { sex = "male"; weightKg = 80.0; heightCm = 180.0; setAge(26) }
+        val day = "2026-10-10"
+        val start = EnergyDays.startEpochS(day)
+        val end = EnergyDays.endEpochS(day)
+        val runStart = start + 6 * 3600
+        repo.upsertDailyMetrics(listOf(DailyMetric("my-whoop", day, restingHr = 55)))
+        repo.upsertWorkouts(listOf(WorkoutRow("my-whoop", runStart, runStart + 3600, "Running", "manual")))
+        // Resting pulse all day, a run at 150 in its window, a stroll at 100 in the afternoon; a tick every
+        // second of the stroll and the run, still otherwise.
+        val hr = (start until end).map { ts ->
+            HrSample("my-whoop", ts, if (ts in runStart until runStart + 3600) 150 else if (ts in start + 10 * 3600 until start + 11 * 3600) 100 else 60)
+        }
+        var counter = 0
+        val steps = (start until end).map { ts ->
+            val moving = ts in runStart until runStart + 3600 || ts in start + 10 * 3600 until start + 11 * 3600
+            if (moving) counter++
+            StepSample("my-whoop", ts, counter and 0xFFFF, activityClass = if (moving) 1 else 0)
+        }
+        val insertStart = System.nanoTime()
+        hr.chunked(10_000).forEach { db.whoopDao().insertHr(it) }
+        steps.chunked(10_000).forEach { db.whoopDao().insertSteps(it) }
+        val insertMs = (System.nanoTime() - insertStart) / 1_000_000
+        val now = end + 86_400
+
+        val coldStart = System.nanoTime()
+        val cold = DayEnergyModel.day(ctx, repo, "my-whoop", day, now)!!
+        val coldMs = (System.nanoTime() - coldStart) / 1_000_000
+        val warmStart = System.nanoTime()
+        val warm = DayEnergyModel.day(ctx, repo, "my-whoop", day, now)!!
+        val warmMs = (System.nanoTime() - warmStart) / 1_000_000
+        println("ENERGY LOAD: insert ${insertMs} ms; cold day ${coldMs} ms; cached day ${warmMs} ms")
+
+        assertEquals(cold, warm)
+        assertEquals(3600, cold.steps!!.freeSteps)
+        assertEquals(EnergyMethod.HEART_RATE, cold.workouts.single().method)
+        assertEquals(0.0, cold.unloggedKcal!!, 0.0)   // the stroll at 100 bpm is under the gate
+        assertTrue("a cold day took ${coldMs} ms", coldMs < 60_000)
+        assertTrue("a cached day took ${warmMs} ms", warmMs < coldMs)
+    }
+}
diff --git a/android/app/src/test/java/com/noop/energy/EnergyHooksTest.kt b/android/app/src/test/java/com/noop/energy/EnergyHooksTest.kt
