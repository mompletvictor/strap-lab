+    /**
+     * Gross energy of the WHOLE window of [durationS]: Keytel on the active seconds, basal on every other
+     * second — the resting ones and the ones without a sample alike — so a window the strap covered 80 %
+     * is not charged its full basal against a gross that only counted 80 % of it. Its net above basal is
+     * then exactly `activeKcal − bmr · activeS`.
+     */
+    fun grossOverWindow(sex: String, weightKg: Double, ageYears: Double, bmrRatePerS: Double, durationS: Long): Double {
+        val active = activeS.coerceIn(0.0, durationS.toDouble().coerceAtLeast(0.0))
+        return activeKcal(sex, weightKg, ageYears) + bmrRatePerS * (durationS - active)
+    }
