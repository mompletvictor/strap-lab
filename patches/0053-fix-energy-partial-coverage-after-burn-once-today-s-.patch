--- /dev/null
+++ b/android/app/src/test/java/com/noop/energy/EnergyHooksTest.kt
@@ -0,0 +1,70 @@
+package com.noop.energy
+
+import com.noop.data.WorkoutRow
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.runBlocking
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.util.concurrent.atomic.AtomicReference
+
+/** victor:energy — a list never waits for a cold cache: past the budget it shows "–" and takes the figures when they come. */
+class EnergyHooksTest {
+
+    private val rows = listOf(
+        WorkoutRow("my-whoop", 1_792_422_000L, 1_792_425_600L, "Running", "manual", energyKcal = 999.0),
+        WorkoutRow("my-whoop", 1_792_500_000L, 1_792_503_600L, "Strength", "manual", energyKcal = 265.0),
+    )
+
+    @After
+    fun tearDown() {
+        EnergyHooks.pricedRows = null
+    }
+
+    @Test
+    fun notInstalledTheRowsPassThrough() = runBlocking {
+        assertEquals(rows, EnergyHooks.priced(rows) { error("never") })
+        assertEquals(rows, EnergyHooks.priced(rows))
+    }
+
+    @Test
+    fun withinTheBudgetThePricedRowsComeBackAtOnce() = runBlocking {
+        EnergyHooks.pricedRows = { list -> list.map { it.copy(energyKcal = 490.0) } }
+        val out = EnergyHooks.priced(rows) { error("not late") }
+        assertEquals(listOf(490.0, 490.0), out.map { it.energyKcal })
+    }
+
+    @Test
+    fun pastTheBudgetTheRowsShowNoFigureAndThePricedOnesAreRepublished() = runBlocking {
+        EnergyHooks.scope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+        EnergyHooks.pricedRows = { list -> delay(EnergyHooks.PRICE_BUDGET_MS + 400); list.map { it.copy(energyKcal = 380.0) } }
+        val late = AtomicReference<List<WorkoutRow>?>(null)
+        val started = System.currentTimeMillis()
+        val quick = EnergyHooks.priced(rows) { late.set(it) }
+        assertTrue(System.currentTimeMillis() - started < EnergyHooks.PRICE_BUDGET_MS + 200)
+        // Never upstream's heart-rate figure while waiting: a dash.
+        assertTrue(quick.all { it.energyKcal == null })
+        assertNull(late.get())
+        var waited = 0
+        while (late.get() == null && waited < 50) { delay(100); waited++ }
+        assertEquals(listOf(380.0, 380.0), late.get()!!.map { it.energyKcal })
+    }
+
+    @Test
+    fun aLatePricingSupersededByANewerCallIsDropped() = runBlocking {
+        EnergyHooks.scope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+        EnergyHooks.pricedRows = { list -> delay(EnergyHooks.PRICE_BUDGET_MS + 300); list.map { it.copy(energyKcal = 1.0) } }
+        val first = AtomicReference<List<WorkoutRow>?>(null)
+        EnergyHooks.priced(rows) { first.set(it) }
+        EnergyHooks.pricedRows = { list -> list.map { it.copy(energyKcal = 2.0) } }
+        val second = EnergyHooks.priced(rows) { error("fast: never late") }
+        assertEquals(listOf(2.0, 2.0), second.map { it.energyKcal })
+        delay(EnergyHooks.PRICE_BUDGET_MS + 600)
+        assertNull(first.get())   // the stale list never overwrote the newer one
+    }
+}
