+        assertEquals(covered.netKcal + bmrRate * 3600, covered.grossKcal, 1e-6)
+        assertEquals(whole.netKcal * 0.7, covered.netKcal, whole.netKcal * 0.01)
+    }
+
+    @Test
+    fun theStepsEstimateOfADayInProgressIsItsShareOfTheMedian() {
+        val prior = listOf(200.0, 260.0, 240.0)
+        assertEquals(240.0, EnergyModel.compose(example(strapDaySteps = null, prior = prior)).steps!!.kcal, 0.0)
+        assertEquals(120.0, EnergyModel.compose(example(strapDaySteps = null, prior = prior, fraction = 0.5)).steps!!.kcal, 0.0)
+    }
+
+    @Test
+    fun aWhoopExportWorkoutWithoutRawPulseKeepsWhoopsOwnCalories() {
+        // The WHOOP CSV import stores its rows under source "my-whoop" with WHOOP's measured kcal, and no raw
+        // heart rate ever reaches the phone for them: that figure is the measurement, not an estimate to replace.
+        val row = WorkoutRow("my-whoop", dayStart + 9 * 3600, dayStart + 10 * 3600, "Cycling", "my-whoop", energyKcal = 640.0)
+        assertEquals(640.0, EnergyModel.externalKcal(row)!!, 0.0)
+        val w = EnergyModel.windows(listOf(row)).single()
+        val priced = EnergyModel.workoutEnergy(WindowInputs(w, hr(w, null), null, null, EnergyModel.externalKcal(row)), body, 2000.0 / 86_400.0)
+        assertEquals(EnergyMethod.EXTERNAL, priced.method)
+        assertEquals(640.0, priced.grossKcal, 0.0)
+        // A live / manual row carries upstream's Keytel figure, which the model replaces; so does a detected one.
+        assertNull(EnergyModel.externalKcal(row.copy(source = "manual")))
+        assertNull(EnergyModel.externalKcal(row.copy(source = "my-whoop-noop")))
+    }
 }
