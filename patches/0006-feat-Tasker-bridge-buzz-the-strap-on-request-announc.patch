+package com.noop.tasker
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.security.SecureRandom
+
+/** victor:tasker — the gating of the exported buzz receiver, without a device. */
+class TaskerBridgeTest {
+
+    @Test
+    fun buzzNeedsTheBridgeOnAndTheExactToken() {
+        assertTrue(TaskerBridge.authorized(enabled = true, expected = "abc123", given = "abc123"))
+        assertFalse(TaskerBridge.authorized(enabled = false, expected = "abc123", given = "abc123"))
+        assertFalse(TaskerBridge.authorized(enabled = true, expected = "abc123", given = "abc124"))
+        assertFalse(TaskerBridge.authorized(enabled = true, expected = "abc123", given = "abc12"))
+        assertFalse(TaskerBridge.authorized(enabled = true, expected = "abc123", given = null))
+        assertFalse(TaskerBridge.authorized(enabled = true, expected = "abc123", given = ""))
+        // A bridge switched on with no token stored must not accept an empty one.
+        assertFalse(TaskerBridge.authorized(enabled = true, expected = null, given = ""))
+        assertFalse(TaskerBridge.authorized(enabled = true, expected = "", given = ""))
+    }
+
+    @Test
+    fun countAcceptsIntsAndStringsAndIsClamped() {
+        assertEquals(1, TaskerBridge.parseCount(null))
+        assertEquals(3, TaskerBridge.parseCount(3))
+        assertEquals(3, TaskerBridge.parseCount(3L))
+        assertEquals(4, TaskerBridge.parseCount(" 4 "))
+        assertEquals(1, TaskerBridge.parseCount("lots"))
+        assertEquals(1, TaskerBridge.parseCount(0))
+        assertEquals(1, TaskerBridge.parseCount(-7))
+        assertEquals(TaskerBridge.MAX_COUNT, TaskerBridge.parseCount(99))
+        assertEquals(TaskerBridge.MAX_COUNT, TaskerBridge.parseCount(Long.MAX_VALUE))
+    }
+
+    @Test
+    fun cooldownCoversTheWholeSequence() {
+        assertEquals(1_000L + TaskerBridge.COOLDOWN_MS, TaskerBridge.busyUntil(1_000L, 1))
+        assertEquals(
+            1_000L + 4 * TaskerBridge.REPEAT_GAP_MS + TaskerBridge.COOLDOWN_MS,
+            TaskerBridge.busyUntil(1_000L, 5),
+        )
+    }
+
+    @Test
+    fun tokensAreLongHexAndDoNotRepeat() {
+        val rng = SecureRandom()
+        val a = TaskerBridge.newToken(rng)
+        val b = TaskerBridge.newToken(rng)
+        assertTrue(a.matches(Regex("[0-9a-f]{24}")))
+        assertNotEquals(a, b)
+    }
+}
