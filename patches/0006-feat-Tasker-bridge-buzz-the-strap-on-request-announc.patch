+package com.noop.ui
+
+import android.content.ClipData
+import android.content.ClipboardManager
+import android.content.Context
+import android.os.PersistableBundle
+import androidx.compose.foundation.layout.Arrangement
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.Row
+import androidx.compose.foundation.layout.Spacer
+import androidx.compose.foundation.layout.width
+import androidx.compose.material.icons.Icons
+import androidx.compose.material.icons.filled.Bolt
+import androidx.compose.material3.ButtonDefaults
+import androidx.compose.material3.Icon
+import androidx.compose.material3.OutlinedButton
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.unit.dp
+import com.noop.R
+import com.noop.tasker.TaskerBridge
+
+/**
+ * victor:tasker — fork-added Automations card for [TaskerBridge]: the opt-in switch, the shared token
+ * (copy / rotate) and the two Tasker recipes with this build's real package name filled in.
+ */
+@Composable
+internal fun TaskerSection() {
+    val ctx = LocalContext.current
+    var enabled by remember { mutableStateOf(TaskerBridge.enabled(ctx)) }
+    var token by remember { mutableStateOf(TaskerBridge.token(ctx).orEmpty()) }
+
+    NoopCard(padding = 20.dp, tint = Palette.accent) {
+        Column(verticalArrangement = Arrangement.spacedBy(16.dp)) {
+            Column(verticalArrangement = Arrangement.spacedBy(2.dp)) {
+                Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                    Overline(uiString(R.string.victor_tasker_overline))
+                    if (enabled) Overline(uiString(R.string.victor_tasker_on), color = Palette.accent)
+                }
+                Row(verticalAlignment = Alignment.CenterVertically) {
+                    Icon(Icons.Filled.Bolt, contentDescription = null, tint = if (enabled) Palette.accent else Palette.textSecondary)
+                    Spacer(Modifier.width(10.dp))
+                    Text(uiString(R.string.victor_tasker_title), style = NoopType.title2, color = Palette.textPrimary)
+                }
+            }
+            Text(uiString(R.string.victor_tasker_blurb), style = NoopType.subhead, color = Palette.textSecondary)
+            SettingsToggleRow(
+                title = uiString(R.string.victor_tasker_toggle),
+                detail = uiString(R.string.victor_tasker_toggle_detail),
+                checked = enabled,
+                onCheckedChange = { on ->
+                    TaskerBridge.setEnabled(ctx, on)
+                    enabled = on
+                    token = TaskerBridge.token(ctx).orEmpty()
+                },
+            )
+            if (enabled) {
+                SettingsRowDivider()
+                Text(uiString(R.string.victor_tasker_token_label), style = NoopType.subhead, color = Palette.textPrimary)
+                Text(token, style = NoopType.mono, color = Palette.textPrimary)
+                Row(horizontalArrangement = Arrangement.spacedBy(12.dp)) {
+                    OutlinedButton(
+                        onClick = { copySensitive(ctx, token) },
+                        colors = ButtonDefaults.outlinedButtonColors(contentColor = Palette.accent),
+                    ) { Text(uiString(R.string.victor_tasker_copy)) }
+                    OutlinedButton(
+                        onClick = { token = TaskerBridge.regenerateToken(ctx) },
+                        colors = ButtonDefaults.outlinedButtonColors(contentColor = Palette.textSecondary),
+                    ) { Text(uiString(R.string.victor_tasker_rotate)) }
+                }
+                Text(
+                    uiString(R.string.victor_tasker_howto_buzz, TaskerBridge.ACTION_BUZZ, ctx.packageName, TaskerBridge.MAX_COUNT),
+                    style = NoopType.footnote,
+                    color = Palette.textTertiary,
+                )
+                Text(
+                    uiString(R.string.victor_tasker_howto_sync, TaskerBridge.ACTION_SYNC_FINISHED),
+                    style = NoopType.footnote,
+                    color = Palette.textTertiary,
+                )
+            }
+        }
+    }
+}
+
+/** Copy the token flagged as sensitive, so keyboard clipboard histories (Samsung, Gboard) don't keep it. */
+private fun copySensitive(ctx: Context, text: String) {
+    val clip = ClipData.newPlainText("NOOP Tasker token", text)
+    // ClipDescription.EXTRA_IS_SENSITIVE (API 33); the same key is honoured as a hint on older builds.
+    clip.description.extras = PersistableBundle().apply { putBoolean("android.content.extra.IS_SENSITIVE", true) }
+    (ctx.getSystemService(Context.CLIPBOARD_SERVICE) as? ClipboardManager)?.setPrimaryClip(clip)
+}
