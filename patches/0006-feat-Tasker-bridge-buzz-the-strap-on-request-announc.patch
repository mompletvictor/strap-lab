diff --git a/android/app/src/main/java/com/noop/tasker/TaskerBridge.kt b/android/app/src/main/java/com/noop/tasker/TaskerBridge.kt
new file mode 100644
index 000000000..e768d058f
--- /dev/null
+++ b/android/app/src/main/java/com/noop/tasker/TaskerBridge.kt
@@ -0,0 +1,119 @@
+package com.noop.tasker
+
+import android.content.Context
+import android.content.Intent
+import android.content.SharedPreferences
+import android.os.Handler
+import android.os.Looper
+import android.util.Log
+import com.noop.NoopApplication
+import java.security.MessageDigest
+import java.security.SecureRandom
+import kotlin.math.roundToInt
+
+/**
+ * victor:tasker — fork-added bridge so Tasker (or any automation app) can buzz the strap and hear when
+ * a history sync finishes. Opt-in (OFF by default) and token-gated: [TaskerBuzzReceiver] is exported,
+ * so without a shared secret any installed app could buzz the wrist.
+ *
+ *  - In:  a broadcast of [ACTION_BUZZ] to this package with extra [EXTRA_TOKEN] (and optional
+ *         [EXTRA_COUNT], 1..[MAX_COUNT] repeats of the hardware-confirmed one-shot buzz).
+ *  - Out: [ACTION_SYNC_FINISHED] after every successful offload, extras [EXTRA_SYNCED_AT] (epoch s) and
+ *         [EXTRA_BATTERY] (strap %, -1 when unknown). No health data rides it: any app can listen.
+ */
+object TaskerBridge {
+    const val ACTION_BUZZ = "com.noop.whoop.tasker.BUZZ"
+    const val ACTION_SYNC_FINISHED = "com.noop.whoop.tasker.SYNC_FINISHED"
+    const val EXTRA_TOKEN = "token"
+    const val EXTRA_COUNT = "count"
+    const val EXTRA_SYNCED_AT = "synced_at"
+    const val EXTRA_BATTERY = "battery"
+
+    const val MAX_COUNT = 5
+    /** Gap between repeated buzzes: the 5/MG one-shot is short, 2 s keeps each pulse distinct. */
+    internal const val REPEAT_GAP_MS = 2_000L
+    /** Quiet time after a sequence before another is accepted, so a looping task can't drain the strap. */
+    internal const val COOLDOWN_MS = 3_000L
+
+    private const val FILE = "noop_prefs"
+    private const val KEY_ENABLED = "victor.tasker.enabled"
+    private const val KEY_TOKEN = "victor.tasker.token"
+    private const val TAG = "NoopTasker"
+
+    // Lazy so the pure helpers below stay usable from JVM unit tests (no main Looper there).
+    private val handler by lazy { Handler(Looper.getMainLooper()) }
+    @Volatile private var busyUntilMs = 0L
+
+    private fun prefs(ctx: Context): SharedPreferences =
+        ctx.applicationContext.getSharedPreferences(FILE, Context.MODE_PRIVATE)
+
+    fun enabled(ctx: Context): Boolean = prefs(ctx).getBoolean(KEY_ENABLED, false)
+
+    fun token(ctx: Context): String? = prefs(ctx).getString(KEY_TOKEN, null)
+
+    /** Turning the bridge on mints a token the first time, so it is never on without a secret. */
+    fun setEnabled(ctx: Context, on: Boolean) {
+        val edit = prefs(ctx).edit().putBoolean(KEY_ENABLED, on)
+        if (on && token(ctx).isNullOrEmpty()) edit.putString(KEY_TOKEN, newToken())
+        edit.apply()
+    }
+
+    /** New secret; every Tasker task holding the old one stops working (the point of rotating it). */
+    fun regenerateToken(ctx: Context): String =
+        newToken().also { prefs(ctx).edit().putString(KEY_TOKEN, it).apply() }
+
+    internal fun newToken(random: SecureRandom = SecureRandom()): String =
+        ByteArray(12).also(random::nextBytes).joinToString("") { "%02x".format(it) }
+
+    /** Bridge on, a token configured, and the caller's token matches (constant-time compare). */
+    internal fun authorized(enabled: Boolean, expected: String?, given: String?): Boolean {
+        if (!enabled || expected.isNullOrEmpty() || given.isNullOrEmpty()) return false
+        return MessageDigest.isEqual(expected.toByteArray(), given.toByteArray())
+    }
+
+    /** Tasker sends `count:3` as an int or a string depending on how it was typed; accept both, clamp. */
+    internal fun parseCount(raw: Any?): Int {
+        val n = when (raw) {
+            is Number -> raw.toLong().coerceIn(Int.MIN_VALUE.toLong(), Int.MAX_VALUE.toLong()).toInt()
+            is String -> raw.trim().toIntOrNull()
+            else -> null
+        } ?: 1
+        return n.coerceIn(1, MAX_COUNT)
+    }
+
+    /** When the strap is free again after a [count]-buzz sequence starting at [nowMs]. */
+    internal fun busyUntil(nowMs: Long, count: Int): Long = nowMs + (count - 1) * REPEAT_GAP_MS + COOLDOWN_MS
+
+    internal fun handleBuzz(context: Context, intent: Intent) {
+        val app = context.applicationContext
+        if (!authorized(enabled(app), token(app), intent.getStringExtra(EXTRA_TOKEN))) {
+            Log.w(TAG, "Buzz rejected: bridge off or wrong token")
+            return
+        }
+        val now = System.currentTimeMillis()
+        if (now < busyUntilMs) {
+            Log.i(TAG, "Buzz ignored: previous request still running")
+            return
+        }
+        val ble = (app as? NoopApplication)?.ble ?: return
+        @Suppress("DEPRECATION")
+        val count = parseCount(intent.extras?.get(EXTRA_COUNT))
+        busyUntilMs = busyUntil(now, count)
+        Log.i(TAG, "Buzz accepted x$count")
+        repeat(count) { i -> handler.postDelayed({ ble.buzzStrapOnce() }, i * REPEAT_GAP_MS) }
+    }
+
+    /** Wired to WhoopBleClient's successfulOffloadSink in NoopApplication. Best-effort, never throws. */
+    fun notifySyncFinished(context: Context) {
+        val app = context.applicationContext
+        if (!enabled(app)) return
+        val battery = (app as? NoopApplication)?.ble?.state?.value?.batteryPct
+        runCatching {
+            app.sendBroadcast(
+                Intent(ACTION_SYNC_FINISHED)
+                    .putExtra(EXTRA_SYNCED_AT, System.currentTimeMillis() / 1000L)
+                    .putExtra(EXTRA_BATTERY, battery?.roundToInt() ?: -1),
+            )
+        }.onFailure { Log.w(TAG, "Sync broadcast failed", it) }
+    }
+}
