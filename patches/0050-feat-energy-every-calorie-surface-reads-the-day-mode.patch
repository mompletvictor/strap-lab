+        assertTrue(code("ui/CoupledScreen.kt").contains("DayEnergyModel.day("))
+        // Installed once, by the application.
+        assertTrue(code("NoopApplication.kt").contains("DayEnergyModel.install(this)"))
+        // The old resolver and the "Claude adds X" arithmetic are gone from the sources.
+        val stale = mainRoot().walkTopDown().filter { it.isFile && it.name.endsWith(".kt") }
+            .map { it.relativeTo(mainRoot()).path }
+            .filter { rel -> code(rel).let { it.contains("FoodEnergy.") || it.contains("TrainingEnergy.extra") || it.contains("EnergySource.") } }
+            .toList()
+        assertEquals(emptyList<String>(), stale)
+    }
