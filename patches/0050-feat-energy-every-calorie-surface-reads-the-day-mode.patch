+    // victor:energy — one energy-out figure everywhere: no screen, prompt or card reads the strap's whole-day
+    // estimate (DailyMetric.activeKcalEst) or the phone's active calories (AppleDaily.activeKcal) on its own;
+    // they reach the day model, which keeps those two as diagnostics.
+    @Test
+    fun noCalorieSurfaceReadsTheStrapOrThePhoneEstimateDirectly() {
+        val scanned = listOf("ui", "food", "ai", "weekly", "training", "day", "goals", "widget")
+        // The device arbitration screen and the Apple Health import's own screen show their sources as such.
+        val allowed = setOf("ui/DevicesScreen.kt", "ui/AppleHealthScreen.kt")
+        val offenders = scanned.flatMap { dir ->
+            File(mainRoot(), dir).walkTopDown().filter { it.isFile && it.name.endsWith(".kt") }.toList()
+        }.map { it.relativeTo(mainRoot()).path }
+            .filter { it !in allowed }
+            .filter { rel ->
+                val c = bareCode(rel)
+                // The phone's figure lives on AppleDaily rows: `.activeKcal` on anything else is the model's own field.
+                c.contains("activeKcalEst") || (c.contains("AppleDaily") || c.contains("appleDaily(")) && Regex("""\.activeKcal\b""").containsMatchIn(c)
+            }
+        assertEquals(emptyList<String>(), offenders)
+    }
