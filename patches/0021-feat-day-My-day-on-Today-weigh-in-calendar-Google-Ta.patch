@@ -0,0 +1,25 @@
+package com.noop.day
+
+import android.content.Context
+import com.noop.ui.TodayCardDismissal
+
+/**
+ * victor:day — Today without the long explainer notes ("Building your baseline…", "Live now. Your scores
+ * are building…", the carried "Latest sleep" note, "New here"). Marks them dismissed ONCE per install, so
+ * the wearer starts clean but any card restored from Updates stays restored.
+ */
+object VictorTodayQuiet {
+
+    private const val PREFS = "noop_prefs"
+    private const val KEY_DONE = "victor.today.quietCards.v1"
+
+    /** Upstream's stable Today info-card ids (TodayScreen CARD_*), the ones that are long text. */
+    internal val QUIET_CARDS = listOf("scoresBuilding", "calibratingBaseline", "carriedSleep", "newHere")
+
+    fun applyOnce(ctx: Context) {
+        val prefs = ctx.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+        if (prefs.getBoolean(KEY_DONE, false)) return
+        QUIET_CARDS.forEach { TodayCardDismissal.setDismissed(ctx, it, true) }
+        prefs.edit().putBoolean(KEY_DONE, true).apply()
+    }
+}
