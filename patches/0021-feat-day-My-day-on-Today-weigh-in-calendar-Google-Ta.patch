@@ -0,0 +1,56 @@
+package com.noop.day
+
+import android.content.Context
+import androidx.health.connect.client.HealthConnectClient
+import androidx.health.connect.client.permission.HealthPermission
+import androidx.health.connect.client.records.WeightRecord
+import androidx.health.connect.client.request.ReadRecordsRequest
+import androidx.health.connect.client.time.TimeRangeFilter
+import com.noop.ingest.HealthConnectImporter
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import java.time.Instant
+import java.time.ZoneId
+import java.time.temporal.ChronoUnit
+
+/** victor:day — the latest weigh-in and the last one from an earlier day (for the change). */
+data class DayWeight(val kg: Double, val at: Instant, val previousKg: Double?)
+
+/**
+ * victor:day — the morning weigh-in, read straight from Health Connect when Today opens, so the scale's
+ * reading (Hume → Samsung Health → Health Connect) shows without waiting for the 12-hour import. Uses the
+ * READ_WEIGHT permission the wearer already granted for the body-composition import.
+ */
+object DayWeightSource {
+
+    private const val LOOKBACK_DAYS = 14L
+
+    /** Null when Health Connect is unavailable, the permission is missing, or nothing was logged lately. */
+    suspend fun latest(ctx: Context, now: Instant = Instant.now()): DayWeight? = withContext(Dispatchers.IO) {
+        runCatching {
+            if (HealthConnectImporter.sdkStatus(ctx) != HealthConnectClient.SDK_AVAILABLE) return@runCatching null
+            val client = HealthConnectImporter.client(ctx)
+            val granted = client.permissionController.getGrantedPermissions()
+            if (HealthPermission.getReadPermission(WeightRecord::class) !in granted) return@runCatching null
+            val records = client.readRecords(
+                ReadRecordsRequest(
+                    WeightRecord::class,
+                    TimeRangeFilter.between(now.minus(LOOKBACK_DAYS, ChronoUnit.DAYS), now.plusSeconds(60)),
+                ),
+            ).records
+            summarize(records.map { it.time to it.weight.inKilograms })
+        }.getOrNull()
+    }
+
+    /**
+     * Pure. The newest plausible sample, and the newest one from an EARLIER local day (two weigh-ins the
+     * same morning are not a change).
+     */
+    internal fun summarize(samples: List<Pair<Instant, Double>>, zone: ZoneId = ZoneId.systemDefault()): DayWeight? {
+        val sorted = samples.filter { it.second.isFinite() && it.second in 20.0..400.0 }.sortedBy { it.first }
+        val last = sorted.lastOrNull() ?: return null
+        val lastDay = last.first.atZone(zone).toLocalDate()
+        val previous = sorted.lastOrNull { it.first.atZone(zone).toLocalDate() < lastDay }
+        return DayWeight(last.second, last.first, previous?.second)
+    }
+}
diff --git a/android/app/src/main/java/com/noop/day/GoogleTasks.kt b/android/app/src/main/java/com/noop/day/GoogleTasks.kt
new file mode 100644
index 000000000..6c8aa4b20
--- /dev/null
+++ b/android/app/src/main/java/com/noop/day/GoogleTasks.kt
@@ -0,0 +1,145 @@
+package com.noop.day
+
+import android.content.Context
+import com.google.android.gms.auth.api.identity.AuthorizationRequest
+import com.google.android.gms.auth.api.identity.AuthorizationResult
+import com.google.android.gms.auth.api.identity.Identity
+import com.google.android.gms.common.api.Scope
+import com.google.android.gms.tasks.Task
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.suspendCancellableCoroutine
+import kotlinx.coroutines.withContext
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import org.json.JSONObject
+import java.time.LocalDate
+import java.util.concurrent.TimeUnit
+import kotlin.coroutines.resume
+import kotlin.coroutines.resumeWithException
+
+/** victor:day — one open Google Task. [due] is the task's date (Google Tasks keeps no time), or null. */
+data class DayTask(val title: String, val due: LocalDate?, val list: String)
+
+/** What the Google Tasks block can show. */
+sealed interface TasksState {
+    /** The wearer has not connected Google Tasks. */
+    object NotConnected : TasksState
+    object Loading : TasksState
+    /** Google needs the wearer's OK again (first connection, or the grant was withdrawn). */
+    object NeedsConsent : TasksState
+    /** Open tasks due today or earlier, overdue first. */
+    data class Ready(val tasks: List<DayTask>) : TasksState
+    data class Failed(val reason: TasksError) : TasksState
+}
+
+enum class TasksError { NOT_CONFIGURED, OFFLINE, SERVER }
+
+/**
+ * victor:day — read-only Google Tasks (where Google's reminders now live too). Opt-in: nothing is asked of
+ * Google until the wearer taps Connect. The token comes from Google Play services' Authorization API
+ * (scope tasks.readonly), which needs an Android OAuth client for this package + signing certificate in
+ * the family's Google Cloud project (see LEEME); no client id or secret ships in the APK.
+ */
+object GoogleTasksSource {
+
+    const val SCOPE = "https://www.googleapis.com/auth/tasks.readonly"
+    private const val PREFS = "noop_prefs"
+    private const val KEY_CONNECTED = "victor.gtasks.connected"
+    private const val API = "https://tasks.googleapis.com/tasks/v1"
+    private const val CACHE_MS = 5 * 60 * 1000L
+
+    private val http = OkHttpClient.Builder()
+        .connectTimeout(15, TimeUnit.SECONDS)
+        .readTimeout(20, TimeUnit.SECONDS)
+        .build()
+
+    /** Last good fetch, so switching tabs does not refetch; dropped after [CACHE_MS] or on disconnect. */
+    @Volatile private var cache: Pair<Long, List<DayTask>>? = null
+
+    fun isConnected(ctx: Context): Boolean = prefs(ctx).getBoolean(KEY_CONNECTED, false)
+
+    fun setConnected(ctx: Context, on: Boolean) {
+        prefs(ctx).edit().putBoolean(KEY_CONNECTED, on).apply()
+        if (!on) cache = null
+    }
+
+    fun request(): AuthorizationRequest =
+        AuthorizationRequest.builder().setRequestedScopes(listOf(Scope(SCOPE))).build()
+
+    /** Ask Play services for a token; the result either has one or carries the consent screen to launch. */
+    suspend fun authorize(ctx: Context): AuthorizationResult =
+        Identity.getAuthorizationClient(ctx).authorize(request()).await()
+
+    /** A fresh cached list, or null when it has to be fetched. */
+    fun cached(): List<DayTask>? = cache?.takeIf { System.currentTimeMillis() - it.first < CACHE_MS }?.second
+
+    /** Every open task of every list, then [forDay]. Throws on HTTP/network failure. */
+    suspend fun fetch(token: String, today: LocalDate = LocalDate.now()): List<DayTask> = withContext(Dispatchers.IO) {
+        val all = ArrayList<DayTask>()
+        for ((id, title) in parseLists(get("$API/users/@me/lists", token, mapOf("maxResults" to "100")))) {
+            var page: String? = null
+            do {
+                val params = mutableMapOf("showCompleted" to "false", "showHidden" to "false", "maxResults" to "100")
+                page?.let { params["pageToken"] = it }
+                val (tasks, next) = parseTasks(get("$API/lists/$id/tasks", token, params), title)
+                all += tasks
+                page = next
+            } while (page != null)
+        }
+        forDay(all, today).also { cache = System.currentTimeMillis() to it }
+    }
+
+    /** Thrown for a non-2xx answer; 401/403 mean the token or the grant is no longer good. */
+    class HttpError(val code: Int) : Exception("HTTP $code")
+
+    private fun get(url: String, token: String, params: Map<String, String>): String {
+        val full = url.toHttpUrl().newBuilder().apply { params.forEach { (k, v) -> addQueryParameter(k, v) } }.build()
+        val req = Request.Builder().url(full).header("Authorization", "Bearer $token").build()
+        http.newCall(req).execute().use { resp ->
+            val body = resp.body?.string().orEmpty()
+            if (!resp.isSuccessful) throw HttpError(resp.code)
+            return body
+        }
+    }
+
+    // MARK: - Pure
+
+    /** (id, title) of each task list. */
+    internal fun parseLists(json: String): List<Pair<String, String>> {
+        val items = JSONObject(json).optJSONArray("items") ?: return emptyList()
+        return (0 until items.length()).mapNotNull { i ->
+            val o = items.optJSONObject(i) ?: return@mapNotNull null
+            val id = o.optString("id").takeIf { it.isNotBlank() } ?: return@mapNotNull null
+            id to o.optString("title")
+        }
+    }
+
+    /** One page of a list: its open, titled tasks and the next page token. */
+    internal fun parseTasks(json: String, list: String): Pair<List<DayTask>, String?> {
+        val root = JSONObject(json)
+        val items = root.optJSONArray("items")
+        val tasks = if (items == null) emptyList() else (0 until items.length()).mapNotNull { i ->
+            val o = items.optJSONObject(i) ?: return@mapNotNull null
+            if (o.optBoolean("deleted") || o.optString("status") == "completed") return@mapNotNull null
+            val title = o.optString("title").trim().takeIf { it.isNotEmpty() } ?: return@mapNotNull null
+            // "2026-10-17T00:00:00.000Z": Google stores the date only; the time part is always midnight UTC.
+            val due = o.optString("due").takeIf { it.length >= 10 }?.let { runCatching { LocalDate.parse(it.substring(0, 10)) }.getOrNull() }
+            DayTask(title, due, list)
+        }
+        return tasks to root.optString("nextPageToken").takeIf { it.isNotBlank() }
+    }
+
+    /** What is for [today]: due today or overdue, oldest due first, then by title. Undated ones wait. */
+    internal fun forDay(tasks: List<DayTask>, today: LocalDate): List<DayTask> =
+        tasks.filter { it.due != null && !it.due.isAfter(today) }
+            .sortedWith(compareBy<DayTask> { it.due }.thenBy { it.title.lowercase() })
+
+    private fun prefs(ctx: Context) = ctx.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+}
+
+private suspend fun <T> Task<T>.await(): T = suspendCancellableCoroutine { cont ->
+    addOnSuccessListener { cont.resume(it) }
+    addOnFailureListener { cont.resumeWithException(it) }
+    addOnCanceledListener { cont.cancel() }
+}
diff --git a/android/app/src/main/java/com/noop/day/TodayMyDaySection.kt b/android/app/src/main/java/com/noop/day/TodayMyDaySection.kt
new file mode 100644
