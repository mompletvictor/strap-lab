--- /dev/null
+++ b/android/app/src/main/java/com/noop/day/TodayMyDaySection.kt
@@ -0,0 +1,310 @@
+package com.noop.day
+
+import android.Manifest
+import android.app.Activity
+import android.content.ActivityNotFoundException
+import android.content.Context
+import android.content.Intent
+import android.net.Uri
+import android.provider.CalendarContract
+import android.text.format.DateFormat
+import androidx.activity.compose.rememberLauncherForActivityResult
+import androidx.activity.result.IntentSenderRequest
+import androidx.activity.result.contract.ActivityResultContracts
+import androidx.compose.foundation.ExperimentalFoundationApi
+import androidx.compose.foundation.clickable
+import androidx.compose.foundation.combinedClickable
+import androidx.compose.foundation.layout.Arrangement
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.Row
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.size
+import androidx.compose.foundation.layout.width
+import androidx.compose.material.icons.Icons
+import androidx.compose.material.icons.outlined.Event
+import androidx.compose.material.icons.outlined.MonitorWeight
+import androidx.compose.material.icons.outlined.TaskAlt
+import androidx.compose.material3.AlertDialog
+import androidx.compose.material3.CircularProgressIndicator
+import androidx.compose.material3.Icon
+import androidx.compose.material3.Text
+import androidx.compose.material3.TextButton
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableIntStateOf
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.produceState
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberCoroutineScope
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.vector.ImageVector
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.text.style.TextOverflow
+import androidx.compose.ui.unit.dp
+import androidx.lifecycle.compose.LifecycleResumeEffect
+import com.google.android.gms.auth.api.identity.Identity
+import com.google.android.gms.common.api.ApiException
+import com.google.android.gms.common.api.CommonStatusCodes
+import com.noop.R
+import com.noop.ui.Metrics
+import com.noop.ui.NoopCard
+import com.noop.ui.NoopType
+import com.noop.ui.Overline
+import com.noop.ui.Palette
+import com.noop.ui.uiString
+import kotlinx.coroutines.launch
+import java.io.IOException
+import java.time.LocalDate
+import java.time.ZoneId
+import java.util.Date
+import java.util.Locale
+import kotlin.math.abs
+
+private const val MAX_EVENTS = 5
+private const val MAX_TASKS = 6
+
+/**
+ * victor:day — "Mi día" at the top of Today: this morning's weigh-in, today's calendar and the Google
+ * Tasks due today. Each block shows only once it has something (or a one-tap way to switch it on); the
+ * weight and agenda re-read every time the app comes back to the front, so stepping off the scale and
+ * opening NOOP is enough. Registered by a one-line hook in TodayScreen.
+ */
+@Composable
+internal fun TodayMyDaySection() {
+    val ctx = LocalContext.current
+    val scope = rememberCoroutineScope()
+    var resumes by remember { mutableIntStateOf(0) }
+    LifecycleResumeEffect(Unit) {
+        resumes++
+        onPauseOrDispose { }
+    }
+
+    val weight by produceState<DayWeight?>(null, resumes) { value = DayWeightSource.latest(ctx) }
+
+    var calendarAllowed by remember { mutableStateOf(DayAgendaSource.hasPermission(ctx)) }
+    val calendarPermission = rememberLauncherForActivityResult(ActivityResultContracts.RequestPermission()) { granted ->
+        calendarAllowed = granted
+    }
+    val agenda by produceState(emptyList<AgendaEvent>(), calendarAllowed, resumes) {
+        value = if (calendarAllowed) DayAgendaSource.today(ctx) else emptyList()
+    }
+
+    var tasks by remember {
+        mutableStateOf(
+            if (!GoogleTasksSource.isConnected(ctx)) TasksState.NotConnected
+            else GoogleTasksSource.cached()?.let { TasksState.Ready(it) } ?: TasksState.Loading,
+        )
+    }
+    suspend fun load(token: String) {
+        tasks = try {
+            TasksState.Ready(GoogleTasksSource.fetch(token))
+        } catch (e: GoogleTasksSource.HttpError) {
+            if (e.code == 401 || e.code == 403) TasksState.NeedsConsent else TasksState.Failed(TasksError.SERVER)
+        } catch (e: IOException) {
+            TasksState.Failed(TasksError.OFFLINE)
+        }
+    }
+    val consent = rememberLauncherForActivityResult(ActivityResultContracts.StartIntentSenderForResult()) { res ->
+        val token = if (res.resultCode == Activity.RESULT_OK) {
+            runCatching { Identity.getAuthorizationClient(ctx).getAuthorizationResultFromIntent(res.data).accessToken }.getOrNull()
+        } else {
+            null
+        }
+        if (token != null) {
+            GoogleTasksSource.setConnected(ctx, true)
+            scope.launch { load(token) }
+        } else {
+            tasks = if (GoogleTasksSource.isConnected(ctx)) TasksState.NeedsConsent else TasksState.NotConnected
+        }
+    }
+    /** [interactive]: a tap may open Google's consent screen; on open it only uses an existing grant. */
+    fun connect(interactive: Boolean) = scope.launch {
+        tasks = TasksState.Loading
+        val result = try {
+            GoogleTasksSource.authorize(ctx)
+        } catch (e: ApiException) {
+            tasks = TasksState.Failed(if (e.statusCode == CommonStatusCodes.DEVELOPER_ERROR) TasksError.NOT_CONFIGURED else TasksError.SERVER)
+            return@launch
+        } catch (e: Exception) {
+            tasks = TasksState.Failed(TasksError.SERVER)
+            return@launch
+        }
+        val pending = result.pendingIntent
+        when {
+            result.hasResolution() && pending != null ->
+                if (interactive) consent.launch(IntentSenderRequest.Builder(pending.intentSender).build())
+                else tasks = TasksState.NeedsConsent
+            result.accessToken != null -> {
+                GoogleTasksSource.setConnected(ctx, true)
+                load(result.accessToken!!)
+            }
+            else -> tasks = TasksState.Failed(TasksError.SERVER)
+        }
+    }
+    LaunchedEffect(resumes) {
+        if (GoogleTasksSource.isConnected(ctx) && GoogleTasksSource.cached() == null) connect(interactive = false)
+    }
+    var confirmDisconnect by remember { mutableStateOf(false) }
+
+    NoopCard(tint = Palette.accent) {
+        Column(verticalArrangement = Arrangement.spacedBy(Metrics.space12)) {
+            Overline(uiString(R.string.victor_day_title))
+            weight?.let { WeightRow(it) }
+            Block(Icons.Outlined.Event, onClick = { openCalendar(ctx) }) {
+                when {
+                    !calendarAllowed -> Action(uiString(R.string.victor_day_calendar_allow)) {
+                        calendarPermission.launch(Manifest.permission.READ_CALENDAR)
+                    }
+                    agenda.isEmpty() -> Quiet(uiString(R.string.victor_day_calendar_empty))
+                    else -> AgendaLines(agenda)
+                }
+            }
+            Block(
+                Icons.Outlined.TaskAlt,
+                onClick = { openTasks(ctx) },
+                onLongClick = { if (GoogleTasksSource.isConnected(ctx)) confirmDisconnect = true },
+            ) {
+                when (val t = tasks) {
+                    TasksState.NotConnected -> Action(uiString(R.string.victor_day_tasks_connect)) { connect(interactive = true) }
+                    TasksState.NeedsConsent -> Action(uiString(R.string.victor_day_tasks_reconnect)) { connect(interactive = true) }
+                    TasksState.Loading -> CircularProgressIndicator(color = Palette.accent, strokeWidth = 2.dp, modifier = Modifier.size(18.dp))
+                    is TasksState.Ready -> if (t.tasks.isEmpty()) Quiet(uiString(R.string.victor_day_tasks_empty)) else TaskLines(t.tasks)
+                    is TasksState.Failed -> Quiet(
+                        uiString(
+                            when (t.reason) {
+                                TasksError.NOT_CONFIGURED -> R.string.victor_day_tasks_not_configured
+                                TasksError.OFFLINE -> R.string.victor_day_tasks_offline
+                                TasksError.SERVER -> R.string.victor_day_tasks_failed
+                            },
+                        ),
+                    )
+                }
+            }
+        }
+    }
+
+    if (confirmDisconnect) {
+        AlertDialog(
+            onDismissRequest = { confirmDisconnect = false },
+            containerColor = Palette.surfaceOverlay,
+            title = { Text(uiString(R.string.victor_day_tasks_disconnect_title), style = NoopType.title2, color = Palette.textPrimary) },
+            text = { Text(uiString(R.string.victor_day_tasks_disconnect_body), style = NoopType.subhead, color = Palette.textSecondary) },
+            confirmButton = {
+                TextButton(onClick = {
+                    GoogleTasksSource.setConnected(ctx, false)
+                    tasks = TasksState.NotConnected
+                    confirmDisconnect = false
+                }) { Text(uiString(R.string.victor_day_disconnect), style = NoopType.body, color = Palette.statusCritical) }
+            },
+            dismissButton = {
+                TextButton(onClick = { confirmDisconnect = false }) {
+                    Text(uiString(R.string.victor_day_cancel), style = NoopType.body, color = Palette.textSecondary)
+                }
+            },
+        )
+    }
+}
+
+@Composable
+private fun WeightRow(w: DayWeight) {
+    val ctx = LocalContext.current
+    val locale = Locale.getDefault()
+    val day = w.at.atZone(ZoneId.systemDefault()).toLocalDate()
+    val today = LocalDate.now()
+    val stamp = when (day) {
+        today -> uiString(R.string.victor_day_weight_today, DateFormat.getTimeFormat(ctx).format(Date(w.at.toEpochMilli())))
+        today.minusDays(1) -> uiString(R.string.victor_day_weight_yesterday)
+        else -> uiString(R.string.victor_day_weight_on, day.format(java.time.format.DateTimeFormatter.ofPattern("d MMM", locale)))
+    }
+    Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(Metrics.space12)) {
+        Icon(Icons.Outlined.MonitorWeight, contentDescription = null, tint = Palette.accent, modifier = Modifier.size(Metrics.iconSmall))
+        Text(uiString(R.string.victor_day_kg, String.format(locale, "%.1f", w.kg)), style = NoopType.headline, color = Palette.textPrimary)
+        val change = w.previousKg?.let { w.kg - it }
+        val parts = listOfNotNull(stamp, change?.takeIf { abs(it) >= 0.05 }?.let { (if (it > 0) "+" else "−") + String.format(locale, "%.1f", abs(it)) })
+        Text(parts.joinToString(" · "), style = NoopType.subhead, color = Palette.textSecondary)
+    }
+}
+
+@Composable
+private fun AgendaLines(events: List<AgendaEvent>) {
+    val ctx = LocalContext.current
+    val now = System.currentTimeMillis()
+    val fmt = remember { DateFormat.getTimeFormat(ctx) }
+    Column(verticalArrangement = Arrangement.spacedBy(Metrics.space6)) {
+        events.take(MAX_EVENTS).forEach { e ->
+            val past = !e.allDay && e.end < now
+            Row(horizontalArrangement = Arrangement.spacedBy(Metrics.space8)) {
+                // An all-day entry simply has no time: the empty column says it, no extra words.
+                Text(
+                    if (e.allDay) "" else fmt.format(Date(e.begin)),
+                    style = NoopType.bodyNumber,
+                    color = if (past) Palette.textTertiary else Palette.textSecondary,
+                    maxLines = 1,
+                    modifier = Modifier.width(72.dp),
+                )
+                Text(
+                    e.title.ifBlank { "—" },
+                    style = NoopType.body,
+                    color = if (past) Palette.textTertiary else Palette.textPrimary,
+                    maxLines = 1,
+                    overflow = TextOverflow.Ellipsis,
+                )
+            }
+        }
+        if (events.size > MAX_EVENTS) Quiet(uiString(R.string.victor_day_more, events.size - MAX_EVENTS))
+    }
+}
+
+@Composable
+private fun TaskLines(tasks: List<DayTask>) {
+    val today = LocalDate.now()
+    Column(verticalArrangement = Arrangement.spacedBy(Metrics.space6)) {
+        tasks.take(MAX_TASKS).forEach { t ->
+            Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(Metrics.space8)) {
+                Text(t.title, style = NoopType.body, color = Palette.textPrimary, maxLines = 1, overflow = TextOverflow.Ellipsis, modifier = Modifier.weight(1f, fill = false))
+                if (t.due != null && t.due.isBefore(today)) {
+                    Text(uiString(R.string.victor_day_tasks_overdue), style = NoopType.subhead, color = Palette.statusWarning)
+                }
+            }
+        }
+        if (tasks.size > MAX_TASKS) Quiet(uiString(R.string.victor_day_more, tasks.size - MAX_TASKS))
+    }
+}
+
+@OptIn(ExperimentalFoundationApi::class)
+@Composable
+private fun Block(icon: ImageVector, onClick: () -> Unit, onLongClick: (() -> Unit)? = null, content: @Composable () -> Unit) {
+    Row(
+        modifier = Modifier.fillMaxWidth().combinedClickable(onClick = onClick, onLongClick = onLongClick),
+        horizontalArrangement = Arrangement.spacedBy(Metrics.space12),
+    ) {
+        Icon(icon, contentDescription = null, tint = Palette.accent, modifier = Modifier.size(Metrics.iconSmall))
+        Column(Modifier.weight(1f)) { content() }
+    }
+}
+
+@Composable
+private fun Quiet(text: String) = Text(text, style = NoopType.subhead, color = Palette.textSecondary)
+
+/** A one-tap switch-on, sized like a line of the card rather than a button. */
+@Composable
+private fun Action(text: String, onClick: () -> Unit) =
+    Text(text, style = NoopType.headline, color = Palette.accent, modifier = Modifier.clickable(onClick = onClick))
+
+private fun openCalendar(ctx: Context) {
+    val uri = CalendarContract.CONTENT_URI.buildUpon().appendPath("time").appendPath(System.currentTimeMillis().toString()).build()
+    tryStart(ctx, Intent(Intent.ACTION_VIEW, uri))
+}
+
+private fun openTasks(ctx: Context) = tryStart(ctx, Intent(Intent.ACTION_VIEW, Uri.parse("https://tasks.google.com/")))
+
+private fun tryStart(ctx: Context, intent: Intent) {
+    try {
+        ctx.startActivity(intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK))
+    } catch (_: ActivityNotFoundException) {
+    } catch (_: SecurityException) {
+    }
+}
