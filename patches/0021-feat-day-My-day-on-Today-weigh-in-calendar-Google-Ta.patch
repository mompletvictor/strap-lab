diff --git a/android/app/src/main/java/com/noop/day/DayAgenda.kt b/android/app/src/main/java/com/noop/day/DayAgenda.kt
new file mode 100644
index 000000000..8f1f01b87
--- /dev/null
+++ b/android/app/src/main/java/com/noop/day/DayAgenda.kt
@@ -0,0 +1,80 @@
+package com.noop.day
+
+import android.Manifest
+import android.content.ContentUris
+import android.content.Context
+import android.content.pm.PackageManager
+import android.provider.CalendarContract
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import java.time.Instant
+import java.time.LocalDate
+import java.time.ZoneId
+import java.time.ZoneOffset
+
+/** victor:day — one calendar entry of today. [begin]/[end] are epoch ms; all-day ones are UTC midnights. */
+data class AgendaEvent(val title: String, val begin: Long, val end: Long, val allDay: Boolean)
+
+/**
+ * victor:day — today's agenda from the phone's own calendar store (CalendarContract): every calendar the
+ * wearer shows in their calendar app, Google Calendar included, with no sign-in and nothing sent anywhere.
+ */
+object DayAgendaSource {
+
+    fun hasPermission(ctx: Context): Boolean =
+        ctx.checkSelfPermission(Manifest.permission.READ_CALENDAR) == PackageManager.PERMISSION_GRANTED
+
+    /** Today's events of visible calendars, not declined, in [inDayOrder]. Empty without the permission. */
+    suspend fun today(ctx: Context, day: LocalDate = LocalDate.now(), zone: ZoneId = ZoneId.systemDefault()): List<AgendaEvent> =
+        withContext(Dispatchers.IO) {
+            if (!hasPermission(ctx)) return@withContext emptyList()
+            val start = day.atStartOfDay(zone).toInstant().toEpochMilli()
+            val end = day.plusDays(1).atStartOfDay(zone).toInstant().toEpochMilli()
+            val uri = CalendarContract.Instances.CONTENT_URI.buildUpon().also {
+                ContentUris.appendId(it, start)
+                ContentUris.appendId(it, end)
+            }.build()
+            val projection = arrayOf(
+                CalendarContract.Instances.TITLE,
+                CalendarContract.Instances.BEGIN,
+                CalendarContract.Instances.END,
+                CalendarContract.Instances.ALL_DAY,
+            )
+            val selection = "${CalendarContract.Instances.VISIBLE} = 1 AND " +
+                "${CalendarContract.Instances.SELF_ATTENDEE_STATUS} != ${CalendarContract.Attendees.ATTENDEE_STATUS_DECLINED}"
+            val events = ArrayList<AgendaEvent>()
+            runCatching {
+                ctx.contentResolver.query(uri, projection, selection, null, "${CalendarContract.Instances.BEGIN} ASC")?.use { c ->
+                    while (c.moveToNext()) {
+                        events += AgendaEvent(
+                            title = c.getString(0)?.trim().orEmpty(),
+                            begin = c.getLong(1),
+                            end = c.getLong(2),
+                            allDay = c.getInt(3) == 1,
+                        )
+                    }
+                }
+            }
+            inDayOrder(events.filter { isOnDay(it, day, zone) })
+        }
+
+    /**
+     * Pure. A timed event belongs to [day] when it overlaps the local day. An all-day event is stored as UTC
+     * midnights, so it belongs when [day] falls in its UTC date range (the Instances window, being local,
+     * would otherwise also return yesterday's all-day events east of UTC).
+     */
+    internal fun isOnDay(e: AgendaEvent, day: LocalDate, zone: ZoneId): Boolean {
+        if (e.allDay) {
+            val from = Instant.ofEpochMilli(e.begin).atOffset(ZoneOffset.UTC).toLocalDate()
+            val until = Instant.ofEpochMilli(e.end).atOffset(ZoneOffset.UTC).toLocalDate()
+            return !day.isBefore(from) && day.isBefore(maxOf(until, from.plusDays(1)))
+        }
+        val start = day.atStartOfDay(zone).toInstant().toEpochMilli()
+        val end = day.plusDays(1).atStartOfDay(zone).toInstant().toEpochMilli()
+        return e.begin < end && (e.end > start || e.begin >= start)
+    }
+
+    /** Pure. All-day entries first, then by start time; untitled ones keep their place. */
+    internal fun inDayOrder(events: List<AgendaEvent>): List<AgendaEvent> =
+        events.sortedWith(compareBy<AgendaEvent> { !it.allDay }.thenBy { it.begin }.thenBy { it.title })
+}
diff --git a/android/app/src/main/java/com/noop/day/DayWeight.kt b/android/app/src/main/java/com/noop/day/DayWeight.kt
