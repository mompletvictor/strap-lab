diff --git a/android/app/src/test/java/com/noop/day/MyDayTest.kt b/android/app/src/test/java/com/noop/day/MyDayTest.kt
new file mode 100644
index 000000000..4b2243673
--- /dev/null
+++ b/android/app/src/test/java/com/noop/day/MyDayTest.kt
@@ -0,0 +1,128 @@
+package com.noop.day
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+import java.time.Instant
+import java.time.LocalDate
+import java.time.ZoneId
+
+/** victor:day — the "Mi día" card's pure parts: which calendar entries are today, weigh-ins, Google Tasks. */
+class MyDayTest {
+
+    private val madrid = ZoneId.of("Europe/Madrid")
+    private val day = LocalDate.of(2026, 10, 17)
+    private fun at(h: Int, m: Int = 0, d: LocalDate = day) = d.atTime(h, m).atZone(madrid).toInstant().toEpochMilli()
+    private fun utcMidnight(d: LocalDate) = d.atStartOfDay(ZoneId.of("UTC")).toInstant().toEpochMilli()
+
+    // MARK: - Agenda
+
+    @Test
+    fun timedEventsOverlappingTheLocalDayAreToday() {
+        assertTrue(DayAgendaSource.isOnDay(AgendaEvent("Gym", at(9), at(10), false), day, madrid))
+        // Started last night, still running after midnight.
+        assertTrue(DayAgendaSource.isOnDay(AgendaEvent("Late", at(23, d = day.minusDays(1)), at(1), false), day, madrid))
+        // Ended exactly at midnight: yesterday's.
+        assertFalse(DayAgendaSource.isOnDay(AgendaEvent("Cena", at(22, d = day.minusDays(1)), at(0), false), day, madrid))
+        assertFalse(DayAgendaSource.isOnDay(AgendaEvent("Mañana", at(9, d = day.plusDays(1)), at(10, d = day.plusDays(1)), false), day, madrid))
+    }
+
+    @Test
+    fun allDayEventsUseTheirUtcDatesNotTheLocalWindow() {
+        val today = AgendaEvent("Cumple de Isa", utcMidnight(day), utcMidnight(day.plusDays(1)), true)
+        val yesterday = AgendaEvent("Ayer", utcMidnight(day.minusDays(1)), utcMidnight(day), true)
+        val trip = AgendaEvent("Viaje", utcMidnight(day.minusDays(2)), utcMidnight(day.plusDays(2)), true)
+        assertTrue(DayAgendaSource.isOnDay(today, day, madrid))
+        assertFalse("UTC+2 overlaps yesterday's all-day event by two hours", DayAgendaSource.isOnDay(yesterday, day, madrid))
+        assertTrue(DayAgendaSource.isOnDay(trip, day, madrid))
+    }
+
+    @Test
+    fun allDayFirstThenByStart() {
+        val ordered = DayAgendaSource.inDayOrder(
+            listOf(
+                AgendaEvent("B", at(13), at(14), false),
+                AgendaEvent("Festivo", utcMidnight(day), utcMidnight(day.plusDays(1)), true),
+                AgendaEvent("A", at(9), at(10), false),
+            ),
+        )
+        assertEquals(listOf("Festivo", "A", "B"), ordered.map { it.title })
+    }
+
+    // MARK: - Weigh-in
+
+    @Test
+    fun latestWeighInAndTheChangeFromAnEarlierDay() {
+        fun i(d: LocalDate, h: Int) = d.atTime(h, 0).atZone(madrid).toInstant()
+        val w = DayWeightSource.summarize(
+            listOf(
+                i(day.minusDays(2), 7) to 79.0,
+                i(day.minusDays(1), 7) to 78.7,
+                i(day, 7) to 78.5,
+                i(day, 8) to 78.4, // second weigh-in the same morning: still compared with yesterday
+                i(day, 9) to Double.NaN,
+                i(day, 10) to 4.0, // a child on the scale, or a bad reading
+            ),
+            madrid,
+        )!!
+        assertEquals(78.4, w.kg, 0.0)
+        assertEquals(78.7, w.previousKg!!, 0.0)
+        assertEquals(i(day, 8), w.at)
+        assertNull(DayWeightSource.summarize(emptyList(), madrid))
+        assertNull(DayWeightSource.summarize(listOf(Instant.now() to 78.0), madrid)!!.previousKg)
+    }
+
+    // MARK: - Google Tasks
+
+    @Test
+    fun parsesListsAndOnlyOpenTitledTasks() {
+        assertEquals(
+            listOf("L1" to "Mis tareas", "L2" to "Casa"),
+            GoogleTasksSource.parseLists("""{"items":[{"id":"L1","title":"Mis tareas"},{"id":"L2","title":"Casa"},{"title":"sin id"}]}"""),
+        )
+        val (tasks, next) = GoogleTasksSource.parseTasks(
+            """{"nextPageToken":"p2","items":[
+              {"title":"Llamar a la gestoría","due":"2026-10-17T00:00:00.000Z","status":"needsAction"},
+              {"title":"Hecha","due":"2026-10-17T00:00:00.000Z","status":"completed"},
+              {"title":"Borrada","deleted":true},
+              {"title":"  "},
+              {"title":"Sin fecha","status":"needsAction"}]}""",
+            "Mis tareas",
+        )
+        assertEquals("p2", next)
+        assertEquals(
+            listOf(DayTask("Llamar a la gestoría", day, "Mis tareas"), DayTask("Sin fecha", null, "Mis tareas")),
+            tasks,
+        )
+        assertNull(GoogleTasksSource.parseTasks("""{"kind":"tasks#tasks"}""", "x").second)
+    }
+
+    @Test
+    fun todayMeansDueTodayOrOverdueOldestFirst() {
+        val all = listOf(
+            DayTask("mañana", day.plusDays(1), "L"),
+            DayTask("hoy b", day, "L"),
+            DayTask("Hoy a", day, "L"),
+            DayTask("vencida", day.minusDays(3), "L"),
+            DayTask("sin fecha", null, "L"),
+        )
+        assertEquals(listOf("vencida", "Hoy a", "hoy b"), GoogleTasksSource.forDay(all, day).map { it.title })
+    }
+
+    // MARK: - Quiet Today
+
+    @Test
+    fun quietCardIdsStillExistInTodayScreen() {
+        // The ids are upstream's private CARD_* constants; if upstream renames one, this fails instead of the
+        // card silently coming back.
+        val userDir = File(System.getProperty("user.dir") ?: ".")
+        val today = listOf("src", "app/src", "android/app/src")
+            .map { File(userDir, "$it/main/java/com/noop/ui/TodayScreen.kt") }
+            .first { it.exists() }
+            .readText()
+        for (id in VictorTodayQuiet.QUIET_CARDS) assertTrue(id, today.contains("= \"$id\""))
+    }
+}
