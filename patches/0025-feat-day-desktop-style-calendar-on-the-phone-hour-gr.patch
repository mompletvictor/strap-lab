+    /** One timed event placed in a day's column: minutes from midnight, and its side-by-side lane. */
+    internal data class Placed(val event: AgendaEvent, val startMin: Int, val endMin: Int, val lane: Int, val lanes: Int)
+
+    /**
+     * Pure. The timed events of [day] laid out for a time grid: clipped to the day, at least
+     * [minMinutes] tall so a short one stays tappable, and overlapping ones side by side (each cluster of
+     * overlaps shares its width equally).
+     */
+    internal fun layoutDay(events: List<AgendaEvent>, day: LocalDate, zone: ZoneId, minMinutes: Int = 20): List<Placed> {
+        val dayStart = day.atStartOfDay(zone).toInstant().toEpochMilli()
+        val spans = events.filter { !it.allDay && isOnDay(it, day, zone) }
+            .map { e ->
+                val s = ((maxOf(e.begin, dayStart) - dayStart) / 60_000L).toInt().coerceIn(0, 24 * 60)
+                val end = ((minOf(e.end, dayStart + 86_400_000L) - dayStart) / 60_000L).toInt().coerceIn(0, 24 * 60)
+                Triple(e, s, maxOf(end, minOf(s + minMinutes, 24 * 60)))
+            }
+            .sortedWith(compareBy<Triple<AgendaEvent, Int, Int>> { it.second }.thenByDescending { it.third })
+        val out = ArrayList<Placed>(spans.size)
+        var cluster = ArrayList<Pair<Triple<AgendaEvent, Int, Int>, Int>>()
+        var clusterEnd = -1
+        fun flush() {
+            val lanes = (cluster.maxOfOrNull { it.second } ?: -1) + 1
+            cluster.forEach { (t, lane) -> out += Placed(t.first, t.second, t.third, lane, lanes) }
+            cluster = ArrayList()
+        }
+        val laneEnds = ArrayList<Int>()
+        for (t in spans) {
+            if (t.second >= clusterEnd) {
+                flush()
+                laneEnds.clear()
+            }
+            val lane = laneEnds.indexOfFirst { it <= t.second }.takeIf { it >= 0 } ?: laneEnds.size.also { laneEnds += 0 }
+            laneEnds[lane] = t.third
+            cluster += t to lane
+            clusterEnd = maxOf(clusterEnd, t.third)
+        }
+        flush()
+        return out
+    }
+
     /** Pure. All-day entries first, then by start time; untitled ones keep their place. */
     internal fun inDayOrder(events: List<AgendaEvent>): List<AgendaEvent> =
         events.sortedWith(compareBy<AgendaEvent> { !it.allDay }.thenBy { it.begin }.thenBy { it.title })
