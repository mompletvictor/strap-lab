+/** victor:day — tiny text for chips inside week columns and month cells. */
+private val ChipText = NoopType.footnote.copy(fontSize = 10.sp, lineHeight = 12.sp)
+
+/** The event's own calendar colour, or the accent when the calendar has none. */
+@Composable
+internal fun eventColor(e: AgendaEvent): Color = e.color?.let { Color(it) } ?: Palette.accent
+
+/** A one-line chip: a calendar event (its colour) or a task (an empty circle, like a reminder). */
+@Composable
+internal fun CalendarChip(text: String, color: Color?, task: Boolean, tiny: Boolean, modifier: Modifier = Modifier) {
+    Row(
+        verticalAlignment = Alignment.CenterVertically,
+        horizontalArrangement = Arrangement.spacedBy(3.dp),
+        modifier = modifier
+            .fillMaxWidth()
+            .clip(RoundedCornerShape(4.dp))
+            .background(if (task) Palette.surfaceInset else (color ?: Palette.accent).copy(alpha = 0.28f))
+            .padding(horizontal = 3.dp, vertical = if (tiny) 1.dp else 3.dp),
+    ) {
+        if (task) {
+            Box(Modifier.size(if (tiny) 7.dp else 10.dp).border(1.5.dp, Palette.statusWarning, CircleShape))
+        }
+        Text(
+            text,
+            style = if (tiny) ChipText else NoopType.subhead,
+            color = Palette.textPrimary,
+            maxLines = 1,
+            overflow = if (tiny) TextOverflow.Clip else TextOverflow.Ellipsis,
+        )
+    }
+}
