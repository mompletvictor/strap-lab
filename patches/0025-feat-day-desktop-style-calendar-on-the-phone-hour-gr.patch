+/** victor:day — the week's day names and numbers over its columns; today circled, tap to open the day. */
+@Composable
+internal fun WeekHeader(days: List<LocalDate>, today: LocalDate, locale: Locale, onDayClick: (LocalDate) -> Unit) {
+    Row(Modifier.fillMaxWidth()) {
