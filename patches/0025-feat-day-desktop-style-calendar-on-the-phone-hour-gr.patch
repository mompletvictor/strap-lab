 /**
- * victor:day — the month at a glance: a dot under a day with calendar events (accent) and one for tasks
- * due (warning). Tapping a day shows its list underneath.
+ * victor:day — the hours of one or several days side by side, like a desktop calendar: each timed event
+ * a block in its calendar's colour, overlaps split side by side, and a line at the current time in
+ * today's column. Scrolls inside [height], opening an hour before now.
+ */
+@Composable
+internal fun TimeGrid(days: List<LocalDate>, events: Map<LocalDate, List<AgendaEvent>>, today: LocalDate, height: Dp, onDayClick: (LocalDate) -> Unit) {
+    val ctx = LocalContext.current
+    val density = LocalDensity.current
+    val scroll = rememberScrollState()
+    val zone = ZoneId.systemDefault()
+    val is24 = remember { DateFormat.is24HourFormat(ctx) }
+    LaunchedEffect(days.first()) {
+        val h = (LocalTime.now().hour - 1).coerceIn(0, 23)
+        scroll.scrollTo(with(density) { (HourHeight * h).roundToPx() })
+    }
+    val lineColor = Palette.hairline
+    Box(Modifier.fillMaxWidth().height(height).verticalScroll(scroll)) {
+        Row(Modifier.fillMaxWidth().height(HourHeight * 24)) {
+            Column(Modifier.width(HourLabelWidth)) {
+                for (h in 0 until 24) {
+                    Box(Modifier.height(HourHeight)) {
+                        Text(
+                            if (is24) "%02d:00".format(h) else LocalTime.of(h, 0).format(java.time.format.DateTimeFormatter.ofPattern("h a")),
+                            style = NoopType.footnote,
+                            color = Palette.textTertiary,
+                        )
+                    }
+                }
+            }
+            days.forEach { day ->
+                val placed = remember(events[day], day) { DayAgendaSource.layoutDay(events[day].orEmpty(), day, zone) }
+                BoxWithConstraints(Modifier.weight(1f).fillMaxHeight().clickable { onDayClick(day) }) {
+                    val colW = maxWidth
+                    Canvas(Modifier.matchParentSize()) {
+                        val hh = HourHeight.toPx()
+                        for (h in 0..24) drawLine(lineColor, Offset(0f, h * hh), Offset(size.width, h * hh), strokeWidth = 1f)
+                        drawLine(lineColor, Offset(0f, 0f), Offset(0f, size.height), strokeWidth = 1f)
+                    }
+                    placed.forEach { p ->
+                        val w = colW / p.lanes
+                        val top = HourHeight * (p.startMin / 60f)
+                        val h = HourHeight * ((p.endMin - p.startMin) / 60f)
+                        val c = eventColor(p.event)
+                        Box(
+                            Modifier
+                                .offset(x = w * p.lane, y = top)
+                                .width(w)
+                                .height(h)
+                                .padding(1.dp)
+                                .clip(RoundedCornerShape(4.dp))
+                                .background(c.copy(alpha = 0.30f))
+                                .border(width = 0.dp, color = c, shape = RoundedCornerShape(4.dp)),
+                        ) {
+                            Box(Modifier.width(3.dp).fillMaxHeight().background(c))
+                            Text(
+                                p.event.title.ifBlank { "—" },
+                                style = if (days.size > 1) ChipText else NoopType.subhead,
+                                color = Palette.textPrimary,
+                                overflow = TextOverflow.Clip,
+                                modifier = Modifier.padding(start = 5.dp, top = 1.dp, end = 2.dp),
+                            )
+                        }
+                    }
+                    if (day == today) {
+                        val now = LocalTime.now()
+                        Box(
+                            Modifier
+                                .offset(y = HourHeight * ((now.hour * 60 + now.minute) / 60f))
+                                .fillMaxWidth()
+                                .height(2.dp)
+                                .background(Palette.statusCritical),
+                        )
+                    }
+                }
+            }
+        }
+    }
+}
