+        assertEquals(60, placed["Anoche"]!!.endMin)
+        assertEquals(2, placed["A"]!!.lanes) // A overlaps B, then C
+        assertEquals(0, placed["A"]!!.lane)
+        assertEquals(1, placed["B"]!!.lane)
+        assertEquals(1, placed["C"]!!.lane) // B's lane is free again by 10:45
