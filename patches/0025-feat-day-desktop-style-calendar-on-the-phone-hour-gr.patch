+/** The all-day row of a day: all-day events, then the day's tasks. [limit] keeps a week column short. */
+@Composable
+internal fun AllDayChips(events: List<AgendaEvent>, tasks: List<DayTask>, tiny: Boolean, limit: Int, today: LocalDate) {
+    val items = events.filter { it.allDay }.map { Triple(it.title, eventColor(it), false) } +
+        tasks.map { t -> Triple(t.title, null, true) }
+    Column(verticalArrangement = Arrangement.spacedBy(2.dp)) {
+        items.take(limit).forEach { (title, color, task) -> CalendarChip(title, color, task, tiny) }
+        if (items.size > limit) Text("+${items.size - limit}", style = ChipText, color = Palette.textSecondary)
+    }
+}
