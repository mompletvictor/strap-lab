+        days.forEach { d ->
+            Column(
+                horizontalAlignment = Alignment.CenterHorizontally,
+                modifier = Modifier.weight(1f).clickable { onDayClick(d) },
+            ) {
+                Text(d.dayOfWeek.getDisplayName(TextStyle.SHORT, locale), style = NoopType.footnote, color = Palette.textSecondary, maxLines = 1)
+                DayNumber(d.dayOfMonth, d == today)
+            }
+        }
+    }
+}
