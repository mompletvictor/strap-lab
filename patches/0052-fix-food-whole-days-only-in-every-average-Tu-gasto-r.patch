+package com.noop.food
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** victor:energy — which logged days are the whole day: a dinner, or 75 % of the usual total. */
+class FoodCompleteDaysTest {
+
+    private fun meal(day: String, kcal: Double, meal: MealType) = FoodEntry(
+        id = "$day-$kcal-$meal", timestamp = 0L, day = day, note = "", items = emptyList(),
+        kcal = kcal, proteinG = 0.0, carbsG = 0.0, fatG = 0.0, thumbnailPaths = emptyList(), meal = meal,
+    )
+
+    @Test
+    fun aDinnerMakesTheDayWholeAndSoDoesThreeQuartersOfTheUsualTotal() {
+        assertTrue(FoodDays.isComplete(listOf(meal("2026-10-10", 400.0, MealType.DINNER)), null))
+        assertFalse(FoodDays.isComplete(listOf(meal("2026-10-10", 400.0, MealType.BREAKFAST)), null))   // no history: only a dinner counts
+        assertTrue(FoodDays.isComplete(listOf(meal("2026-10-10", 1800.0, MealType.LUNCH)), 2400.0))      // 75 % of the median
+        assertFalse(FoodDays.isComplete(listOf(meal("2026-10-10", 1700.0, MealType.LUNCH)), 2400.0))
+        assertFalse(FoodDays.isComplete(emptyList(), 2400.0))
+    }
+
+    @Test
+    fun theMedianIsOfTheLoggedDaysInTheTwentyEightBefore() {
+        val entries = listOf(
+            meal("2026-09-01", 2000.0, MealType.DINNER),    // 39 days before the 10th: outside its window
+            meal("2026-09-20", 2400.0, MealType.DINNER),
+            meal("2026-09-25", 2600.0, MealType.DINNER),
+            meal("2026-10-01", 2000.0, MealType.DINNER),
+            meal("2026-10-05", 300.0, MealType.BREAKFAST),  // partial: still a logged day in the median (as logged)
+            meal("2026-10-10", 1800.0, MealType.LUNCH),     // lunch alone, 1 800 ≥ 0.75 × median(2400, 2600, 2000, 300) = 0.75 × 2200
+            meal("2026-10-11", 1400.0, MealType.LUNCH),     // under 0.75 × median(2400, 2600, 2000, 300, 1800) = 1 500
+        )
+        val complete = FoodDays.completeDays(entries)
+        assertEquals(setOf("2026-09-01", "2026-09-20", "2026-09-25", "2026-10-01", "2026-10-10"), complete)
+        assertFalse("2026-10-05" in complete)
+        assertFalse("2026-10-11" in complete)
+    }
+}
