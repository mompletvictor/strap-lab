+
+    /** Days of logged intake a day's completeness is judged against, and the share of their median it must reach. */
+    const val COMPLETE_LOOKBACK_DAYS = 28L
+    const val COMPLETE_SHARE = 0.75
+
+    /**
+     * victor:energy — whether a logged day is the WHOLE day: it has a dinner, or its total reaches
+     * [COMPLETE_SHARE] of [medianKcal], the median of the days logged before it. A day with only breakfast
+     * logged is not a day of under-eating; it stays on the charts and out of every average.
+     */
+    fun isComplete(dayEntries: List<FoodEntry>, medianKcal: Double?): Boolean {
+        if (dayEntries.isEmpty()) return false
+        if (dayEntries.any { it.meal == MealType.DINNER }) return true
+        val median = medianKcal ?: return false
+        return FoodTotals.ofEntries(dayEntries).kcal >= COMPLETE_SHARE * median
+    }
+
+    /**
+     * The complete days of the log ([isComplete]): each logged day against the median of the logged days in
+     * the [COMPLETE_LOOKBACK_DAYS] days before it. Pure.
+     */
+    fun completeDays(entries: List<FoodEntry>): Set<String> {
+        val byDay = entries.groupBy { it.day }.toSortedMap()
+        val kcalByDay = byDay.mapValues { (_, list) -> FoodTotals.ofEntries(list).kcal }
+        val out = HashSet<String>()
+        for ((day, list) in byDay) {
+            val from = LocalDate.parse(day).minusDays(COMPLETE_LOOKBACK_DAYS).toString()
+            val prior = kcalByDay.filterKeys { it >= from && it < day }.values.sorted()
+            val median = prior.takeIf { it.isNotEmpty() }?.let { if (it.size % 2 == 1) it[it.size / 2] else (it[it.size / 2 - 1] + it[it.size / 2]) / 2.0 }
+            if (isComplete(list, median)) out += day
+        }
+        return out
+    }
