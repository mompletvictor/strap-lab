diff --git a/android/app/src/main/java/com/noop/ingest/ScaleImport.kt b/android/app/src/main/java/com/noop/ingest/ScaleImport.kt
new file mode 100644
index 000000000..301478c26
--- /dev/null
+++ b/android/app/src/main/java/com/noop/ingest/ScaleImport.kt
@@ -0,0 +1,189 @@
+package com.noop.ingest
+
+import android.content.Context
+import androidx.health.connect.client.records.BasalMetabolicRateRecord
+import androidx.health.connect.client.records.BodyFatRecord
+import androidx.health.connect.client.records.BodyWaterMassRecord
+import androidx.health.connect.client.records.BoneMassRecord
+import androidx.health.connect.client.records.LeanBodyMassRecord
+import androidx.health.connect.client.records.Record
+import androidx.health.connect.client.records.WeightRecord
+import androidx.health.connect.client.time.TimeRangeFilter
+import com.noop.analytics.ScaleBody
+import com.noop.data.MetricSeriesRow
+import com.noop.data.WhoopRepository
+import com.noop.ui.NoopPrefs
+import java.time.Duration
+import java.time.Instant
+import java.time.ZoneOffset
+import kotlin.math.round
+import kotlin.reflect.KClass
+
+/**
+ * The importer's gated per-type reader (upstream's local `readSelected`), erased to [Record] so it can be
+ * handed across as a lambda: a Kotlin lambda cannot be generic. Returns whether the type was read.
+ */
+internal typealias ScaleReader = suspend (KClass<Record>, TimeRangeFilter, (Record) -> Unit) -> Boolean
+
+/**
+ * victor:scale — the smart-scale readings Health Connect carries beyond the weight / body fat / lean mass
+ * upstream already imports: bone mass, body water mass and basal metabolic rate. A Hume Body Pod writes
+ * them to Samsung Health, which shares to Health Connect; whether Samsung forwards these three types is
+ * unverified, so every path here is a quiet no-op when Health Connect holds none.
+ *
+ * Stored exactly like upstream's body_fat / lean_mass: one metricSeries point per local day under the
+ * Health Connect source, the LATEST reading of the day winning, keys in [ScaleBody]. Reached through
+ * marked hooks in HealthConnectImporter: [RECORD_TYPES] spread into BODY_COMPOSITION (so the same
+ * consent, selection and grant gating cover them), [read] before the write-out, and its rows appended
+ * to the metricSeries batch.
+ */
+object ScaleImport {
+
+    /** Spread into upstream's `setOf(...)` for BODY_COMPOSITION, hence an array. */
+    internal val RECORD_TYPES: Array<KClass<out Record>> = arrayOf(
+        BoneMassRecord::class,
+        BodyWaterMassRecord::class,
+        BasalMetabolicRateRecord::class,
+    )
+
+    /**
+     * Read ONLY for the time of the newest weigh-in: the stored series carry a day, never a clock time,
+     * and upstream already stores these three values. A short window keeps the extra read to a handful
+     * of records; a newest reading older than this just shows its date without a time.
+     */
+    private val WEIGH_IN_TYPES: Array<KClass<out Record>> = arrayOf(
+        WeightRecord::class,
+        BodyFatRecord::class,
+        LeanBodyMassRecord::class,
+    )
+    private val WEIGH_IN_TIME_WINDOW: Duration = Duration.ofDays(90)
+
+    private const val KEY_NEWEST_AT = "victor.scale.newestReadingAt"
+    private const val KEY_NEWEST_DAY = "victor.scale.newestReadingDay"
+
+    /** The metricSeries key and stored-unit value for one of [RECORD_TYPES]; null for any other record. */
+    internal fun entry(record: Record): Pair<String, Double>? = when (record) {
+        is BoneMassRecord -> ScaleBody.KEY_BONE_MASS to record.mass.inKilograms
+        is BodyWaterMassRecord -> ScaleBody.KEY_BODY_WATER to record.mass.inKilograms
+        is BasalMetabolicRateRecord -> ScaleBody.KEY_BMR to record.basalMetabolicRate.inKilocaloriesPerDay
+        else -> null
+    }
+
+    /**
+     * When a scale record was taken: (time, zone offset) for every type this file reads; null otherwise.
+     * Spelled out per type because Health Connect's shared `InstantaneousRecord` interface is internal.
+     */
+    internal fun stamp(record: Record): Pair<Instant, ZoneOffset?>? = when (record) {
+        is BoneMassRecord -> record.time to record.zoneOffset
+        is BodyWaterMassRecord -> record.time to record.zoneOffset
+        is BasalMetabolicRateRecord -> record.time to record.zoneOffset
+        is WeightRecord -> record.time to record.zoneOffset
+        is BodyFatRecord -> record.time to record.zoneOffset
+        is LeanBodyMassRecord -> record.time to record.zoneOffset
+        else -> null
+    }
+
+    /** Latest-reading-of-the-day accumulator, plus the newest reading seen across every scale type. */
+    internal class Accumulator {
+        private val byDay = HashMap<String, HashMap<String, Pair<Long, Double>>>()
+
+        var newestAt: Long? = null
+            private set
+        var newestDay: String? = null
+            private set
+
+        fun add(day: String, key: String, epochSecond: Long, value: Double) {
+            val slot = byDay.getOrPut(day) { HashMap() }
+            val previous = slot[key]
+            // Same rule as upstream's weight / body-fat reads (`>=`): a later record at the same second wins.
+            if (previous == null || epochSecond >= previous.first) slot[key] = epochSecond to value
+            seen(day, epochSecond)
+        }
+
+        fun seen(day: String, epochSecond: Long) {
+            val current = newestAt
+            if (current == null || epochSecond > current) {
+                newestAt = epochSecond
+                newestDay = day
+            }
+        }
+
+        /** One row per (day, key), rounded to two places like upstream's body-composition series. */
+        fun rows(deviceId: String): List<MetricSeriesRow> =
+            byDay.entries.sortedBy { it.key }.flatMap { (day, slot) ->
+                slot.entries.sortedBy { it.key }.map { (key, reading) ->
+                    MetricSeriesRow(deviceId, day, key, round(reading.second * 100.0) / 100.0)
+                }
+            }
+    }
+
+    /**
+     * Read the three extra types over the import's [filter], remember the newest reading's time, and
+     * return the rows to append to the import's metricSeries batch (empty when nothing was found or the
+     * category is not selected/granted: [reader] gates that). Never throws: the reader swallows
+     * per-type failures and the preference write is best-effort.
+     */
+    internal suspend fun read(
+        context: Context,
+        deviceId: String,
+        filter: TimeRangeFilter,
+        dayOf: (Instant, ZoneOffset?) -> String,
+        reader: ScaleReader,
+    ): List<MetricSeriesRow> {
+        val acc = Accumulator()
+        for (type in RECORD_TYPES) {
+            reader(erase(type), filter) { r ->
+                val e = entry(r)
+                val at = stamp(r)
+                if (e != null && at != null) {
+                    acc.add(dayOf(at.first, at.second), e.first, at.first.epochSecond, e.second)
+                }
+            }
+        }
+        val now = Instant.now()
+        val recent = TimeRangeFilter.between(now.minus(WEIGH_IN_TIME_WINDOW), now)
+        for (type in WEIGH_IN_TYPES) {
+            reader(erase(type), recent) { r ->
+                stamp(r)?.let { (time, offset) -> acc.seen(dayOf(time, offset), time.epochSecond) }
+            }
+        }
+        val at = acc.newestAt
+        val day = acc.newestDay
+        if (at != null && day != null) {
+            runCatching {
+                prefs(context).edit().putLong(KEY_NEWEST_AT, at).putString(KEY_NEWEST_DAY, day).apply()
+            }
+        }
+        return acc.rows(deviceId)
+    }
+
+    /** The (epoch seconds, local day) of the newest scale reading the last import saw, or null. */
+    fun newestReading(context: Context): Pair<Long, String>? {
+        val p = prefs(context)
+        val day = p.getString(KEY_NEWEST_DAY, null) ?: return null
+        if (!p.contains(KEY_NEWEST_AT)) return null
+        return p.getLong(KEY_NEWEST_AT, 0L) to day
+    }
+
+    /**
+     * The stored scale series (Health Connect source) as a [ScaleBody.Snapshot], or null when there is
+     * none. Each series is read whole; a scale writes at most a point per day per key, so that is small.
+     */
+    suspend fun snapshot(
+        repo: WhoopRepository,
+        newestReading: Pair<Long, String>? = null,
+    ): ScaleBody.Snapshot? {
+        val series = ScaleBody.KEYS.associateWith { key ->
+            runCatching { repo.metricSeries(HealthConnectImporter.HC_DEVICE, key, "0000-01-01", "9999-12-31") }
+                .getOrDefault(emptyList())
+                .map { ScaleBody.Reading(it.day, it.value) }
+        }
+        return ScaleBody.snapshot(series, newestReading)
+    }
+
+    @Suppress("UNCHECKED_CAST")
+    private fun erase(type: KClass<out Record>): KClass<Record> = type as KClass<Record>
+
+    private fun prefs(context: Context) =
+        context.getSharedPreferences(NoopPrefs.NAME, Context.MODE_PRIVATE)
+}
