@@ -0,0 +1,105 @@
+package com.noop.analytics
+
+import com.noop.analytics.ScaleBody.Reading
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+/** victor:scale — the smart-scale snapshot: newest values, ~7 / ~30 day deltas, the 30-day trend. */
+class ScaleBodyTest {
+
+    private fun r(day: String, v: Double) = Reading(day, v)
+
+    @Test
+    fun noReadingsMeansNoSnapshot() {
+        assertNull(ScaleBody.snapshot(emptyMap()))
+        assertNull(ScaleBody.snapshot(mapOf(ScaleBody.KEY_WEIGHT to emptyList())))
+        // A series nobody reads (not a scale key) does not count either.
+        assertNull(ScaleBody.snapshot(mapOf("steps" to listOf(r("2026-10-15", 9000.0)))))
+    }
+
+    @Test
+    fun newestValuePerMetricAndHeadlineDay() {
+        val s = ScaleBody.snapshot(
+            mapOf(
+                // Unsorted on purpose: the store returns ascending, but nothing here relies on it.
+                ScaleBody.KEY_WEIGHT to listOf(r("2026-10-15", 78.2), r("2026-10-14", 78.5)),
+                ScaleBody.KEY_BODY_FAT to listOf(r("2026-10-12", 18.4)),
+                ScaleBody.KEY_BMR to listOf(r("2026-10-15", 1780.0)),
+            ),
+        )!!
+        assertEquals("2026-10-15", s.day)
+        assertEquals(78.2, s.weight!!.value, 0.0)
+        assertEquals("2026-10-12", s.bodyFat!!.day)   // keeps its own day; the card says "as of"
+        assertEquals(1780.0, s.bmr!!.value, 0.0)
+        assertNull(s.leanMass)
+        assertNull(s.boneMass)
+        assertNull(s.bodyWater)
+        assertNull(s.bmr!!.vs7d)                        // deltas are tracked for weight and body fat only
+    }
+
+    @Test
+    fun deltaUsesTheReadingClosestToTheTargetDay() {
+        val series = listOf(
+            r("2026-09-14", 80.0),   // 31 days back
+            r("2026-09-17", 79.9),   // 28 days back
+            r("2026-10-07", 78.9),   // 8 days back
+            r("2026-10-09", 79.0),   // 6 days back
+            r("2026-10-15", 78.2),
+        )
+        // 7d target 2026-10-08: the 7th and the 9th are both one day off; the tie goes to the OLDER one.
+        assertEquals(78.2 - 78.9, ScaleBody.delta(series, 7, 3)!!, 1e-9)
+        // 30d target 2026-09-15: the 14th (1 day off) beats the 17th (2 days off).
+        assertEquals(78.2 - 80.0, ScaleBody.delta(series, 30, 7)!!, 1e-9)
+    }
+
+    @Test
+    fun deltaIsNullOutsideTheTolerance() {
+        val series = listOf(r("2026-10-01", 80.0), r("2026-10-15", 78.2))   // 14 days back only
+        assertNull(ScaleBody.delta(series, 7, 3))                           // window 10-05..10-11
+        assertNull(ScaleBody.delta(series, 30, 7))                          // window 09-08..09-22
+        assertNull(ScaleBody.delta(listOf(r("2026-10-15", 78.2)), 7, 3))
+        assertNull(ScaleBody.delta(emptyList(), 7, 3))
+    }
+
+    @Test
+    fun snapshotCarriesWeightAndBodyFatDeltas() {
+        val s = ScaleBody.snapshot(
+            mapOf(
+                ScaleBody.KEY_WEIGHT to listOf(r("2026-09-15", 79.6), r("2026-10-08", 78.8), r("2026-10-15", 78.2)),
+                ScaleBody.KEY_BODY_FAT to listOf(r("2026-10-08", 18.4), r("2026-10-15", 18.1)),
+            ),
+        )!!
+        assertEquals(-0.6, s.weight!!.vs7d!!, 1e-9)
+        assertEquals(-1.4, s.weight!!.vs30d!!, 1e-9)
+        assertEquals(-0.3, s.bodyFat!!.vs7d!!, 1e-9)
+        assertNull(s.bodyFat!!.vs30d)
+    }
+
+    @Test
+    fun trendIsTheThirtyDaysEndingAtTheNewestWeighIn() {
+        val series = listOf(
+            r("2026-09-15", 80.0),   // 30 days before the newest: just outside
+            r("2026-09-16", 79.8),   // day 1 of the 30
+            r("2026-10-01", 79.0),
+            r("2026-10-15", 78.2),
+        )
+        assertEquals(listOf(79.8, 79.0, 78.2), ScaleBody.trend(series))
+        assertEquals(emptyList<Double>(), ScaleBody.trend(emptyList()))
+    }
+
+    @Test
+    fun readingTimeOnlyWhenItFallsOnTheHeadlineDay() {
+        val series = mapOf(ScaleBody.KEY_WEIGHT to listOf(r("2026-10-15", 78.2)))
+        assertEquals(1_760_510_000L, ScaleBody.snapshot(series, 1_760_510_000L to "2026-10-15")!!.readingAt)
+        assertNull(ScaleBody.snapshot(series, 1_760_400_000L to "2026-10-14")!!.readingAt)
+        assertNull(ScaleBody.snapshot(series, null)!!.readingAt)
+    }
+
+    @Test
+    fun malformedDaysAreIgnored() {
+        val s = ScaleBody.snapshot(mapOf(ScaleBody.KEY_WEIGHT to listOf(r("garbage", 1.0), r("2026-10-15", 78.2))))!!
+        assertEquals("2026-10-15", s.day)
+        assertEquals(listOf(78.2), s.weightTrend)
+    }
+}
