+++ b/android/app/src/main/java/com/noop/analytics/ScaleBody.kt
@@ -0,0 +1,128 @@
+package com.noop.analytics
+
+import java.time.LocalDate
+import kotlin.math.abs
+
+/**
+ * victor:scale — pure model behind the smart-scale card and the coach's BODY line.
+ *
+ * Input is the per-day body-composition series the Health Connect importer stores (latest reading of
+ * each local day, one metricSeries point per key). Everything here is database- and Android-free so it
+ * runs as a plain JVM test; the reads live in `ScaleImport.snapshot`.
+ */
+object ScaleBody {
+    // Upstream keys (HealthConnectImporter / AppleHealthImporter), reused verbatim.
+    const val KEY_WEIGHT = "weight"         // kg
+    const val KEY_BODY_FAT = "body_fat"     // percent, 0-100
+    const val KEY_LEAN_MASS = "lean_mass"   // kg
+    // Fork-added keys. No Swift twin defines a vocabulary for these yet; named in the same style.
+    const val KEY_BONE_MASS = "bone_mass"   // kg
+    const val KEY_BODY_WATER = "body_water" // kg (mass, as Health Connect stores it, not a percentage)
+    const val KEY_BMR = "bmr"               // kcal/day
+
+    /** Every series the scale card reads, in display order. */
+    val KEYS: List<String> =
+        listOf(KEY_WEIGHT, KEY_BODY_FAT, KEY_LEAN_MASS, KEY_BONE_MASS, KEY_BODY_WATER, KEY_BMR)
+
+    /** Days of weight shown in the trend line, ending at the newest weigh-in. */
+    const val TREND_DAYS = 30L
+
+    /**
+     * "~7 days" / "~30 days" earlier: the reading CLOSEST to the target day within this many days either
+     * side. A scale is not used daily by everyone, so an exact-day match would leave most deltas empty;
+     * the tolerance keeps each window clear of the other and of the newest reading itself.
+     */
+    private const val WEEK_TOLERANCE_DAYS = 3L
+    private const val MONTH_TOLERANCE_DAYS = 7L
+
+    data class Reading(val day: String, val value: Double)
+
+    /** One metric's newest reading, plus its change vs ~7 and ~30 days earlier when that is tracked. */
+    data class Metric(
+        val day: String,
+        val value: Double,
+        val vs7d: Double? = null,
+        val vs30d: Double? = null,
+    )
+
+    data class Snapshot(
+        /** The newest local day any scale metric was recorded on. */
+        val day: String,
+        /** Epoch seconds of the newest reading, only when it is known AND falls on [day]. */
+        val readingAt: Long?,
+        val weight: Metric?,
+        val bodyFat: Metric?,
+        val leanMass: Metric?,
+        val boneMass: Metric?,
+        val bodyWater: Metric?,
+        val bmr: Metric?,
+        /** Weight values over the [TREND_DAYS] days ending at the newest weigh-in, oldest first. */
+        val weightTrend: List<Double>,
+    )
+
+    /**
+     * Build the snapshot from [series] (key -> readings, any order). Null when no key carries a reading,
+     * which is what the card and the coach treat as "no scale data". [newestReading] is the importer's
+     * remembered (epoch seconds, local day) of the newest reading; its time is only used when its day is
+     * the snapshot's day, so a stale stamp can never put a clock time on a different day's numbers.
+     */
+    fun snapshot(series: Map<String, List<Reading>>, newestReading: Pair<Long, String>? = null): Snapshot? {
+        val sorted = KEYS.associateWith { key ->
+            series[key].orEmpty().filter { parseDay(it.day) != null }.sortedBy { it.day }
+        }
+        val day = sorted.values.mapNotNull { it.lastOrNull()?.day }.maxOrNull() ?: return null
+        fun metric(key: String, withDeltas: Boolean): Metric? {
+            val s = sorted.getValue(key)
+            val last = s.lastOrNull() ?: return null
+            return if (withDeltas) {
+                Metric(last.day, last.value, delta(s, 7, WEEK_TOLERANCE_DAYS), delta(s, 30, MONTH_TOLERANCE_DAYS))
+            } else {
+                Metric(last.day, last.value)
+            }
+        }
+        return Snapshot(
+            day = day,
+            readingAt = newestReading?.takeIf { it.second == day }?.first,
+            weight = metric(KEY_WEIGHT, withDeltas = true),
+            bodyFat = metric(KEY_BODY_FAT, withDeltas = true),
+            leanMass = metric(KEY_LEAN_MASS, withDeltas = false),
+            boneMass = metric(KEY_BONE_MASS, withDeltas = false),
+            bodyWater = metric(KEY_BODY_WATER, withDeltas = false),
+            bmr = metric(KEY_BMR, withDeltas = false),
+            weightTrend = trend(sorted.getValue(KEY_WEIGHT)),
+        )
+    }
+
+    /**
+     * Newest value minus the reading closest to [daysBack] days before it (within ±[toleranceDays],
+     * ties going to the OLDER reading). Null when the series has no reading in that window.
+     * [series] must be sorted ascending by day.
+     */
+    internal fun delta(series: List<Reading>, daysBack: Long, toleranceDays: Long): Double? {
+        val last = series.lastOrNull() ?: return null
+        val lastDate = parseDay(last.day) ?: return null
+        val target = lastDate.minusDays(daysBack)
+        var best: Reading? = null
+        var bestDistance = Long.MAX_VALUE
+        // Ascending walk with a strict '<', so on a tie the earlier (older) reading is kept.
+        for (r in series) {
+            val d = parseDay(r.day) ?: continue
+            if (!d.isBefore(lastDate)) continue
+            val distance = abs(d.toEpochDay() - target.toEpochDay())
+            if (distance <= toleranceDays && distance < bestDistance) {
+                best = r
+                bestDistance = distance
+            }
+        }
+        return best?.let { last.value - it.value }
+    }
+
+    /** Weight values from the [TREND_DAYS]-day window ending at the newest weigh-in, oldest first. */
+    internal fun trend(series: List<Reading>): List<Double> {
+        val last = series.lastOrNull() ?: return emptyList()
+        val from = parseDay(last.day)?.minusDays(TREND_DAYS - 1)?.toString() ?: return emptyList()
+        return series.filter { it.day >= from }.map { it.value }
+    }
+
+    private fun parseDay(day: String): LocalDate? = runCatching { LocalDate.parse(day) }.getOrNull()
+}
