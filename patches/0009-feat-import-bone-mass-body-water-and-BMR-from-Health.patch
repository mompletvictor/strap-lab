+package com.noop.ingest
+
+import android.content.Context
+import androidx.health.connect.client.permission.HealthPermission
+import androidx.health.connect.client.records.BasalMetabolicRateRecord
+import androidx.health.connect.client.records.BodyFatRecord
+import androidx.health.connect.client.records.BodyWaterMassRecord
+import androidx.health.connect.client.records.BoneMassRecord
+import androidx.health.connect.client.records.Record
+import androidx.health.connect.client.records.WeightRecord
+import androidx.health.connect.client.units.Mass
+import androidx.health.connect.client.units.Percentage
+import androidx.health.connect.client.units.Power
+import com.noop.analytics.ScaleBody
+import com.noop.data.MetricSeriesRow
+import com.noop.ingest.HealthConnectImporter.ImportCategory
+import com.noop.ui.NoopPrefs
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import java.time.Instant
+import java.time.ZoneOffset
+import kotlin.reflect.KClass
+
+/** victor:scale — bone mass / body water / BMR import: consent wiring, record mapping, latest-of-day. */
+@RunWith(RobolectricTestRunner::class)
+class ScaleImportTest {
+
+    private val madrid = ZoneOffset.ofHours(2)
+    private fun at(iso: String): Instant = Instant.parse(iso)
+    private fun dayOf(i: Instant, o: ZoneOffset?): String = HealthConnectImporter.localDayKey(i, o, ZoneOffset.UTC)
+
+    private val scalePermissions = listOf(
+        "android.permission.health.READ_BONE_MASS",
+        "android.permission.health.READ_BODY_WATER_MASS",
+        "android.permission.health.READ_BASAL_METABOLIC_RATE",
+    )
+
+    // MARK: - consent wiring
+
+    @Test
+    fun scaleTypesRideTheBodyCompositionCategoryOnly() {
+        val body = HealthConnectImporter.permissionsFor(setOf(ImportCategory.BODY_COMPOSITION))
+        val others = HealthConnectImporter.permissionsFor(setOf(ImportCategory.RECOVERY, ImportCategory.ACTIVITY))
+        assertEquals(scalePermissions, ScaleImport.RECORD_TYPES.map { HealthPermission.getReadPermission(it) })
+        for (p in scalePermissions) {
+            assertTrue(p, p in body)
+            assertFalse(p, p in others)
+            assertTrue(p, p in HealthConnectImporter.PERMISSIONS)
+        }
+    }
+
+    /** Health Connect silently drops a runtime request for a permission the manifest does not declare (#412). */
+    @Test
+    fun manifestDeclaresEveryScalePermission() {
+        val manifest = read("android/app/src/main/AndroidManifest.xml")
+        for (p in scalePermissions) assertTrue("$p missing from the manifest", "android:name=\"$p\"" in manifest)
+    }
+
+    // MARK: - record -> (key, stored unit)
+
+    @Test
+    fun recordsMapToTheirKeysInStoredUnits() {
+        val t = at("2026-10-15T05:42:00Z")
+        assertEquals(
+            ScaleBody.KEY_BONE_MASS to 3.1,
+            ScaleImport.entry(BoneMassRecord(time = t, zoneOffset = madrid, mass = Mass.kilograms(3.1))),
+        )
+        assertEquals(
+            ScaleBody.KEY_BODY_WATER to 45.2,
+            ScaleImport.entry(BodyWaterMassRecord(time = t, zoneOffset = madrid, mass = Mass.kilograms(45.2))),
+        )
+        val bmr = ScaleImport.entry(
+            BasalMetabolicRateRecord(time = t, zoneOffset = madrid, basalMetabolicRate = Power.kilocaloriesPerDay(1780.0)),
+        )!!
+        assertEquals(ScaleBody.KEY_BMR, bmr.first)
+        assertEquals(1780.0, bmr.second, 1e-6)
+        // Weight stays upstream's: this file only maps the three types it owns.
+        assertNull(ScaleImport.entry(WeightRecord(time = t, zoneOffset = madrid, weight = Mass.kilograms(78.2))))
+    }
+
+    @Test
+    fun stampCarriesTheRecordsOwnOffset() {
+        val t = at("2026-10-15T22:30:00Z")
+        val r = BoneMassRecord(time = t, zoneOffset = madrid, mass = Mass.kilograms(3.0))
+        assertEquals(t to madrid, ScaleImport.stamp(r))
+        // 22:30Z is already the 16th in Madrid: keyed by the record's offset, like upstream's weight.
+        assertEquals("2026-10-16", dayOf(t, madrid))
+    }
+
+    // MARK: - latest reading of the day
+
+    @Test
+    fun latestReadingOfTheDayWins() {
+        val acc = ScaleImport.Accumulator()
+        acc.add("2026-10-15", ScaleBody.KEY_BONE_MASS, 2_000L, 3.2)
+        acc.add("2026-10-15", ScaleBody.KEY_BONE_MASS, 1_000L, 3.0)   // older, read later: ignored
+        acc.add("2026-10-14", ScaleBody.KEY_BONE_MASS, 500L, 2.9)
+        acc.add("2026-10-15", ScaleBody.KEY_BMR, 2_000L, 1780.456)
+        assertEquals(
+            listOf(
+                MetricSeriesRow("health-connect", "2026-10-14", "bone_mass", 2.9),
+                MetricSeriesRow("health-connect", "2026-10-15", "bmr", 1780.46),
+                MetricSeriesRow("health-connect", "2026-10-15", "bone_mass", 3.2),
+            ),
+            acc.rows("health-connect"),
+        )
+    }
+
+    @Test
+    fun sameSecondTieGoesToTheLaterRecordLikeUpstream() {
+        val acc = ScaleImport.Accumulator()
+        acc.add("2026-10-15", ScaleBody.KEY_BODY_WATER, 1_000L, 45.0)
+        acc.add("2026-10-15", ScaleBody.KEY_BODY_WATER, 1_000L, 45.4)
+        assertEquals(45.4, acc.rows("hc").single().value, 0.0)
+    }
+
+    @Test
+    fun newestReadingTracksTheMaxAcrossAddAndSeen() {
+        val acc = ScaleImport.Accumulator()
+        assertNull(acc.newestAt)
+        acc.add("2026-10-14", ScaleBody.KEY_BMR, 1_000L, 1700.0)
+        acc.seen("2026-10-15", 3_000L)
+        acc.seen("2026-10-13", 500L)
+        assertEquals(3_000L, acc.newestAt)
+        assertEquals("2026-10-15", acc.newestDay)
+        assertTrue(ScaleImport.Accumulator().rows("hc").isEmpty())
+    }
+
+    // MARK: - the importer hook, end to end with a fake gated reader
+
+    @Test
+    fun readImportsLatestOfDayAndRemembersTheNewestWeighIn() = runBlocking {
+        val ctx = freshContext()
+        val store: Map<KClass<*>, List<Record>> = mapOf(
+            BoneMassRecord::class to listOf(
+                BoneMassRecord(time = at("2026-10-15T05:40:00Z"), zoneOffset = madrid, mass = Mass.kilograms(3.0)),
+                BoneMassRecord(time = at("2026-10-15T18:10:00Z"), zoneOffset = madrid, mass = Mass.kilograms(3.1)),
+            ),
+            BasalMetabolicRateRecord::class to listOf(
+                BasalMetabolicRateRecord(
+                    time = at("2026-10-14T06:00:00Z"), zoneOffset = madrid,
+                    basalMetabolicRate = Power.kilocaloriesPerDay(1775.0),
+                ),
+            ),
+            // Not present in Health Connect at all: must simply contribute nothing.
+            BodyWaterMassRecord::class to emptyList(),
+            // Weigh-in types are read only for their time; the newest one here is the newest reading.
+            WeightRecord::class to listOf(
+                WeightRecord(time = at("2026-10-15T18:11:00Z"), zoneOffset = madrid, weight = Mass.kilograms(78.2)),
+            ),
+            BodyFatRecord::class to listOf(
+                BodyFatRecord(time = at("2026-10-15T18:11:00Z"), zoneOffset = madrid, percentage = Percentage(18.1)),
+            ),
+        )
+        val touched = mutableListOf<String>()
+        val rows = ScaleImport.read(ctx, "health-connect", anyFilter(), { i, o -> dayOf(i, o).also { touched += it } }) { type, _, cb ->
+            val records = store[type] ?: return@read false
+            records.forEach(cb)
+            true
+        }
+
+        assertEquals(
+            listOf(
+                MetricSeriesRow("health-connect", "2026-10-14", "bmr", 1775.0),
+                MetricSeriesRow("health-connect", "2026-10-15", "bone_mass", 3.1),
+            ),
+            rows,
+        )
+        assertEquals(at("2026-10-15T18:11:00Z").epochSecond to "2026-10-15", ScaleImport.newestReading(ctx))
+        // Every record's day reached the importer's day function (so its bucket exists).
+        assertTrue(touched.containsAll(listOf("2026-10-14", "2026-10-15")))
+    }
+
+    /** Category deselected or permission not granted: the gated reader refuses every type. */
+    @Test
+    fun readIsANoOpWhenNothingIsReadable() = runBlocking {
+        val ctx = freshContext()
+        val rows = ScaleImport.read(ctx, "health-connect", anyFilter(), { i, o -> dayOf(i, o) }) { _, _, _ -> false }
+        assertTrue(rows.isEmpty())
+        assertNull(ScaleImport.newestReading(ctx))
+    }
+
+    private fun freshContext(): Context = RuntimeEnvironment.getApplication().also {
+        it.getSharedPreferences(NoopPrefs.NAME, Context.MODE_PRIVATE).edit().clear().commit()
+    }
+
+    private fun anyFilter() = androidx.health.connect.client.time.TimeRangeFilter.between(
+        at("2016-01-01T00:00:00Z"), at("2026-10-16T00:00:00Z"),
+    )
+
+    private fun read(relative: String): String {
+        var root = java.io.File(System.getProperty("user.dir") ?: ".").canonicalFile
+        repeat(4) {
+            val f = java.io.File(root, relative)
+            if (f.isFile) return f.readText()
+            root = root.parentFile ?: root
+        }
+        throw IllegalStateException("$relative not found from ${System.getProperty("user.dir")}")
+    }
+}
