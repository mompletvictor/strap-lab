+++ b/android/app/src/main/java/com/noop/training/VictorDayEffort.kt
@@ -0,0 +1,64 @@
+package com.noop.training
+
+import com.noop.analytics.StrainScorer
+import com.noop.data.DailyMetric
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import java.time.ZoneId
+import kotlin.math.exp
+
+/**
+ * victor:training — the muscular load of analysed gym sessions, added to the DAY's Effort, the way WHOOP's
+ * Strength Trainer adds it to Day Strain. Upstream's Effort is heart-rate only (100 × ln(TRIMP+1) / ln(D)),
+ * which barely moves for heavy short sets: an hour of hard lifting read 18/100 for the day.
+ *
+ * The axis is logarithmic, so efforts are not added: each session's extra load is
+ * TRIMP(Claude's effort) − TRIMP(its heart-rate effort), the day's extras are summed, added to the day's
+ * own TRIMP and mapped back. A session without a heart-rate effort counts its whole effort as extra.
+ * Applied where the merged daily rows are read (one line in each of WhoopRepository's three merged
+ * readers), so the Today ring, its tiles, Trends and the coach all read the same number; nothing is
+ * written back, so a later analysis simply replaces it.
+ */
+object VictorDayEffort {
+
+    private val _boosts = MutableStateFlow<Map<String, Double>>(emptyMap())
+    /** Extra TRIMP per local day ("yyyy-MM-dd"). Kept current by [TrainingStore]. */
+    val boosts: StateFlow<Map<String, Double>> = _boosts.asStateFlow()
+
+    fun update(sessions: List<TrainingSession>, zone: ZoneId = ZoneId.systemDefault()) {
+        _boosts.value = extraTrimpByDay(sessions, zone)
+    }
+
+    /** Pure: the day's merged rows with the extra load added to their Effort. */
+    fun apply(days: List<DailyMetric>, boosts: Map<String, Double>): List<DailyMetric> {
+        if (boosts.isEmpty()) return days
+        return days.map { d ->
+            val extra = boosts[d.day]?.takeIf { it > 0 } ?: return@map d
+            d.copy(strain = withExtra(d.strain, extra))
+        }
+    }
+
+    /** Pure: an Effort with [extraTrimp] more load on the same 0-100 axis. */
+    fun withExtra(effort: Double?, extraTrimp: Double): Double {
+        val base = trimpOf(effort ?: 0.0)
+        return StrainScorer.trimpToStrain(base + extraTrimp.coerceAtLeast(0.0)).coerceIn(0.0, StrainScorer.maxStrain)
+    }
+
+    /** Pure: the inverse of [StrainScorer.trimpToStrain] on the default denominator. */
+    fun trimpOf(effort: Double): Double =
+        (exp(effort.coerceIn(0.0, StrainScorer.maxStrain) * StrainScorer.lnStrainDenominator / StrainScorer.maxStrain) - 1.0).coerceAtLeast(0.0)
+
+    /** Pure: per day, the load Claude's efforts add above what the heart rate already measured. */
+    fun extraTrimpByDay(sessions: List<TrainingSession>, zone: ZoneId): Map<String, Double> {
+        val out = HashMap<String, Double>()
+        for (s in sessions) {
+            if (s.isLive) continue
+            val a = s.analysis ?: continue
+            val effort = a.effort ?: continue
+            val extra = trimpOf(effort) - trimpOf(a.hrStrain ?: 0.0)
+            if (extra > 0) out.merge(s.day(zone), extra, Double::plus)
+        }
+        return out
+    }
+}
diff --git a/android/app/src/test/java/com/noop/training/VictorDayEffortTest.kt b/android/app/src/test/java/com/noop/training/VictorDayEffortTest.kt
new file mode 100644
index 000000000..a45e98f75
--- /dev/null
+++ b/android/app/src/test/java/com/noop/training/VictorDayEffortTest.kt
@@ -0,0 +1,53 @@
+package com.noop.training
+
+import com.noop.analytics.StrainScorer
+import com.noop.data.DailyMetric
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertSame
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.time.ZoneId
+
+/** victor:training — a gym session's muscular load reaches the day's Effort, on its logarithmic axis. */
+class VictorDayEffortTest {
+
+    private val madrid = ZoneId.of("Europe/Madrid")
+    // 2026-10-19 09:00 in Madrid.
+    private val start = 1_792_393_200L
+
+    private fun session(effort: Double?, hrStrain: Double?, live: Boolean = false) = TrainingSession(
+        id = "s", mode = TrainingMode.LOGGED, startTs = start, endTs = if (live) null else start + 4500, sport = "Strength",
+        description = "", exercises = emptyList(),
+        analysis = TrainingAnalysis(430.0, null, null, 263.0, "", 1L, hrStrain = hrStrain, effort = effort),
+    )
+
+    @Test
+    fun theInverseRoundTripsTheEffortMap() {
+        for (e in listOf(0.0, 5.0, 18.0, 55.0, 90.0)) {
+            assertEquals(e, StrainScorer.trimpToStrain(VictorDayEffort.trimpOf(e)), 0.01)
+        }
+    }
+
+    @Test
+    fun aDayAt18WithAnHourOfHeavyLiftingLandsNearTheSessionsEffort() {
+        // The day's 18 already holds the session's heart-rate 15; Claude puts the session at 55.
+        val extra = VictorDayEffort.extraTrimpByDay(listOf(session(55.0, 15.0)), madrid)
+        assertEquals(setOf("2026-10-19"), extra.keys)
+        val day = VictorDayEffort.withExtra(18.0, extra.getValue("2026-10-19"))
+        assertTrue("day $day", day in 55.0..56.0)
+    }
+
+    @Test
+    fun onlyAnalysedFinishedSessionsWithAnEffortCountAndOtherDaysAreUntouched() {
+        assertEquals(emptyMap<String, Double>(), VictorDayEffort.extraTrimpByDay(listOf(session(null, 15.0)), madrid))
+        assertEquals(emptyMap<String, Double>(), VictorDayEffort.extraTrimpByDay(listOf(session(55.0, 15.0, live = true)), madrid))
+        // Cardio where Claude's effort is the heart-rate one: nothing to add.
+        assertEquals(emptyMap<String, Double>(), VictorDayEffort.extraTrimpByDay(listOf(session(40.0, 40.0)), madrid))
+
+        val days = listOf(DailyMetric("my-whoop", "2026-10-18", strain = 30.0), DailyMetric("my-whoop", "2026-10-19", strain = 18.0))
+        val out = VictorDayEffort.apply(days, VictorDayEffort.extraTrimpByDay(listOf(session(55.0, 15.0)), madrid))
+        assertEquals(30.0, out[0].strain!!, 0.0)
+        assertTrue(out[1].strain!! > 55.0)
+        assertSame(days, VictorDayEffort.apply(days, emptyMap()))
+    }
+}
