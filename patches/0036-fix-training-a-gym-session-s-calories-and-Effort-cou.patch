+    /**
+     * Whether an analysis that saw [seenSamples] heart-rate samples (null = never analysed) should run again
+     * now that the window holds [nowSamples]: never analysed, or a quarter more and at least a minute more.
+     */
+    fun needsReanalysis(seenSamples: Int?, nowSamples: Int): Boolean {
+        if (seenSamples == null) return true
+        return nowSamples >= seenSamples + maxOf(60, seenSamples / 4)
+    }
+
+    /**
+     * The workout row with the session's figures from its latest analysis, so the Workouts list, its detail
+     * and every total show them: energy = the larger of Claude's estimate and the heart-rate one, Effort = the
