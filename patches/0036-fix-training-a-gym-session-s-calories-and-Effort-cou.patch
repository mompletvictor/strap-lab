+    /**
+     * The strap banks its heart rate and hands it over at the next sync, so a workout saved before that is
+     * first scored on part of it. For the sessions of the last [RECHECK_DAYS] days: one never analysed (a
+     * failed try) or one whose window now holds clearly more samples than its analysis saw is analysed
+     * again. Cheap when nothing changed (a local count); called when Today, Food or a workout shows.
+     */
+    fun refreshStale(ctx: Context) {
+        val app = ctx.applicationContext
+        if (!refreshing.compareAndSet(false, true)) return
+        scope.launch {
+            try {
+                runCatching {
+                    val a = app as NoopApplication
+                    val strapId = a.sourceCoordinator.activeDeviceId.value ?: a.activeDeviceId
+                    val since = System.currentTimeMillis() / 1000 - RECHECK_DAYS * 86_400L
+                    for (s in TrainingStore.load(app).filter { !it.isLive && (it.endTs ?: 0) >= since }) {
+                        val end = s.endTs ?: continue
+                        val seen = s.analysis?.hrSamples
+                        val now = runCatching { a.repository.hrSamplesUnion(strapId, s.startTs, end, HR_LIMIT).size }.getOrDefault(0)
+                        if (TrainingEnergy.needsReanalysis(seen, now)) analyze(app, s.id)
+                    }
+                }
+            } finally {
+                refreshing.set(false)
+            }
+        }
+    }
